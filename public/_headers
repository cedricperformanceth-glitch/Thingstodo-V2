# The isolated 300x250 ad document is the only active ad endpoint.
# Keep click isolation and noindex; exclude embedded ad documents from visitor analytics.
/adsterra/300x250/
  X-Robots-Tag: noindex, nofollow
  Cache-Control: public, max-age=0, no-transform
  Content-Security-Policy: sandbox allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox; frame-ancestors 'self'
