# Cloudflare may canonicalize an Astro folder page to a trailing slash.
# Cover every final 200 response path, not only the redirecting URL.
/adsterra/*
  X-Robots-Tag: noindex, nofollow
  Content-Security-Policy: sandbox allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox; frame-ancestors 'self'

/adsterra/300x250
  X-Robots-Tag: noindex, nofollow
  Content-Security-Policy: sandbox allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox; frame-ancestors 'self'

/adsterra/300x250/
  X-Robots-Tag: noindex, nofollow
  Content-Security-Policy: sandbox allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox; frame-ancestors 'self'
