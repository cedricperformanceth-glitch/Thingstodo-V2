{
  "laos": {
    "searchArea": {
      "scope": "settlement-first",
      "preferredRadiusKm": 2,
      "maxRadiusKm": 3,
      "appliesTo": [
        "restaurants",
        "cafes",
        "accommodation",
        "scooter-rental",
        "gyms",
        "markets",
        "practical-services"
      ]
    },
    "sourceStrategy": {
      "candidateDiscovery": [
        "existing-atlas-activity-database",
        "official-establishment-sites",
        "government-and-official-tourism-sites",
        "wikipedia",
        "wikimedia-commons",
        "wikivoyage",
        "wikitravel",
        "unesco-and-other-authoritative-cultural-sites",
        "web-results",
        "travel-platforms",
        "social-networks",
        "other-public-sources"
      ],
      "preferRepeatedMentionsAcrossIndependentSources": true,
      "verifyCurrentExistenceBeforeSelection": true
    },
    "selectionPrinciples": {
      "pricePositioning": "mostly-affordable-and-midrange",
      "requireVariety": true,
      "avoidUltraLuxury": true,
      "manualEditorialAdditionsExpected": true
    },
    "categories": {
      "things-to-do": {
        "useExistingAtlasDatabaseAsPrioritySeed": true,
        "locationScope": "destination-linked-without-fixed-radius",
        "selectionGoal": "distinct-visitor-relevant-experiences",
        "avoidNearDuplicates": true,
        "automaticSubcategoryFilters": false
      },
      "restaurants": {
        "venueTypes": [
          "restaurant",
          "bar"
        ],
        "barsBelongToRestaurants": true,
        "automaticSubcategoryFilters": false
      },
      "cafes": {
        "venueTypes": [
          "cafe",
          "coffee-shop"
        ],
        "automaticSubcategoryFilters": false
      },
      "accommodation": {
        "venueTypes": [
          "guesthouse",
          "hostel",
          "small-hotel",
          "budget-hotel"
        ],
        "priceUsdPerNight": {
          "hardMinimum": null,
          "preferredMin": 10,
          "preferredMax": 30,
          "hardMax": 50,
          "upperBandMaxCount": 3
        },
        "automaticSubcategoryFilters": false
      },
      "scooter-rental": {
        "venueTypes": [
          "scooter-rental",
          "motorbike-rental"
        ],
        "automaticSubcategoryFilters": false
      },
      "gyms": {
        "automaticSubcategoryFilters": false
      },
      "markets": {
        "venueTypes": [
          "market",
          "night-market"
        ],
        "automaticSubcategoryFilters": false
      },
      "practical-services": {
        "searchTypes": [
          "hospital",
          "tourism-office",
          "immigration-office"
        ],
        "officialOnly": [
          "immigration-office"
        ],
        "exclude": [
          "visa-agency",
          "travel-agency"
        ],
        "automaticSubcategoryFilters": false
      }
    }
  }
}
