{
  "schemaVersion": 1,
  "scope": "city-publication-preflight",
  "fieldCardGeneration": false,
  "statuses": {
    "ready": "ready",
    "readyWithWarnings": "ready-with-warnings",
    "blocked": "blocked"
  },
  "blockingChecks": [
    "city-contract",
    "entity-identity-and-destination",
    "entity-kind-and-category",
    "coordinates",
    "category-targets",
    "unique-entity-identities",
    "allowed-category-membership",
    "spa-card-contract",
    "google-maps",
    "source-verification",
    "media-integrity-and-license",
    "generation-transient-fields",
    "explore-board-integrity"
  ],
  "targetRules": {
    "things-to-do": "exact-editorial-target",
    "automatic-target-categories": "at-least-target",
    "categories-without-target": "no-count-block"
  },
  "verification": {
    "publishableAutomaticEntityDecision": "accept",
    "missingVerificationDecision": "block",
    "manualReviewDecision": "block",
    "rejectClosedDecision": "block"
  },
  "media": {
    "missingSpaPhoto": "warning",
    "placeholderIsPublishable": true,
    "syntheticFallbackForbidden": true,
    "photoAttributionMustRemainCompleteWhenRequired": true,
    "photoPresentRequiresVerifiedStatus": true,
    "acceptedAutomaticLicenses": ["public-domain", "cc0", "cc-by", "cc-by-sa"]
  },
  "sources": {
    "automaticEntityRequiresResearchSource": true
  },
  "transientGenerationFieldsForbidden": [
    "editorialDraft",
    "editorialFacts",
    "photoCandidates",
    "verificationSignals",
    "verificationKind"
  ],
  "warnings": [
    "missing-spa-photo"
  ],
  "finalCommand": "generate-city --publish-check",
  "standaloneCommand": "qa-city"
}
