{
  "schemaVersion": 1,
  "scope": "spa-cards-only",
  "fieldCardGeneration": false,
  "allCards": {
    "required": [
      "exactName",
      "shortDescription",
      "googleMapsUrl",
      "handwrittenTags"
    ],
    "optional": [
      "photo",
      "openingHours"
    ],
    "photo": {
      "required": false,
      "preferred": true,
      "licenseMustPassSourceVerificationContract": true,
      "mustRepresentTheActualPlaceOrActivity": true,
      "whenUnavailable": "placeholder-manual-fill",
      "neverGenerateSyntheticFallback": true
    },
    "exactName": {
      "required": true,
      "preserveVerifiedOfficialSpelling": true,
      "doNotEditoriallyRename": true
    },
    "shortDescription": {
      "required": true,
      "targetWordsMin": 16,
      "targetWordsMax": 28,
      "hardMaxWords": 30,
      "tone": [
        "friendly",
        "warm",
        "cordial",
        "polite",
        "endearing"
      ],
      "style": "specific-natural-atlas-note",
      "mustRemainFactGrounded": true,
      "mustContainConcreteEntitySpecificInformation": true,
      "noCopiedTravelPlatformProse": true
    },
    "openingHours": {
      "required": false,
      "includeOnlyWhenReasonablyVerified": true,
      "omitRatherThanGuess": true,
      "humanReadable": true
    },
    "googleMapsUrl": {
      "required": true,
      "mustResolveToTheSelectedPlaceOrActivityLocation": true
    },
    "handwrittenTags": {
      "required": true,
      "count": 3,
      "maxWordsPerTag": 2,
      "purpose": "three-short-handwritten-notes-over-the-photo-slot",
      "tone": "warm-specific-and-evocative",
      "avoidRepeatingTheName": true,
      "examples": [
        ["Riverside", "Easy dinner", "Sunset"],
        ["Local", "Quiet stop", "Morning"]
      ]
    }
  },
  "thingsToDoCards": {
    "requiredAdditional": [
      "gettingThere",
      "duration",
      "costType",
      "bestTime"
    ],
    "gettingThere": {
      "required": true,
      "humanReadable": true,
      "purpose": "tell-the-traveller-how-to-reach-the-activity-from-the-usual-settlement-base",
      "includeTravelTimeOrDistanceWhenDefensible": true,
      "examples": ["Walk · 20 min", "Bicycle · 15 min", "Boat required", "Tuk-tuk · 25 min"]
    },
    "duration": {
      "required": true,
      "humanReadable": true,
      "examples": ["1–2 hours", "Morning", "Half-day", "Full day", "2 days"]
    },
    "costType": {
      "required": true,
      "allowed": ["free", "paid"],
      "exactPriceIsNotRequiredForSpaCard": true
    },
    "bestTime": {
      "required": true,
      "humanReadable": true,
      "contextual": true,
      "examples": ["Sunset", "Early morning", "Afternoon", "Sunday morning", "Dry season"]
    }
  }
}
