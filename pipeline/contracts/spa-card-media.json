{
  "schemaVersion": 1,
  "scope": "spa-card-photo-and-future-field-card-reserve",
  "fieldCardMedia": false,
  "futureFieldCardReserve": true,
  "discovery": {
    "preferredSources": [
      "manual-owned-or-authorized-media",
      "wikimedia-commons",
      "openverse",
      "public-domain-repositories",
      "official-source-with-explicit-compatible-license",
      "other-explicit-open-license-source"
    ],
    "adapters": {
      "openverse": {
        "enabledByDefault": true,
        "useAsDiscoveryIndex": true,
        "acceptedLicenseFilters": ["by", "by-sa", "cc0", "pdm"],
        "requireSourceLandingPage": true
      },
      "firstParty": {
        "enabledByDefault": true,
        "acceptedSourceTypes": ["official-website", "facebook", "instagram"],
        "capturePublicPagePreviewImageWhenAvailable": true,
        "scanOfficialWebsitePageImages": true,
        "retainPageLeadWhenPreviewImageCannotBeRead": true,
        "neverAssumeReuseRightsFromFirstPartyPublication": true,
        "neverAutoPublishWithoutSeparateCompatibleRightsEvidence": true,
        "storeAsEditorialLead": true
      }
    },
    "discoveryOnlyNotReusableWithoutSeparatePermission": [
      "google-image-results",
      "travel-platforms",
      "booking-platforms",
      "social-networks",
      "generic-web-images"
    ]
  },
  "selection": {
    "photoIsPreferredButNotRequired": true,
    "neverGenerateSyntheticFallback": true,
    "neverUseAProbablySimilarPlace": true,
    "mustRepresentExactSelectedEntity": true,
    "manualPhotoMayOverrideAutomaticSelection": true,
    "whenNoQualifiedPhoto": "placeholder-manual-fill",
    "entityModes": {
      "place": {
        "publicCardPhotoCount": 1,
        "continueDiscoveryAfterPrimaryPhoto": false,
        "retainReusableSurplus": false
      },
      "thingToDo": {
        "publicCardPhotoCount": 1,
        "continueDiscoveryAfterPrimaryPhoto": true,
        "discoveryGoal": "as-many-qualified-as-practical",
        "retainReusableSurplus": true,
        "persistReusableSurplusUnder": "media.research.activityPhotoReserve",
        "reusableReserveMaximum": 24
      }
    }
  },
  "acceptedLicenses": [
    "public-domain",
    "cc0",
    "cc-by",
    "cc-by-sa"
  ],
  "rejectedLicenses": [
    "all-rights-reserved",
    "unknown-license",
    "cc-by-nc",
    "cc-by-nc-sa",
    "cc-by-nc-nd"
  ],
  "candidateRequirements": {
    "subjectVerified": true,
    "minimumSubjectConfidence": 0.9,
    "minimumSourceConfidence": 0.75,
    "sourceUrlRequiredForExternalMedia": true,
    "licenseRequiredForExternalMedia": true,
    "minimumWidth": 640,
    "minimumHeight": 400,
    "authorRequiredWhenLicenseRequiresAttribution": true
  },
  "ranking": [
    "manual-locked",
    "exact-subject-confidence",
    "source-confidence",
    "resolution",
    "stable-source-url"
  ],
  "editorialLeads": {
    "firstParty": {
      "rightsStatus": "unconfirmed-first-party",
      "autoPublishable": false,
      "editorialAction": "review-rights-before-use",
      "maximumPerEntity": 12,
      "persistUnder": "media.research.firstPartyPhotoLeads"
    }
  },
  "attribution": {
    "storeSourceUrl": true,
    "storeSourceName": true,
    "storeAuthor": true,
    "storeLicense": true,
    "showOnSpaCardWhenRequired": true
  },
  "placeholder": {
    "keepFullPhotoSlot": true,
    "label": "Photo to add",
    "status": "missing",
    "requiresManualFill": true,
    "mustNotUseImageAsset": true
  }
}
