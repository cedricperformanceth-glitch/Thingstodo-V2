{
  "laos": {
    "discoveryBudget": {
      "initialQueriesPerCategory": 4,
      "maxQueriesPerCategory": 12,
      "candidatePoolMultiplier": 1.5,
      "stopWhenQualifiedTargetReached": true
    },
    "sourceClasses": {
      "authoritative": [
        "government",
        "official-tourism",
        "official-establishment",
        "unesco-or-equivalent-institution"
      ],
      "open-reference": [
        "wikipedia",
        "wikivoyage",
        "wikitravel"
      ],
      "open-media": [
        "wikimedia-commons"
      ],
      "supporting": [
        "travel-platform",
        "booking-platform",
        "map-platform",
        "reputable-travel-editorial",
        "local-news",
        "first-party-social-network",
        "public-web-result",
        "public-user-report"
      ]
    },
    "candidateIdentity": {
      "normalizeName": true,
      "compareCoordinatesWhenAvailable": true,
      "compareAddressWhenAvailable": true,
      "mergeObviousAliases": true,
      "doNotCountSyndicatedCopiesAsIndependentMentions": true
    },
    "repeatedMentionRanking": {
      "countIndependentSources": true,
      "preferRecentMentions": true,
      "preferAuthoritativeSources": true,
      "existingAtlasDatabaseIsSeedNotProof": true
    },
    "reputationRanking": {
      "purpose": "ranking-signal-only",
      "sourceNeutral": true,
      "examples": [
        "booking-platform-rating",
        "travel-platform-rating",
        "map-platform-rating",
        "local-directory-rating",
        "other-public-rating-source"
      ],
      "maxIndependentSnapshotsUsedPerCandidate": 3,
      "storeReviewText": false,
      "storeReviewBodies": false,
      "bulkReviewCollection": false,
      "normalizeDifferentRatingScales": true,
      "useReviewCountWithDiminishingWeight": true,
      "preferRecentSnapshots": true,
      "missingRatingsNeverRejectCandidate": true,
      "firstPartySocialActivityIsSmallPositiveSignalOnly": true,
      "missingSocialPresenceNeverRejectCandidate": true,
      "editorialReviewRemainsFinalAuthority": true
    },
    "acceptance": {
      "businessOrOperator": {
        "minimumIndependentCurrentSignals": 2,
        "requireAtLeastOneStrongSignal": true,
        "singleWeakSourceNeverAutoAccepts": true
      },
      "staticLandmarkOrNaturalSite": {
        "singleCurrentAuthoritativeSourceCanConfirmExistence": true,
        "otherwiseMinimumIndependentSignals": 2
      },
      "publicExperience": {
        "singleCurrentAuthoritativeSourceCanConfirmAvailability": true,
        "otherwiseMinimumIndependentSignals": 2,
        "requiresSpecificOperatorVerification": false
      },
      "conflictingCurrentSources": "manual-review"
    },
    "existenceVerification": {
      "strongOperationalSignals": [
        "current-official-establishment-site",
        "recent-first-party-social-activity",
        "current-authoritative-listing",
        "places-api-operational-status"
      ],
      "permanentClosure": {
        "officialClosureNoticeIsConclusive": true,
        "placesApiClosedPermanentlyIsConclusive": true,
        "independentExplicitClosureReportsThreshold": 3,
        "closureReportMaxAgeMonths": 18,
        "requireNoNewerOperationalSignal": true
      },
      "temporaryClosure": {
        "doNotTreatAsPermanent": true,
        "status": "needs-review"
      },
      "movedBusiness": {
        "followReplacementLocationWhenVerified": true
      },
      "googleMapsPolicy": {
        "noReviewScraping": true,
        "noReviewTextCopying": true,
        "preferPermittedPlacesApiStatusFieldsWhenAvailable": true
      }
    },
    "reusePolicy": {
      "facts": {
        "useForResearchAndCrossCheck": true,
        "writeAtlasCopyIndependently": true,
        "recordProvenance": true
      },
      "text": {
        "default": "do-not-copy",
        "mayReuseOnlyWithExplicitCompatibleLicense": true,
        "honorAttributionAndShareAlikeWhenRequired": true
      },
      "media": {
        "automaticDiscoverySource": "wikimedia-commons",
        "requirePerAssetLicenseCheck": true,
        "allowedWhenCompliant": ["public-domain", "cc0", "cc-by", "cc-by-sa"],
        "rejectWithoutPermission": ["all-rights-reserved", "unknown-license"],
        "rejectForCommercialAtlasUse": ["cc-by-nc", "cc-by-nc-sa", "cc-by-nc-nd"],
        "noDerivativeAssetsCannotBeEdited": true,
        "storeAuthorLicenseSourceAndAttribution": true
      },
      "domainSpecific": {
        "wikimedia-commons": "only-automatic-photo-search-source-check-each-file-license",
        "wikipedia": "research-and-facts-by-default-do-not-copy-prose",
        "wikivoyage": "research-and-facts-by-default-do-not-copy-prose-without-cc-by-sa-compliance",
        "wikitravel": "research-and-facts-by-default-do-not-copy-prose-without-cc-by-sa-compliance",
        "unesco": "authoritative-research-source-but-not-an-automatic-photo-source"
      }
    }
  }
}
