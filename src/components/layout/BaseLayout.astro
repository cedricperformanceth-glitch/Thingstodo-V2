---
import '../../core/design-system/tokens.css';
import type { SeoMetadata } from '../../core/models/types';
import { pageSeo } from '../../core/seo/metadata';
import Navbar from './Navbar.astro';
import SiteFooter from './SiteFooter.astro';
import MakeYourOwnAtlas from '../shared/MakeYourOwnAtlas.astro';

interface Props {
  seo: SeoMetadata;
  breadcrumbs?: Array<{ name: string; path: string }>;
  structuredData?: Record<string, unknown>[];
  ogType?: 'website' | 'article';
  immersive?: boolean;
}

const { seo, breadcrumbs = [], structuredData = [], ogType = 'website', immersive = false } = Astro.props;
const meta = pageSeo(seo, breadcrumbs);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={meta.canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={meta.canonical} />
    <meta property="og:site_name" content="Things To Do Atlas" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    {meta.image && <meta property="og:image" content={meta.image} />}
    {meta.image && meta.imageAlt && <meta property="og:image:alt" content={meta.imageAlt} />}
    <meta name="twitter:card" content={meta.image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    {meta.image && <meta name="twitter:image" content={meta.image} />}
    {meta.image && meta.imageAlt && <meta name="twitter:image:alt" content={meta.imageAlt} />}
    {!meta.indexable && <meta name="robots" content="noindex,nofollow" />}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(meta.breadcrumbs)} />
    {structuredData.map((item) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
  </head>
  <body class:list={{ 'page--immersive': immersive }}>
    {!immersive && <Navbar />}
    <main id="main-content" class:list={{ 'main--immersive': immersive }}><slot /></main>
    {!immersive && <SiteFooter />}
    {!immersive && <MakeYourOwnAtlas />}
    <script>
      import '../../features/trip/client';

      if (document.querySelector('[data-city-spa]')) {
        void import('../../features/spa/client');
      }

      if (document.querySelector('[data-favorite], [data-favorites-panel], [data-favorites-empty], [data-favorites-count]')) {
        void import('../../features/favorites/client');
      }
    </script>
  </body>
</html>
