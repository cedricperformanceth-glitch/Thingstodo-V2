---
import { getCountries } from '../../engines/country/country-engine';

const countries = getCountries();
---

<footer class="atlas-footer" aria-label="Things To Do Atlas footer">
  <div class="atlas-footer__inner">
    <div class="atlas-footer__brand">
      <a href="/" aria-label="Things To Do Atlas home">
        <img
          src="/assets/navbar/things-to-do-atlas-logo-v2.webp"
          alt="Things To Do Atlas"
          width="1254"
          height="1254"
          loading="lazy"
          decoding="async"
        />
      </a>
    </div>

    <div class="atlas-footer__content">
      <div class="atlas-footer__heading">
        <p>Things To Do Atlas</p>
        <div class="atlas-footer__divider" aria-hidden="true"></div>
      </div>

      <div class="atlas-footer__navigation-grid">
        <nav class="atlas-footer__navigation" aria-labelledby="atlas-footer-navigation-title">
          <h2 id="atlas-footer-navigation-title">Navigation</h2>
          <div class="atlas-footer__country-list">
            {countries.map((country) => <a href={`/${country.slug}`}>{country.name}</a>)}
          </div>
        </nav>

        <nav class="atlas-footer__navigation atlas-footer__navigation--legal" aria-labelledby="atlas-footer-legal-title">
          <h2 id="atlas-footer-legal-title">Legal</h2>
          <div class="atlas-footer__legal-list">
            <div class="atlas-footer__legal-column">
              <a href="/legal/privacy-policy">Privacy Policy</a>
              <a href="/legal/cookie-policy">Cookie Policy</a>
              <a href="/legal/terms-of-use">Terms of Use</a>
            </div>

            <div class="atlas-footer__legal-divider" aria-hidden="true"></div>

            <div class="atlas-footer__legal-column">
              <a href="/legal/legal-notice">Legal Notice</a>
              <a class="atlas-footer__legal-media" href="/legal/media-credits">Media Credits &amp; Licensing</a>
              <a href="/legal/editorial-policy">Editorial Policy</a>
            </div>
          </div>
        </nav>
      </div>
    </div>
  </div>
</footer>

<style>
  .atlas-footer {
    width: 100%;
    min-height: 330px;
    margin: 0;
    background: #315545;
    color: #fffdf8;
  }

  .atlas-footer__inner {
    display: grid;
    grid-template-columns: minmax(220px, 25%) minmax(0, 75%);
    width: min(1280px, calc(100% - 48px));
    min-height: 330px;
    margin: 0 auto;
    padding: clamp(58px, 7vw, 92px) 0 clamp(54px, 6vw, 78px);
  }

  .atlas-footer__brand {
    display: flex;
    align-items: flex-start;
    min-width: 0;
    padding: 2px clamp(34px, 4vw, 62px) 0 0;
    border-right: 1px solid #db8058;
  }

  .atlas-footer__brand a {
    display: block;
    width: min(100%, 230px);
  }

  .atlas-footer__brand img {
    display: block;
    width: 100%;
    max-width: 230px;
    height: auto;
    object-fit: contain;
    object-position: left top;
  }

  .atlas-footer__content {
    --footer-content-gutter: clamp(38px, 5vw, 78px);
    min-width: 0;
    padding-inline: var(--footer-content-gutter);
  }

  .atlas-footer__heading {
    width: fit-content;
    max-width: 100%;
    margin: 0 auto clamp(38px, 4.5vw, 58px);
  }

  .atlas-footer__heading p {
    margin: 0;
    color: #fffdf8;
    font-family: Fraunces, Georgia, serif;
    font-size: clamp(2rem, 4vw, 4rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -.055em;
  }

  .atlas-footer__divider {
    width: 100%;
    height: 1px;
    margin-top: clamp(18px, 2.2vw, 28px);
    background: #db8058;
  }

  .atlas-footer__navigation-grid {
    display: grid;
    grid-template-columns: minmax(0, .8fr) minmax(360px, .62fr);
    gap: clamp(24px, 3.5vw, 48px);
    align-items: start;
  }

  .atlas-footer__navigation h2 {
    margin: 0 0 18px;
    color: #db8058;
    font-family: 'DM Sans', Arial, sans-serif;
    font-size: .66rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  .atlas-footer__country-list {
    display: flex;
    flex-wrap: wrap;
    gap: .7rem 1.35rem;
  }

  .atlas-footer__legal-list {
    display: grid;
    grid-template-columns: max-content 1px max-content;
    column-gap: clamp(12px, 1.35vw, 18px);
    align-items: stretch;
    justify-content: start;
  }

  .atlas-footer__legal-column {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: .7rem;
  }

  .atlas-footer__legal-divider {
    width: 1px;
    min-height: 100%;
    background: linear-gradient(
      to bottom,
      rgb(219 128 88 / 0) 0%,
      rgb(219 128 88 / .7) 16%,
      rgb(219 128 88 / .7) 84%,
      rgb(219 128 88 / 0) 100%
    );
  }

  .atlas-footer__legal-media {
    white-space: nowrap;
  }

  .atlas-footer__navigation a {
    display: inline-block;
    color: #f7f2e7;
    font-family: 'Caveat', 'Segoe Print', 'Bradley Hand', cursive;
    font-size: 1.28rem;
    font-weight: 600;
    line-height: 1.15;
    text-decoration: none;
    opacity: .9;
    transition: color .2s ease, opacity .2s ease, transform .2s ease;
  }

  .atlas-footer__navigation a:hover,
  .atlas-footer__navigation a:focus-visible {
    color: #f2ad70;
    opacity: 1;
    transform: translateX(2px);
  }

  @media (max-width: 980px) {
    .atlas-footer__navigation-grid {
      grid-template-columns: minmax(0, .72fr) minmax(330px, .68fr);
      gap: 24px;
    }

    .atlas-footer__legal-list {
      column-gap: 12px;
    }
  }

  @media (max-width: 800px) {
    .atlas-footer {
      min-height: 0;
    }

    .atlas-footer__inner {
      grid-template-columns: 1fr;
      width: calc(100% - 32px);
      min-height: 0;
      padding: 52px 0 46px;
    }

    .atlas-footer__brand {
      padding: 0 0 34px;
      border-right: 0;
      border-bottom: 1px solid #db8058;
    }

    .atlas-footer__brand a {
      width: min(62vw, 210px);
    }

    .atlas-footer__content {
      --footer-content-gutter: 0px;
      padding: 38px 0 0;
    }

    .atlas-footer__heading {
      margin-bottom: 34px;
    }

    .atlas-footer__navigation-grid {
      grid-template-columns: 1fr;
      gap: 34px;
    }

    .atlas-footer__navigation--legal {
      width: min(100%, 500px);
    }
  }

  @media (max-width: 440px) {
    .atlas-footer__heading p {
      font-size: clamp(1.9rem, 10vw, 2.75rem);
    }

    .atlas-footer__legal-list {
      grid-template-columns: minmax(0, 1fr) 1px minmax(0, 1fr);
      column-gap: 10px;
    }

    .atlas-footer__navigation a {
      font-size: 1.18rem;
    }
  }
</style>
