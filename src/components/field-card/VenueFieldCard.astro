---
import type { Place, ThingToDo } from '../../core/models/types';
import {
  getVenueFieldCard,
  personalVenuePlaces,
  type VenueFieldCardContent,
} from '../../content/venue-field-card-registry';
import { placeFieldCardPath } from '../../core/routing/paths';
import { getCity } from '../../engines/city/city-engine';
import { getCountry } from '../../engines/country/country-engine';
import { venueFieldCardView } from '../../engines/field-card/venue-field-card-engine';
import FieldCardHero from './FieldCardHero.astro';
import FieldCardQuickRead from './FieldCardQuickRead.astro';
import FieldCardStoryBlock from './FieldCardStoryBlock.astro';
import FieldCardSecondaryStory from './FieldCardSecondaryStory.astro';
import FieldCardBeforeYouLeave from './FieldCardBeforeYouLeave.astro';
import FieldCardFaq from './FieldCardFaq.astro';
import FieldCardPracticalNotes from './FieldCardPracticalNotes.astro';
import FieldCardAtlasCta from './FieldCardAtlasCta.astro';

interface Props {
  place: Place;
  content: VenueFieldCardContent;
}

const { place, content } = Astro.props;
const city = getCity(place.country, place.city);
const country = getCountry(place.country);
if (!city || !country) throw new Error(`Missing city or country context for ${place.id}`);

const view = venueFieldCardView(place, content);
const fieldEntity = place as unknown as ThingToDo;
const relatedPlaces = (content.relatedPlaceIds ?? []).flatMap((placeId) => {
  const related = personalVenuePlaces.find((candidate) => candidate.id === placeId);
  return related && getVenueFieldCard(related.id) ? [related] : [];
});
---

<article class={`field-card field-card--${view.template}`}>
  <FieldCardHero thing={fieldEntity} {city} {country} hero={view.hero} image={view.heroImage} />

  {content.status === 'draft' ? (
    <section class="field-card-venue-draft">
      <p>PERSONAL FIELD NOTE</p>
      <h2>First-hand story coming next</h2>
      <span>No generic review is inserted here. This page stays noindex until the traveller’s own notes are ready.</span>
    </section>
  ) : (
    <>
      <FieldCardQuickRead thing={fieldEntity} {country} quickRead={view.quickRead} />
      {view.primaryStory.chapters.length > 0 && (
        <FieldCardStoryBlock thing={fieldEntity} story={view.primaryStory} image={view.storyImage} />
      )}
      {view.secondaryStory && (
        <FieldCardSecondaryStory thing={fieldEntity} story={view.secondaryStory} image={view.secondaryImage} />
      )}
      {view.secondaryStory && (
        <FieldCardBeforeYouLeave thing={fieldEntity} content={view.secondaryStory.beforeYouLeave} />
      )}

      <div class="field-card__body">
        {view.faq.length > 0 && <FieldCardFaq thing={fieldEntity} items={view.faq} />}
        <FieldCardPracticalNotes thing={fieldEntity} content={view.practicalNotes} />
        <FieldCardAtlasCta thing={fieldEntity} />

        {relatedPlaces.length > 0 && (
          <section class="field-card-venue-related" aria-label="Related personal field notes">
            <p class="field-card-venue-related__eyebrow">RELATED PERSONAL NOTES</p>
            <h2>Another place connected to this one</h2>
            <div>
              {relatedPlaces.map((related) => (
                <a href={placeFieldCardPath(related)}>
                  <strong>{related.name}</strong>
                  <span>{related.shortDescription}</span>
                </a>
              ))}
            </div>
          </section>
        )}
      </div>
    </>
  )}
</article>

<style>
  .field-card {
    display: grid;
    gap: 0;
  }

  .field-card__body {
    display: grid;
    gap: 2rem;
  }

  .field-card-venue-draft,
  .field-card-venue-related {
    justify-self: center;
    width: min(1000px, calc(100vw - 48px));
    margin: clamp(48px, 6vw, 82px) 0;
    color: #203c31;
  }

  .field-card-venue-draft {
    padding: clamp(28px, 4vw, 48px);
    border-top: 1px solid rgb(49 85 69 / .2);
    border-bottom: 1px solid rgb(49 85 69 / .2);
  }

  .field-card-venue-draft p,
  .field-card-venue-related__eyebrow {
    margin: 0 0 10px;
    color: #9d3040;
    font-family: var(--field-card-practical);
    font-size: .58rem;
    letter-spacing: .14em;
  }

  .field-card-venue-draft h2,
  .field-card-venue-related h2 {
    margin: 0;
    color: #203c31;
    font-family: var(--field-card-title);
    font-size: clamp(2rem, 4vw, 3.4rem);
    font-weight: 600;
  }

  .field-card-venue-draft span {
    display: block;
    max-width: 48rem;
    margin-top: 14px;
    color: rgb(38 55 47 / .7);
    font-family: var(--field-card-editorial);
    line-height: 1.65;
  }

  .field-card-venue-related {
    padding-top: 24px;
    border-top: 1px solid rgb(49 85 69 / .16);
  }

  .field-card-venue-related > div {
    display: grid;
    gap: 12px;
    margin-top: 22px;
  }

  .field-card-venue-related a {
    display: grid;
    gap: 5px;
    padding: 16px 0;
    border-top: 1px solid rgb(49 85 69 / .12);
    color: #203c31;
    text-decoration: none;
  }

  .field-card-venue-related strong {
    font-family: var(--field-card-title);
    font-size: 1.3rem;
    font-weight: 600;
  }

  .field-card-venue-related span {
    max-width: 48rem;
    color: rgb(38 55 47 / .65);
    font-family: var(--field-card-editorial);
    line-height: 1.55;
  }

  @media (max-width: 620px) {
    .field-card-venue-draft,
    .field-card-venue-related {
      width: calc(100vw - 28px);
    }
  }
</style>

<style is:global>
  body:has(.field-card) {
    background: var(--field-card-page);
  }

  /* Fandee Island photos 2 and 3 are wider than their Polaroid slots.
     Keep the complete photo visible, while a subdued cover layer of the
     same image fills the slot behind it so the frame never has empty bands. */
  .field-card-story-block__photo:has(img[src$="/fandee-island-2.webp"])::after,
  .field-card-secondary-story__photo:has(img[src$="/fandee-island-3.webp"])::after {
    position: absolute;
    z-index: 0;
    left: 8px;
    right: 8px;
    top: 8px;
    content: '';
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    filter: saturate(.72) brightness(.82);
    opacity: .52;
  }

  .field-card-story-block__photo:has(img[src$="/fandee-island-2.webp"])::after {
    height: clamp(300px, 31vw, 420px);
    background-image: url('/images/places/tad-lo/fandee-island-2.webp');
  }

  .field-card-secondary-story__photo:has(img[src$="/fandee-island-3.webp"])::after {
    height: clamp(330px, 34vw, 470px);
    background-image: url('/images/places/tad-lo/fandee-island-3.webp');
  }

  .field-card-story-block__photo img[src$="/fandee-island-2.webp"],
  .field-card-secondary-story__photo img[src$="/fandee-island-3.webp"] {
    position: relative;
    z-index: 1;
    object-fit: contain;
    object-position: center;
    filter: saturate(.92) contrast(.98);
  }

  .field-card-story-block__photo img[src$="/fandee-island-2.webp"] {
    object-fit: cover;
    object-position: right center;
  }

  @media (max-width: 820px) {
    .field-card-story-block__photo:has(img[src$="/fandee-island-2.webp"])::after {
      height: clamp(260px, 65vw, 380px);
    }

    .field-card-secondary-story__photo:has(img[src$="/fandee-island-3.webp"])::after {
      height: clamp(280px, 70vw, 420px);
    }
  }
</style>
