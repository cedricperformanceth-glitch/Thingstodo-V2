---
import type { Country, FieldCardQuickReadContent, ThingToDo } from '../../core/models/types';

interface Props {
  thing: ThingToDo;
  country: Country;
  quickRead: FieldCardQuickReadContent;
}

const { thing, country, quickRead } = Astro.props;
const items = [
  { key: 'time', index: '01', label: 'TIME', content: quickRead.time },
  { key: 'route', index: '02', label: 'ROUTE', content: quickRead.route },
  { key: 'budget', index: '03', label: 'BUDGET', content: quickRead.budget },
  { key: 'bestFor', index: '04', label: 'BEST FOR', content: quickRead.bestFor },
] as const;
---

<section class="field-card-quick-read" aria-labelledby={`field-card-quick-read-${thing.slug}`}>
  <header class="field-card-quick-read__heading">
    <div class="field-card-quick-read__lead">
      <p class="field-card-quick-read__kicker">FIELD NOTES</p>
      <span class="field-card-quick-read__divider" aria-hidden="true"></span>
      <h2 id={`field-card-quick-read-${thing.slug}`}>THE QUICK READ</h2>
    </div>
    <p class="field-card-quick-read__context">{thing.name} / {country.name}</p>
  </header>

  <div class="field-card-quick-read__grid">
    {items.map((item) => (
      <article class={`field-card-quick-read__item field-card-quick-read__item--${item.key}`}>
        <span class="field-card-quick-read__index" aria-hidden="true">{item.index}</span>
        <p class="field-card-quick-read__label">{item.label}</p>
        <p class="field-card-quick-read__primary">{item.content.primary}</p>
        <p class="field-card-quick-read__secondary">{item.content.secondary}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .field-card-quick-read {
    padding: clamp(46px, 5.8vw, 74px) clamp(28px, 5vw, 64px) clamp(54px, 6.8vw, 84px);
    color: #203c31;
  }

  .field-card-quick-read__heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: clamp(38px, 4.7vw, 58px);
  }

  .field-card-quick-read__lead {
    display: flex;
    align-items: center;
    gap: 7px;
    min-width: 0;
  }

  .field-card-quick-read__kicker,
  .field-card-quick-read__context {
    margin: 0;
    font-family: 'DM Sans', var(--sans);
    font-weight: 800;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .field-card-quick-read__kicker {
    flex: none;
    color: #b76645;
    font-size: .54rem;
    letter-spacing: .17em;
  }

  .field-card-quick-read__context {
    flex: none;
    color: rgb(49 85 69 / .48);
    font-size: .5rem;
    letter-spacing: .13em;
    text-align: right;
  }

  .field-card-quick-read__divider {
    width: 76px;
    height: 1px;
    flex: none;
    background: rgb(49 85 69 / .18);
  }

  .field-card-quick-read__heading h2 {
    flex: none;
    margin: 0;
    color: rgb(49 85 69 / .78);
    font-family: 'DM Sans', var(--sans);
    font-size: .72rem;
    font-weight: 750;
    line-height: 1.25;
    letter-spacing: .13em;
    white-space: nowrap;
  }

  .field-card-quick-read__grid {
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
    column-gap: clamp(70px, 11vw, 168px);
    row-gap: clamp(44px, 5.6vw, 68px);
    max-width: 980px;
  }

  .field-card-quick-read__item {
    position: relative;
    min-height: 124px;
    padding: 22px 0 0 22px;
  }

  .field-card-quick-read__item--route {
    transform: translateY(28px);
  }

  .field-card-quick-read__item--budget {
    margin-left: 12%;
    transform: translateY(-4px);
  }

  .field-card-quick-read__item--bestFor {
    margin-left: 8%;
    transform: translateY(30px);
  }

  .field-card-quick-read__index {
    position: absolute;
    z-index: 0;
    top: -.18em;
    left: -.02em;
    color: rgb(49 85 69 / .075);
    font-family: Fraunces, var(--serif);
    font-size: clamp(5.7rem, 8vw, 7.9rem);
    font-weight: 500;
    line-height: .8;
    letter-spacing: -.06em;
    pointer-events: none;
    user-select: none;
  }

  .field-card-quick-read__label,
  .field-card-quick-read__primary,
  .field-card-quick-read__secondary {
    position: relative;
    z-index: 1;
  }

  .field-card-quick-read__label {
    margin: 0 0 11px;
    color: #b76645;
    font-family: 'DM Sans', var(--sans);
    font-size: .54rem;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: .17em;
    text-transform: uppercase;
  }

  .field-card-quick-read__primary {
    max-width: 14ch;
    margin: 0;
    color: #203c31;
    font-family: Fraunces, var(--serif);
    font-size: clamp(1.85rem, 3vw, 2.65rem);
    font-weight: 520;
    line-height: .98;
    letter-spacing: -.035em;
    text-transform: uppercase;
  }

  .field-card-quick-read__item--budget .field-card-quick-read__primary {
    font-size: clamp(2rem, 3.35vw, 2.95rem);
  }

  .field-card-quick-read__item--bestFor .field-card-quick-read__primary {
    font-size: clamp(1.75rem, 2.75vw, 2.45rem);
  }

  .field-card-quick-read__secondary {
    max-width: 27ch;
    margin: 9px 0 0;
    color: rgb(49 85 69 / .62);
    font-family: 'DM Sans', var(--sans);
    font-size: .72rem;
    font-weight: 600;
    line-height: 1.45;
    letter-spacing: .015em;
  }

  @media (max-width: 820px) {
    .field-card-quick-read__heading {
      gap: 16px;
    }

    .field-card-quick-read__divider {
      width: 68px;
    }

    .field-card-quick-read__grid {
      column-gap: clamp(42px, 8vw, 76px);
    }

    .field-card-quick-read__item--budget {
      margin-left: 6%;
    }

    .field-card-quick-read__item--bestFor {
      margin-left: 4%;
    }
  }

  @media (max-width: 620px) {
    .field-card-quick-read {
      padding: 42px 20px 50px;
    }

    .field-card-quick-read__heading {
      display: grid;
      grid-template-columns: 1fr auto;
      row-gap: 8px;
      margin-bottom: 30px;
    }

    .field-card-quick-read__lead {
      grid-column: 1 / -1;
      gap: 6px;
    }

    .field-card-quick-read__divider {
      width: 58px;
    }

    .field-card-quick-read__context {
      grid-column: 2;
      max-width: 24ch;
      font-size: .46rem;
    }

    .field-card-quick-read__grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .field-card-quick-read__item,
    .field-card-quick-read__item--route,
    .field-card-quick-read__item--budget,
    .field-card-quick-read__item--bestFor {
      min-height: 106px;
      margin-left: 0;
      padding: 18px 0 0 18px;
      transform: none;
    }

    .field-card-quick-read__index {
      font-size: 5.3rem;
    }

    .field-card-quick-read__primary,
    .field-card-quick-read__item--budget .field-card-quick-read__primary,
    .field-card-quick-read__item--bestFor .field-card-quick-read__primary {
      max-width: 18ch;
      font-size: clamp(1.75rem, 9vw, 2.35rem);
    }
  }
</style>
