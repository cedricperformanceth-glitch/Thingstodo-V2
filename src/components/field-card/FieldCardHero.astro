---
import type { City, Country, FieldCardHeroContent, MediaRecord, ThingToDo } from '../../core/models/types';

interface Props {
  thing: ThingToDo;
  city: City;
  country: Country;
  hero: FieldCardHeroContent;
  image?: MediaRecord;
}

const { thing, city, country, hero, image } = Astro.props;
---

<header class="field-card-hero" aria-labelledby={`field-card-title-${thing.slug}`}>
  <div class="field-card-hero__copy">
    <p class="field-card-hero__eyebrow">{hero.eyebrow}</p>
    <h1 id={`field-card-title-${thing.slug}`}>{thing.name}</h1>

    <p class="field-card-hero__aliases" aria-label={`${thing.name} quick identity`}>
      {hero.aliases.map((alias, index) => (
        <>
          {index > 0 && <span aria-hidden="true">·</span>}
          <span>{alias}</span>
        </>
      ))}
    </p>

    <p class="field-card-hero__description">{hero.description}</p>

    <div class="field-card-hero__axis" aria-label={`${thing.name} visit rhythm`}>
      <span class="field-card-hero__axis-label">READ THE VISIT</span>
      <ol>
        {hero.steps.map((step, index) => (
          <li>
            <span class="field-card-hero__node">{String(index + 1).padStart(2, '0')}</span>
            <span class="field-card-hero__step">{step}</span>
          </li>
        ))}
      </ol>
      <p class="field-card-hero__rhythm-note">{hero.rhythmNote}</p>
    </div>

    <div class="field-card-hero__stamp" aria-label={`Field note for ${city.name}, ${country.name}`}>
      <span>FIELD NOTE</span>
      <strong>Plan the visit</strong>
      <small>{city.name} · {country.name}</small>
    </div>
  </div>

  <figure class:list={{ 'field-card-hero__photo': true, 'is-missing': !image }}>
    <span class="field-card-hero__tape" aria-hidden="true"></span>
    {image ? (
      <img src={image.src} alt={image.alt} width="1800" height="1120" fetchpriority="high" />
    ) : (
      <div class="field-card-hero__photo-placeholder" role="img" aria-label={`Photo to add for ${thing.name}`}>
        <span>Photo to add</span>
        <small>{thing.name}</small>
      </div>
    )}
    {image && (image.author || image.sourceName || image.license) && (
      <figcaption>
        {image.sourceUrl ? (
          <a href={image.sourceUrl} target="_blank" rel="noreferrer">{image.author || image.sourceName || 'Photo source'}</a>
        ) : (
          <span>{image.author || image.sourceName || 'Photo source'}</span>
        )}
        {image.license && <> · {image.license}</>}
      </figcaption>
    )}
    <span class="field-card-hero__photo-note">{hero.photoNote}</span>
  </figure>
</header>

<style>
  .field-card-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(320px, .88fr) minmax(460px, 1.12fr);
    gap: clamp(34px, 6vw, 78px);
    align-items: center;
    padding: clamp(42px, 6vw, 72px) clamp(30px, 5vw, 64px);
    overflow: visible;
    border-top: 1px solid rgb(49 85 69 / .2);
    border-bottom: 1px solid rgb(49 85 69 / .2);
    background:
      linear-gradient(var(--field-card-sheet-wash), var(--field-card-sheet-wash)),
      repeating-linear-gradient(0deg, transparent 0 34px, rgb(49 85 69 / .035) 34px 35px);
    color: var(--ink);
  }

  .field-card-hero::before {
    position: absolute;
    z-index: 3;
    top: -8px;
    left: 8%;
    width: 96px;
    height: 20px;
    background: rgb(199 181 143 / .48);
    content: '';
    pointer-events: none;
    transform: rotate(-2deg);
  }

  .field-card-hero__copy {
    position: relative;
    z-index: 2;
  }

  .field-card-hero__eyebrow {
    margin: 0 0 10px;
    color: #b76645;
    font-family: var(--field-card-practical);
    font-size: .6rem;
    font-weight: 400;
    line-height: 1.35;
    letter-spacing: .17em;
    text-transform: uppercase;
  }

  .field-card-hero h1 {
    max-width: 8.8ch;
    margin: 0;
    color: #203c31;
    font-family: var(--field-card-title);
    font-size: clamp(4.15rem, 7.4vw, 7.2rem);
    font-weight: 600;
    line-height: .84;
    letter-spacing: -.055em;
  }

  .field-card-hero__aliases {
    display: flex;
    flex-wrap: wrap;
    gap: .35rem .55rem;
    align-items: center;
    margin: 16px 0 0;
    color: rgb(49 85 69 / .68);
    font-family: var(--field-card-practical);
    font-size: .62rem;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .field-card-hero__aliases > span[aria-hidden='true'] {
    color: #b76645;
  }

  .field-card-hero__description {
    max-width: 31rem;
    margin: 24px 0 0;
    color: #35463e;
    font-family: var(--field-card-editorial);
    font-size: clamp(1rem, 1.45vw, 1.2rem);
    font-weight: 400;
    line-height: 1.68;
  }

  .field-card-hero__axis {
    position: relative;
    max-width: 33rem;
    margin-top: 30px;
    padding-top: 20px;
    border-top: 1px dashed rgb(49 85 69 / .28);
  }

  .field-card-hero__axis-label {
    display: block;
    margin-bottom: 12px;
    color: rgb(49 85 69 / .65);
    font-family: var(--field-card-practical);
    font-size: .5rem;
    font-weight: 400;
    line-height: 1;
    letter-spacing: .16em;
  }

  .field-card-hero__axis ol {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .field-card-hero__axis ol::before {
    position: absolute;
    top: 10px;
    right: 11%;
    left: 11%;
    border-top: 1px solid rgb(49 85 69 / .38);
    content: '';
  }

  .field-card-hero__axis li {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 7px;
    justify-items: center;
    padding-inline: 4px;
    color: #315545;
    text-align: center;
  }

  .field-card-hero__node {
    display: grid;
    width: 20px;
    height: 20px;
    place-items: center;
    border: 1px solid rgb(49 85 69 / .42);
    border-radius: 50%;
    background: #f8f5ec;
    color: #b76645;
    font-family: var(--field-card-practical);
    font-size: .48rem;
    font-weight: 400;
    line-height: 1;
  }

  .field-card-hero__step {
    max-width: 8.5rem;
    font-family: var(--field-card-practical);
    font-size: .55rem;
    font-weight: 400;
    line-height: 1.25;
  }

  .field-card-hero__rhythm-note {
    max-width: 22rem;
    margin: 16px 2px 0 auto;
    color: #315545;
    font-family: var(--field-card-handwritten);
    font-size: 1.08rem;
    font-weight: 600;
    line-height: 1.08;
    text-align: right;
    transform: rotate(-1.2deg);
  }

  .field-card-hero__stamp {
    display: inline-grid;
    gap: 3px;
    margin-top: 28px;
    padding: 11px 15px;
    border: 2px solid rgb(183 102 69 / .58);
    color: #9c563a;
    text-transform: uppercase;
    transform: rotate(-2deg);
  }

  .field-card-hero__stamp span,
  .field-card-hero__stamp small {
    font-family: var(--field-card-practical);
    font-size: .46rem;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: .13em;
  }

  .field-card-hero__stamp strong {
    font-family: var(--field-card-handwritten);
    font-size: 1.12rem;
    font-weight: 600;
    line-height: 1;
    text-transform: none;
  }

  .field-card-hero__photo {
    position: relative;
    width: calc(100% + 22px);
    margin: 0 -22px 0 0;
    padding: 9px 9px 29px;
    overflow: visible;
    background: #fffaf0;
    box-shadow: 6px 8px 0 rgb(49 85 69 / .08), 0 16px 34px rgb(32 60 49 / .1);
    transform: rotate(1.15deg);
  }

  .field-card-hero__photo img,
  .field-card-hero__photo-placeholder {
    display: block;
    width: 100%;
    height: clamp(390px, 46vw, 575px);
  }

  .field-card-hero__photo img {
    object-fit: cover;
    filter: saturate(.86) contrast(.97);
  }

  .field-card-hero__photo-placeholder {
    display: grid;
    place-content: center;
    gap: 7px;
    border: 1px dashed rgb(49 85 69 / .22);
    background:
      linear-gradient(135deg, rgb(49 85 69 / .035), transparent 42%),
      #eee8db;
    color: rgb(49 85 69 / .55);
    text-align: center;
  }

  .field-card-hero__photo-placeholder span {
    font-family: var(--field-card-handwritten);
    font-size: 1.55rem;
    font-weight: 600;
    transform: rotate(-2deg);
  }

  .field-card-hero__photo-placeholder small {
    font-family: var(--field-card-practical);
    font-size: .5rem;
    font-weight: 400;
    letter-spacing: .13em;
    text-transform: uppercase;
  }

  .field-card-hero__tape {
    position: absolute;
    z-index: 2;
    top: -12px;
    left: 50%;
    width: 92px;
    height: 24px;
    background: rgb(197 178 138 / .55);
    transform: translateX(-50%) rotate(-3deg);
  }

  .field-card-hero__photo figcaption {
    min-height: 1em;
    margin-top: 8px;
    color: rgb(38 55 47 / .52);
    font-family: var(--field-card-editorial);
    font-size: .52rem;
    font-weight: 400;
    line-height: 1.35;
  }

  .field-card-hero__photo figcaption a {
    color: rgb(49 85 69 / .72);
  }

  .field-card-hero__photo-note {
    position: absolute;
    z-index: 3;
    right: 10px;
    bottom: -34px;
    max-width: 15rem;
    color: #315545;
    font-family: var(--field-card-handwritten);
    font-size: 1.08rem;
    font-weight: 600;
    line-height: 1;
    text-align: right;
    transform: rotate(-4deg);
  }

  @media (max-width: 980px) {
    .field-card-hero {
      grid-template-columns: minmax(280px, .82fr) minmax(380px, 1.18fr);
      gap: 34px;
      padding-inline: 30px;
    }
  }

  @media (max-width: 820px) {
    .field-card-hero {
      grid-template-columns: 1fr;
      gap: 38px;
    }

    .field-card-hero__photo {
      width: min(650px, 96%);
      margin: 12px 0 0 auto;
    }
  }

  @media (max-width: 620px) {
    .field-card-hero {
      gap: 34px;
      padding: 34px 20px 44px;
    }

    .field-card-hero h1 {
      max-width: 9.5ch;
      font-size: clamp(3.7rem, 18vw, 5.25rem);
    }

    .field-card-hero__description {
      font-size: .96rem;
    }

    .field-card-hero__axis {
      overflow-x: auto;
      overflow-y: hidden;
      padding-bottom: 4px;
    }

    .field-card-hero__axis ol {
      min-width: 430px;
      overflow-x: visible;
    }

    .field-card-hero__rhythm-note {
      position: sticky;
      left: 0;
    }

    .field-card-hero__photo {
      width: 100%;
      margin-right: 0;
    }

    .field-card-hero__photo img,
    .field-card-hero__photo-placeholder {
      height: 360px;
    }

    .field-card-hero__photo-note {
      right: 4px;
      bottom: -31px;
    }
  }
</style>
