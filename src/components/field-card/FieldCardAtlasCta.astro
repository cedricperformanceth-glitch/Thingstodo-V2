---
import type { ThingToDo } from '../../core/models/types';

interface Props {
  thing: ThingToDo;
}

const { thing } = Astro.props;
const headingId = `field-card-atlas-cta-${thing.id}`;
---

<section class="field-card-atlas-cta" aria-labelledby={headingId}>
  <span class="field-card-atlas-cta__tape" aria-hidden="true"></span>

  <div class="field-card-atlas-cta__copy">
    <p class="field-card-atlas-cta__eyebrow">KEEP IT IN YOUR ATLAS</p>
    <h2 id={headingId}>Save {thing.name} for the road.</h2>
    <p class="field-card-atlas-cta__body">
      Keep this field note close. Add it to My Atlas now, or open the map when you are ready to work out the route.
    </p>
  </div>

  <div class="field-card-atlas-cta__actions">
    <img
      class="field-card-atlas-cta__atlas-mark"
      src="/assets/shared/make-your-own-atlas/Logo%20MY%20ATLAS%20CTA%20FINAL.webp"
      alt="Make Your Own Atlas"
      loading="lazy"
      decoding="async"
    />

    <button
      class="field-card-atlas-cta__primary"
      type="button"
      data-trip
      data-entity={JSON.stringify(thing)}
      aria-label={`Add ${thing.name} to My Atlas`}
      aria-pressed="false"
    >Add to My Atlas</button>
    <a
      class="field-card-atlas-cta__secondary"
      href={thing.googleMapsUrl}
      target="_blank"
      rel="noreferrer"
    >Google Maps ↗</a>
  </div>
</section>

<style>
  .field-card-atlas-cta {
    position: relative;
    isolation: isolate;
    justify-self: center;
    width: min(1040px, calc(100vw - 52px));
    margin: clamp(76px, 9vw, 118px) 0 clamp(54px, 7vw, 84px);
    padding: clamp(36px, 4.8vw, 56px) clamp(34px, 5vw, 62px);
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(260px, .8fr);
    gap: clamp(42px, 7vw, 78px);
    align-items: end;
    border: 1px solid rgb(92 83 61 / .18);
    background:
      linear-gradient(rgb(239 229 207 / .93), rgb(239 229 207 / .93)),
      repeating-linear-gradient(0deg, transparent 0 31px, rgb(78 72 55 / .035) 31px 32px),
      #efe5cf;
    color: #203c31;
    box-shadow:
      9px 11px 0 rgb(49 85 69 / .095),
      0 24px 58px rgb(32 60 49 / .16);
    transform: rotate(-.48deg);
    transform-origin: center;
  }

  .field-card-atlas-cta::before {
    content: '';
    position: absolute;
    z-index: -2;
    inset: 10px -9px -12px 12px;
    border: 1px solid rgb(92 83 61 / .08);
    background: rgb(216 204 177 / .34);
    box-shadow: 0 13px 30px rgb(32 60 49 / .09);
    transform: rotate(.72deg);
  }

  .field-card-atlas-cta::after {
    content: '';
    position: absolute;
    z-index: -1;
    right: 7%;
    bottom: -7px;
    left: 11%;
    height: 14px;
    background: rgb(82 69 47 / .07);
    filter: blur(7px);
    transform: rotate(.3deg);
  }

  .field-card-atlas-cta__tape {
    position: absolute;
    z-index: 2;
    top: -12px;
    left: 13%;
    width: 94px;
    height: 24px;
    border: 1px solid rgb(156 132 88 / .08);
    background:
      linear-gradient(90deg, rgb(221 194 146 / .38), rgb(211 181 128 / .62), rgb(230 207 165 / .4));
    box-shadow: 0 2px 5px rgb(79 65 43 / .08);
    transform: rotate(-3.4deg);
    opacity: .9;
    pointer-events: none;
  }

  .field-card-atlas-cta__copy {
    min-width: 0;
  }

  .field-card-atlas-cta__eyebrow {
    margin: 0 0 11px;
    color: #9d3040;
    font-family: var(--field-card-practical);
    font-size: .54rem;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: .17em;
    text-transform: uppercase;
  }

  .field-card-atlas-cta h2 {
    max-width: 14ch;
    margin: 0;
    color: #203c31;
    font-family: var(--field-card-title);
    font-size: clamp(2.2rem, 4.15vw, 4rem);
    font-weight: 600;
    line-height: .96;
    letter-spacing: -.038em;
  }

  .field-card-atlas-cta__body {
    max-width: 40rem;
    margin: 18px 0 0;
    color: rgb(49 69 58 / .72);
    font-family: var(--field-card-editorial);
    font-size: clamp(.9rem, 1.05vw, 1rem);
    font-weight: 400;
    line-height: 1.68;
  }

  .field-card-atlas-cta__actions {
    display: grid;
    gap: 10px;
    width: min(100%, 320px);
    justify-self: end;
  }

  .field-card-atlas-cta__atlas-mark {
    display: block;
    width: min(100%, 310px);
    height: auto;
    margin: 0 auto 8px;
    object-fit: contain;
  }

  .field-card-atlas-cta__primary,
  .field-card-atlas-cta__secondary {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    padding: 12px 18px;
    border-radius: 0;
    font-family: var(--field-card-practical);
    font-weight: 400;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition: transform 160ms ease, box-shadow 160ms ease, background 160ms ease, color 160ms ease;
  }

  .field-card-atlas-cta__primary {
    border: 1px solid #315545;
    background: #315545;
    color: #fffaf0;
    font-size: .67rem;
    letter-spacing: .08em;
    text-transform: uppercase;
    box-shadow: 4px 5px 0 rgb(32 60 49 / .15);
  }

  .field-card-atlas-cta__primary:hover:not(:disabled),
  .field-card-atlas-cta__primary:focus-visible:not(:disabled) {
    background: #203c31;
    box-shadow: 6px 7px 0 rgb(32 60 49 / .17);
    transform: translateY(-2px);
  }

  .field-card-atlas-cta__primary:disabled {
    border-color: rgb(49 85 69 / .24);
    background: rgb(49 85 69 / .14);
    color: rgb(49 85 69 / .62);
    box-shadow: none;
    cursor: default;
  }

  .field-card-atlas-cta__secondary {
    border: 1px solid rgb(49 85 69 / .23);
    background: rgb(255 250 240 / .24);
    color: #315545;
    font-size: .61rem;
    letter-spacing: .05em;
  }

  .field-card-atlas-cta__secondary:hover,
  .field-card-atlas-cta__secondary:focus-visible {
    border-color: rgb(157 48 64 / .4);
    color: #9d3040;
    transform: translateY(-1px);
  }

  .field-card-atlas-cta__primary:focus-visible,
  .field-card-atlas-cta__secondary:focus-visible {
    outline: 2px solid #9d3040;
    outline-offset: 4px;
  }

  @media (max-width: 820px) {
    .field-card-atlas-cta {
      width: min(calc(100vw - 34px), 720px);
      grid-template-columns: 1fr;
      gap: 30px;
      padding: 38px 34px 40px;
    }

    .field-card-atlas-cta__actions {
      width: min(100%, 360px);
      justify-self: start;
    }
  }

  @media (max-width: 620px) {
    .field-card-atlas-cta {
      width: calc(100vw - 22px);
      margin-top: 64px;
      margin-bottom: 46px;
      padding: 34px 24px 36px;
      gap: 26px;
      box-shadow:
        6px 8px 0 rgb(49 85 69 / .09),
        0 18px 40px rgb(32 60 49 / .14);
      transform: rotate(-.3deg);
    }

    .field-card-atlas-cta::before {
      inset: 8px -5px -9px 8px;
    }

    .field-card-atlas-cta__tape {
      left: 15%;
      width: 78px;
      height: 20px;
      top: -10px;
    }

    .field-card-atlas-cta h2 {
      max-width: 15ch;
      font-size: clamp(2.05rem, 10vw, 3rem);
    }

    .field-card-atlas-cta__body {
      font-size: .88rem;
      line-height: 1.62;
    }

    .field-card-atlas-cta__actions {
      width: 100%;
    }

    .field-card-atlas-cta__atlas-mark {
      width: min(88%, 300px);
      margin-bottom: 6px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .field-card-atlas-cta__primary,
    .field-card-atlas-cta__secondary {
      transition: none;
    }
  }
</style>
