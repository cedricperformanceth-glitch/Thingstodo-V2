---
import type { City, Country, ThingToDo } from '../../core/models/types';
import { fieldCardView } from '../../engines/field-card/field-card-engine';
import AdSlot from '../shared/AdSlot.astro';
import FavoriteHeart from '../shared/FavoriteHeart.astro';
import TripButton from '../shared/TripButton.astro';
import FieldCardHero from './FieldCardHero.astro';
import FieldCardQuickRead from './FieldCardQuickRead.astro';

interface Props {
  thing: ThingToDo;
  city: City;
  country: Country;
}

const { thing, city, country } = Astro.props;
const view = fieldCardView(thing, city, country);
const hasFaq = thing.fieldCard.faq.length > 0;
---

<article class={`field-card field-card--${view.template}`}>
  <FieldCardHero {thing} {city} {country} hero={view.hero} image={view.heroImage} />
  <FieldCardQuickRead {thing} quickRead={view.quickRead} />

  <div class="field-card__utility">
    <FavoriteHeart entity={thing} />
    <div class="field-card__actions">
      {thing.googleMapsUrl && <a class="button button--quiet" href={thing.googleMapsUrl} target="_blank" rel="noreferrer">Open Google Maps</a>}
      <TripButton entity={thing} />
    </div>
  </div>

  <div class="field-card__body">
    {thing.fieldCard.whyGo && <section><h2>Why go</h2><p>{thing.fieldCard.whyGo}</p></section>}
    {view.adSlots[0] && <AdSlot slot={view.adSlots[0]} />}
    {thing.fieldCard.sections?.map((section,index) => <><section><h2>{section.title}</h2><p>{section.body}</p></section>{view.adSlots[index+1] && <AdSlot slot={view.adSlots[index+1]} />}</>)}
    {thing.fieldCard.practical && <section><h2>Practical information</h2><p>{thing.fieldCard.practical}</p></section>}
    {thing.fieldCard.access && <section><h2>How to get there</h2><p>{thing.fieldCard.access}</p></section>}
    {thing.fieldCard.notes && <section><h2>Useful notes</h2><p>{thing.fieldCard.notes}</p></section>}
    {hasFaq && <section><h2>FAQ</h2>{thing.fieldCard.faq.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</section>}
  </div>
</article>

<style>
  .field-card {
    display: grid;
    gap: 0;
  }

  .field-card__utility {
    position: relative;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
    margin: 1rem 0 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgb(49 85 69 / .14);
  }

  .field-card__utility .favorite-heart {
    position: static;
    flex: none;
  }

  .field-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
    justify-content: flex-end;
  }

  .field-card__body {
    display: grid;
    gap: 2rem;
  }

  @media (max-width: 620px) {
    .field-card__utility {
      align-items: flex-start;
    }
  }
</style>
