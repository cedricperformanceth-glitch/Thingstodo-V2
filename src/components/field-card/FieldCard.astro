---
import type { City, Country, ThingToDo } from '../../core/models/types';
import { fieldCardView } from '../../engines/field-card/field-card-engine';
import { getEditorialThingName } from '../../engines/field-card/field-card-editorial';
import { fieldCardRelatedActivities } from '../../engines/field-card/related-activities-engine';
import AdSlot from '../shared/AdSlot.astro';
import FieldCardHero from './FieldCardHero.astro';
import FieldCardQuickRead from './FieldCardQuickRead.astro';
import FieldCardStoryBlock from './FieldCardStoryBlock.astro';
import FieldCardSecondaryStory from './FieldCardSecondaryStory.astro';
import FieldCardBeforeYouLeave from './FieldCardBeforeYouLeave.astro';
import FieldCardFaq from './FieldCardFaq.astro';
import FieldCardPracticalNotes from './FieldCardPracticalNotes.astro';
import FieldCardAtlasCta from './FieldCardAtlasCta.astro';
import FieldCardRelatedActivities from './FieldCardRelatedActivities.astro';
import FieldCardMethodSources from './FieldCardMethodSources.astro';

interface Props {
  thing: ThingToDo;
  city: City;
  country: Country;
}

const { thing, city, country } = Astro.props;
const displayName = getEditorialThingName(thing.id) ?? thing.name;
const displayThing = displayName === thing.name ? thing : { ...thing, name: displayName };
const view = fieldCardView(thing, city, country);
const relatedActivities = fieldCardRelatedActivities(city, thing);
const renderedPhotos = view.gallery;
const additionalGallery = view.gallery.slice(3);
const relatedPhotos = relatedActivities.flatMap((item) => item.image ? [item.image] : []);
---

<article class={`field-card field-card--${view.template}`}>
  <FieldCardHero thing={displayThing} {city} {country} hero={view.hero} image={view.heroImage} />
  <FieldCardQuickRead thing={displayThing} {country} quickRead={view.quickRead} />
  <FieldCardStoryBlock thing={displayThing} story={view.primaryStory} image={view.storyImage} />
  {view.secondaryStory && <FieldCardSecondaryStory thing={displayThing} story={view.secondaryStory} image={view.secondaryImage} />}
  {view.adSlots[0] && <AdSlot slot={view.adSlots[0]} />}
  {view.secondaryStory && <FieldCardBeforeYouLeave thing={displayThing} content={view.secondaryStory.beforeYouLeave} />}

  <div class="field-card__body">
    {view.remainingSections.map((section,index) => <><section><h2>{section.title}</h2><p>{section.body}</p></section>{view.adSlots[index+1] && <AdSlot slot={view.adSlots[index+1]} />}</>)}
    <FieldCardFaq thing={displayThing} items={view.faq} />
    <FieldCardPracticalNotes thing={displayThing} content={view.practicalNotes} />
    {additionalGallery.length > 0 && (
      <section class="field-card__gallery" aria-label={`${displayThing.name} additional field photographs`}>
        {additionalGallery.map((image) => (
          <figure>
            <img src={image.src} alt={image.alt} width="1100" height="900" loading="lazy" decoding="async" />
            {(image.author || image.sourceName || image.license) && <figcaption>{image.sourceUrl ? <a href={image.sourceUrl} target="_blank" rel="noreferrer">{image.author || image.sourceName || 'Photo source'}</a> : <span>{image.author || image.sourceName || 'Photo source'}</span>}{image.license && <> · {image.license}</>}</figcaption>}
          </figure>
        ))}
      </section>
    )}
    <FieldCardAtlasCta thing={displayThing} />
    <FieldCardRelatedActivities {city} items={relatedActivities} />
    <FieldCardMethodSources thing={displayThing} additionalPhotos={[...renderedPhotos, ...relatedPhotos]} />
  </div>
</article>

<style>
  .field-card {
    display: grid;
    gap: 0;
  }

  .field-card__body {
    display: grid;
    gap: 2rem;
  }

  .field-card__body h2 {
    font-family: var(--field-card-title);
    font-weight: 600;
  }

  .field-card__body > section > p {
    font-family: var(--field-card-editorial);
    font-weight: 400;
  }

  .field-card__gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
  }

  .field-card__gallery figure { margin: 0; }
  .field-card__gallery img { display: block; width: 100%; aspect-ratio: 11 / 9; object-fit: cover; }
  .field-card__gallery figcaption { margin-top: .45rem; font-size: .72rem; }
</style>

<style is:global>
  body:has(.field-card) {
    background: var(--field-card-page);
  }
</style>
