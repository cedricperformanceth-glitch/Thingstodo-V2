---
import type { City, Country, ThingToDo } from '../../core/models/types';
import { fieldCardView } from '../../engines/field-card/field-card-engine';
import AdSlot from '../shared/AdSlot.astro';
import FieldCardHero from './FieldCardHero.astro';
import FieldCardQuickRead from './FieldCardQuickRead.astro';
import FieldCardStoryBlock from './FieldCardStoryBlock.astro';
import FieldCardSecondaryStory from './FieldCardSecondaryStory.astro';
import FieldCardBeforeYouLeave from './FieldCardBeforeYouLeave.astro';
import FieldCardFaq from './FieldCardFaq.astro';
import FieldCardPracticalNotes from './FieldCardPracticalNotes.astro';

interface Props {
  thing: ThingToDo;
  city: City;
  country: Country;
}

const { thing, city, country } = Astro.props;
const view = fieldCardView(thing, city, country);
---

<article class={`field-card field-card--${view.template}`}>
  <FieldCardHero {thing} {city} {country} hero={view.hero} image={view.heroImage} />
  <FieldCardQuickRead {thing} {country} quickRead={view.quickRead} />
  <FieldCardStoryBlock {thing} story={view.primaryStory} image={view.storyImage} />
  <FieldCardSecondaryStory {thing} story={view.secondaryStory} image={view.secondaryImage} />
  {view.adSlots[0] && <AdSlot slot={view.adSlots[0]} />}
  <FieldCardBeforeYouLeave {thing} content={view.secondaryStory.beforeYouLeave} />

  <div class="field-card__body">
    {view.remainingSections.map((section,index) => <><section><h2>{section.title}</h2><p>{section.body}</p></section>{view.adSlots[index+1] && <AdSlot slot={view.adSlots[index+1]} />}</>)}
    <FieldCardFaq {thing} items={view.faq} />
    <FieldCardPracticalNotes {thing} content={view.practicalNotes} />
  </div>
</article>

<style>
  .field-card {
    display: grid;
    gap: 0;
  }

  .field-card__body {
    display: grid;
    gap: 2rem;
  }

  .field-card__body h2 {
    font-family: var(--field-card-title);
    font-weight: 600;
  }

  .field-card__body > section > p {
    font-family: var(--field-card-editorial);
    font-weight: 400;
  }
</style>

<style is:global>
  body:has(.field-card) {
    background: var(--field-card-page);
  }
</style>
