---
import type { FieldCardPracticalContent, ThingToDo } from '../../core/models/types';

interface Props {
  thing: ThingToDo;
  content: FieldCardPracticalContent;
}

const { thing, content } = Astro.props;
const items = content.items.filter((item) => item.label.trim() && item.value.trim()).slice(0, 6);
const headingId = `field-card-practical-${thing.id}`;
const leftCount = Math.ceil(items.length / 2);
const leftItems = items.slice(0, leftCount);
const rightItems = items.slice(leftCount);
---

{items.length > 0 && (
  <section class="field-card-practical" aria-labelledby={headingId}>
    <header class="field-card-practical__heading">
      <div class="field-card-practical__heading-page field-card-practical__heading-page--left">
        <p class="field-card-practical__eyebrow">PLAN YOUR VISIT</p>
        <h2 id={headingId}>{thing.name}, at a glance</h2>
        <span class="field-card-practical__divider field-card-practical__divider--blue" aria-hidden="true"></span>
      </div>

      <div class="field-card-practical__heading-page field-card-practical__heading-page--right">
        <p class="field-card-practical__intro">The practical details worth keeping close before you go.</p>
        <span class="field-card-practical__divider field-card-practical__divider--red" aria-hidden="true"></span>
      </div>
    </header>

    <div class:list={{ 'field-card-practical__pages': true, 'field-card-practical__pages--single': rightItems.length === 0 }}>
      <ol class="field-card-practical__page" aria-label={`${thing.name} practical field notes`}>
        {leftItems.map((item, index) => (
          <li class="field-card-practical__note">
            <span class="field-card-practical__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <div class="field-card-practical__content">
              <h3>{item.label}</h3>
              <p class="field-card-practical__value">{item.value}</p>
              {item.detail && <p class="field-card-practical__detail">{item.detail}</p>}
            </div>
          </li>
        ))}
      </ol>

      {rightItems.length > 0 && (
        <ol class="field-card-practical__page field-card-practical__page--right" start={leftCount + 1}>
          {rightItems.map((item, index) => (
            <li class="field-card-practical__note">
              <span class="field-card-practical__number" aria-hidden="true">{String(leftCount + index + 1).padStart(2, '0')}</span>
              <div class="field-card-practical__content">
                <h3>{item.label}</h3>
                <p class="field-card-practical__value">{item.value}</p>
                {item.detail && <p class="field-card-practical__detail">{item.detail}</p>}
              </div>
            </li>
          ))}
        </ol>
      )}
    </div>
  </section>
)}

<style>
  .field-card-practical {
    --laos-blue-premium: #213f68;
    --laos-red-premium: #9d3040;
    position: relative;
    isolation: isolate;
    width: clamp(1000px, 82vw, 1600px);
    max-width: calc(100% - 48px);
    margin: clamp(72px, 8vw, 108px) auto 0;
    padding: clamp(48px, 5.4vw, 76px) clamp(36px, 4.5vw, 72px) clamp(52px, 5.6vw, 80px);
    overflow: hidden;
    background:
      linear-gradient(rgb(255 253 248 / .84), rgb(255 253 248 / .84)),
      repeating-linear-gradient(0deg, transparent 0 39px, rgb(49 85 69 / .018) 39px 40px),
      var(--field-card-sheet);
    color: #203c31;
    box-shadow: 0 22px 58px rgb(32 60 49 / .065);
  }

  .field-card-practical::before {
    content: '';
    position: absolute;
    z-index: -1;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 52px;
    transform: translateX(-50%);
    background: linear-gradient(90deg, transparent, rgb(32 60 49 / .026) 45%, rgb(255 255 255 / .34) 50%, rgb(32 60 49 / .021) 55%, transparent);
    pointer-events: none;
  }

  .field-card-practical::after {
    content: '';
    position: absolute;
    z-index: -1;
    top: clamp(40px, 5vw, 64px);
    bottom: clamp(40px, 4.8vw, 60px);
    left: 50%;
    border-left: 1px solid rgb(49 85 69 / .065);
    transform: translateX(-.5px);
    pointer-events: none;
  }

  .field-card-practical__heading {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: stretch;
    margin-bottom: clamp(42px, 5vw, 62px);
  }

  .field-card-practical__heading-page {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }

  .field-card-practical__heading-page--left {
    padding-right: clamp(42px, 4.8vw, 76px);
  }

  .field-card-practical__heading-page--right {
    justify-content: flex-end;
    padding-left: clamp(42px, 4.8vw, 76px);
  }

  .field-card-practical__eyebrow {
    margin: 0 0 10px;
    color: #b76645;
    font-family: var(--field-card-practical);
    font-size: .54rem;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: .17em;
    text-transform: uppercase;
  }

  .field-card-practical__heading h2 {
    max-width: 16ch;
    margin: 0;
    color: #203c31;
    font-family: var(--field-card-title);
    font-size: clamp(2.35rem, 3.4vw, 3.65rem);
    font-weight: 600;
    line-height: .99;
    letter-spacing: -.034em;
  }

  .field-card-practical__intro {
    max-width: 21rem;
    margin: 0 auto;
    color: #536158;
    font-family: var(--field-card-handwritten);
    font-size: clamp(1.15rem, 1.7vw, 1.45rem);
    font-weight: 500;
    line-height: 1.32;
    letter-spacing: .004em;
    text-align: left;
    transform: rotate(-1.05deg);
    transform-origin: center;
  }

  .field-card-practical__divider {
    display: block;
    width: 50%;
    height: 1px;
    margin: clamp(26px, 2.8vw, 36px) auto 0;
    border-radius: 999px;
    opacity: .92;
  }

  .field-card-practical__divider--blue {
    background: linear-gradient(
      90deg,
      transparent 0,
      rgb(33 63 104 / .5) 9%,
      var(--laos-blue-premium) 27%,
      var(--laos-blue-premium) 73%,
      rgb(33 63 104 / .5) 91%,
      transparent 100%
    );
    box-shadow: 0 1px 0 rgb(255 253 248 / .78);
  }

  .field-card-practical__divider--red {
    background: linear-gradient(
      90deg,
      transparent 0,
      rgb(157 48 64 / .5) 9%,
      var(--laos-red-premium) 27%,
      var(--laos-red-premium) 73%,
      rgb(157 48 64 / .5) 91%,
      transparent 100%
    );
    box-shadow: 0 1px 0 rgb(255 253 248 / .78);
  }

  .field-card-practical__pages {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
  }

  .field-card-practical__pages--single {
    grid-template-columns: minmax(0, 1fr);
    max-width: 42rem;
  }

  .field-card-practical__page {
    display: grid;
    align-content: start;
    gap: clamp(34px, 3.7vw, 48px);
    margin: 0;
    padding: 4px clamp(42px, 4.8vw, 76px) 4px 0;
    list-style: none;
  }

  .field-card-practical__page--right {
    padding-right: 0;
    padding-left: clamp(42px, 4.8vw, 76px);
  }

  .field-card-practical__note {
    position: relative;
    display: grid;
    grid-template-columns: 38px minmax(0, 1fr);
    gap: 15px;
    min-width: 0;
    padding-top: 16px;
  }

  .field-card-practical__note::before {
    content: '';
    position: absolute;
    top: 0;
    left: 53px;
    width: 46px;
    border-top: 1px solid rgb(49 85 69 / .2);
    transform: rotate(-1.1deg);
    transform-origin: left center;
  }

  .field-card-practical__page .field-card-practical__note:nth-child(2) {
    margin-left: 9px;
  }

  .field-card-practical__page--right .field-card-practical__note:nth-child(2) {
    margin-left: 13px;
  }

  .field-card-practical__number {
    padding-top: 1px;
    color: #b76645;
    font-family: var(--field-card-handwritten);
    font-size: 1.12rem;
    font-weight: 600;
    line-height: 1;
    opacity: .78;
    transform: rotate(-5deg);
  }

  .field-card-practical__content {
    min-width: 0;
  }

  .field-card-practical__content h3 {
    margin: 0 0 9px;
    color: #315545;
    font-family: var(--field-card-practical);
    font-size: .56rem;
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .field-card-practical__value {
    max-width: 32rem;
    margin: 0;
    color: #203c31;
    font-family: var(--field-card-title);
    font-size: clamp(1.24rem, 1.58vw, 1.56rem);
    font-weight: 600;
    line-height: 1.18;
    letter-spacing: -.016em;
  }

  .field-card-practical__detail {
    max-width: 33rem;
    margin: 11px 0 0;
    color: #59625d;
    font-family: var(--field-card-editorial);
    font-size: clamp(.82rem, .82vw, .9rem);
    font-weight: 400;
    line-height: 1.66;
  }

  @media (max-width: 980px) {
    .field-card-practical {
      width: min(90vw, calc(100% - 32px));
      max-width: none;
    }

    .field-card-practical__heading-page--left {
      padding-right: 32px;
    }

    .field-card-practical__heading-page--right {
      padding-left: 32px;
    }

    .field-card-practical__page {
      padding-right: 32px;
    }

    .field-card-practical__page--right {
      padding-right: 0;
      padding-left: 32px;
    }
  }

  @media (max-width: 820px) {
    .field-card-practical {
      width: min(100% - 32px, 680px);
    }

    .field-card-practical::before,
    .field-card-practical::after {
      display: none;
    }

    .field-card-practical__heading {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .field-card-practical__heading-page--left,
    .field-card-practical__heading-page--right {
      padding: 0;
    }

    .field-card-practical__intro {
      max-width: 25rem;
      margin-left: 0;
    }

    .field-card-practical__divider {
      width: min(50%, 13rem);
      margin-left: auto;
      margin-right: auto;
    }

    .field-card-practical__pages,
    .field-card-practical__pages--single {
      grid-template-columns: 1fr;
      max-width: none;
    }

    .field-card-practical__page,
    .field-card-practical__page--right {
      gap: 32px;
      padding: 0;
    }

    .field-card-practical__page--right {
      margin-top: 32px;
    }

    .field-card-practical__page .field-card-practical__note:nth-child(2),
    .field-card-practical__page--right .field-card-practical__note:nth-child(2) {
      margin-left: 0;
    }
  }

  @media (max-width: 620px) {
    .field-card-practical {
      width: calc(100% - 16px);
      margin-top: 56px;
      padding: 38px 20px 44px;
      box-shadow: none;
    }

    .field-card-practical__heading {
      margin-bottom: 34px;
    }

    .field-card-practical__heading h2 {
      max-width: 18ch;
      font-size: clamp(2rem, 9.2vw, 2.8rem);
    }

    .field-card-practical__intro {
      font-size: 1.1rem;
    }

    .field-card-practical__divider {
      margin-top: 22px;
    }

    .field-card-practical__note {
      grid-template-columns: 32px minmax(0, 1fr);
      gap: 11px;
      padding-top: 13px;
    }

    .field-card-practical__note::before {
      left: 43px;
      width: 34px;
    }

    .field-card-practical__value {
      font-size: 1.18rem;
    }

    .field-card-practical__detail {
      font-size: .79rem;
      line-height: 1.6;
    }
  }
</style>
