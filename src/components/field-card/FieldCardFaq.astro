---
import type { ThingToDo } from '../../core/models/types';

interface Props {
  thing: ThingToDo;
  items: ThingToDo['fieldCard']['faq'];
}

const { thing, items: sourceItems } = Astro.props;
const items = sourceItems
  .filter((item) => item.question.trim() && item.answer.trim())
  .slice(0, 5);
const headingId = `field-card-faq-${thing.id}`;
---

{items.length > 0 && (
  <section class="field-card-faq" aria-labelledby={headingId}>
    <header class="field-card-faq__heading">
      <div>
        <p class="field-card-faq__eyebrow">QUESTIONS BEFORE GOING</p>
        <h2 id={headingId}>{thing.name}, without the guesswork</h2>
      </div>
      <p class="field-card-faq__note">Five things worth clearing up before you go.</p>
    </header>

    <div class="field-card-faq__list">
      {items.map((item, index) => (
        <details class="field-card-faq__item" open={index === 0}>
          <summary>
            <span class="field-card-faq__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <span class="field-card-faq__question">{item.question}</span>
            <span class="field-card-faq__marker" aria-hidden="true">+</span>
          </summary>
          <div class="field-card-faq__answer">
            <p>{item.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </section>
)}

<style>
  .field-card-faq {
    justify-self: center;
    width: min(1020px, calc(100vw - 48px));
    margin-top: clamp(68px, 8vw, 104px);
    padding: 0 clamp(12px, 2.4vw, 30px);
    color: #203c31;
  }

  .field-card-faq__heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, .42fr);
    gap: clamp(32px, 7vw, 92px);
    align-items: end;
    margin-bottom: clamp(38px, 5vw, 58px);
  }

  .field-card-faq__eyebrow {
    margin: 0 0 11px;
    color: #b76645;
    font-family: var(--field-card-practical);
    font-size: .54rem;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: .17em;
    text-transform: uppercase;
  }

  .field-card-faq__heading h2 {
    max-width: 17ch;
    margin: 0;
    color: #203c31;
    font-family: var(--field-card-title);
    font-size: clamp(2.15rem, 3.7vw, 3.45rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -.032em;
  }

  .field-card-faq__note {
    max-width: 16rem;
    margin: 0 0 4px auto;
    color: rgb(49 85 69 / .58);
    font-family: var(--field-card-handwritten);
    font-size: clamp(1.05rem, 1.55vw, 1.26rem);
    font-weight: 500;
    line-height: 1.28;
    transform: rotate(-1.2deg);
  }

  .field-card-faq__list {
    border-top: 1px solid rgb(49 85 69 / .16);
  }

  .field-card-faq__item {
    position: relative;
    border-bottom: 1px solid rgb(49 85 69 / .14);
  }

  .field-card-faq__item summary {
    position: relative;
    display: grid;
    grid-template-columns: clamp(58px, 7vw, 82px) minmax(0, 1fr) 34px;
    gap: clamp(12px, 2.2vw, 26px);
    align-items: center;
    min-height: clamp(92px, 10vw, 118px);
    padding: 14px 0;
    cursor: pointer;
    list-style: none;
  }

  .field-card-faq__item summary::-webkit-details-marker {
    display: none;
  }

  .field-card-faq__index {
    color: rgb(49 85 69 / .09);
    font-family: var(--field-card-editorial);
    font-size: clamp(3.9rem, 6.7vw, 5.8rem);
    font-weight: 400;
    line-height: .78;
    letter-spacing: -.06em;
    pointer-events: none;
    user-select: none;
  }

  .field-card-faq__question {
    max-width: 38ch;
    color: #203c31;
    font-family: var(--field-card-title);
    font-size: clamp(1.28rem, 2vw, 1.68rem);
    font-weight: 600;
    line-height: 1.16;
    letter-spacing: -.018em;
  }

  .field-card-faq__marker {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    color: rgb(49 85 69 / .58);
    font-family: var(--field-card-practical);
    font-size: 1.15rem;
    font-weight: 400;
    line-height: 1;
    transition: transform 180ms ease, color 180ms ease;
  }

  .field-card-faq__item[open] .field-card-faq__marker {
    color: #b76645;
    transform: rotate(45deg);
  }

  .field-card-faq__answer {
    max-width: 54rem;
    padding: 0 40px clamp(28px, 3.4vw, 38px) clamp(70px, 9.2vw, 108px);
  }

  .field-card-faq__answer p {
    margin: 0;
    color: rgb(49 85 69 / .72);
    font-family: var(--field-card-editorial);
    font-size: clamp(.9rem, 1.05vw, 1rem);
    font-weight: 400;
    line-height: 1.72;
  }

  @media (max-width: 820px) {
    .field-card-faq {
      width: min(100vw - 32px, 720px);
      padding-inline: 8px;
    }

    .field-card-faq__heading {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .field-card-faq__note {
      max-width: 22rem;
      margin-left: 0;
    }
  }

  @media (max-width: 620px) {
    .field-card-faq {
      width: calc(100vw - 20px);
      margin-top: 58px;
      padding-inline: 10px;
    }

    .field-card-faq__heading {
      margin-bottom: 30px;
    }

    .field-card-faq__heading h2 {
      max-width: 18ch;
      font-size: clamp(2rem, 9.5vw, 2.75rem);
    }

    .field-card-faq__item summary {
      grid-template-columns: 48px minmax(0, 1fr) 28px;
      gap: 10px;
      min-height: 88px;
      padding: 12px 0;
    }

    .field-card-faq__index {
      font-size: 3.45rem;
    }

    .field-card-faq__question {
      font-size: 1.18rem;
    }

    .field-card-faq__answer {
      padding: 0 28px 26px 58px;
    }

    .field-card-faq__answer p {
      font-size: .86rem;
      line-height: 1.66;
    }
  }
</style>
