---
import type { ThingToDo } from '../../core/models/types';

interface Props {
  thing: ThingToDo;
  items: ThingToDo['fieldCard']['faq'];
}

const { thing, items: sourceItems } = Astro.props;
const items = sourceItems
  .filter((item) => item.question.trim() && item.answer.trim())
  .slice(0, 5);
const headingId = `field-card-faq-${thing.id}`;
---

{items.length > 0 && (
  <section class="field-card-faq" aria-labelledby={headingId}>
    <header class="field-card-faq__heading">
      <div>
        <p class="field-card-faq__eyebrow">QUESTIONS BEFORE GOING</p>
        <h2 id={headingId}>
          <span>{thing.name},</span>
          <span>without the guesswork</span>
        </h2>
      </div>
      <p class="field-card-faq__note">Five things worth clearing up before you go.</p>
    </header>

    <div class="field-card-faq__list">
      {items.map((item, index) => (
        <details class="field-card-faq__item" open={index === 0}>
          <summary>
            <span class="field-card-faq__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <span class="field-card-faq__question">{item.question}</span>
            <span class="field-card-faq__marker" aria-hidden="true">+</span>
          </summary>
          <div class="field-card-faq__answer">
            <p>{item.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </section>
)}

<style>
  .field-card-faq {
    --faq-index-column: clamp(52px, 6vw, 68px);
    --faq-row-gap: clamp(10px, 1.7vw, 18px);

    justify-self: center;
    width: min(980px, calc(100vw - 48px));
    margin-top: clamp(60px, 7vw, 90px);
    padding: 0 clamp(12px, 2.2vw, 26px);
    color: #203c31;
  }

  .field-card-faq__heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(210px, .4fr);
    gap: clamp(28px, 6vw, 76px);
    align-items: end;
    margin-bottom: clamp(30px, 4vw, 44px);
  }

  .field-card-faq__eyebrow {
    margin: 0 0 9px;
    color: #b76645;
    font-family: var(--field-card-practical);
    font-size: .52rem;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: .17em;
    text-transform: uppercase;
  }

  .field-card-faq__heading h2 {
    max-width: 17ch;
    margin: 0;
    color: #203c31;
    font-family: var(--field-card-title);
    font-size: clamp(1.95rem, 3.25vw, 3.05rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -.03em;
  }

  .field-card-faq__heading h2 span {
    display: block;
  }

  .field-card-faq__heading h2 span + span {
    margin-top: .03em;
  }

  .field-card-faq__note {
    max-width: 15rem;
    margin: 0 0 3px auto;
    color: rgb(49 85 69 / .58);
    font-family: var(--field-card-handwritten);
    font-size: clamp(.98rem, 1.4vw, 1.16rem);
    font-weight: 500;
    line-height: 1.26;
    transform: rotate(-1.2deg);
  }

  .field-card-faq__list {
    border-top: 1px solid rgb(49 85 69 / .16);
  }

  .field-card-faq__item {
    border-bottom: 1px solid rgb(49 85 69 / .14);
  }

  .field-card-faq__item summary {
    display: grid;
    grid-template-columns: var(--faq-index-column) minmax(0, 1fr) 30px;
    gap: var(--faq-row-gap);
    align-items: center;
    min-height: clamp(78px, 8.2vw, 96px);
    padding: 10px 0;
    cursor: pointer;
    list-style: none;
  }

  .field-card-faq__item summary::-webkit-details-marker {
    display: none;
  }

  .field-card-faq__index {
    color: rgb(49 85 69 / .075);
    font-family: var(--field-card-editorial);
    font-size: clamp(3.25rem, 5.4vw, 4.55rem);
    font-weight: 400;
    line-height: .8;
    letter-spacing: -.06em;
    pointer-events: none;
    user-select: none;
  }

  .field-card-faq__question {
    max-width: 38ch;
    color: #203c31;
    font-family: var(--field-card-title);
    font-size: clamp(1.14rem, 1.7vw, 1.5rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -.017em;
  }

  .field-card-faq__marker {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    color: rgb(49 85 69 / .56);
    font-family: var(--field-card-practical);
    font-size: 1.05rem;
    font-weight: 400;
    line-height: 1;
    transition: transform 180ms ease, color 180ms ease;
  }

  .field-card-faq__item[open] .field-card-faq__marker {
    color: #b76645;
    transform: rotate(45deg);
  }

  .field-card-faq__answer {
    max-width: 51rem;
    padding: 0 36px clamp(22px, 2.8vw, 30px) calc(var(--faq-index-column) + var(--faq-row-gap));
  }

  .field-card-faq__answer p {
    margin: 0;
    color: rgb(49 85 69 / .72);
    font-family: var(--field-card-editorial);
    font-size: clamp(.86rem, .95vw, .95rem);
    font-weight: 400;
    line-height: 1.66;
  }

  @media (max-width: 820px) {
    .field-card-faq {
      width: min(100vw - 32px, 700px);
      padding-inline: 8px;
    }

    .field-card-faq__heading {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .field-card-faq__note {
      max-width: 21rem;
      margin-left: 0;
    }
  }

  @media (max-width: 620px) {
    .field-card-faq {
      --faq-index-column: 44px;
      --faq-row-gap: 9px;

      width: calc(100vw - 20px);
      margin-top: 52px;
      padding-inline: 10px;
    }

    .field-card-faq__heading {
      margin-bottom: 25px;
    }

    .field-card-faq__heading h2 {
      max-width: 18ch;
      font-size: clamp(1.82rem, 8.6vw, 2.45rem);
    }

    .field-card-faq__item summary {
      grid-template-columns: var(--faq-index-column) minmax(0, 1fr) 26px;
      min-height: 76px;
      padding: 9px 0;
    }

    .field-card-faq__index {
      font-size: 3rem;
    }

    .field-card-faq__question {
      font-size: 1.08rem;
    }

    .field-card-faq__marker {
      width: 26px;
      height: 26px;
    }

    .field-card-faq__answer {
      padding: 0 24px 22px calc(var(--faq-index-column) + var(--faq-row-gap));
    }

    .field-card-faq__answer p {
      font-size: .82rem;
      line-height: 1.62;
    }
  }
</style>
