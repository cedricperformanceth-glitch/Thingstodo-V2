---
import type { City } from '../../core/models/types';
import { cityFieldNotePath, thingPath } from '../../core/routing/paths';
import { getExploreBoard } from '../../engines/explore-board/explore-board-engine';

interface Props { city: City; }
const { city } = Astro.props;
const board = getExploreBoard(city);
const sectionId = `explore-board-${city.country}-${city.slug}`;
const cityNoteHref = cityFieldNotePath(city);
---

<section class="explore-board-section" aria-labelledby={sectionId}>
  <div class="explore-board-frame">
    <div class="explore-board">
      <img
        class="explore-board__globe-mark"
        src="/assets/admin/svg-workbench/catalogue/globe-flight-line-art-v1.svg"
        alt=""
        aria-hidden="true"
        loading="lazy"
        decoding="async"
      />
      <a class="explore-board__city-note" href={cityNoteHref} aria-label={`Read the ${city.name} City Field Note`}>
        <span class="explore-board__city-note-tape" aria-hidden="true"></span>
        <span>Read the City Field Note</span>
      </a>
      <header class="explore-board__header">
        <p class="explore-board__question">What can I actually do in {city.name}?</p>
        <h2 id={sectionId}>Explore from {city.name}</h2>
        <span class="explore-board__chalk-line" aria-hidden="true"></span>
        <p class="explore-board__intro">{board.intro}</p>
      </header>

      <div class="explore-board__content" aria-label={`Landmarks to explore from ${city.name}`}>
        {board.things.map(({ thing, kicker, duration, route }, index) => {
          const image = thing.media.card?.image;
          return (
            <a
              class:list={['explore-board-card', `explore-board-card--${index % 3}`]}
              href={thingPath(city, thing)}
              aria-label={`Open the complete ${thing.name} field note`}
            >
              <span class="explore-board-card__photo">
                <span class="explore-board-card__tape" aria-hidden="true"></span>
                {image ? (
                  <img src={image.src} alt={image.alt} width="480" height="270" loading="lazy" decoding="async" />
                ) : (
                  <span class="explore-board-card__photo-placeholder" aria-hidden="true"></span>
                )}
                <span class="explore-board-card__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              </span>

              <span class="explore-board-card__copy">
                <small>{kicker}</small>
                <strong>{thing.name}</strong>
                <span class="explore-board-card__summary">{thing.shortDescription}</span>
                <span class="explore-board-card__meta">
                  <span>{duration}</span>
                  <i aria-hidden="true"></i>
                  <span>{route}</span>
                </span>
                <span class="explore-board-card__action">open the field note <b aria-hidden="true">↗</b></span>
              </span>
            </a>
          );
        })}
      </div>

      <footer class="explore-board__footer">
        <span aria-hidden="true">↳</span>
        <p>{board.note}</p>
      </footer>
    </div>
  </div>
</section>

<style>
  .explore-board-section {
    width: min(1400px, calc(100% - .25rem));
    margin: 0 auto;
    padding: clamp(2rem, 4vw, 3.7rem) 0 clamp(2.8rem, 5vw, 4.7rem);
  }

  .explore-board-frame {
    position: relative;
    padding: clamp(.5rem, .9vw, .7rem);
    border: 1px solid rgba(57, 38, 22, .82);
    background:
      linear-gradient(90deg, rgba(255,255,255,.08), transparent 12%, transparent 88%, rgba(0,0,0,.14)),
      repeating-linear-gradient(1deg, #765436 0 5px, #68472e 5px 10px, #7b593a 10px 15px);
    box-shadow: 0 14px 30px rgba(28, 31, 27, .15), inset 0 0 0 1px rgba(255,255,255,.1);
    transform: rotate(-.04deg);
  }

  .explore-board-frame::before,
  .explore-board-frame::after {
    content: '';
    position: absolute;
    z-index: 4;
    width: clamp(3.1rem, 6vw, 4.8rem);
    height: .82rem;
    background: rgba(216, 200, 164, .56);
    box-shadow: 0 1px 2px rgba(39, 31, 22, .12);
    pointer-events: none;
  }

  .explore-board-frame::before { top: -.28rem; left: 7%; transform: rotate(-4deg); }
  .explore-board-frame::after { right: 7%; bottom: -.28rem; transform: rotate(3deg); }

  .explore-board {
    position: relative;
    overflow: hidden;
    padding: clamp(1.8rem, 3vw, 2.7rem) clamp(1.5rem, 3vw, 2.7rem) clamp(1.5rem, 2.6vw, 2.15rem);
    border: 1px solid rgba(238, 234, 216, .1);
    background:
      radial-gradient(ellipse at 18% 19%, rgba(255,255,255,.025), transparent 34%),
      radial-gradient(ellipse at 83% 76%, rgba(255,255,255,.018), transparent 31%),
      repeating-linear-gradient(176deg, rgba(255,255,255,.009) 0 1px, transparent 1px 5px),
      #050505;
    box-shadow: inset 0 0 42px rgba(0,0,0,.74), inset 0 0 0 2px rgba(255,255,255,.014);
    color: #efecdd;
  }

  .explore-board__globe-mark {
    position: absolute;
    top: clamp(.65rem, 1.35vw, 1.05rem);
    right: clamp(.75rem, 1.45vw, 1.2rem);
    z-index: 3;
    display: block;
    width: clamp(3.8rem, 5.5vw, 5.4rem);
    height: auto;
    opacity: .72;
    filter: invert(1);
    mix-blend-mode: screen;
    pointer-events: none;
    user-select: none;
    transform: rotate(1.5deg);
  }

  .explore-board__city-note {
    position: absolute;
    top: clamp(2rem, 3vw, 2.7rem);
    left: clamp(1.15rem, 2.2vw, 2rem);
    z-index: 4;
    display: inline-flex;
    width: clamp(6.7rem, 9vw, 7.7rem);
    min-height: 3.7rem;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    padding: .78rem .72rem .66rem;
    border: 1px solid rgba(90, 72, 42, .28);
    background: #d9c99a;
    color: #315545;
    box-shadow: 0 5px 10px rgba(0,0,0,.28), inset 0 0 12px rgba(255,255,255,.12);
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: clamp(.66rem, .85vw, .8rem);
    font-weight: 600;
    line-height: 1.25;
    text-align: center;
    text-decoration: none;
    transform: rotate(-3.5deg);
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .explore-board__city-note-tape {
    position: absolute;
    top: -.38rem;
    left: 50%;
    width: 2.65rem;
    height: .62rem;
    background: rgba(220, 207, 171, .7);
    box-shadow: 0 1px 2px rgba(0,0,0,.16);
    transform: translateX(-50%) rotate(2deg);
    pointer-events: none;
  }

  .explore-board__city-note:hover,
  .explore-board__city-note:focus-visible {
    outline: none;
    box-shadow: 0 8px 14px rgba(0,0,0,.34), inset 0 0 12px rgba(255,255,255,.15);
    transform: translateY(-2px) rotate(-2.6deg);
  }

  .explore-board::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: .22;
    background-image:
      radial-gradient(circle, rgba(255,255,255,.11) 0 .55px, transparent .8px),
      radial-gradient(circle, rgba(255,255,255,.06) 0 .45px, transparent .7px);
    background-position: 0 0, 4px 3px;
    background-size: 9px 9px, 13px 13px;
    mix-blend-mode: screen;
  }

  .explore-board__header,
  .explore-board__content,
  .explore-board__footer { position: relative; z-index: 2; }

  .explore-board__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 54rem;
    margin: 0 auto clamp(2rem, 3.4vw, 2.8rem);
    text-align: center;
  }

  .explore-board__question {
    margin: 0 0 .4rem;
    color: rgba(241, 237, 220, .8);
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: clamp(.78rem, 1.35vw, 1.04rem);
    font-weight: 500;
    line-height: 1.2;
    white-space: nowrap;
    text-shadow: .35px .35px 0 rgba(255,255,255,.24);
    transform: rotate(-.35deg);
  }

  .explore-board__header h2 {
    margin: 0;
    color: #f3efde;
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 500;
    letter-spacing: -.065em;
    line-height: 1;
    text-shadow: .55px .55px 0 rgba(255,255,255,.32), -.35px .15px 0 rgba(255,255,255,.16), 0 0 2px rgba(255,255,255,.15);
    transform: rotate(-.35deg);
  }

  .explore-board__chalk-line {
    display: block;
    width: min(18rem, 55%);
    height: .42rem;
    margin: .28rem 0 .65rem;
    border-top: 2px solid rgba(240, 235, 214, .64);
    border-radius: 50%;
    box-shadow: 0 2px 0 rgba(240,235,214,.07);
    transform: rotate(-1deg);
  }

  .explore-board__intro {
    max-width: 43rem;
    margin: 0;
    color: rgba(238, 234, 219, .75);
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: clamp(.75rem, 1.08vw, .9rem);
    line-height: 1.55;
  }

  .explore-board__content {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.6rem, 3.2vw, 2.65rem);
    align-items: start;
  }

  .explore-board-card {
    position: relative;
    z-index: 2;
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: .25rem;
    border: 1px solid transparent;
    border-radius: 2px;
    color: inherit;
    text-align: left;
    text-decoration: none;
    transition: transform 180ms ease, background 180ms ease, border-color 180ms ease;
  }

  .explore-board-card--0 { transform: rotate(-.2deg); }
  .explore-board-card--1 { transform: rotate(.18deg); }
  .explore-board-card--2 { transform: rotate(-.1deg); }

  .explore-board-card:hover,
  .explore-board-card:focus-visible {
    z-index: 3;
    border-color: rgba(239, 234, 214, .14);
    background: rgba(255,255,255,.02);
    outline: none;
    transform: translateY(-3px) rotate(0deg);
  }

  .explore-board-card__photo {
    position: relative;
    display: block;
    width: 100%;
    padding: .34rem;
    background: #f1ede0;
    box-shadow: 0 6px 13px rgba(0,0,0,.38);
    box-sizing: border-box;
    transform: rotate(-.75deg);
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .explore-board-card--1 .explore-board-card__photo { transform: rotate(.6deg); }
  .explore-board-card--2 .explore-board-card__photo { transform: rotate(-.35deg); }

  .explore-board-card:hover .explore-board-card__photo,
  .explore-board-card:focus-visible .explore-board-card__photo {
    box-shadow: 0 9px 18px rgba(0,0,0,.46);
    transform: rotate(0deg) scale(1.01);
  }

  .explore-board-card__photo img,
  .explore-board-card__photo-placeholder {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .explore-board-card__photo img { filter: saturate(.68) contrast(.97) sepia(.06); }
  .explore-board-card__photo-placeholder { background: rgba(49,85,69,.18); }

  .explore-board-card__tape {
    position: absolute;
    z-index: 2;
    top: -.3rem;
    left: 50%;
    width: 2.9rem;
    height: .58rem;
    background: rgba(210, 195, 157, .62);
    transform: translateX(-50%) rotate(2deg);
  }

  .explore-board-card__number {
    position: absolute;
    right: .58rem;
    bottom: .48rem;
    padding: .08rem .28rem;
    background: rgba(5,5,5,.72);
    color: rgba(244,240,224,.82);
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: .56rem;
    font-weight: 700;
    transform: rotate(-3deg);
  }

  .explore-board-card__copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: 1.05rem .4rem .2rem;
  }

  .explore-board-card__copy small {
    margin-bottom: .36rem;
    color: rgba(223, 216, 188, .64);
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: clamp(.52rem, .78vw, .6rem);
    font-weight: 600;
    letter-spacing: .04em;
    line-height: 1.3;
  }

  .explore-board-card__copy strong {
    color: #f1eddb;
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: clamp(1.35rem, 2.25vw, 1.82rem);
    font-weight: 500;
    letter-spacing: -.045em;
    line-height: 1.05;
    text-shadow: .45px .45px 0 rgba(255,255,255,.22);
  }

  .explore-board-card__summary {
    margin-top: .58rem;
    color: rgba(236, 232, 216, .77);
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: clamp(.7rem, 1vw, .82rem);
    line-height: 1.52;
  }

  .explore-board-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .42rem;
    margin-top: .72rem;
    color: #dfc18c;
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: clamp(.59rem, .82vw, .68rem);
    font-weight: 600;
  }

  .explore-board-card__meta i { width: 2px; height: 2px; border-radius: 50%; background: currentColor; }

  .explore-board-card__action {
    display: inline-flex;
    align-items: center;
    gap: .25rem;
    align-self: flex-start;
    margin-top: .68rem;
    border-bottom: 1px dashed rgba(238, 233, 214, .48);
    color: rgba(242, 238, 222, .92);
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: clamp(.62rem, .86vw, .72rem);
    line-height: 1.35;
  }

  .explore-board-card__action b { font-size: .84rem; transition: transform 180ms ease; }
  .explore-board-card:hover .explore-board-card__action b,
  .explore-board-card:focus-visible .explore-board-card__action b { transform: translate(2px, -2px); }

  .explore-board__footer {
    display: flex;
    justify-content: center;
    gap: .42rem;
    margin-top: clamp(1.6rem, 2.7vw, 2.15rem);
    color: rgba(231, 225, 202, .64);
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    transform: rotate(-.25deg);
  }

  .explore-board__footer p { margin: 0; font-size: clamp(.65rem, .94vw, .78rem); line-height: 1.35; }

  @media (max-width: 860px) {
    .explore-board-section { width: min(100% - 1rem, 1400px); }
    .explore-board__content { grid-template-columns: 1fr; gap: 1.55rem; }
    .explore-board-card { width: min(34rem, 100%); margin-inline: auto; }
  }

  @media (max-width: 520px) {
    .explore-board-section { width: min(100% - .5rem, 1400px); padding-top: 1.6rem; }
    .explore-board { padding: 1.55rem 1rem 1.35rem; }
    .explore-board__globe-mark { width: 3.5rem; top: .55rem; right: .55rem; opacity: .64; }
    .explore-board__question { white-space: normal; }
    .explore-board-card__copy { padding-inline: .15rem; }
  }
</style>
