---
import type { City, Place, ThingToDo } from '../../core/models/types';
import { getExploreBoard } from '../../engines/explore-board/explore-board-engine';
import { cityPresentation } from '../../engines/spa/city-presentation';
import PlaceCard from '../cards/PlaceCard.astro';
import ThingToDoCard from '../cards/ThingToDoCard.astro';
interface Props { city: City; }
const { city } = Astro.props; const board = getExploreBoard(city) as { places: Place[]; things: ThingToDo[] }; const presentation = cityPresentation[city.profile];
---
<section aria-labelledby="explore-title"><h2 id="explore-title">Explore Board</h2><div class="grid" style={`--board-columns:${presentation.boardColumns}`}>{board.places.map((place) => <PlaceCard place={place} />)}{board.things.map((thing) => <ThingToDoCard city={city} thing={thing} />)}</div></section>
<style>.grid{display:grid;grid-template-columns:repeat(var(--board-columns),minmax(0,1fr));gap:1rem}@media(max-width:700px){.grid{grid-template-columns:1fr}}</style>
