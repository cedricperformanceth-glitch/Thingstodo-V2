---
import {
  HOME_COUNTRIES,
  HOME_SCENE_ASSETS,
  NEUTRAL_SHELF,
} from '../../features/homepage/countries';

const LAOS_DIRECTORY_MEDIA = {
  kuangSi: {
    src: 'https://commons.wikimedia.org/wiki/Special:Redirect/file/Kuang%20Si%20Falls%20and%20a%20turquoise%20water%20pool%20in%20Luang%20Prabang%20province%20Laos.jpg',
    alt: 'Kuang Si Falls and a turquoise pool near Luang Prabang',
    sourceUrl: 'https://commons.wikimedia.org/wiki/File:Kuang_Si_Falls_and_a_turquoise_water_pool_in_Luang_Prabang_province_Laos.jpg',
    author: 'Basile Morin',
    license: 'CC BY-SA',
  },
  mekong: {
    src: 'https://commons.wikimedia.org/wiki/Special:Redirect/file/Mountains%20clouds%20Mekong%20and%20dwellings%20from%20Mount%20Phou%20Si%20at%20sunrise%20in%20Luang%20Prabang%20Laos.jpg',
    alt: 'The Mekong and mountain landscape seen from Mount Phou Si at sunrise',
    sourceUrl: 'https://commons.wikimedia.org/wiki/File:Mountains_clouds_Mekong_and_dwellings_from_Mount_Phou_Si_at_sunrise_in_Luang_Prabang_Laos.jpg',
    author: 'Basile Morin',
    license: 'CC BY-SA',
  },
  lagoon: {
    src: 'https://commons.wikimedia.org/wiki/Special:Redirect/file/Blue%20Lagoon%20Vang%20Vieng.jpg',
    alt: 'Blue Lagoon in Vang Vieng',
    sourceUrl: 'https://commons.wikimedia.org/wiki/File:Blue_Lagoon_Vang_Vieng.jpg',
    author: 'Christophe95',
    license: 'CC BY-SA',
  },
  vatPhou: {
    src: 'https://upload.wikimedia.org/wikipedia/commons/thumb/0/02/Stone_gate_with_columns_and_Buddhist_reliefs_leading_to_a_clothed_statue_of_the_Buddha_seated%2C_Wat_Phou_temple%2C_Champasak%2C_Laos.jpg/1920px-Stone_gate_with_columns_and_Buddhist_reliefs_leading_to_a_clothed_statue_of_the_Buddha_seated%2C_Wat_Phou_temple%2C_Champasak%2C_Laos.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail',
    alt: 'Stone gate and Buddhist reliefs at Vat Phou in Champasak',
    sourceUrl: 'https://commons.wikimedia.org/wiki/File:Stone_gate_with_columns_and_Buddhist_reliefs_leading_to_a_clothed_statue_of_the_Buddha_seated,_Wat_Phou_temple,_Champasak,_Laos.jpg',
    author: 'Basile Morin',
    license: 'CC BY-SA',
  },
  cave: {
    src: 'https://commons.wikimedia.org/wiki/Special:Redirect/file/VientianeProvince%20VangVieng%20ThamJang4%20tango7174.jpg',
    alt: 'Interior of Tham Jang cave in Vang Vieng',
    sourceUrl: 'https://commons.wikimedia.org/wiki/File:VientianeProvince_VangVieng_ThamJang4_tango7174.jpg',
    author: 'Tango7174',
    license: 'CC BY-SA',
  },
} as const;
---

<section class="atlas-home" data-atlas-home data-ready="false" aria-busy="true" aria-label="Things to Do Atlas country selection">
  <div class="atlas-ambient" aria-hidden="true"></div>

  <div class="atlas-tableau" data-atlas-tableau>
    <div class="atlas-stage" data-atlas-stage>
      <div class="atlas-background" aria-hidden="true">
        <img
          class="atlas-background__image"
          data-background-on
          src={HOME_SCENE_ASSETS.backgroundOn}
          alt=""
          width="1448"
          height="1086"
          fetchpriority="high"
          decoding="async"
        />
        <img
          class="atlas-background__image atlas-background__image--off"
          data-background-off
          src={HOME_SCENE_ASSETS.backgroundOff}
          alt=""
          width="1448"
          height="1086"
          decoding="async"
        />
      </div>

      <div class="atlas-shelf" aria-label="Country notebooks">
        <div
          class="atlas-shelf__neutral-group"
          style={`--neutral-left:${NEUTRAL_SHELF.left}%;--neutral-top:${NEUTRAL_SHELF.top}%;--neutral-height:${NEUTRAL_SHELF.height}%;--neutral-book-width:${NEUTRAL_SHELF.bookWidth}px`}
          aria-hidden="true"
        >
          {Array.from({ length: NEUTRAL_SHELF.count }).map(() => (
            <span class="atlas-shelf__neutral">
              <img
                src={HOME_SCENE_ASSETS.neutralShelf}
                alt=""
                width="1254"
                height="1254"
                decoding="async"
              />
            </span>
          ))}
        </div>

        {HOME_COUNTRIES.map((country) => (
          <button
            class="atlas-country-spine"
            type="button"
            data-country-trigger={country.slug}
            style={`--shelf-left:${country.shelfLeft}%`}
            aria-label={`Select ${country.name}`}
            disabled
          >
            <img src={country.assets.shelfSpine} alt="" decoding="async" />
          </button>
        ))}

        <button
          class="atlas-country-extracted"
          type="button"
          data-country-extracted
          aria-label="Open selected country notebook"
          disabled
        >
          <img data-country-extracted-image alt="" decoding="async" />
        </button>
      </div>

      <div class="atlas-globe" data-globe aria-hidden="true">
        <img class="atlas-globe__state" data-globe-asia src={HOME_SCENE_ASSETS.globeAsia} alt="" decoding="async" />
        <span class="atlas-globe__sphere-window">
          <img class="atlas-globe__state atlas-globe__state--alternate" data-globe-europe src={HOME_SCENE_ASSETS.globeEurope} alt="" decoding="async" />
        </span>
      </div>

      <button class="atlas-lamp-pull" type="button" data-lamp-pull aria-label="Toggle desk lamp" disabled>
        <img src={HOME_SCENE_ASSETS.lampPull} alt="" decoding="async" />
      </button>

      <div class="atlas-hero-copy">
        <h1>Make your own Atlas</h1>
        <h2>A better journey begins with knowing where to look.</h2>
      </div>

      <button class="atlas-desk-book" type="button" data-desk-book aria-label="Selected country notebook" disabled>
        <img
          class="atlas-desk-book__state atlas-desk-book__state--neutral"
          data-desk-neutral
          src={HOME_SCENE_ASSETS.neutralDesk}
          alt=""
          decoding="async"
        />
        <img class="atlas-desk-book__state atlas-desk-book__state--closed" data-desk-closed-a alt="" decoding="async" />
        <img class="atlas-desk-book__state atlas-desk-book__state--closed" data-desk-closed-b alt="" decoding="async" />
        <img class="atlas-desk-book__state atlas-desk-book__state--opening-1" data-desk-opening-1 alt="" decoding="async" />
        <img class="atlas-desk-book__state atlas-desk-book__state--opening-2" data-desk-opening-2 alt="" decoding="async" />
        <img class="atlas-desk-book__state atlas-desk-book__state--open" data-desk-open alt="" decoding="async" />
      </button>
    </div>

    <svg class="atlas-tableau-frame" viewBox="-32 -32 1512 1150" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="atlas-frame-top" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#7c4d2d" />
          <stop offset="0.42" stop-color="#4d2b1a" />
          <stop offset="1" stop-color="#25140d" />
        </linearGradient>
        <linearGradient id="atlas-frame-side" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#24130c" />
          <stop offset="0.48" stop-color="#5b341f" />
          <stop offset="1" stop-color="#2a160e" />
        </linearGradient>
        <filter id="atlas-frame-shadow" x="-12%" y="-12%" width="124%" height="132%">
          <feDropShadow dx="0" dy="14" stdDeviation="11" flood-color="#000000" flood-opacity="0.42" />
        </filter>
      </defs>

      <g filter="url(#atlas-frame-shadow)">
        <path d="M-22 -22H1470L1436 16H12Z" fill="url(#atlas-frame-top)" />
        <path d="M-22 1108H1470L1436 1070H12Z" fill="url(#atlas-frame-top)" />
        <path d="M-22 -22L12 16V1070L-22 1108Z" fill="url(#atlas-frame-side)" />
        <path d="M1470 -22L1436 16V1070L1470 1108Z" fill="url(#atlas-frame-side)" />
        <rect x="9" y="13" width="1430" height="1060" fill="none" stroke="#b97942" stroke-opacity="0.42" stroke-width="3" />
        <rect x="16" y="20" width="1416" height="1046" fill="none" stroke="#1a0e09" stroke-opacity="0.72" stroke-width="4" />
      </g>
    </svg>
  </div>
</section>

<section class="atlas-country-feature" aria-labelledby="atlas-country-feature-title">
  <div class="atlas-country-feature__inner">
    <div class="atlas-country-feature__visual">
      <svg class="atlas-country-feature__river-line" viewBox="0 0 700 520" aria-hidden="true" focusable="false">
        <path d="M25 352C150 286 189 371 292 333C393 296 410 177 536 174C603 172 655 201 683 230" />
        <path d="M83 401C189 354 240 432 339 384C431 340 480 263 633 282" />
      </svg>

      <figure class="atlas-water-drop atlas-water-drop--mekong">
        <span class="atlas-water-drop__mask">
          <img src={LAOS_DIRECTORY_MEDIA.mekong.src} alt={LAOS_DIRECTORY_MEDIA.mekong.alt} loading="lazy" decoding="async" fetchpriority="low" />
        </span>
      </figure>

      <figure class="atlas-water-drop atlas-water-drop--kuang-si">
        <span class="atlas-water-drop__mask">
          <img src={LAOS_DIRECTORY_MEDIA.kuangSi.src} alt={LAOS_DIRECTORY_MEDIA.kuangSi.alt} loading="lazy" decoding="async" fetchpriority="low" />
        </span>
      </figure>

      <figure class="atlas-water-drop atlas-water-drop--lagoon">
        <span class="atlas-water-drop__mask">
          <img src={LAOS_DIRECTORY_MEDIA.lagoon.src} alt={LAOS_DIRECTORY_MEDIA.lagoon.alt} loading="lazy" decoding="async" fetchpriority="low" />
        </span>
      </figure>

      <figure class="atlas-photo-leaf atlas-photo-leaf--vat-phou">
        <span class="atlas-photo-leaf__mask">
          <img src={LAOS_DIRECTORY_MEDIA.vatPhou.src} alt={LAOS_DIRECTORY_MEDIA.vatPhou.alt} loading="lazy" decoding="async" fetchpriority="low" />
        </span>
      </figure>

      <figure class="atlas-photo-leaf atlas-photo-leaf--cave">
        <span class="atlas-photo-leaf__mask">
          <img src={LAOS_DIRECTORY_MEDIA.cave.src} alt={LAOS_DIRECTORY_MEDIA.cave.alt} loading="lazy" decoding="async" fetchpriority="low" />
        </span>
      </figure>

      <details class="atlas-country-feature__credits">
        <summary>Photo credits</summary>
        <div class="atlas-country-feature__credits-list">
          {Object.values(LAOS_DIRECTORY_MEDIA).map((photo) => (
            <a href={photo.sourceUrl} target="_blank" rel="noreferrer">{photo.author} · {photo.license}</a>
          ))}
        </div>
      </details>
    </div>

    <div class="atlas-country-feature__content">
      <p class="atlas-country-feature__eyebrow"><span>01</span> The Laos chapter</p>
      <h1 id="atlas-country-feature-title">Explore Laos</h1>
      <p class="atlas-country-feature__lede">
        Follow the Mekong through temple towns, limestone caves, turquoise pools and the deep green south.
        Open the Laos chapter for places worth the detour, field notes and practical stops gathered for travellers
        who like to look a little closer.
      </p>
      <a class="atlas-country-feature__cta" href="/laos">
        <span>Open the Laos chapter</span>
        <span class="atlas-country-feature__cta-mark" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/gsap.min.js"></script>
<script>
  import { initAtlasHomepage } from '../../features/homepage/client';
  initAtlasHomepage();
</script>
