---
import {
  HOME_COUNTRIES,
  HOME_SCENE_ASSETS,
  NEUTRAL_SHELF,
} from '../../features/homepage/countries';
---

<section class="atlas-home" data-atlas-home data-ready="false" aria-busy="true" aria-label="Things to Do Atlas country selection">
  <div class="atlas-ambient" aria-hidden="true"></div>

  <div class="atlas-tableau" data-atlas-tableau>
    <div class="atlas-stage" data-atlas-stage>
      <div class="atlas-background" aria-hidden="true">
        <img
          class="atlas-background__image"
          data-background-on
          src={HOME_SCENE_ASSETS.backgroundOn}
          alt=""
          width="1448"
          height="1086"
          fetchpriority="high"
          decoding="async"
        />
        <img
          class="atlas-background__image atlas-background__image--off"
          data-background-off
          src={HOME_SCENE_ASSETS.backgroundOff}
          alt=""
          width="1448"
          height="1086"
          decoding="async"
        />
      </div>

      <div class="atlas-shelf" aria-label="Country notebooks">
        <div
          class="atlas-shelf__neutral-group"
          style={`--neutral-left:${NEUTRAL_SHELF.left}%;--neutral-top:${NEUTRAL_SHELF.top}%;--neutral-height:${NEUTRAL_SHELF.height}%;--neutral-book-width:${NEUTRAL_SHELF.bookWidth}px`}
          aria-hidden="true"
        >
          {Array.from({ length: NEUTRAL_SHELF.count }).map(() => (
            <span class="atlas-shelf__neutral">
              <img
                src={HOME_SCENE_ASSETS.neutralShelf}
                alt=""
                width="1254"
                height="1254"
                decoding="async"
              />
            </span>
          ))}
        </div>

        {HOME_COUNTRIES.map((country) => (
          <button
            class="atlas-country-spine"
            type="button"
            data-country-trigger={country.slug}
            style={`--shelf-left:${country.shelfLeft}%`}
            aria-label={`Select ${country.name}`}
            disabled
          >
            <img src={country.assets.shelfSpine} alt="" decoding="async" />
          </button>
        ))}

        <button
          class="atlas-country-extracted"
          type="button"
          data-country-extracted
          aria-label="Open selected country notebook"
          disabled
        >
          <img data-country-extracted-image alt="" decoding="async" />
        </button>
      </div>

      <button class="atlas-lamp-pull" type="button" data-lamp-pull aria-label="Toggle desk lamp" disabled>
        <img src={HOME_SCENE_ASSETS.lampPull} alt="" decoding="async" />
      </button>

      <div class="atlas-hero-copy">
        <h1>Make your own Atlas</h1>
        <h2>A better journey begins with knowing where to look.</h2>
      </div>

      <button class="atlas-desk-book" type="button" data-desk-book aria-label="Selected country notebook" disabled>
        <img
          class="atlas-desk-book__state atlas-desk-book__state--neutral"
          data-desk-neutral
          src={HOME_SCENE_ASSETS.neutralDesk}
          alt=""
          decoding="async"
        />
        <img class="atlas-desk-book__state atlas-desk-book__state--closed" data-desk-closed-a alt="" decoding="async" />
        <img class="atlas-desk-book__state atlas-desk-book__state--closed" data-desk-closed-b alt="" decoding="async" />
        <img class="atlas-desk-book__state atlas-desk-book__state--opening-1" data-desk-opening-1 alt="" decoding="async" />
        <img class="atlas-desk-book__state atlas-desk-book__state--opening-2" data-desk-opening-2 alt="" decoding="async" />
        <img class="atlas-desk-book__state atlas-desk-book__state--open" data-desk-open alt="" decoding="async" />
      </button>
    </div>

    <svg class="atlas-tableau-frame" viewBox="-32 -32 1512 1150" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="atlas-frame-top" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#7c4d2d" />
          <stop offset="0.42" stop-color="#4d2b1a" />
          <stop offset="1" stop-color="#25140d" />
        </linearGradient>
        <linearGradient id="atlas-frame-side" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#24130c" />
          <stop offset="0.48" stop-color="#5b341f" />
          <stop offset="1" stop-color="#2a160e" />
        </linearGradient>
        <filter id="atlas-frame-shadow" x="-12%" y="-12%" width="124%" height="132%">
          <feDropShadow dx="0" dy="14" stdDeviation="11" flood-color="#000000" flood-opacity="0.42" />
        </filter>
      </defs>

      <g filter="url(#atlas-frame-shadow)">
        <path d="M-22 -22H1470L1436 16H12Z" fill="url(#atlas-frame-top)" />
        <path d="M-22 1108H1470L1436 1070H12Z" fill="url(#atlas-frame-top)" />
        <path d="M-22 -22L12 16V1070L-22 1108Z" fill="url(#atlas-frame-side)" />
        <path d="M1470 -22L1436 16V1070L1470 1108Z" fill="url(#atlas-frame-side)" />
        <rect x="9" y="13" width="1430" height="1060" fill="none" stroke="#b97942" stroke-opacity="0.42" stroke-width="3" />
        <rect x="16" y="20" width="1416" height="1046" fill="none" stroke="#1a0e09" stroke-opacity="0.72" stroke-width="4" />
      </g>
    </svg>
  </div>
</section>

<section class="atlas-country-feature" aria-labelledby="atlas-country-feature-title">
  <div class="atlas-country-feature__inner">
    <div class="atlas-country-feature__palm atlas-country-feature__palm--left" aria-hidden="true">
      <img src="/assets/home/laos-palm-left.webp" alt="" width="1024" height="1536" loading="lazy" decoding="async" />
    </div>

    <div class="atlas-country-feature__content">
      <p class="atlas-country-feature__eyebrow"><span>01</span> The Laos chapter</p>
      <div class="atlas-country-feature__title-row">
        <img class="atlas-country-feature__water-drop" src="/assets/home/laos-water-drop.webp" alt="" width="1024" height="1536" loading="lazy" decoding="async" aria-hidden="true" />
        <h1 id="atlas-country-feature-title">Explore Laos</h1>
        <img class="atlas-country-feature__water-drop atlas-country-feature__water-drop--right" src="/assets/home/laos-water-drop.webp" alt="" width="1024" height="1536" loading="lazy" decoding="async" aria-hidden="true" />
      </div>
      <p class="atlas-country-feature__lede">
        Follow the Mekong through temple towns, limestone caves, turquoise pools and the deep green south.
        Open the Laos chapter for places worth the detour, field notes and practical stops gathered for travellers
        who like to look a little closer.
      </p>
      <a class="atlas-country-feature__cta" href="/laos">
        <span>Open the Laos chapter</span>
        <span class="atlas-country-feature__cta-mark" aria-hidden="true">→</span>
      </a>
    </div>

    <div class="atlas-country-feature__palm atlas-country-feature__palm--right" aria-hidden="true">
      <img src="/assets/home/laos-palm-right.webp" alt="" width="1024" height="1536" loading="lazy" decoding="async" />
    </div>
  </div>
</section>

<script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/gsap.min.js"></script>
<script>
  import { initAtlasHomepage } from '../../features/homepage/client';
  initAtlasHomepage();
</script>
