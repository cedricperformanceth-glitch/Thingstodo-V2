---
import type { AtlasRouteReference as Reference } from '../../content/atlas-route-experience';

interface Props {
  reference: Reference;
  compact?: boolean;
}

const { reference, compact = false } = Astro.props;
const published = reference.status !== 'coming-soon' && Boolean(reference.entity && reference.href);
---

<article class:list={['atlas-route-reference', compact && 'atlas-route-reference--compact']}>
  {reference.media?.src && (
    <a class="atlas-route-reference__photo" href={reference.href ?? '#'} aria-label={published ? `Open ${reference.title}` : reference.title}>
      <img src={reference.media.src} alt={reference.media.alt} loading="lazy" decoding="async" />
    </a>
  )}

  <div class="atlas-route-reference__copy">
    <span class="atlas-route-reference__kicker">{reference.kicker ?? 'FROM THE ATLAS'}</span>
    <strong>{reference.title}</strong>
    {reference.note && <p>{reference.note}</p>}
  </div>

  <div class="atlas-route-reference__actions">
    {published ? (
      <>
        <a href={reference.href}>Open field note →</a>
        <button
          type="button"
          data-trip
          data-entity={JSON.stringify(reference.entity)}
          data-source-path={reference.href}
          aria-pressed="false"
          aria-label={`Add ${reference.title} to My Atlas`}
        >Add to My Atlas</button>
      </>
    ) : (
      <span class="atlas-route-reference__soon">Coming to the Atlas</span>
    )}
  </div>
</article>

<style>
  .atlas-route-reference {
    position: relative;
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: center;
    min-width: 0;
    padding: .8rem .9rem;
    border: 1px solid rgba(91, 79, 59, .16);
    background: rgba(255, 253, 248, .82);
    box-shadow: 4px 5px 0 rgba(49, 85, 69, .065);
    transform: rotate(-.2deg);
  }

  .atlas-route-reference:nth-child(even) {
    transform: rotate(.35deg);
  }

  .atlas-route-reference::before {
    content: '';
    position: absolute;
    top: -6px;
    left: 24px;
    width: 46px;
    height: 13px;
    background: rgba(214, 193, 151, .55);
    transform: rotate(-3deg);
  }

  .atlas-route-reference__photo {
    display: block;
    width: 88px;
    height: 72px;
    overflow: hidden;
    border: 4px solid #fffaf0;
    box-shadow: 0 5px 12px rgba(60, 49, 34, .12);
  }

  .atlas-route-reference__photo img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .atlas-route-reference__copy {
    min-width: 0;
  }

  .atlas-route-reference__kicker {
    display: block;
    margin-bottom: .18rem;
    color: #a3513d;
    font-size: .55rem;
    font-weight: 700;
    letter-spacing: .13em;
  }

  .atlas-route-reference__copy strong {
    display: block;
    color: #315545;
    font-family: 'Newsreader', Georgia, serif;
    font-size: 1.1rem;
    line-height: 1.1;
  }

  .atlas-route-reference__copy p {
    margin: .28rem 0 0;
    color: #70675d;
    font-size: .72rem;
    line-height: 1.35;
  }

  .atlas-route-reference__actions {
    display: grid;
    gap: .38rem;
    justify-items: end;
    min-width: 132px;
  }

  .atlas-route-reference__actions a,
  .atlas-route-reference__actions button,
  .atlas-route-reference__soon {
    font-size: .62rem;
    line-height: 1.2;
  }

  .atlas-route-reference__actions a {
    color: #315545;
    text-decoration: none;
  }

  .atlas-route-reference__actions button {
    min-height: 34px;
    padding: .45rem .65rem;
    border: 1px solid #315545;
    background: #315545;
    color: #fffaf0;
    font: inherit;
    cursor: pointer;
  }

  .atlas-route-reference__actions button:disabled {
    border-color: rgba(49, 85, 69, .2);
    background: rgba(49, 85, 69, .11);
    color: #587062;
    cursor: default;
  }

  .atlas-route-reference__soon {
    padding: .4rem .55rem;
    background: #eadfcb;
    color: #746957;
    font-family: 'Caveat', cursive;
    font-size: .95rem;
    transform: rotate(-1deg);
  }

  .atlas-route-reference--compact {
    grid-template-columns: 62px minmax(0, 1fr);
  }

  .atlas-route-reference--compact .atlas-route-reference__photo {
    width: 62px;
    height: 58px;
  }

  .atlas-route-reference--compact .atlas-route-reference__actions {
    grid-column: 1 / -1;
    display: flex;
    justify-content: flex-end;
  }

  @media (max-width: 680px) {
    .atlas-route-reference {
      grid-template-columns: 72px minmax(0, 1fr);
    }

    .atlas-route-reference__photo {
      width: 72px;
      height: 64px;
    }

    .atlas-route-reference__actions {
      grid-column: 1 / -1;
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      align-items: center;
    }
  }
</style>
