---
import type { AtlasRouteChapter as AtlasRouteChapterData, AtlasRouteMedia } from '../../content/atlas-route-content';
import type { AtlasRouteExperienceChapter } from '../../content/atlas-route-experience';
import AtlasRouteReference from './AtlasRouteReference.astro';
import FieldNotebook from './FieldNotebook.astro';

interface Props {
  chapter: AtlasRouteChapterData;
}

const { chapter } = Astro.props;
const richChapter = chapter as AtlasRouteExperienceChapter;
const variant = chapter.variant ?? 'standard';
const references = richChapter.references ?? [];
const notes = richChapter.personalNotes ?? [];
const storyNotes = notes.filter((note) => !note.placement || note.placement === 'story');
const galleryNotes = notes.filter((note) => note.placement && note.placement !== 'story');

const aspectClass = (media: AtlasRouteMedia) =>
  `atlas-route-chapter__media--${media.aspect ?? 'landscape'}`;
---

<section
  class:list={['atlas-route-chapter', `atlas-route-chapter--${variant}`]}
  id={chapter.id}
  data-route-chapter
>
  <header class="atlas-route-chapter__heading">
    <p>{chapter.chapterLabel}</p>
    <div>
      <h2>{chapter.title}</h2>
      {chapter.durationLabel && <span>{chapter.durationLabel}</span>}
    </div>
  </header>

  <div class="atlas-route-chapter__layout">
    <div class="atlas-route-chapter__story">
      <p class="atlas-route-chapter__intro">{chapter.intro}</p>

      {richChapter.marginNote && <p class="atlas-route-chapter__margin-note">{richChapter.marginNote}</p>}

      {chapter.body && chapter.body.length > 0 && (
        <div class="atlas-route-chapter__body">
          {chapter.body.map((paragraph, index) => (
            <p class:list={[index === 0 && 'atlas-route-chapter__body-lead']}>{paragraph}</p>
          ))}
        </div>
      )}

      {chapter.highlights && chapter.highlights.length > 0 && (
        <div class="atlas-route-chapter__highlights" aria-label={`${chapter.title} highlights`}>
          <span class="atlas-route-chapter__highlights-label">KEEP CLOSE</span>
          <ul>{chapter.highlights.map((highlight) => <li>{highlight}</li>)}</ul>
        </div>
      )}

      {references.length > 0 && (
        <aside class="atlas-route-chapter__references" aria-label={`${chapter.title} Atlas picks`}>
          <div class="atlas-route-chapter__references-heading">
            <span>OPEN FROM THE ATLAS</span>
            <small>Save only the ones you want</small>
          </div>
          <div class="atlas-route-chapter__references-list">
            {references.map((reference) => <AtlasRouteReference {reference} />)}
          </div>
        </aside>
      )}

      {storyNotes.length > 0 && (
        <aside class="atlas-route-chapter__personal-notes" aria-label={`${chapter.title} personal notes`}>
          {storyNotes.map((note) => (
            <div
              class:list={[
                'atlas-route-chapter__post-it',
                `atlas-route-chapter__post-it--${note.tone ?? 'butter'}`,
                `atlas-route-chapter__post-it--${note.style ?? 'memory'}`,
                `atlas-route-chapter__post-it--${note.size ?? 'medium'}`,
              ]}
              data-personal-note={note.id}
            >
              <span>{note.label ?? 'PERSONAL NOTE'}</span>
              <p>{note.text}</p>
              {note.items && note.items.length > 0 && <ul>{note.items.map((item) => <li>{item}</li>)}</ul>}
            </div>
          ))}
        </aside>
      )}
    </div>

    {chapter.media && chapter.media.length > 0 && (
      <div class:list={['atlas-route-chapter__gallery', `atlas-route-chapter__gallery--${Math.min(chapter.media.length, 3)}`]}>
        {chapter.media.slice(0, 3).map((media, index) => (
          <figure class:list={['atlas-route-chapter__media', aspectClass(media), `atlas-route-chapter__media--slot-${index + 1}`]}>
            {media.src ? (
              <img src={media.src} alt={media.alt} loading="lazy" decoding="async" />
            ) : (
              <div class="atlas-route-chapter__placeholder" role="img" aria-label={media.alt}>
                <span>PHOTO</span>
                <small>{media.label ?? `${chapter.title} image ${index + 1}`}</small>
              </div>
            )}
            {media.label && <figcaption>{media.label}</figcaption>}
          </figure>
        ))}

        {galleryNotes.length > 0 && (
          <aside class="atlas-route-chapter__gallery-notes" aria-label={`${chapter.title} image notes`}>
            {galleryNotes.map((note) => (
              <div
                class:list={[
                  'atlas-route-chapter__post-it',
                  'atlas-route-chapter__post-it--gallery',
                  `atlas-route-chapter__post-it--${note.placement}`,
                  `atlas-route-chapter__post-it--${note.tone ?? 'butter'}`,
                  `atlas-route-chapter__post-it--${note.style ?? 'memory'}`,
                  `atlas-route-chapter__post-it--${note.size ?? 'medium'}`,
                ]}
                data-personal-note={note.id}
              >
                <span>{note.label ?? 'PERSONAL NOTE'}</span>
                <p>{note.text}</p>
                {note.items && note.items.length > 0 && <ul>{note.items.map((item) => <li>{item}</li>)}</ul>}
              </div>
            ))}
          </aside>
        )}
      </div>
    )}
  </div>

  {chapter.notebook && <FieldNotebook notebook={chapter.notebook} />}

  {chapter.transfer && (
    <aside class="atlas-route-chapter__transfer">
      <span>ON THE ROAD</span>
      <strong>{chapter.transfer.label}</strong>
      {chapter.transfer.note && <p>{chapter.transfer.note}</p>}
    </aside>
  )}
</section>

<style>
  .atlas-route-chapter { scroll-margin-top: 7rem; margin-bottom: clamp(6rem, 12vw, 11rem); }
  .atlas-route-chapter__heading { display: grid; grid-template-columns: 130px minmax(0, 1fr); gap: 1.5rem; align-items: end; padding-bottom: 1.25rem; border-bottom: 1px solid #d8cfbf; }
  .atlas-route-chapter__heading > p { margin: 0 0 .4rem; color: #b76645; font-size: .68rem; font-weight: 700; letter-spacing: .17em; text-transform: uppercase; }
  .atlas-route-chapter__heading > div { display: flex; justify-content: space-between; gap: 1.5rem; align-items: baseline; }
  .atlas-route-chapter__heading h2 { margin: 0; color: #315545; font-family: 'Newsreader', Georgia, serif; font-size: clamp(3rem, 7vw, 6rem); font-weight: 500; letter-spacing: -.035em; }
  .atlas-route-chapter__heading span { color: #7a7166; font-size: .75rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; white-space: nowrap; }
  .atlas-route-chapter__layout { display: grid; grid-template-columns: minmax(250px, .76fr) minmax(0, 1.24fr); gap: clamp(2rem, 6vw, 5rem); padding-top: clamp(2rem, 4vw, 3.5rem); }
  .atlas-route-chapter__story { align-self: start; }
  .atlas-route-chapter__intro { max-width: 35rem; margin: 0; color: #302c27; font-family: 'Newsreader', Georgia, serif; font-size: clamp(1.22rem, 2.2vw, 1.55rem); line-height: 1.42; }
  .atlas-route-chapter__margin-note { width: fit-content; max-width: 30rem; margin: 1rem 0 0; color: #8a5848; font-family: 'Caveat', cursive; font-size: 1.28rem; line-height: 1.08; transform: rotate(-1deg); }
  .atlas-route-chapter__body { display: grid; gap: .85rem; margin-top: 1.45rem; }
  .atlas-route-chapter__body p { max-width: 38rem; margin: 0; color: #5b554d; font-family: 'Newsreader', Georgia, serif; font-size: .95rem; line-height: 1.6; }
  .atlas-route-chapter__body p:nth-child(even) { width: 91%; margin-left: 6%; color: #6d655b; font-size: .89rem; }
  .atlas-route-chapter__highlights { position: relative; width: min(100%, 360px); margin-top: 1.7rem; padding: 1rem 1.1rem 1rem 1.25rem; border-left: 2px solid rgba(183, 102, 69, .42); background: rgba(238, 230, 211, .44); }
  .atlas-route-chapter__highlights-label { color: #a3523f; font-size: .55rem; font-weight: 700; letter-spacing: .14em; }
  .atlas-route-chapter__highlights ul { display: grid; gap: .34rem; margin: .55rem 0 0; padding: 0; list-style: none; }
  .atlas-route-chapter__highlights li { position: relative; padding-left: 1.1rem; color: #565047; font-family: 'Caveat', cursive; font-size: 1.12rem; line-height: 1.15; }
  .atlas-route-chapter__highlights li::before { content: '✓'; position: absolute; left: 0; color: #315545; font-family: sans-serif; font-size: .72rem; }
  .atlas-route-chapter__references { margin-top: 2.2rem; }
  .atlas-route-chapter__references-heading { display: flex; justify-content: space-between; gap: .8rem; align-items: baseline; margin-bottom: .65rem; }
  .atlas-route-chapter__references-heading span { color: #315545; font-size: .58rem; font-weight: 700; letter-spacing: .14em; }
  .atlas-route-chapter__references-heading small { color: #8a7f70; font-family: 'Caveat', cursive; font-size: 1rem; }
  .atlas-route-chapter__references-list { display: grid; gap: .65rem; }
  .atlas-route-chapter__personal-notes { display: flex; flex-wrap: wrap; gap: 1.1rem; align-items: flex-start; margin-top: 2.25rem; padding: .25rem 0 .8rem; }
  .atlas-route-chapter__post-it { position: relative; width: min(220px, 88%); min-height: 118px; padding: 1rem 1.05rem 1.1rem; box-shadow: 0 8px 14px rgba(71, 59, 39, .11); }
  .atlas-route-chapter__post-it::before { content: ''; position: absolute; top: -7px; left: 50%; width: 52px; height: 16px; transform: translateX(-50%) rotate(.8deg); background: rgba(225, 211, 178, .68); }
  .atlas-route-chapter__post-it--butter { background: #f1dc88; }
  .atlas-route-chapter__post-it--rose { background: #ecc6bc; }
  .atlas-route-chapter__post-it--sage { background: #cddbc5; }
  .atlas-route-chapter__post-it--sky { background: #cbdce0; }
  .atlas-route-chapter__post-it--paper { background: #eadfcf; }
  .atlas-route-chapter__post-it--small { width: min(180px, 80%); min-height: 95px; }
  .atlas-route-chapter__post-it--large { width: min(275px, 96%); min-height: 145px; }
  .atlas-route-chapter__post-it--memory { transform: rotate(-2deg); }
  .atlas-route-chapter__post-it--scribble { transform: rotate(1.8deg); }
  .atlas-route-chapter__post-it--reminder { transform: rotate(-.6deg); }
  .atlas-route-chapter__post-it--list { transform: rotate(1deg); }
  .atlas-route-chapter__post-it > span { display: block; margin-bottom: .45rem; color: #845843; font-size: .55rem; font-weight: 700; letter-spacing: .14em; }
  .atlas-route-chapter__post-it p { margin: 0; color: #4d4437; font-family: 'Caveat', cursive; font-size: 1.25rem; line-height: 1.13; }
  .atlas-route-chapter__post-it--scribble p { font-size: 1.48rem; line-height: 1.02; }
  .atlas-route-chapter__post-it--reminder p { font-family: 'Newsreader', Georgia, serif; font-size: .89rem; line-height: 1.42; }
  .atlas-route-chapter__post-it--large p { font-size: 1.48rem; }
  .atlas-route-chapter__post-it--small p { font-size: 1.08rem; }
  .atlas-route-chapter__post-it ul { display: grid; gap: .18rem; margin: .55rem 0 0; padding: 0; list-style: none; color: #4d4437; font-family: 'Caveat', cursive; font-size: 1.05rem; }
  .atlas-route-chapter__post-it li::before { content: '○ '; }
  .atlas-route-chapter__gallery { position: relative; min-height: clamp(380px, 47vw, 565px); }
  .atlas-route-chapter__media { position: absolute; overflow: visible; margin: 0; border: 7px solid #fffdf8; background: #ece4d5; box-shadow: 0 14px 32px rgba(57, 50, 40, .13); }
  .atlas-route-chapter__media img, .atlas-route-chapter__placeholder { width: 100%; height: 100%; }
  .atlas-route-chapter__media img { display: block; object-fit: cover; }
  .atlas-route-chapter__media figcaption { position: absolute; right: .35rem; bottom: .3rem; max-width: 78%; padding: .18rem .35rem; background: rgba(255, 253, 248, .84); color: #746b5e; font-family: 'Caveat', cursive; font-size: .88rem; line-height: 1; }
  .atlas-route-chapter__gallery--1 .atlas-route-chapter__media--slot-1 { inset: 0; transform: rotate(-.7deg); }
  .atlas-route-chapter__gallery--2 .atlas-route-chapter__media--slot-1 { top: 0; left: 0; width: 66%; height: 78%; transform: rotate(-1.2deg); }
  .atlas-route-chapter__gallery--2 .atlas-route-chapter__media--slot-2 { right: 0; bottom: 0; width: 50%; height: 58%; transform: rotate(1.8deg); }
  .atlas-route-chapter__gallery--3 .atlas-route-chapter__media--slot-1 { top: 2%; left: 0; width: 62%; height: 68%; transform: rotate(-1.4deg); }
  .atlas-route-chapter__gallery--3 .atlas-route-chapter__media--slot-2 { top: 0; right: 0; width: 36%; height: 49%; transform: rotate(1.6deg); }
  .atlas-route-chapter__gallery--3 .atlas-route-chapter__media--slot-3 { right: 8%; bottom: 0; width: 51%; height: 46%; transform: rotate(-.6deg); }
  .atlas-route-chapter__placeholder { display: grid; place-content: center; gap: .35rem; padding: 1rem; background: #eee6d7; color: #81786d; text-align: center; }
  .atlas-route-chapter__placeholder span { font-size: .65rem; font-weight: 700; letter-spacing: .2em; }
  .atlas-route-chapter__placeholder small { font-family: 'Caveat', cursive; font-size: 1.05rem; }
  .atlas-route-chapter__gallery-notes { position: absolute; z-index: 5; inset: 0; pointer-events: none; }
  .atlas-route-chapter__post-it--gallery { position: absolute; width: min(210px, 31%); min-height: 108px; padding: .9rem .95rem 1rem; }
  .atlas-route-chapter__post-it--gallery-top-right-gap { top: 6%; right: 0; left: auto; }
  .atlas-route-chapter__post-it--gallery-image-1-overlap { top: 62%; left: 3%; right: auto; }
  .atlas-route-chapter__post-it--gallery-bottom-left-gap { left: 2%; bottom: 1%; width: min(220px, 35%); }
  .atlas-route-chapter__transfer { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: .4rem 1.5rem; width: min(100%, 840px); margin-top: clamp(3rem, 6vw, 5rem); padding: 1.25rem 1.2rem; border: 1px solid rgba(114, 99, 76, .15); background: rgba(235, 225, 204, .48); box-shadow: 5px 6px 0 rgba(49, 85, 69, .045); transform: rotate(-.18deg); }
  .atlas-route-chapter__transfer > span { grid-row: 1 / span 2; color: #b76645; font-size: .62rem; font-weight: 700; letter-spacing: .16em; }
  .atlas-route-chapter__transfer strong { color: #315545; font-family: 'Newsreader', Georgia, serif; font-size: 1.2rem; font-weight: 600; }
  .atlas-route-chapter__transfer p { margin: 0; color: #71695f; font-size: .82rem; line-height: 1.5; }
  .atlas-route-chapter--feature { padding: clamp(2rem, 5vw, 4rem); margin-inline: clamp(-2rem, -3vw, -.5rem); border: 1px solid rgba(112, 96, 74, .13); background: rgba(240, 233, 218, .47); }
  .atlas-route-chapter--epilogue .atlas-route-chapter__heading h2 { font-style: italic; }
  @media (max-width: 780px) {
    .atlas-route-chapter__heading, .atlas-route-chapter__layout { grid-template-columns: 1fr; }
    .atlas-route-chapter__heading > div { align-items: end; }
    .atlas-route-chapter__gallery { min-height: 560px; margin-top: 1rem; }
    .atlas-route-chapter__post-it--gallery { width: min(190px, 38%); }
    .atlas-route-chapter__references-heading { align-items: flex-start; flex-direction: column; }
  }
  @media (max-width: 560px) {
    .atlas-route-chapter { margin-bottom: 6rem; }
    .atlas-route-chapter__heading > div { display: grid; gap: .35rem; }
    .atlas-route-chapter__heading h2 { font-size: clamp(2.8rem, 15vw, 4.4rem); }
    .atlas-route-chapter__gallery { min-height: 475px; }
    .atlas-route-chapter__gallery--3 .atlas-route-chapter__media--slot-1 { width: 69%; height: 59%; }
    .atlas-route-chapter__gallery--3 .atlas-route-chapter__media--slot-2 { width: 38%; height: 40%; }
    .atlas-route-chapter__gallery--3 .atlas-route-chapter__media--slot-3 { right: 2%; width: 61%; height: 42%; }
    .atlas-route-chapter__post-it--gallery { width: min(160px, 43%); min-height: 92px; }
    .atlas-route-chapter__post-it--gallery p { font-size: 1rem; }
    .atlas-route-chapter__transfer { grid-template-columns: 1fr; }
    .atlas-route-chapter__transfer > span { grid-row: auto; }
    .atlas-route-chapter--feature { margin-inline: -.6rem; padding: 1.2rem .8rem 2rem; }
  }
</style>
