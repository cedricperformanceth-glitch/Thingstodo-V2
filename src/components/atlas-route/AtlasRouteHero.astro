---
import type { AtlasRouteContent, AtlasRouteMedia } from '../../content/atlas-route-content';

interface Props {
  route: AtlasRouteContent;
}

const { route } = Astro.props;

const aspectClass = (media: AtlasRouteMedia) =>
  `atlas-route-hero__media--${media.aspect ?? 'landscape'}`;
---

<header class="atlas-route-hero">
  <div class="atlas-route-hero__copy">
    <p class="atlas-route-hero__eyebrow">{route.eyebrow}</p>
    <h1>{route.title}</h1>
    <p class="atlas-route-hero__subtitle">{route.subtitle}</p>

    <div class="atlas-route-hero__meta" aria-label="Route summary">
      <span>{route.durationLabel}</span>
      <span aria-hidden="true">·</span>
      <span>{route.directionLabel}</span>
    </div>

    <div class="atlas-route-hero__intro">
      {route.intro.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>

  <div class="atlas-route-hero__collage" aria-label="Route photo placeholders">
    {route.heroMedia.slice(0, 4).map((media, index) => (
      <figure class:list={['atlas-route-hero__media', aspectClass(media), `atlas-route-hero__media--slot-${index + 1}`]}>
        {media.src ? (
          <img src={media.src} alt={media.alt} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
        ) : (
          <div class="atlas-route-hero__placeholder" role="img" aria-label={media.alt}>
            <span>PHOTO</span>
            <small>{media.label ?? `Hero image ${index + 1}`}</small>
          </div>
        )}
      </figure>
    ))}
  </div>
</header>

<style>
  .atlas-route-hero {
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
    min-height: 78vh;
    padding: clamp(6.5rem, 10vw, 9rem) 0 clamp(4rem, 8vw, 7rem);
  }

  .atlas-route-hero__eyebrow {
    margin: 0 0 .75rem;
    color: #b76645;
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .18em;
  }

  h1 {
    margin: 0;
    color: #315545;
    font-family: 'Newsreader', Georgia, serif;
    font-size: clamp(3.5rem, 8vw, 7.6rem);
    font-weight: 500;
    letter-spacing: -.045em;
  }

  .atlas-route-hero__subtitle {
    max-width: 34rem;
    margin: 1rem 0 0;
    color: #5f5a51;
    font-family: 'Newsreader', Georgia, serif;
    font-size: clamp(1.25rem, 2.3vw, 1.7rem);
    line-height: 1.35;
  }

  .atlas-route-hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: .65rem;
    margin-top: 1.5rem;
    color: #315545;
    font-size: .8rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .atlas-route-hero__intro {
    max-width: 39rem;
    margin-top: 2rem;
    color: #555048;
    font-family: 'Newsreader', Georgia, serif;
    font-size: 1.03rem;
  }

  .atlas-route-hero__intro p {
    margin: 0 0 .8rem;
  }

  .atlas-route-hero__collage {
    position: relative;
    min-height: min(670px, 62vw);
  }

  .atlas-route-hero__media {
    position: absolute;
    overflow: hidden;
    margin: 0;
    border: 1px solid rgba(75, 67, 54, .17);
    background: #eee6d7;
    box-shadow: 0 18px 45px rgba(54, 48, 39, .11);
  }

  .atlas-route-hero__media--slot-1 {
    top: 5%;
    left: 3%;
    width: 42%;
    height: 65%;
    transform: rotate(-2.2deg);
  }

  .atlas-route-hero__media--slot-2 {
    top: 0;
    right: 2%;
    width: 51%;
    height: 39%;
    transform: rotate(1.6deg);
  }

  .atlas-route-hero__media--slot-3 {
    right: 6%;
    bottom: 5%;
    width: 44%;
    height: 49%;
    transform: rotate(-1.1deg);
  }

  .atlas-route-hero__media--slot-4 {
    bottom: 1%;
    left: 14%;
    width: 31%;
    height: 26%;
    transform: rotate(2.4deg);
  }

  .atlas-route-hero__media img,
  .atlas-route-hero__placeholder {
    width: 100%;
    height: 100%;
  }

  .atlas-route-hero__media img {
    display: block;
    object-fit: cover;
  }

  .atlas-route-hero__placeholder {
    display: grid;
    place-content: center;
    gap: .35rem;
    padding: 1rem;
    background:
      linear-gradient(135deg, rgba(49, 85, 69, .035), rgba(183, 102, 69, .045)),
      repeating-linear-gradient(0deg, transparent 0 23px, rgba(84, 74, 58, .035) 24px);
    color: #7c7468;
    text-align: center;
  }

  .atlas-route-hero__placeholder span {
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .2em;
  }

  .atlas-route-hero__placeholder small {
    font-family: 'Caveat', cursive;
    font-size: 1.05rem;
  }

  @media (max-width: 820px) {
    .atlas-route-hero {
      grid-template-columns: 1fr;
      min-height: 0;
      padding-top: 7rem;
    }

    .atlas-route-hero__collage {
      min-height: min(650px, 105vw);
    }
  }

  @media (max-width: 520px) {
    .atlas-route-hero__collage {
      min-height: 118vw;
    }

    .atlas-route-hero__media--slot-1 {
      left: 0;
      width: 46%;
    }

    .atlas-route-hero__media--slot-2 {
      right: 0;
      width: 52%;
    }

    .atlas-route-hero__media--slot-3 {
      right: 0;
      width: 49%;
    }

    .atlas-route-hero__media--slot-4 {
      left: 8%;
      width: 36%;
    }
  }
</style>
