---
import type { AtlasRouteContent } from '../../content/atlas-route-content';

interface Props {
  route: AtlasRouteContent;
}

const { route } = Astro.props;
---

<nav class="route-overview" aria-label="Route at a glance">
  <div class="route-overview__heading">
    <p>ROUTE AT A GLANCE</p>
    <h2>{route.durationLabel}</h2>
    <span>{route.stops.length} stops · {route.directionLabel}</span>
  </div>

  <ol class="route-overview__stops">
    {route.stops.map((stop, index) => (
      <li>
        <a href={`#${stop.chapterId}`}>
          <span class="route-overview__number">{String(index + 1).padStart(2, '0')}</span>
          <span class="route-overview__stop-copy">
            <strong>{stop.label}</strong>
            {stop.durationLabel && <small>{stop.durationLabel}</small>}
          </span>
        </a>
      </li>
    ))}
  </ol>
</nav>

<style>
  .route-overview {
    display: grid;
    grid-template-columns: minmax(220px, .7fr) minmax(0, 1.3fr);
    gap: clamp(2rem, 6vw, 5rem);
    margin: 0 0 clamp(5rem, 10vw, 9rem);
    padding: clamp(2rem, 4vw, 3.2rem);
    border: 1px solid #d8cfbf;
    background:
      linear-gradient(rgba(255, 253, 248, .92), rgba(255, 253, 248, .92)),
      repeating-linear-gradient(0deg, transparent 0 27px, rgba(84, 74, 58, .06) 28px);
    box-shadow: 0 14px 36px rgba(57, 50, 40, .06);
  }

  .route-overview__heading p {
    margin: 0 0 .55rem;
    color: #b76645;
    font-size: .67rem;
    font-weight: 700;
    letter-spacing: .17em;
  }

  .route-overview__heading h2 {
    margin: 0;
    color: #315545;
    font-family: 'Newsreader', Georgia, serif;
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 500;
  }

  .route-overview__heading span {
    display: block;
    margin-top: .7rem;
    color: #696259;
    font-size: .8rem;
    text-transform: uppercase;
    letter-spacing: .08em;
  }

  .route-overview__stops {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .route-overview__stops li {
    border-bottom: 1px solid rgba(93, 84, 70, .16);
  }

  .route-overview__stops a {
    display: flex;
    gap: .9rem;
    align-items: center;
    padding: .85rem .2rem;
    color: inherit;
    text-decoration: none;
  }

  .route-overview__stops a:hover strong {
    color: #b76645;
  }

  .route-overview__number {
    color: #a19687;
    font-family: 'Caveat', cursive;
    font-size: 1.15rem;
  }

  .route-overview__stop-copy {
    display: flex;
    flex: 1;
    justify-content: space-between;
    gap: .75rem;
    align-items: baseline;
  }

  .route-overview__stop-copy strong {
    color: #315545;
    font-family: 'Newsreader', Georgia, serif;
    font-size: 1.05rem;
    font-weight: 600;
    transition: color .18s ease;
  }

  .route-overview__stop-copy small {
    color: #7b7469;
    font-size: .72rem;
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    .route-overview {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .route-overview {
      margin-inline: -.3rem;
      padding: 1.35rem;
    }

    .route-overview__stops {
      grid-template-columns: 1fr;
    }
  }
</style>
