---
import type { AtlasRouteMedia, AtlasRouteNotebook } from '../../content/atlas-route-content';

interface Props {
  notebook: AtlasRouteNotebook;
}

const { notebook } = Astro.props;
const panelId = `field-notebook-${notebook.id}`;

const aspectClass = (media: AtlasRouteMedia) =>
  `field-notebook__media--${media.aspect ?? 'landscape'}`;
---

<section class="field-notebook" data-field-notebook>
  <button
    class="field-notebook__open"
    type="button"
    aria-expanded="false"
    aria-controls={panelId}
    data-notebook-open
  >
    <span class="field-notebook__open-kicker">{notebook.label ?? 'FIELD NOTES'}</span>
    <span class="field-notebook__open-title">{notebook.title}</span>
    <span class="field-notebook__open-action">Open notebook <span aria-hidden="true">↗</span></span>
  </button>

  <div class="field-notebook__panel" id={panelId} data-notebook-panel hidden>
    <div class="field-notebook__toolbar">
      <div>
        <span>{notebook.label ?? 'FIELD NOTES'}</span>
        <strong>{notebook.title}</strong>
      </div>
      <button type="button" data-notebook-close aria-label={`Close ${notebook.title}`}>Close ×</button>
    </div>

    {notebook.intro && <p class="field-notebook__intro">{notebook.intro}</p>}

    <div class="field-notebook__book" data-notebook-book>
      <div class="field-notebook__binding" aria-hidden="true"></div>

      {notebook.pages.map((page, pageIndex) => (
        <article
          class="field-notebook__page"
          data-notebook-page
          data-page-index={pageIndex}
          hidden={pageIndex !== 0}
        >
          <div class="field-notebook__page-copy">
            {page.kicker && <p class="field-notebook__kicker">{page.kicker}</p>}
            <h3>{page.title}</h3>
            {page.copy && <p class="field-notebook__copy">{page.copy}</p>}
            {page.handwrittenNote && (
              <p class="field-notebook__handwritten">{page.handwrittenNote}</p>
            )}
          </div>

          {page.media && page.media.length > 0 && (
            <div class="field-notebook__media-grid">
              {page.media.map((media) => (
                <figure class:list={['field-notebook__media', aspectClass(media)]}>
                  {media.src ? (
                    <img
                      data-notebook-media
                      data-src={media.src}
                      alt={media.alt}
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <div class="field-notebook__placeholder" role="img" aria-label={media.alt}>
                      <span>PHOTO</span>
                      <small>{media.label ?? 'Notebook image'}</small>
                    </div>
                  )}
                </figure>
              ))}
            </div>
          )}

          <span class="field-notebook__folio" aria-hidden="true">{pageIndex + 1}</span>
        </article>
      ))}
    </div>

    <div class="field-notebook__controls">
      <button type="button" data-notebook-prev>← Previous</button>
      <span data-notebook-status aria-live="polite">1 / {notebook.pages.length}</span>
      <button type="button" data-notebook-next>Next →</button>
    </div>
  </div>
</section>

<script>
  const hydratePageMedia = (pages: HTMLElement[], index: number) => {
    const page = pages[index];
    if (!page) return;

    page.querySelectorAll<HTMLImageElement>('img[data-notebook-media][data-src]').forEach((image) => {
      if (image.src) return;
      const src = image.dataset.src;
      if (src) image.src = src;
    });
  };

  document.querySelectorAll<HTMLElement>('[data-field-notebook]').forEach((notebook) => {
    if (notebook.dataset.ready === 'true') return;
    notebook.dataset.ready = 'true';

    const openButton = notebook.querySelector<HTMLButtonElement>('[data-notebook-open]');
    const closeButton = notebook.querySelector<HTMLButtonElement>('[data-notebook-close]');
    const panel = notebook.querySelector<HTMLElement>('[data-notebook-panel]');
    const pages = Array.from(notebook.querySelectorAll<HTMLElement>('[data-notebook-page]'));
    const previous = notebook.querySelector<HTMLButtonElement>('[data-notebook-prev]');
    const next = notebook.querySelector<HTMLButtonElement>('[data-notebook-next]');
    const status = notebook.querySelector<HTMLElement>('[data-notebook-status]');

    if (!openButton || !closeButton || !panel || pages.length === 0 || !previous || !next || !status) return;

    let currentIndex = 0;
    let animating = false;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const updateControls = () => {
      previous.disabled = currentIndex === 0;
      next.disabled = currentIndex === pages.length - 1;
      status.textContent = `${currentIndex + 1} / ${pages.length}`;
    };

    const openNotebook = () => {
      panel.hidden = false;
      openButton.setAttribute('aria-expanded', 'true');
      hydratePageMedia(pages, currentIndex);
      hydratePageMedia(pages, currentIndex + 1);
      updateControls();
      panel.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'nearest' });
    };

    const closeNotebook = () => {
      panel.hidden = true;
      openButton.setAttribute('aria-expanded', 'false');
      openButton.focus();
    };

    const goTo = async (targetIndex: number) => {
      if (animating || targetIndex < 0 || targetIndex >= pages.length || targetIndex === currentIndex) return;
      animating = true;

      const direction = targetIndex > currentIndex ? 1 : -1;
      const currentPage = pages[currentIndex];
      const targetPage = pages[targetIndex];

      hydratePageMedia(pages, targetIndex);
      if (direction > 0) hydratePageMedia(pages, targetIndex + 1);

      if (!reduceMotion) {
        await currentPage.animate(
          [
            { transform: 'perspective(1400px) rotateY(0deg)', opacity: 1 },
            { transform: `perspective(1400px) rotateY(${direction > 0 ? -82 : 82}deg)`, opacity: .2 },
          ],
          { duration: 260, easing: 'cubic-bezier(.4,0,.2,1)', fill: 'forwards' },
        ).finished;
      }

      currentPage.hidden = true;
      currentPage.getAnimations().forEach((animation) => animation.cancel());
      targetPage.hidden = false;

      if (!reduceMotion) {
        await targetPage.animate(
          [
            { transform: `perspective(1400px) rotateY(${direction > 0 ? 82 : -82}deg)`, opacity: .25 },
            { transform: 'perspective(1400px) rotateY(0deg)', opacity: 1 },
          ],
          { duration: 280, easing: 'cubic-bezier(.2,.7,.2,1)' },
        ).finished;
      }

      currentIndex = targetIndex;
      updateControls();
      animating = false;
    };

    openButton.addEventListener('click', openNotebook);
    closeButton.addEventListener('click', closeNotebook);
    previous.addEventListener('click', () => void goTo(currentIndex - 1));
    next.addEventListener('click', () => void goTo(currentIndex + 1));
    updateControls();
  });
</script>

<style>
  .field-notebook {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .field-notebook__open {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1rem 1.4rem;
    align-items: center;
    width: min(100%, 860px);
    min-height: 92px;
    padding: 1.1rem 1.25rem;
    border: 1px solid #cfc3ae;
    background:
      linear-gradient(90deg, rgba(183, 102, 69, .08), transparent 20%),
      #fffdf8;
    color: #302c26;
    text-align: left;
    cursor: pointer;
    box-shadow: 0 12px 28px rgba(57, 50, 40, .08);
  }

  .field-notebook__open:hover {
    border-color: #a9876e;
    transform: translateY(-1px);
  }

  .field-notebook__open-kicker {
    color: #b76645;
    font-size: .64rem;
    font-weight: 700;
    letter-spacing: .16em;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  .field-notebook__open-title {
    color: #315545;
    font-family: 'Newsreader', Georgia, serif;
    font-size: clamp(1.45rem, 3vw, 2rem);
  }

  .field-notebook__open-action {
    color: #6b6257;
    font-family: 'Caveat', cursive;
    font-size: 1.12rem;
    white-space: nowrap;
  }

  .field-notebook__panel {
    width: min(100%, 920px);
    margin-top: 1.2rem;
    padding: clamp(1rem, 3vw, 1.75rem);
    border: 1px solid #cfc3ae;
    background: #e9dfcc;
    box-shadow: 0 22px 55px rgba(49, 43, 34, .15);
  }

  .field-notebook__toolbar {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    align-items: start;
    padding: .25rem .25rem 1rem;
  }

  .field-notebook__toolbar > div {
    display: grid;
    gap: .15rem;
  }

  .field-notebook__toolbar span {
    color: #b76645;
    font-size: .62rem;
    font-weight: 700;
    letter-spacing: .16em;
  }

  .field-notebook__toolbar strong {
    color: #315545;
    font-family: 'Newsreader', Georgia, serif;
    font-size: 1.25rem;
    font-weight: 600;
  }

  .field-notebook__toolbar button,
  .field-notebook__controls button {
    min-height: 42px;
    border: 0;
    background: transparent;
    color: #4e473e;
    font: inherit;
    cursor: pointer;
  }

  .field-notebook__toolbar button {
    font-size: .78rem;
  }

  .field-notebook__intro {
    max-width: 670px;
    margin: 0 .25rem 1.2rem;
    color: #655d53;
    font-family: 'Newsreader', Georgia, serif;
  }

  .field-notebook__book {
    position: relative;
    min-height: 460px;
    perspective: 1400px;
  }

  .field-notebook__binding {
    position: absolute;
    z-index: 3;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 28px;
    transform: translateX(-50%);
    pointer-events: none;
    background: linear-gradient(90deg, transparent, rgba(75, 61, 45, .12), transparent);
  }

  .field-notebook__page {
    position: relative;
    min-height: 460px;
    padding: clamp(1.6rem, 4vw, 3.4rem);
    overflow: hidden;
    border: 1px solid rgba(108, 92, 70, .2);
    background:
      linear-gradient(90deg, rgba(118, 96, 66, .035), transparent 8%, transparent 92%, rgba(118, 96, 66, .035)),
      repeating-linear-gradient(0deg, transparent 0 30px, rgba(83, 72, 57, .045) 31px),
      #fffdf8;
    box-shadow: inset 0 0 35px rgba(78, 64, 47, .04);
    transform-origin: left center;
  }

  .field-notebook__page-copy {
    width: min(48%, 390px);
  }

  .field-notebook__kicker {
    margin: 0 0 .45rem;
    color: #b76645;
    font-size: .62rem;
    font-weight: 700;
    letter-spacing: .16em;
  }

  .field-notebook__page h3 {
    margin: 0;
    color: #315545;
    font-family: 'Newsreader', Georgia, serif;
    font-size: clamp(2rem, 4vw, 3.3rem);
    font-weight: 500;
  }

  .field-notebook__copy {
    margin: 1.2rem 0 0;
    color: #514b43;
    font-family: 'Newsreader', Georgia, serif;
    font-size: 1rem;
  }

  .field-notebook__handwritten {
    width: min(100%, 310px);
    margin: 2rem 0 0;
    padding: 1rem 1.15rem;
    transform: rotate(-1.7deg);
    background: #f4df91;
    color: #504331;
    font-family: 'Caveat', cursive;
    font-size: 1.35rem;
    line-height: 1.18;
    box-shadow: 0 7px 12px rgba(81, 68, 47, .09);
  }

  .field-notebook__media-grid {
    position: absolute;
    top: 9%;
    right: 6%;
    bottom: 9%;
    width: 40%;
  }

  .field-notebook__media {
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
    border: 8px solid #f8f4e9;
    background: #e8dfcf;
    box-shadow: 0 12px 24px rgba(59, 49, 38, .15);
    transform: rotate(1.4deg);
  }

  .field-notebook__media img,
  .field-notebook__placeholder {
    width: 100%;
    height: 100%;
  }

  .field-notebook__media img {
    display: block;
    object-fit: cover;
  }

  .field-notebook__placeholder {
    display: grid;
    place-content: center;
    gap: .3rem;
    padding: 1rem;
    background:
      linear-gradient(135deg, rgba(49, 85, 69, .035), rgba(183, 102, 69, .05)),
      #eee6d7;
    color: #81786d;
    text-align: center;
  }

  .field-notebook__placeholder span {
    font-size: .64rem;
    font-weight: 700;
    letter-spacing: .19em;
  }

  .field-notebook__placeholder small {
    font-family: 'Caveat', cursive;
    font-size: 1.05rem;
  }

  .field-notebook__folio {
    position: absolute;
    right: 1.4rem;
    bottom: .9rem;
    color: #9e9589;
    font-family: 'Newsreader', Georgia, serif;
    font-size: .75rem;
  }

  .field-notebook__controls {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding-top: .75rem;
  }

  .field-notebook__controls button:first-child {
    justify-self: start;
  }

  .field-notebook__controls button:last-child {
    justify-self: end;
  }

  .field-notebook__controls button:disabled {
    opacity: .35;
    cursor: default;
  }

  .field-notebook__controls span {
    color: #62594f;
    font-size: .76rem;
    font-weight: 700;
    letter-spacing: .08em;
  }

  @media (max-width: 680px) {
    .field-notebook__open {
      grid-template-columns: auto 1fr;
    }

    .field-notebook__open-action {
      grid-column: 2;
    }

    .field-notebook__book,
    .field-notebook__page {
      min-height: 650px;
    }

    .field-notebook__binding {
      display: none;
    }

    .field-notebook__page-copy {
      width: 100%;
    }

    .field-notebook__media-grid {
      position: absolute;
      top: auto;
      right: 1.5rem;
      bottom: 2.4rem;
      left: 1.5rem;
      width: auto;
      height: 250px;
    }

    .field-notebook__handwritten {
      position: relative;
      z-index: 2;
      margin-top: 1.3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .field-notebook__open {
      transition: none;
    }
  }
</style>
