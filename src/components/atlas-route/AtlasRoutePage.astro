---
import type { AtlasRouteContent } from '../../content/atlas-route-content';
import FinalCta from '../final-cta/FinalCta.astro';
import AtlasRouteHero from './AtlasRouteHero.astro';
import RouteOverview from './RouteOverview.astro';
import AtlasRouteChapter from './AtlasRouteChapter.astro';

interface Props {
  route: AtlasRouteContent;
}

const { route } = Astro.props;
---

<div class="atlas-route-page" data-atlas-route-page>
  <AtlasRouteHero {route} />
  <RouteOverview {route} />

  <div class="atlas-route-page__journey">
    {route.chapters.map((chapter) => <AtlasRouteChapter {chapter} />)}
  </div>

  <FinalCta country={route.country} />
  <div class="atlas-route-page__footer-transition" aria-hidden="true"></div>
</div>

<style>
  .atlas-route-page {
    padding-bottom: 0;
  }

  .atlas-route-page :global(.final-cta__transition) {
    background: linear-gradient(
      180deg,
      #fbf7ed 0%,
      #f6f0e4 42%,
      #f3ede0 100%
    );
  }

  .atlas-route-page__footer-transition {
    width: 100vw;
    height: clamp(2.5rem, 5vw, 4.5rem);
    margin-left: calc(50% - 50vw);
    background: linear-gradient(
      180deg,
      #f3ede0 0%,
      rgba(243, 237, 224, .72) 18%,
      rgba(49, 85, 69, .54) 48%,
      #315545 80%,
      #315545 100%
    );
  }

  @media (max-width: 640px) {
    .atlas-route-page__footer-transition {
      height: 2.75rem;
    }
  }
</style>
