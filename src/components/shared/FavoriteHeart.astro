---
import type { AtlasEntity } from '../../core/models/types';
import { favoriteSnapshot } from '../../features/favorites/store';
interface Props { entity: AtlasEntity; }
const { entity } = Astro.props;
const snapshot = favoriteSnapshot(entity);
---
<button class="favorite-heart" type="button" data-favorite data-entity-key={`${snapshot.country}:${snapshot.city}:${snapshot.id}`} data-entity-name={snapshot.name} data-entity={JSON.stringify(snapshot)} aria-label={`Add ${snapshot.name} to My Favorites`} aria-pressed="false"><span aria-hidden="true">♡</span></button>
