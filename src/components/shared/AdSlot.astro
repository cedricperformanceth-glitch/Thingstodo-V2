---
import type { AdSlot } from '../../core/ads/slots';
import { activityAdSlots, cityFieldNoteAdSlots, ADSTERRA_BANNERS_PAUSED } from '../../core/ads/slots';

interface Props { slot: AdSlot; visible?: boolean; }
const { slot, visible = false } = Astro.props;

// One banner per eligible editorial page: long activity, short activity,
// or City Field Note. All other reserved slots stay inert.
const primaryAdSlots: string[] = [
  activityAdSlots.afterChapterOne,
  activityAdSlots.beforeFaq,
  cityFieldNoteAdSlots.afterChapterTwo,
];
const primary = visible && !ADSTERRA_BANNERS_PAUSED && primaryAdSlots.includes(slot);

// The provider writes its creative into the document while parsing. Keep all
// provider JavaScript inside a separate sandboxed iframe document. Never run
// document.write in the Atlas page or expose the surrounding page to ad clicks.
const adFrameDocument = `<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=300, initial-scale=1">
  <style>html,body{width:300px;height:250px;margin:0;padding:0;overflow:hidden;background:transparent}</style>
</head>
<body>
  <script>
    window.atOptions = {
      key: '8ae25b964fbb4d4378a45891366f2143',
      format: 'iframe',
      height: 250,
      width: 300,
      params: {}
    };
  </script>
  <script src="https://bauval.org/22/8ae25b964fbb4d4378a45891366f2143"></script>
</body>
</html>`;
---

{/* Keep the complete slot architecture without visible placeholders. */}
{visible && <template data-atlas-ad-slot={slot}></template>}

{primary && (
  <div class="atlas-ad-placement" data-atlas-ad-primary={slot} hidden>
    <iframe
      data-atlas-ad-frame
      data-srcdoc={adFrameDocument}
      title="Advertisement"
      width="300"
      height="250"
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"
      sandbox="allow-scripts allow-popups allow-popups-to-escape-sandbox"
    ></iframe>
    <script is:inline>
      (() => {
        if (document.documentElement.dataset.atlasAdsEligible !== 'true') return;

        // The frame remains about:blank and cannot request the advertising
        // provider unless the visitor has accepted advertising.
        let allowed = false;
        try {
          const value = JSON.parse(localStorage.getItem('atlas.optionalAdvertisingConsent.v2') || 'null');
          const age = Date.now() - value?.at;
          allowed = value?.choice === 'accepted' &&
            typeof value.at === 'number' &&
            age >= 0 && age <= 180 * 24 * 60 * 60 * 1000;
        } catch { /* No consent means no ad request. */ }
        if (!allowed) return;

        const container = document.currentScript?.parentElement;
        const frame = container?.querySelector('iframe[data-atlas-ad-frame]');
        const frameDocument = frame?.getAttribute('data-srcdoc');
        if (!frameDocument) return;

        // srcdoc is assigned only after opt-in. With no allow-same-origin or
        // allow-top-navigation, ad scripts cannot control the Atlas document.
        frame.srcdoc = frameDocument;
        frame.removeAttribute('data-srcdoc');
        container.hidden = false;
      })();
    </script>
  </div>
)}

<style>
  :global(.atlas-ad-placement[hidden]) { display: none !important; }
  :global(.atlas-ad-placement:not([hidden])) {
    display: block;
    width: 300px;
    max-width: 100%;
    height: 250px;
    margin: clamp(24px, 4vw, 44px) auto;
    overflow: hidden;
    contain: layout paint;
    isolation: isolate;
    text-align: center;
  }
  :global(.atlas-ad-placement iframe) {
    display: block;
    width: 300px;
    max-width: 100%;
    height: 250px;
    border: 0;
  }
</style>
