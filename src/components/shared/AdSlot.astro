---
import type { AdSlot } from '../../core/ads/slots';
import { activityAdSlots, cityFieldNoteAdSlots, ADSTERRA_BANNERS_PAUSED } from '../../core/ads/slots';

interface Props { slot: AdSlot; visible?: boolean; }
const { slot, visible = false } = Astro.props;

// One 300x250 placement per eligible editorial page.
// All other reserved ad slots remain inert.
const primaryAdSlots: string[] = [
  activityAdSlots.afterChapterOne,
  activityAdSlots.beforeFaq,
  cityFieldNoteAdSlots.afterChapterTwo,
];
const primary = visible && !ADSTERRA_BANNERS_PAUSED && primaryAdSlots.includes(slot);
---

{/* Keep the reserved slot architecture without empty public placeholders. */}
{visible && <template data-atlas-ad-slot={slot}></template>}

{primary && (
  <div class="atlas-ad-placement" data-atlas-ad-primary={slot}>
    <iframe
      data-atlas-ad-frame
      src="/adsterra/300x250/"
      title="Advertisement"
      width="300"
      height="250"
      loading="eager"
      referrerpolicy="strict-origin-when-cross-origin"
      sandbox="allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox"
    ></iframe>
  </div>
)}

<style>
  :global(.atlas-ad-placement) {
    display: block;
    width: 300px;
    max-width: 100%;
    height: 250px;
    margin: clamp(24px, 4vw, 44px) auto;
    overflow: hidden;
    contain: layout paint;
    isolation: isolate;
    text-align: center;
  }
  :global(.atlas-ad-placement iframe) {
    display: block;
    width: 300px;
    max-width: 100%;
    height: 250px;
    border: 0;
  }
</style>
