---
interface Props { adsEligible?: boolean; }
const { adsEligible = false } = Astro.props;
---
<div class="atlas-consent" data-atlas-consent data-atlas-ads-eligible={adsEligible ? 'true' : 'false'}>
  <button class="atlas-consent__settings" type="button" data-consent-settings
    aria-label="Cookie settings" title="Cookie settings" hidden>
    <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor"
      stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M20.5 12.3A8.6 8.6 0 1 1 11.7 3.5a3 3 0 0 0 3.7 3.7 3 3 0 0 0 3.7 3.7c0 .5.4 1.1 1.4 1.4Z" />
      <circle cx="8.6" cy="8.9" r=".65" fill="currentColor" stroke="none" />
      <circle cx="13" cy="15.7" r=".85" fill="currentColor" stroke="none" />
      <circle cx="8.3" cy="16.2" r=".65" fill="currentColor" stroke="none" />
    </svg>
    <span class="atlas-consent__settings-label" aria-hidden="true">Cookies</span>
  </button>
  <aside class="atlas-consent__notice" data-consent-notice aria-label="Optional cookies and privacy choices" hidden>
    <div class="atlas-consent__explanation">
      <strong>Privacy and cookies</strong>
      <p>Atlas saves your travel selections locally. Analytics and advertising are optional and stay off unless you consent. Choose each service independently.</p>
      <div class="atlas-consent__options" role="group" aria-label="Optional services">
        <label><input type="checkbox" data-consent-analytics /> Audience measurement (Google Analytics)</label>
        <label><input type="checkbox" data-consent-ads /> Advertising technology (Infolinks)</label>
      </div>
      <p class="atlas-consent__links"><a href="/legal/cookie-policy">Cookie Policy</a><a href="/legal/privacy-policy">Privacy Policy</a></p>
    </div>
    <div class="atlas-consent__actions">
      <button type="button" data-consent-reject>Reject optional</button>
      <button type="button" data-consent-save>Save choices</button>
      <button type="button" data-consent-accept>Accept all</button>
    </div>
  </aside>
</div>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-atlas-consent]');
    if (!root || root.dataset.consentReady === 'true') return;
    root.dataset.consentReady = 'true';

    const notice = root.querySelector('[data-consent-notice]');
    const settings = root.querySelector('[data-consent-settings]');
    const accept = root.querySelector('[data-consent-accept]');
    const reject = root.querySelector('[data-consent-reject]');
    const saveButton = root.querySelector('[data-consent-save]');
    const adsInput = root.querySelector('[data-consent-ads]');
    const analyticsInput = root.querySelector('[data-consent-analytics]');
    if (!notice || !settings || !accept || !reject || !saveButton || !adsInput || !analyticsInput) return;

    // Preserve existing advertising preferences. Analytics has its own consent
    // key, so previous advertising consent never authorizes GA4 retroactively.
    const adsKey = 'atlas.optionalAdvertisingConsent.v1';
    const analyticsKey = 'atlas.optionalAnalyticsConsent.v1';
    const maxAgeMs = 180 * 24 * 60 * 60 * 1000;
    let adsLoaded = false;
    let analyticsLoaded = false;

    const read = key => {
      try {
        const value = JSON.parse(localStorage.getItem(key) || 'null');
        const age = Date.now() - value?.at;
        return (value?.choice === 'accepted' || value?.choice === 'rejected') &&
          typeof value.at === 'number' && age >= 0 && age <= maxAgeMs ? value.choice : null;
      } catch { return null; }
    };
    const write = (key, choice) => {
      try { localStorage.setItem(key, JSON.stringify({ choice, at: Date.now() })); }
      catch { /* Respect the current page choice even without persistent storage. */ }
    };
    const loadAds = () => {
      // Only approved editorial pages with registered ad slots load Infolinks.
      if (root.dataset.atlasAdsEligible !== 'true') return;
      if (!document.querySelector('template[data-atlas-ad-slot]')) return;
      if (adsLoaded || document.querySelector('script[data-atlas-infolinks]')) return;
      adsLoaded = true;
      window.infolinks_pid = 3448891;
      window.infolinks_wsid = 0;
      const script = document.createElement('script');
      script.src = 'https://resources.infolinks.com/js/infolinks_main.js';
      script.dataset.atlasInfolinks = 'true';
      document.body.appendChild(script);
    };
    const loadAnalytics = () => {
      // Do not request Google's script or create GA cookies before opt-in.
      if (analyticsLoaded || document.querySelector('script[data-atlas-analytics]')) return;
      analyticsLoaded = true;
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      window.gtag('js', new Date());
      window.gtag('config', 'G-MR20XJMESG');
      const script = document.createElement('script');
      script.async = true;
      script.src = 'https://www.googletagmanager.com/gtag/js?id=G-MR20XJMESG';
      script.dataset.atlasAnalytics = 'true';
      document.head.appendChild(script);
    };
    const show = () => { notice.hidden = false; settings.hidden = true; };
    const hide = () => { notice.hidden = true; settings.hidden = false; };
    const select = (allowAds, allowAnalytics) => {
      // A reload stops already loaded scripts when consent is withdrawn.
      const revokeLoadedAds = adsLoaded && !allowAds;
      const revokeLoadedAnalytics = analyticsLoaded && !allowAnalytics;
      write(adsKey, allowAds ? 'accepted' : 'rejected');
      write(analyticsKey, allowAnalytics ? 'accepted' : 'rejected');
      adsInput.checked = allowAds;
      analyticsInput.checked = allowAnalytics;
      hide();
      if (revokeLoadedAds || revokeLoadedAnalytics) {
        window.location.reload();
        return;
      }
      if (allowAds) loadAds();
      if (allowAnalytics) loadAnalytics();
    };

    settings.addEventListener('click', () => { show(); reject.focus(); });
    accept.addEventListener('click', () => select(true, true));
    reject.addEventListener('click', () => select(false, false));
    saveButton.addEventListener('click', () => select(adsInput.checked, analyticsInput.checked));
    window.addEventListener('storage', event => {
      if (event.key === adsKey || event.key === analyticsKey || event.key === null) window.location.reload();
    });

    // Align this independent button alongside the existing Menu block, without
    // changing the navigation or the permanent My Atlas floating controls.
    const positionSettings = () => {
      const menuBlock = document.querySelector('.atlas-navbar__left-block');
      if (!menuBlock) {
        settings.style.left = window.innerWidth <= 700 ? '12px' : '24px';
        settings.style.top = window.innerWidth <= 700 ? '10px' : '16px';
        return;
      }

      const menuBox = menuBlock.getBoundingClientRect();
      const logoBox = document.querySelector('.atlas-navbar__logo-block')?.getBoundingClientRect();
      const buttonWidth = settings.offsetWidth || (window.innerWidth <= 700 ? 44 : 90);
      const buttonHeight = settings.offsetHeight || 44;
      const proposedLeft = menuBox.right + 12;

      // Extremely narrow viewports: use the free space immediately below Menu
      // rather than covering the fixed logo or altering navbar dimensions.
      const fitsAlongside = !logoBox || proposedLeft + buttonWidth + 8 < logoBox.left;
      settings.style.left = Math.round(fitsAlongside ? proposedLeft : menuBox.left) + 'px';
      settings.style.top = Math.round(
        fitsAlongside
          ? menuBox.top + (menuBox.height - buttonHeight) / 2
          : menuBox.bottom + 9
      ) + 'px';
    };

    let previousScrollY = Math.max(0, window.scrollY);
    let scrollDirection = 0;
    let scrollDistance = 0;
    const onScroll = () => {
      const currentY = Math.max(0, window.scrollY);
      const delta = currentY - previousScrollY;
      previousScrollY = currentY;
      if (currentY <= 60) {
        settings.classList.remove('is-scroll-hidden');
        scrollDistance = 0;
        return;
      }
      const direction = Math.sign(delta);
      if (!direction) return;
      if (direction !== scrollDirection) {
        scrollDistance = 0;
        scrollDirection = direction;
      }
      scrollDistance += Math.abs(delta);
      if (direction > 0 && currentY > 120 && scrollDistance >= 16) {
        settings.classList.add('is-scroll-hidden');
      } else if (direction < 0 && scrollDistance >= 12) {
        settings.classList.remove('is-scroll-hidden');
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', positionSettings, { passive: true });

    const adChoice = read(adsKey);
    const analyticsChoice = read(analyticsKey);
    adsInput.checked = adChoice === 'accepted';
    analyticsInput.checked = analyticsChoice === 'accepted';
    if (adChoice === 'accepted') loadAds();
    if (analyticsChoice === 'accepted') loadAnalytics();
    // Previously saved ad consent does not count as analytics consent.
    if (adChoice && analyticsChoice) hide();
    else show();

    positionSettings();
    window.requestAnimationFrame(positionSettings);
  })();
</script>

<style>
  .atlas-consent__notice[hidden], .atlas-consent__settings[hidden] { display: none !important; }
  .atlas-consent__settings {
    position: fixed; top: 16px; left: 24px; z-index: 24;
    display: inline-flex; align-items: center; justify-content: center; gap: .45rem;
    min-width: 44px; height: 44px; padding: 0 .75rem;
    border: 1px solid #b7a887; border-radius: 5px;
    background: #263e33; color: #fffaf1; box-shadow: 0 4px 16px #0004;
    font: 600 .76rem/1.3 system-ui, sans-serif; cursor: pointer;
    transition: opacity 190ms ease, transform 190ms ease;
  }
  .atlas-consent__settings svg { display: block; flex: none; }
  .atlas-consent__settings.is-scroll-hidden {
    opacity: 0;
    transform: translateY(-14px);
    pointer-events: none;
  }
  .atlas-consent__notice {
    position: fixed; right: 1rem; bottom: 1rem; left: 1rem; z-index: 1151;
    display: flex; align-items: center; justify-content: space-between; gap: 1.3rem;
    box-sizing: border-box; width: min(940px, calc(100% - 2rem)); margin: 0 auto;
    padding: 1.2rem 1.35rem; border: 1px solid #b7a887; border-radius: 8px;
    background: #23392f; color: #fffaf1; box-shadow: 0 12px 42px #0006;
  }
  .atlas-consent__explanation { flex: 1 1 370px; min-width: 0; }
  .atlas-consent__explanation strong { display: block; margin: 0 0 .45rem; font: 600 1.08rem/1.2 Georgia, serif; }
  .atlas-consent__explanation p { margin: 0; color: #f4eadc; font: .84rem/1.55 system-ui, sans-serif; }
  .atlas-consent__options {
    display: grid; gap: .5rem; margin-top: .85rem;
    font: 500 .84rem/1.45 system-ui, sans-serif;
  }
  .atlas-consent__options label { display: flex; align-items: center; gap: .65rem; cursor: pointer; }
  .atlas-consent__options input { flex: none; width: 17px; height: 17px; accent-color: #edd4a3; }
  .atlas-consent__explanation .atlas-consent__links {
    display: flex; flex-wrap: wrap; gap: 1rem; margin-top: .55rem; font-size: .78rem;
  }
  .atlas-consent__links a { color: #f3d6a4; text-decoration: underline; text-underline-offset: 3px; }
  .atlas-consent__actions { display: flex; flex: 0 0 210px; flex-direction: column; gap: .55rem; }
  .atlas-consent__actions button {
    min-height: 40px; padding: .6rem .8rem; border: 1px solid #cdbd9a; border-radius: 4px;
    background: transparent; color: #fffaf1; font: 600 .78rem/1.2 system-ui, sans-serif; cursor: pointer;
  }
  .atlas-consent__actions [data-consent-save] { border-color: #edd4a3; }
  .atlas-consent__actions [data-consent-accept] { background: #edd4a3; border-color: #edd4a3; color: #23392f; }
  .atlas-consent button:focus-visible, .atlas-consent a:focus-visible { outline: 3px solid #f3c17a; outline-offset: 3px; }
  @media (max-width: 700px) {
    .atlas-consent__settings { width: 44px; padding: 0; }
    .atlas-consent__settings-label { display: none; }
  }
  @media (max-width: 650px) {
    .atlas-consent__notice { flex-direction: column; align-items: stretch; gap: .9rem; max-height: 85vh; overflow-y: auto; padding: 1rem; }
    .atlas-consent__explanation, .atlas-consent__actions { flex-basis: auto; }
    .atlas-consent__actions { flex-direction: row; }
    .atlas-consent__actions button { flex: 1; }
  }
  @media (max-width: 390px) { .atlas-consent__actions { flex-direction: column; } }
  @media (prefers-reduced-motion: reduce) {
    .atlas-consent__settings { transition: none; }
  }
</style>

<!-- Publisher verification HTML appears only on approved editorial pages.
     This template is inert; the script is still loaded only with consent. -->
{adsEligible && (
  <template data-atlas-infolinks-verification>
    <script is:inline type="text/javascript">
      var infolinks_pid = 3448891;
      var infolinks_wsid = 0;
    </script>
    <script is:inline type="text/javascript" src="//resources.infolinks.com/js/infolinks_main.js"></script>
  </template>
)}
