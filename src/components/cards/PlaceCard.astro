---
import type { Place } from '../../core/models/types';
import { getVenueFieldCard } from '../../content/venue-field-card-registry';
import { placeFieldCardPath } from '../../core/routing/paths';
import FavoriteHeart from '../shared/FavoriteHeart.astro';
import CardActions from './CardActions.astro';
import './entry-card.css';
interface Props { place: Place; showDestination?: boolean; }
const { place, showDestination = false } = Astro.props;
const image = place.image ?? place.media.card?.image;
const photoCredit = image?.sourceUrl && (image.author || image.sourceName || image.license)
  ? [image.author ?? image.sourceName, image.license].filter(Boolean).join(' · ')
  : '';
const titleize = (value: string) => value.split('-').map((part) => part ? `${part.charAt(0).toUpperCase()}${part.slice(1)}` : '').join(' ');
const fieldHref = getVenueFieldCard(place.id) ? placeFieldCardPath(place) : undefined;
---
<article class="card atlas-entry-card">
  <div class:list={['card-media', { empty: !image }]}>
    {image ? (
      <img src={image.src} alt={image.alt} loading="lazy" width="640" height="400" />
    ) : (
      <span class="card-photo-placeholder" aria-label="Photo missing; manual photo needed">Photo to add</span>
    )}
    {place.spaCard?.handwrittenTags && (
      <div class="card-handwritten" aria-label="Quick notes">
        {place.spaCard.handwrittenTags.map((tag) => <span>{tag}</span>)}
      </div>
    )}
    {photoCredit && image?.sourceUrl && (
      <a class="card-photo-credit" href={image.sourceUrl} target="_blank" rel="noreferrer">Photo: {photoCredit}</a>
    )}
    <FavoriteHeart entity={place} />
  </div>

  <div class="card-preview">
    <h3>{place.name}</h3>
    {showDestination && <p class="destination">{titleize(place.city)}, {titleize(place.country)}</p>}
    <p class="card-description">{place.shortDescription}</p>
    {place.spaCard?.openingHours && (
      <p class="card-practical-line"><span>Hours</span>{place.spaCard.openingHours}</p>
    )}
  </div>

  <CardActions entity={place} {fieldHref} cardImage={image} />
</article>
