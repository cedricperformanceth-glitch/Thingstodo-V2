---
import type { Place } from '../../core/models/types';
import FavoriteHeart from '../shared/FavoriteHeart.astro';
import TripButton from '../shared/TripButton.astro';
interface Props { place: Place; showDestination?: boolean; }
const { place, showDestination = false } = Astro.props;
const image = place.image ?? place.media.card?.image;
const titleize = (value: string) => value.split('-').map((part) => part ? `${part.charAt(0).toUpperCase()}${part.slice(1)}` : '').join(' ');
const categoryLabels: Record<Place['category'], string> = {
  'things-to-do': 'Things to do',
  accommodation: 'Guest House',
  restaurants: 'Restaurant',
  cafes: 'Coffee',
  'scooter-rental': 'Rental Scooter',
  gyms: 'Gym & Fitness',
  markets: 'Market & Shopping',
  'practical-services': 'Essential Information',
};
const context = `${categoryLabels[place.category]} · ${titleize(place.city)}`;
---
<article class:list={['card', 'atlas-entry-card', { selection: place.isMySelection }]}>
  <div class:list={['card-media', { empty: !image }]}>
    {image && <img src={image.src} alt={image.alt} loading="lazy" width="640" height="400" />}
    <FavoriteHeart entity={place} />
  </div>

  <div class="card-preview">
    {place.isMySelection && <p class="eyebrow">My Selection</p>}
    <p class="card-type">{context}</p>
    <h3>{place.name}</h3>
    {showDestination && <p class="destination">{titleize(place.city)}, {titleize(place.country)}</p>}
    <p class="card-description">{place.shortDescription}</p>
  </div>

  <div class="actions">
    <a class="card-action card-action--map" href={place.googleMapsUrl} target="_blank" rel="noreferrer">Open Google Maps</a>
    <TripButton entity={place} />
  </div>
</article>

<style>
  .card {
    position: relative;
    min-width: 0;
    overflow: hidden;
    border: 1px solid rgba(75,81,70,.22);
    border-radius: 0;
    background: #eee8dc;
    box-shadow: 5px 7px 0 rgba(49,85,69,.07);
  }
  .card-media {
    position: relative;
    height: 205px;
    overflow: hidden;
    background: #e8e3d6;
  }
  .card-media::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(180deg,transparent 48%,rgba(24,31,26,.3));
  }
  .card-media.empty { min-height: 0; }
  .card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(.72) contrast(.96);
  }
  .card-preview {
    display: flex;
    min-height: 190px;
    flex-direction: column;
    padding: 23px 22px 20px;
  }
  .eyebrow,
  .card-type {
    margin: 0 0 9px;
    color: #b76645;
    font: 700 .56rem/1.2 'DM Sans',var(--sans);
    letter-spacing: .13em;
    text-transform: uppercase;
  }
  .eyebrow { margin-bottom: 6px; }
  .card h3 {
    margin: 0 0 10px;
    color: #315545;
    font: 500 clamp(1.55rem,2.1vw,2rem)/1.04 Fraunces,var(--serif);
    letter-spacing: -.035em;
  }
  .card-description {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: #68685f;
    font: 400 .77rem/1.58 'DM Sans',var(--sans);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .destination {
    margin: -3px 0 9px;
    color: rgba(49,85,69,.62);
    font: 600 .58rem/1.3 'DM Sans',var(--sans);
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  /* Same visual language and spacing as the Hero partner links. */
  .actions {
    display: grid;
    gap: .90rem;
    padding: 0 17px 17px;
  }
  .card-action,
  .actions :global([data-trip]) {
    position: relative;
    display: block !important;
    width: 100%;
    min-height: 0 !important;
    padding: .18rem 1.25rem .36rem .05rem !important;
    border: 0 !important;
    border-bottom: 1px solid currentColor !important;
    border-radius: 0 !important;
    background: transparent !important;
    font-family: 'Segoe Print', 'Bradley Hand', cursive !important;
    font-size: .72rem !important;
    font-weight: 600 !important;
    line-height: 1.1 !important;
    text-align: left;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }
  .card-action::before,
  .actions :global([data-trip])::before {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    height: .72rem;
    border-right: 1px solid currentColor;
  }
  .card-action::after,
  .actions :global([data-trip])::after {
    content: '↗';
    position: absolute;
    right: -.03rem;
    bottom: .49rem;
    z-index: 1;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: .88rem;
    font-weight: 400;
    line-height: 1;
    transform: translate(38%, -10%);
  }
  .card-action--map { color: var(--river, #306f85); }
  .actions :global([data-trip]) { color: #315545 !important; }
  .card-action:hover,
  .card-action:focus-visible,
  .actions :global([data-trip]):hover,
  .actions :global([data-trip]):focus-visible {
    opacity: .72;
    outline: none;
  }
</style>
