---
import type { City, ThingToDo } from '../../core/models/types';
import { thingPath } from '../../core/routing/paths';
import FavoriteHeart from '../shared/FavoriteHeart.astro';
import TripButton from '../shared/TripButton.astro';
interface Props { city: City; thing: ThingToDo; showDestination?: boolean; }
const { city, thing, showDestination = false } = Astro.props;
---
<article class:list={['card', { selection: thing.isMySelection }]}>
  <div class:list={['card-media', { empty: !thing.media.card?.image }]}>{thing.media.card?.image && <img src={thing.media.card.image.src} alt={thing.media.card.image.alt} loading="lazy" width="640" height="400" />}<FavoriteHeart entity={thing} /></div>
  {thing.isMySelection && <p class="eyebrow">My Selection</p>}
  <h3>{thing.name}</h3>{showDestination && <p class="destination">{thing.city}, {thing.country}</p>}<p>{thing.shortDescription}</p>
  <div class="actions"><a class="button" href={thingPath(city, thing)}>Open Field Card</a>{thing.googleMapsUrl && <a class="button button--quiet" href={thing.googleMapsUrl} target="_blank" rel="noreferrer">Open Google Maps</a>}<TripButton entity={thing} /></div>
</article>
<style>.card{border:1px solid var(--line);padding:1rem;border-radius:.5rem}.card-media{position:relative}.card-media.empty{min-height:3.2rem;background:#f1ead9}.card img{display:block;width:100%;aspect-ratio:1.6;object-fit:cover}.eyebrow{font-size:.75rem;font-weight:700;text-transform:uppercase}.destination{font-size:.9rem;text-transform:capitalize}.actions{display:flex;flex-wrap:wrap;gap:.5rem}</style>
