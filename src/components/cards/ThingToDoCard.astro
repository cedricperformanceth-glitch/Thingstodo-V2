---
import type { City, ThingToDo } from '../../core/models/types';
import { thingPath } from '../../core/routing/paths';
import FavoriteHeart from '../shared/FavoriteHeart.astro';
import TripButton from '../shared/TripButton.astro';
interface Props { city: City; thing: ThingToDo; showDestination?: boolean; }
const { city, thing, showDestination = false } = Astro.props;
const titleize = (value: string) => value.split('-').map((part) => part ? `${part.charAt(0).toUpperCase()}${part.slice(1)}` : '').join(' ');
const context = `Things to do · ${titleize(thing.city)}`;
---
<article class:list={['card', 'atlas-entry-card', { selection: thing.isMySelection }]}>
  <div class:list={['card-media', { empty: !thing.media.card?.image }]}>
    {thing.media.card?.image && <img src={thing.media.card.image.src} alt={thing.media.card.image.alt} loading="lazy" width="640" height="400" />}
    <FavoriteHeart entity={thing} />
  </div>

  <div class="card-preview">
    {thing.isMySelection && <p class="eyebrow">My Selection</p>}
    <p class="card-type">{context}</p>
    <h3>{thing.name}</h3>
    {showDestination && <p class="destination">{titleize(thing.city)}, {titleize(thing.country)}</p>}
    <p class="card-description">{thing.shortDescription}</p>
  </div>

  <div class="actions"><a class="button" href={thingPath(city, thing)}>Open Field Card</a>{thing.googleMapsUrl && <a class="button button--quiet" href={thing.googleMapsUrl} target="_blank" rel="noreferrer">Open Google Maps</a>}<TripButton entity={thing} /></div>
</article>

<style>
  .card {
    position: relative;
    min-width: 0;
    overflow: hidden;
    border: 1px solid rgba(75,81,70,.22);
    border-radius: 0;
    background: #eee8dc;
    box-shadow: 5px 7px 0 rgba(49,85,69,.07);
  }
  .card-media {
    position: relative;
    height: 205px;
    overflow: hidden;
    background: #e8e3d6;
  }
  .card-media::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(180deg,transparent 48%,rgba(24,31,26,.3));
  }
  .card-media.empty { min-height: 0; }
  .card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(.72) contrast(.96);
  }
  .card-preview {
    display: flex;
    min-height: 190px;
    flex-direction: column;
    padding: 23px 22px 20px;
  }
  .eyebrow,
  .card-type {
    margin: 0 0 9px;
    color: #b76645;
    font: 700 .56rem/1.2 'DM Sans',var(--sans);
    letter-spacing: .13em;
    text-transform: uppercase;
  }
  .eyebrow { margin-bottom: 6px; }
  .card h3 {
    margin: 0 0 10px;
    color: #315545;
    font: 500 clamp(1.55rem,2.1vw,2rem)/1.04 Fraunces,var(--serif);
    letter-spacing: -.035em;
  }
  .card-description {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: #68685f;
    font: 400 .77rem/1.58 'DM Sans',var(--sans);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .destination {
    margin: -3px 0 9px;
    color: rgba(49,85,69,.62);
    font: 600 .58rem/1.3 'DM Sans',var(--sans);
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .actions { display:flex; flex-wrap:wrap; gap:.5rem; }
</style>
