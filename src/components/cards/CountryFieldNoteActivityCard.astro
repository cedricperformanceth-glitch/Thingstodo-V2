---
import type { Country } from '../../core/models/types';
import { countryFieldNotePath } from '../../core/routing/paths';
import { countryFieldNoteView } from '../../engines/country-field-note/country-field-note-engine';
import './entry-card.css';
import './card-actions.css';

interface Props { targetCountry: Country; }
const { targetCountry } = Astro.props;
const note = countryFieldNoteView(targetCountry);
const image = note.media[0];
const quickValue = (label: string) => note.quickRead.find((item) => item.label === label)?.value;
const chapters = quickValue('Chapters') ?? `${note.chapters.length} country notes`;
const scope = quickValue('Scope') ?? note.contextLine;
const useItFor = quickValue('Use it for') ?? 'Planning the country route';
const photoCredit = image?.sourceUrl && (image.author || image.sourceName || image.license)
  ? [image.author ?? image.sourceName, image.license].filter(Boolean).join(' · ')
  : '';
---

<article class="card atlas-entry-card country-field-note-activity-card">
  <div class:list={['card-media', { empty: !image }]}>
    {image ? (
      <img src={image.src} alt={image.alt} loading="lazy" width="640" height="400" />
    ) : (
      <span class="card-photo-placeholder" aria-label="Country Field Note hero photo missing">Photo to add</span>
    )}
    <div class="card-handwritten" aria-label="Country Field Note">
      <span>Country Field Note</span>
      <span>Next country</span>
    </div>
    {photoCredit && image?.sourceUrl && (
      <a class="card-photo-credit" href={image.sourceUrl} target="_blank" rel="noreferrer">Photo: {photoCredit}</a>
    )}
  </div>

  <div class="card-preview">
    <h3>{targetCountry.name}</h3>
    <p class="destination">Country · Destination field guide</p>
    <p class="card-description">{note.subtitle}</p>
    <dl class="card-activity-meta">
      <div><dt>Guide</dt><dd>{chapters}</dd></div>
      <div><dt>Scope</dt><dd>{scope}</dd></div>
      <div><dt>Use it for</dt><dd>{useItFor}</dd></div>
      <div><dt>Type</dt><dd>{note.typeLabel}</dd></div>
    </dl>
  </div>

  <div class="card-actions" style={`--card-field-color:${targetCountry.accentColor}`}>
    <a class="card-action card-action--field" href={countryFieldNotePath(targetCountry)}>Open the Country Field Note</a>
  </div>
</article>
