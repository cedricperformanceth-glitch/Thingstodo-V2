---
import type { City } from '../../core/models/types';
import { cityFieldNotePath, cityPath } from '../../core/routing/paths';
import { getCountry } from '../../engines/country/country-engine';
import { getCountryFieldNote } from '../../content/country-field-notes';
import { cityFieldNoteView } from '../../engines/city-field-note/city-field-note-engine';
import './entry-card.css';
import './card-actions.css';

interface Props { targetCity: City; sourceCity: City; }
const { targetCity, sourceCity } = Astro.props;
const isCountryFieldNote = targetCity.id.startsWith('country-');
const hostCountry = getCountry(sourceCity.country);
const noteCountry = isCountryFieldNote ? getCountryFieldNote(targetCity.id.replace(/^country-/, '')) : getCountry(targetCity.country);
if (!hostCountry || !noteCountry) throw new Error(`Missing Field Note context for ${targetCity.id}.`);
const note = cityFieldNoteView(targetCity, noteCountry);
const image = note.media[0];
const quickValue = (label: string) => note.quickRead.find((item) => item.label === label)?.value;
const chapters = quickValue('Chapters') ?? `${note.chapters.length} ${isCountryFieldNote ? 'country' : 'city'} notes`;
const scope = quickValue('Scope') ?? note.contextLine;
const useItFor = quickValue('Use it for') ?? (isCountryFieldNote ? 'Planning the country route' : 'Planning the next destination');
const fieldHref = isCountryFieldNote ? ${cityPath(sourceCity)}/field-note/ : cityFieldNotePath(targetCity);
const photoCredit = image?.sourceUrl && (image.author || image.sourceName || image.license)
  ? [image.author ?? image.sourceName, image.license].filter(Boolean).join(' · ')
  : '';
---

<article class="card atlas-entry-card city-field-note-activity-card">
  <div class:list={['card-media', { empty: !image }]}>
    {image ? (
      <img src={image.src} alt={image.alt} loading="lazy" width="640" height="400" />
    ) : (
      <span class="card-photo-placeholder" aria-label={`${isCountryFieldNote ? 'Country' : 'City'} Field Note hero photo missing`}>Photo to add</span>
    )}
    <div class="card-handwritten" aria-label={`${isCountryFieldNote ? 'Country' : 'City'} Field Note`}>
      <span>{isCountryFieldNote ? 'Country Field Note' : 'City Field Note'}</span>
      <span>{isCountryFieldNote ? 'Next country' : 'Next destination'}</span>
    </div>
    {photoCredit && image?.sourceUrl && (
      <a class="card-photo-credit" href={image.sourceUrl} target="_blank" rel="noreferrer">Photo: {photoCredit}</a>
    )}
  </div>

  <div class="card-preview">
    <h3>{targetCity.name}</h3>
    <p class="destination">{isCountryFieldNote ? 'Country field card' : noteCountry.name} · Destination field guide</p>
    <p class="card-description">{note.subtitle}</p>
    <dl class="card-activity-meta">
      <div><dt>Guide</dt><dd>{chapters}</dd></div>
      <div><dt>Scope</dt><dd>{scope}</dd></div>
      <div><dt>Use it for</dt><dd>{useItFor}</dd></div>
      <div><dt>Type</dt><dd>{note.typeLabel}</dd></div>
    </dl>
  </div>

  <div class="card-actions" style={`--card-field-color:${hostCountry.accentColor}`}>
    <a class="card-action card-action--field" href={fieldHref}>Open the {isCountryFieldNote ? 'Country' : 'City'} Field Note</a>
  </div>
</article>
