---
import type { AtlasEntity } from '../../core/models/types';
import { getCountry } from '../../engines/country/country-engine';
import TripButton from '../shared/TripButton.astro';
import './card-actions.css';

interface Props {
  entity: AtlasEntity;
  fieldHref?: string;
  cardImage?: { src: string; alt: string };
}

const { entity, fieldHref, cardImage } = Astro.props;
const countryAccent = getCountry(entity.country)?.accentColor ?? '#b7473b';
const mapsHref = entity.googleMapsUrl;
---

<div class="card-actions" style={`--card-field-color:${countryAccent}`}>
  {mapsHref && (
    <a class="card-action card-action--map" href={mapsHref} target="_blank" rel="noreferrer">Open Google Maps</a>
  )}
  {fieldHref && (
    <a class="card-action card-action--field" href={fieldHref}>Open the Field Card</a>
  )}
  <TripButton entity={entity} {cardImage} />
</div>
