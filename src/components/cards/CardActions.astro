---
import type { AtlasEntity } from '../../core/models/types';
import { getCountry } from '../../engines/country/country-engine';
import TripButton from '../shared/TripButton.astro';

interface Props {
  entity: AtlasEntity;
  fieldHref?: string;
}

const { entity, fieldHref } = Astro.props;
const countryAccent = getCountry(entity.country)?.accentColor ?? '#b7473b';
const mapsHref = entity.googleMapsUrl;
---

<div class="card-actions" style={`--card-field-color:${countryAccent}`}>
  {mapsHref && (
    <a class="card-action card-action--map" href={mapsHref} target="_blank" rel="noreferrer">Open Google Maps</a>
  )}
  {fieldHref && (
    <a class="card-action card-action--field" href={fieldHref}>Open the Field Card</a>
  )}
  <TripButton entity={entity} />
</div>

<style>
  .card-actions {
    display: grid;
    gap: .90rem;
    padding: 0 17px 17px;
  }

  .card-action,
  .card-actions :global([data-trip]) {
    position: relative;
    display: block !important;
    width: 100%;
    min-height: 0 !important;
    padding: .18rem 1.25rem .36rem .05rem !important;
    border: 0 !important;
    border-bottom: 1px solid currentColor !important;
    border-radius: 0 !important;
    background: transparent !important;
    font-family: 'Segoe Print', 'Bradley Hand', cursive !important;
    font-size: .72rem !important;
    font-weight: 600 !important;
    line-height: 1.1 !important;
    text-align: left;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }

  .card-action::before,
  .card-actions :global([data-trip])::before {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    height: .72rem;
    border-right: 1px solid currentColor;
  }

  .card-action::after,
  .card-actions :global([data-trip])::after {
    content: '↗';
    position: absolute;
    right: -.03rem;
    bottom: .49rem;
    z-index: 1;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: .88rem;
    font-weight: 400;
    line-height: 1;
    transform: translate(38%, -10%);
  }

  .card-action--map { color: var(--river, #306f85); }
  .card-action--field { color: var(--card-field-color, #b7473b); }
  .card-actions :global([data-trip]) { color: #315545 !important; }

  .card-action:hover,
  .card-action:focus-visible,
  .card-actions :global([data-trip]):hover,
  .card-actions :global([data-trip]):focus-visible {
    opacity: .72;
    outline: none;
  }
</style>
