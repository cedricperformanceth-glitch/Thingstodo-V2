---
import { getFinalCtaRoutes } from '../../content/final-cta-routes';

interface Props {
  country: string;
}

const { country } = Astro.props;
const routes = getFinalCtaRoutes(country);
---

<section class="final-cta" aria-label="Make Your Own Atlas">
  <div class="final-cta__transition" aria-hidden="true"></div>

  <div class="final-cta__inner">
    <div class="final-cta__canvas">
      <svg class="final-cta__note final-cta__note--explore" viewBox="0 0 190 86" aria-hidden="true">
        <path class="final-cta__ink" d="M23 45C20 19 162 11 173 40C184 68 42 77 20 52C14 45 15 39 23 32" />
        <path class="final-cta__ink final-cta__ink--soft" d="M30 39C44 20 154 17 169 42C179 60 80 73 34 61" />
        <text x="95" y="52" text-anchor="middle">explore</text>
      </svg>

      <svg class="final-cta__note final-cta__note--save" viewBox="0 0 180 78" aria-hidden="true">
        <path class="final-cta__highlight" d="M24 45C58 37 105 38 154 41" />
        <path class="final-cta__highlight final-cta__highlight--second" d="M28 51C71 44 116 45 151 47" />
        <text x="90" y="49" text-anchor="middle">save this</text>
      </svg>

      <svg class="final-cta__note final-cta__note--yours" viewBox="0 0 220 82" aria-hidden="true">
        <text x="110" y="44" text-anchor="middle">make it yours</text>
        <path class="final-cta__ink" d="M40 57C78 62 129 61 178 55C190 54 198 55 202 57" />
        <path class="final-cta__ink final-cta__ink--soft" d="M47 62C89 65 145 63 187 58" />
      </svg>

      <img
        class="final-cta__logo"
        src="/assets/shared/make-your-own-atlas/Logo%20MY%20ATLAS%20CTA%20FINAL.webp"
        alt="Make Your Own Atlas"
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="final-cta__links" aria-label="Your Atlas and Atlas Routes">
      {routes[0] && (
        <a class="atlas-route atlas-route--first" href={routes[0].href} aria-label={`Open Atlas Route ${routes[0].label}`}>
          <span class="atlas-route__label">{routes[0].label}</span>
          <svg viewBox="0 0 250 112" aria-hidden="true">
            <path class="atlas-route__path" d="M18 78C47 36 67 95 103 55C130 25 153 73 188 42C203 29 219 34 232 24" />
            <circle cx="18" cy="78" r="5" />
            <circle cx="103" cy="55" r="4" />
            <circle cx="188" cy="42" r="4" />
            <path class="atlas-route__arrow" d="M218 19L234 23L226 38" />
          </svg>
          <span class="atlas-route__ends"><small>{routes[0].startLabel}</small><small>{routes[0].endLabel}</small></span>
        </a>
      )}

      <a class="atlas-door" href="/summary" aria-label="Open Your Atlas">
        <svg viewBox="0 0 74 98" aria-hidden="true">
          <path d="M20 88V18L56 10V88" />
          <path d="M20 88H60" />
          <circle cx="47" cy="52" r="2.5" />
          <path class="atlas-door__arrow" d="M8 31C14 23 21 19 29 18M9 31L11 20M9 31L20 29" />
        </svg>
        <span>Your Atlas</span>
      </a>

      {routes[1] && (
        <a class="atlas-route atlas-route--second" href={routes[1].href} aria-label={`Open Atlas Route ${routes[1].label}`}>
          <span class="atlas-route__label">{routes[1].label}</span>
          <svg viewBox="0 0 250 112" aria-hidden="true">
            <path class="atlas-route__path" d="M21 30C53 63 77 17 111 54C139 85 162 39 194 66C210 80 225 77 237 87" />
            <circle cx="21" cy="30" r="5" />
            <circle cx="111" cy="54" r="4" />
            <circle cx="194" cy="66" r="4" />
            <path class="atlas-route__arrow" d="M224 81L238 88L226 98" />
          </svg>
          <span class="atlas-route__ends"><small>{routes[1].startLabel}</small><small>{routes[1].endLabel}</small></span>
        </a>
      )}
    </div>
  </div>
</section>

<style>
  .final-cta {
    position: relative;
    isolation: isolate;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    overflow: hidden;
    background: #f3ede0;
  }

  .final-cta__transition {
    height: clamp(2.5rem, 5vw, 4.5rem);
    background: linear-gradient(180deg, #1b2b24 0%, #263a31 20%, rgba(38, 58, 49, .54) 52%, rgba(243, 237, 224, .72) 82%, #f3ede0 100%);
  }

  .final-cta__inner {
    width: min(1180px, calc(100% - 2rem));
    margin: 0 auto;
  }

  .final-cta__canvas {
    position: relative;
    min-height: clamp(22rem, 44vw, 34rem);
    display: grid;
    place-items: center;
    padding: clamp(3rem, 7vw, 6rem) 0 clamp(4rem, 8vw, 7rem);
  }

  .final-cta__logo {
    position: relative;
    z-index: 2;
    display: block;
    width: min(42rem, 76vw);
    max-width: 100%;
    height: auto;
  }

  .final-cta__note {
    position: absolute;
    z-index: 3;
    overflow: visible;
    pointer-events: none;
  }

  .final-cta__note text {
    fill: #315f83;
    font-family: 'Caveat', cursive;
    font-size: 31px;
    font-weight: 600;
    letter-spacing: .01em;
  }

  .final-cta__ink {
    fill: none;
    stroke: #315f83;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: .9;
  }

  .final-cta__ink--soft {
    stroke-width: 1.35;
    opacity: .55;
  }

  .final-cta__highlight {
    fill: none;
    stroke: rgba(222, 185, 77, .46);
    stroke-width: 15;
    stroke-linecap: round;
  }

  .final-cta__highlight--second {
    stroke-width: 9;
    opacity: .55;
  }

  .final-cta__note--explore {
    top: 9%;
    left: 7.5%;
    width: clamp(9.5rem, 16vw, 13.5rem);
    transform: rotate(-8deg);
  }

  .final-cta__note--save {
    top: 24%;
    right: 5.5%;
    width: clamp(8.5rem, 14vw, 12rem);
    transform: rotate(5deg);
  }

  .final-cta__note--yours {
    right: 14%;
    bottom: 8.5%;
    width: clamp(10.5rem, 17vw, 14rem);
    transform: rotate(-3deg);
  }

  .final-cta__links {
    position: relative;
    min-height: 17rem;
    margin-top: -1.5rem;
    pointer-events: none;
  }

  .atlas-route,
  .atlas-door {
    position: absolute;
    pointer-events: auto;
    text-decoration: none;
    transition: transform 160ms ease, opacity 160ms ease;
  }

  .atlas-route:hover,
  .atlas-door:hover {
    opacity: .78;
  }

  .atlas-route {
    width: clamp(13rem, 23vw, 18rem);
    color: #315545;
    font-family: 'Caveat', cursive;
  }

  .atlas-route--first {
    left: 2.5%;
    top: .4rem;
    transform: rotate(-5deg);
  }

  .atlas-route--first:hover {
    transform: rotate(-3deg) translateY(-2px);
  }

  .atlas-route--second {
    right: 3%;
    bottom: 1.4rem;
    transform: rotate(6deg);
    color: #a95f46;
  }

  .atlas-route--second:hover {
    transform: rotate(4deg) translateY(-2px);
  }

  .atlas-route__label {
    display: block;
    margin: 0 0 -.7rem 1.4rem;
    font-size: clamp(1.15rem, 1.8vw, 1.55rem);
    font-weight: 650;
    line-height: 1;
  }

  .atlas-route svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    fill: #f3ede0;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .atlas-route__path {
    fill: none;
    stroke-dasharray: 3 8;
  }

  .atlas-route__arrow {
    fill: none;
  }

  .atlas-route__ends {
    display: flex;
    justify-content: space-between;
    margin: -1.25rem 1.2rem 0 .8rem;
    font-size: .82rem;
    letter-spacing: .02em;
    opacity: .78;
  }

  .atlas-door {
    left: 47%;
    top: 3.2rem;
    display: grid;
    justify-items: center;
    color: #315545;
    font-family: 'Caveat', cursive;
    transform: rotate(2.5deg) translateX(-50%);
  }

  .atlas-door:hover {
    transform: rotate(0deg) translateX(-50%) translateY(-2px);
  }

  .atlas-door svg {
    width: 3.7rem;
    height: auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .atlas-door circle {
    fill: #b76645;
    stroke: none;
  }

  .atlas-door__arrow {
    stroke: #315f83;
  }

  .atlas-door span {
    margin-top: -.4rem;
    font-size: 1.35rem;
    font-weight: 650;
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    .final-cta__note text {
      font-size: 28px;
    }

    .final-cta__note--explore {
      top: 8%;
      left: -1.5%;
      width: 9.5rem;
      transform: rotate(-10deg);
    }

    .final-cta__note--save {
      top: 20%;
      right: -2%;
      width: 8.5rem;
      transform: rotate(7deg);
    }

    .final-cta__note--yours {
      right: 4%;
      bottom: 5%;
      width: 10rem;
      transform: rotate(-5deg);
    }

    .final-cta__links {
      min-height: 21rem;
      margin-top: -.5rem;
    }

    .atlas-route {
      width: min(13rem, 57vw);
    }

    .atlas-route--first {
      left: -1%;
      top: .3rem;
      transform: rotate(-7deg);
    }

    .atlas-door {
      left: 67%;
      top: 4.8rem;
      transform: rotate(4deg) translateX(-50%);
    }

    .atlas-door svg {
      width: 3.2rem;
    }

    .atlas-door span {
      font-size: 1.2rem;
    }

    .atlas-route--second {
      right: -2%;
      bottom: .8rem;
      transform: rotate(5deg);
    }
  }

  @media (max-width: 640px) {
    .final-cta__transition {
      height: 2.75rem;
    }

    .final-cta__inner {
      width: min(100% - 1.25rem, 1180px);
    }

    .final-cta__canvas {
      min-height: 22rem;
      padding: 3.5rem 0 5rem;
    }

    .final-cta__logo {
      width: min(88vw, 34rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .atlas-route,
    .atlas-door {
      transition: none;
    }
  }
</style>
