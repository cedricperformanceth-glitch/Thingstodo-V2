---
import { getFinalCtaRoutes } from '../../content/final-cta-routes';

interface Props {
  country: string;
}

const { country } = Astro.props;
const routes = getFinalCtaRoutes(country);
---

<section class="final-cta" aria-label="Make Your Own Atlas">
  <div class="final-cta__transition" aria-hidden="true"></div>

  <div class="final-cta__inner">
    <div class="final-cta__canvas">
      <svg class="final-cta__note final-cta__note--explore" viewBox="0 0 190 86" aria-hidden="true">
        <path class="final-cta__ink" d="M23 45C20 19 162 11 173 40C184 68 42 77 20 52C14 45 15 39 23 32" />
        <path class="final-cta__ink final-cta__ink--soft" d="M30 39C44 20 154 17 169 42C179 60 80 73 34 61" />
        <text x="95" y="52" text-anchor="middle">explore</text>
      </svg>

      <svg class="final-cta__note final-cta__note--yours" viewBox="0 0 220 82" aria-hidden="true">
        <text x="110" y="44" text-anchor="middle">make it yours</text>
        <path class="final-cta__ink" d="M40 57C78 62 129 61 178 55C190 54 198 55 202 57" />
        <path class="final-cta__ink final-cta__ink--soft" d="M47 62C89 65 145 63 187 58" />
      </svg>

      <img
        class="final-cta__logo"
        src="/assets/shared/make-your-own-atlas/Logo%20MY%20ATLAS%20CTA%20FINAL.webp"
        alt="Make Your Own Atlas"
        loading="lazy"
        decoding="async"
      />

      <div class="final-cta__actions" aria-label="Your Atlas and Atlas Routes">
        {routes[0] && (
          <a class="atlas-route atlas-route--first" href={routes[0].href} aria-label={`Open Atlas Route ${routes[0].label}`}>
            <span class="atlas-route__label">{routes[0].label}</span>
            <svg viewBox="0 0 250 48" aria-hidden="true">
              <line x1="24" y1="24" x2="81" y2="24" />
              <line x1="96" y1="24" x2="153" y2="24" />
              <line x1="168" y1="24" x2="225" y2="24" />
              <circle cx="17" cy="24" r="7" />
              <circle cx="89" cy="24" r="7" />
              <circle cx="161" cy="24" r="7" />
              <circle cx="233" cy="24" r="7" />
            </svg>
          </a>
        )}

        <a class="atlas-summary-link" href="/summary" aria-label="Build Your Atlas">
          <span>Build Your Atlas</span>
          <span class="atlas-summary-link__arrow" aria-hidden="true">↗</span>
        </a>

        {routes[1] && (
          <a class="atlas-route atlas-route--second" href={routes[1].href} aria-label={`Open Atlas Route ${routes[1].label}`}>
            <span class="atlas-route__label">{routes[1].label}</span>
            <svg viewBox="0 0 250 48" aria-hidden="true">
              <line x1="24" y1="24" x2="81" y2="24" />
              <line x1="96" y1="24" x2="153" y2="24" />
              <line x1="168" y1="24" x2="225" y2="24" />
              <circle cx="17" cy="24" r="7" />
              <circle cx="89" cy="24" r="7" />
              <circle cx="161" cy="24" r="7" />
              <circle cx="233" cy="24" r="7" />
            </svg>
          </a>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .final-cta {
    position: relative;
    isolation: isolate;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    overflow: hidden;
    background: #f3ede0;
  }

  .final-cta__transition {
    height: clamp(2.5rem, 5vw, 4.5rem);
    background: linear-gradient(180deg, #1b2b24 0%, #263a31 20%, rgba(38, 58, 49, .54) 52%, rgba(243, 237, 224, .72) 82%, #f3ede0 100%);
  }

  .final-cta__inner {
    width: min(1180px, calc(100% - 2rem));
    margin: 0 auto;
  }

  .final-cta__canvas {
    position: relative;
    min-height: clamp(22rem, 44vw, 34rem);
    display: grid;
    place-items: center;
    padding: clamp(3rem, 7vw, 6rem) 0 clamp(4rem, 8vw, 7rem);
  }

  .final-cta__logo {
    position: relative;
    z-index: 2;
    display: block;
    width: min(42rem, 76vw);
    max-width: 100%;
    height: auto;
  }

  .final-cta__note {
    position: absolute;
    z-index: 3;
    overflow: visible;
    pointer-events: none;
  }

  .final-cta__note text {
    fill: #315f83;
    font-family: 'Caveat', cursive;
    font-size: 31px;
    font-weight: 600;
    letter-spacing: .01em;
  }

  .final-cta__ink {
    fill: none;
    stroke: #315f83;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: .9;
  }

  .final-cta__ink--soft {
    stroke-width: 1.35;
    opacity: .55;
  }

  .final-cta__note--explore {
    top: 9%;
    left: 7.5%;
    width: clamp(9.5rem, 16vw, 13.5rem);
    transform: rotate(-8deg);
  }

  .final-cta__note--yours {
    top: 24%;
    right: 5.5%;
    width: clamp(10.5rem, 17vw, 14rem);
    transform: rotate(-3deg);
  }

  .final-cta__actions {
    position: absolute;
    z-index: 4;
    inset: 0;
    pointer-events: none;
  }

  .atlas-route,
  .atlas-summary-link {
    position: absolute;
    pointer-events: auto;
    text-decoration: none;
    transition: transform 160ms ease, opacity 160ms ease;
  }

  .atlas-route:hover,
  .atlas-summary-link:hover,
  .atlas-summary-link:focus-visible {
    opacity: .74;
  }

  .atlas-route {
    width: clamp(11.5rem, 20vw, 15.5rem);
    font-family: 'Caveat', cursive;
  }

  .atlas-route--first {
    left: 3.5%;
    bottom: 13%;
    color: #4f7180;
    transform: rotate(-4deg);
  }

  .atlas-route--first:hover {
    transform: rotate(-2deg) translateY(-2px);
  }

  .atlas-route--second {
    right: 3%;
    bottom: 13%;
    color: #9e5f53;
    transform: rotate(5deg);
  }

  .atlas-route--second:hover {
    transform: rotate(3deg) translateY(-2px);
  }

  .atlas-route__label {
    display: block;
    margin: 0 0 .35rem .7rem;
    font-size: clamp(1.18rem, 1.8vw, 1.5rem);
    font-weight: 650;
    line-height: 1;
  }

  .atlas-route svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    fill: #f3ede0;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .atlas-summary-link {
    left: 50%;
    top: 68%;
    display: inline-flex;
    align-items: center;
    gap: 2rem;
    width: max-content;
    padding: .22rem .45rem .42rem .08rem;
    border-bottom: 1px solid currentColor;
    color: #315545;
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.05;
    text-align: left;
    white-space: nowrap;
    transform: translateX(-50%) rotate(-1deg);
  }

  .atlas-summary-link::before {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    height: .9rem;
    border-right: 1px solid currentColor;
  }

  .atlas-summary-link__arrow {
    display: inline-block;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.02rem;
    font-weight: 400;
    line-height: 1;
  }

  .atlas-summary-link:hover {
    transform: translateX(-50%) rotate(0deg) translateY(-2px);
  }

  .atlas-summary-link:focus-visible {
    outline: none;
  }

  @media (max-width: 760px) {
    .final-cta__note text {
      font-size: 28px;
    }

    .final-cta__note--explore {
      top: 8%;
      left: -1.5%;
      width: 9.5rem;
      transform: rotate(-10deg);
    }

    .final-cta__note--yours {
      top: 20%;
      right: -2%;
      width: 10rem;
      transform: rotate(-5deg);
    }

    .atlas-route {
      width: min(10rem, 43vw);
    }

    .atlas-route--first {
      left: -1%;
      bottom: 10.5%;
      transform: rotate(-5deg);
    }

    .atlas-route--second {
      right: -1%;
      bottom: 9%;
      transform: rotate(4deg);
    }

    .atlas-route__label {
      margin-left: .3rem;
      font-size: 1.15rem;
    }

    .atlas-summary-link {
      top: 67%;
      font-size: 1.3rem;
    }
  }

  @media (max-width: 640px) {
    .final-cta__transition {
      height: 2.75rem;
    }

    .final-cta__inner {
      width: min(100% - 1.25rem, 1180px);
    }

    .final-cta__canvas {
      min-height: 22rem;
      padding: 3.5rem 0 5rem;
    }

    .final-cta__logo {
      width: min(88vw, 34rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .atlas-route,
    .atlas-summary-link {
      transition: none;
    }
  }
</style>
