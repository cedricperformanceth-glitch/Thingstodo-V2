---
import { getFinalCtaRoutes } from '../../content/final-cta-routes';

interface Props {
  country: string;
}

const { country } = Astro.props;
const routes = getFinalCtaRoutes(country);
---

<section class="final-cta" aria-label="Make Your Own Atlas">
  <div class="final-cta__transition" aria-hidden="true"></div>

  <div class="final-cta__inner">
    <div class="final-cta__canvas">
      <svg class="final-cta__note final-cta__note--explore" viewBox="0 0 190 86" aria-hidden="true">
        <path class="final-cta__ink" d="M23 45C20 19 162 11 173 40C184 68 42 77 20 52C14 45 15 39 23 32" />
        <path class="final-cta__ink final-cta__ink--soft" d="M30 39C44 20 154 17 169 42C179 60 80 73 34 61" />
        <text x="95" y="52" text-anchor="middle">explore</text>
      </svg>

      <svg class="final-cta__note final-cta__note--yours" viewBox="0 0 220 82" aria-hidden="true">
        <text x="110" y="44" text-anchor="middle">make it yours</text>
        <path class="final-cta__ink" d="M40 57C78 62 129 61 178 55C190 54 198 55 202 57" />
        <path class="final-cta__ink final-cta__ink--soft" d="M47 62C89 65 145 63 187 58" />
      </svg>

      <img
        class="final-cta__logo"
        src="/assets/shared/make-your-own-atlas/Logo%20MY%20ATLAS%20CTA%20FINAL.webp"
        alt="Make Your Own Atlas"
        loading="lazy"
        decoding="async"
      />

      <div class="final-cta__actions" aria-label="Your Atlas and Atlas Routes">
        <a class="atlas-summary-link" href="/summary" aria-label="Build Your Atlas">
          <span>Build Your Atlas</span>
          <span class="atlas-summary-link__arrow" aria-hidden="true">↗</span>
        </a>

        {(routes[0] || routes[1]) && (
          <div class="atlas-route-selector" aria-label="Choose an Atlas route direction">
            {routes[0] ? (
              <a
                class="atlas-route atlas-route--first"
                href={routes[0].href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Open Atlas Route ${routes[0].label} in a new tab`}
              >
                <span class="atlas-route__label">{routes[0].label}</span>
                <span class="atlas-route__direction" aria-hidden="true">
                  <span class="atlas-route__line"></span>
                  <span class="atlas-route__arrow">↓</span>
                </span>
              </a>
            ) : <span aria-hidden="true"></span>}

            <div class="atlas-compass" aria-hidden="true">
              <svg viewBox="0 0 180 180" role="presentation">
                <circle class="atlas-compass__outer" cx="90" cy="90" r="70" />
                <circle class="atlas-compass__inner" cx="90" cy="90" r="58" />

                <path class="atlas-compass__tick" d="M90 20V31M90 149V160M20 90H31M149 90H160" />
                <path class="atlas-compass__tick atlas-compass__tick--soft" d="M40.5 40.5L48.5 48.5M131.5 131.5L139.5 139.5M139.5 40.5L131.5 48.5M48.5 131.5L40.5 139.5" />

                <text class="atlas-compass__cardinal atlas-compass__cardinal--north" x="90" y="17" text-anchor="middle">N</text>
                <text class="atlas-compass__cardinal atlas-compass__cardinal--south" x="90" y="176" text-anchor="middle">S</text>

                <path class="atlas-compass__needle atlas-compass__needle--north" d="M90 45L104 91L90 83L76 91Z" />
                <path class="atlas-compass__needle atlas-compass__needle--south" d="M90 135L76 89L90 97L104 89Z" />
                <circle class="atlas-compass__pin" cx="90" cy="90" r="6" />
                <circle class="atlas-compass__pin-core" cx="90" cy="90" r="2.2" />
              </svg>
            </div>

            {routes[1] ? (
              <a
                class="atlas-route atlas-route--second"
                href={routes[1].href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Open Atlas Route ${routes[1].label} in a new tab`}
              >
                <span class="atlas-route__label">{routes[1].label}</span>
                <span class="atlas-route__direction" aria-hidden="true">
                  <span class="atlas-route__arrow">↑</span>
                  <span class="atlas-route__line"></span>
                </span>
              </a>
            ) : <span aria-hidden="true"></span>}
          </div>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .final-cta {
    position: relative;
    isolation: isolate;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    overflow: hidden;
    background: #f3ede0;
  }

  .final-cta__transition {
    height: clamp(2.5rem, 5vw, 4.5rem);
    background: linear-gradient(180deg, #1b2b24 0%, #263a31 20%, rgba(38, 58, 49, .54) 52%, rgba(243, 237, 224, .72) 82%, #f3ede0 100%);
  }

  .final-cta__inner {
    width: min(1180px, calc(100% - 2rem));
    margin: 0 auto;
  }

  .final-cta__canvas {
    position: relative;
    min-height: clamp(29.5rem, 43vw, 34rem);
    display: grid;
    place-items: center;
    padding: clamp(2.6rem, 5vw, 4rem) 0 clamp(2.5rem, 4vw, 3.5rem);
  }

  .final-cta__logo {
    position: relative;
    z-index: 2;
    display: block;
    width: min(42rem, 76vw);
    max-width: 100%;
    height: auto;
    transform: translateY(-6.2rem);
  }

  .final-cta__note {
    position: absolute;
    z-index: 3;
    overflow: visible;
    pointer-events: none;
  }

  .final-cta__note text {
    fill: #315f83;
    font-family: 'Caveat', cursive;
    font-size: 31px;
    font-weight: 600;
    letter-spacing: .01em;
  }

  .final-cta__ink {
    fill: none;
    stroke: #315f83;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: .9;
  }

  .final-cta__ink--soft {
    stroke-width: 1.35;
    opacity: .55;
  }

  .final-cta__note--explore {
    top: clamp(2.85rem, 4.2vw, 3.35rem);
    left: 7.5%;
    width: clamp(9.5rem, 16vw, 13.5rem);
    transform: rotate(-8deg);
  }

  .final-cta__note--yours {
    top: clamp(7.1rem, 10.8vw, 8.35rem);
    right: 5.5%;
    width: clamp(10.5rem, 17vw, 14rem);
    transform: rotate(-3deg);
  }

  .final-cta__actions {
    position: absolute;
    z-index: 4;
    inset: 0;
    pointer-events: none;
  }

  .atlas-route,
  .atlas-summary-link {
    pointer-events: auto;
    text-decoration: none;
  }

  .atlas-summary-link {
    position: absolute;
    left: 50%;
    top: 48.5%;
    display: inline-flex;
    align-items: center;
    gap: 2rem;
    width: max-content;
    padding: .22rem .45rem .42rem .08rem;
    border-bottom: 1px solid currentColor;
    color: #315545;
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.05;
    text-align: left;
    white-space: nowrap;
    transform: translateX(-50%) rotate(-1deg);
    transition: transform 160ms ease, opacity 160ms ease;
  }

  .atlas-summary-link::before {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    height: .9rem;
    border-right: 1px solid currentColor;
  }

  .atlas-summary-link__arrow {
    display: inline-block;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.02rem;
    font-weight: 400;
    line-height: 1;
  }

  .atlas-summary-link:hover,
  .atlas-summary-link:focus-visible {
    opacity: .74;
    transform: translateX(-50%) rotate(0deg) translateY(-2px);
  }

  .atlas-summary-link:focus-visible,
  .atlas-route:focus-visible {
    outline: 2px solid rgba(49, 85, 69, .55);
    outline-offset: 5px;
    border-radius: 4px;
  }

  .atlas-route-selector {
    position: absolute;
    left: 50%;
    top: 63%;
    width: min(50rem, 92%);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: clamp(1rem, 3vw, 2.6rem);
    transform: translateX(-50%);
    pointer-events: none;
  }

  .atlas-route {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: .4rem;
    min-width: 0;
    font-family: 'Caveat', cursive;
    font-weight: 650;
    line-height: 1;
    transition: transform 180ms ease, opacity 180ms ease;
  }

  .atlas-route--first {
    align-items: flex-end;
    color: #4f7180;
    text-align: right;
  }

  .atlas-route--second {
    align-items: flex-start;
    color: #9e5f53;
    text-align: left;
  }

  .atlas-route__label {
    display: block;
    font-size: clamp(1.35rem, 2vw, 1.75rem);
    white-space: nowrap;
  }

  .atlas-route__direction {
    display: flex;
    align-items: center;
    gap: .45rem;
    width: min(10rem, 100%);
    opacity: .62;
  }

  .atlas-route--first .atlas-route__direction {
    justify-content: flex-end;
  }

  .atlas-route--second .atlas-route__direction {
    justify-content: flex-start;
  }

  .atlas-route__line {
    display: block;
    width: clamp(2.7rem, 6vw, 5.4rem);
    height: 1px;
    background: currentColor;
    transform-origin: center;
    transition: transform 180ms ease, opacity 180ms ease;
  }

  .atlas-route__arrow {
    display: block;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.2rem;
    font-weight: 400;
    line-height: .8;
  }

  .atlas-route:hover {
    opacity: .76;
  }

  .atlas-route--first:hover {
    transform: translateX(-4px);
  }

  .atlas-route--second:hover {
    transform: translateX(4px);
  }

  .atlas-route:hover .atlas-route__line {
    transform: scaleX(1.12);
  }

  .atlas-compass {
    width: clamp(7.25rem, 12vw, 9.1rem);
    aspect-ratio: 1;
    color: #315545;
    pointer-events: none;
  }

  .atlas-compass svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .atlas-compass__outer,
  .atlas-compass__inner,
  .atlas-compass__tick {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .atlas-compass__outer {
    stroke-width: 2;
    opacity: .88;
  }

  .atlas-compass__inner {
    stroke-width: 1;
    opacity: .36;
    stroke-dasharray: 2 5;
  }

  .atlas-compass__tick {
    stroke-width: 1.7;
    opacity: .72;
  }

  .atlas-compass__tick--soft {
    stroke-width: 1;
    opacity: .36;
  }

  .atlas-compass__cardinal {
    fill: #315545;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 13px;
    font-weight: 700;
  }

  .atlas-compass__needle {
    stroke: #315545;
    stroke-width: 1.4;
    stroke-linejoin: round;
  }

  .atlas-compass__needle--north {
    fill: #4f7180;
  }

  .atlas-compass__needle--south {
    fill: #f3ede0;
  }

  .atlas-compass__pin {
    fill: #f3ede0;
    stroke: #315545;
    stroke-width: 1.5;
  }

  .atlas-compass__pin-core {
    fill: #315545;
  }

  @media (max-width: 760px) {
    .final-cta__canvas {
      min-height: 30.5rem;
      padding: 3rem 0 3.25rem;
    }

    .final-cta__logo {
      width: min(84vw, 34rem);
      transform: translateY(-5.5rem);
    }

    .final-cta__note text {
      font-size: 28px;
    }

    .final-cta__note--explore {
      top: 2.45rem;
      left: -1.5%;
      width: 9.5rem;
      transform: rotate(-10deg);
    }

    .final-cta__note--yours {
      top: 5.95rem;
      right: -2%;
      width: 10rem;
      transform: rotate(-5deg);
    }

    .atlas-summary-link {
      top: 48.5%;
      font-size: 1.3rem;
    }

    .atlas-route-selector {
      top: 64%;
      width: 96%;
      gap: .75rem;
    }

    .atlas-route__label {
      font-size: clamp(1.08rem, 4vw, 1.3rem);
    }

    .atlas-route__direction {
      width: min(7rem, 100%);
    }

    .atlas-compass {
      width: clamp(6rem, 20vw, 7.1rem);
    }
  }

  @media (max-width: 520px) {
    .final-cta__canvas {
      min-height: 29.5rem;
      padding: 3rem 0 3rem;
    }

    .atlas-summary-link {
      top: 48%;
      font-size: 1.2rem;
    }

    .atlas-route-selector {
      grid-template-columns: 1fr 5.5rem 1fr;
      gap: .45rem;
      top: 64.5%;
    }

    .atlas-compass {
      width: 5.5rem;
    }

    .atlas-route__label {
      font-size: 1.02rem;
    }

    .atlas-route__direction {
      gap: .3rem;
    }

    .atlas-route__line {
      width: clamp(1.6rem, 8vw, 2.8rem);
    }
  }

  @media (max-width: 640px) {
    .final-cta__transition {
      height: 2.75rem;
    }

    .final-cta__inner {
      width: min(100% - 1.25rem, 1180px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .atlas-route,
    .atlas-route__line,
    .atlas-summary-link {
      transition: none;
    }
  }
</style>
