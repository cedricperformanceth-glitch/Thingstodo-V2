---
interface Props {
  slug: string;
  cityName: string;
  summary: string;
  fieldNote: string;
  active?: boolean;
}
const { slug, cityName, summary, fieldNote, active = false } = Astro.props;
const cityId = cityName.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---

<article
  class:list={['spa-panel', { 'is-active': active }]}
  id={`spa-panel-${cityId}-${slug}`}
  role="tabpanel"
  tabindex="-1"
  data-spa-panel={slug}
  hidden={!active}
>
  <header class="spa-panel__header">
    <p>{summary}</p>
    <div class="spa-panel__chapter">
      <span>FIELD NOTE</span>
      <strong>{fieldNote}</strong>
    </div>
  </header>

  <div class="spa-panel__divider" aria-hidden="true">
    <span></span><small>OPEN THE CARDS FOR THE FULL FIELD NOTE</small><span></span>
  </div>

  <div class="spa-panel__content"><slot /></div>
</article>

<style>
  .spa-panel[hidden]{display:none}
  .spa-panel{outline:none;animation:spa-panel-in 220ms cubic-bezier(.22,.75,.2,1) both}
  .spa-panel__header{position:relative;display:grid;place-items:start center;min-height:2.7rem;margin-top:clamp(-3.25rem,-3.5vw,-2.55rem)}
  .spa-panel__header p{max-width:calc(100% - 10rem);margin:.12rem auto 0;color:#315545;font-family:var(--handwritten);font-size:clamp(1.15rem,1.8vw,1.55rem);line-height:1;text-align:center;white-space:nowrap;transform:rotate(-.65deg)}
  .spa-panel__chapter{position:absolute;top:-.1rem;right:0;display:flex;gap:.45rem;align-items:baseline;color:#315545}
  .spa-panel__chapter span{color:rgba(31,57,45,.48);font:700 .47rem/1 'DM Sans',var(--sans);letter-spacing:.15em}
  .spa-panel__chapter strong{font:500 clamp(1.25rem,1.8vw,1.7rem)/1 Fraunces,var(--serif)}
  .spa-panel__divider{display:grid;grid-template-columns:1fr auto 1fr;gap:.7rem;align-items:center;margin:.85rem 0 clamp(1.15rem,2vw,1.65rem)}
  .spa-panel__divider span{height:1px;background:rgba(49,85,69,.18)}
  .spa-panel__divider small{color:rgba(31,57,45,.44);font:700 .45rem/1 'DM Sans',var(--sans);letter-spacing:.13em}
  .spa-panel__content :global(.spa-card-grid){display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(.78rem,1.35vw,1.08rem);align-items:stretch}
  .spa-panel__content :global(.spa-empty){padding:clamp(2.2rem,4vw,3.5rem);border:1px dashed rgba(49,85,69,.3);background:rgba(255,252,245,.45);text-align:center}
  .spa-panel__content :global(.spa-empty h4){margin:0 0 .7rem;color:#315545;font:500 clamp(1.55rem,2.6vw,2.2rem)/1.1 Fraunces,var(--serif)}
  .spa-panel__content :global(.spa-empty p){max-width:36rem;margin:0 auto;color:rgba(31,41,36,.65);line-height:1.6}
  @keyframes spa-panel-in{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:translateY(0)}}
  @media(max-width:1120px){.spa-panel__content :global(.spa-card-grid){grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:760px){.spa-panel__header{min-height:2.45rem;margin-top:-2.75rem;place-items:start}.spa-panel__header p{max-width:calc(100% - 7rem);margin:.2rem 0 0;overflow:hidden;font-size:1.05rem;text-align:left;text-overflow:ellipsis;white-space:nowrap}.spa-panel__chapter span{display:none}.spa-panel__divider{grid-template-columns:1fr;margin-top:.65rem;text-align:left}.spa-panel__divider span{display:none}.spa-panel__content :global(.spa-card-grid){grid-template-columns:1fr}}
  @media(prefers-reduced-motion:reduce){.spa-panel{animation:none}}
</style>
