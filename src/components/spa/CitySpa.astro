---
import type { CategorySlug, City } from '../../core/models/types';
import { getPlaces, getThings } from '../../engines/category/category-engine';
import { getSpaTabs } from '../../engines/spa/spa-engine';
import PlaceCard from '../cards/PlaceCard.astro';
import ThingToDoCard from '../cards/ThingToDoCard.astro';
import FavoritesPanel from './FavoritesPanel.astro';
import SpaCategoryIcon from './SpaCategoryIcon.astro';
import SpaPanel from './SpaPanel.astro';

interface Props { city: City; }
const { city } = Astro.props;
const tabs = getSpaTabs(city);
const defaultSlug = 'things-to-do';
const cityId = `${city.country}-${city.slug}`;
---

<section class="travel-desk" data-city-spa data-spa-default={defaultSlug} aria-labelledby={`${cityId}-travel-desk-title`}>
  <div class="travel-desk__transition" aria-hidden="true">
    <span></span>
    <p>Now for the practical side.</p>
    <small>EAT · SLEEP · EXPLORE · PREPARE THE ROAD AHEAD</small>
  </div>

  <div class="travel-desk__inner">
    <header class="travel-desk__heading">
      <p>THE PRACTICAL NOTEBOOK</p>
      <h2 id={`${cityId}-travel-desk-title`}>Plan your stay in {city.name}</h2>
    </header>

    <div class="travel-desk__board">
      <nav class="travel-desk__index" role="tablist" aria-label={`${city.name} guide categories`}>
        <p class="travel-desk__index-label">OPEN A SECTION</p>
        <div class="travel-desk__index-list">
          {tabs.map((tab, index) => {
            const selected = tab.slug === defaultSlug;
            return (
              <button
                class:list={['travel-desk-tab', { 'is-active': selected, 'is-favorites': tab.slug === 'favorites' }]}
                type="button"
                role="tab"
                aria-selected={selected}
                aria-controls={`spa-panel-${city.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}-${tab.slug}`}
                data-spa-tab={tab.slug}
              >
                <span class="travel-desk-tab__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <span class="travel-desk-tab__drawing" aria-hidden="true"><SpaCategoryIcon icon={tab.icon} /></span>
                <span class="travel-desk-tab__copy">
                  <strong>{tab.title}</strong>
                  <small data-favorites-count={tab.slug === 'favorites' ? '' : undefined}>{tab.countLabel}</small>
                </span>
                <span class="travel-desk-tab__arrow" aria-hidden="true">→</span>
              </button>
            );
          })}
        </div>
        <p class="travel-desk__index-note">One section stays open. Favorites travel with you across the Atlas.</p>
      </nav>

      <div class="travel-desk__paper">
        <span class="travel-desk__clip travel-desk__clip--top" aria-hidden="true"></span>
        <span class="travel-desk__clip travel-desk__clip--bottom" aria-hidden="true"></span>
        <div class="travel-desk__paper-rule" aria-hidden="true"></div>
        <div class="travel-desk__panels">
          {tabs.map((tab, index) => {
            const active = tab.slug === defaultSlug;
            const summary = tab.slug === 'favorites' ? 'Saved places from across your Atlas' : `${tab.countLabel} in ${city.name}`;
            if (tab.slug === 'favorites') {
              return (
                <SpaPanel slug={tab.slug} cityName={city.name} summary={summary} fieldNote={String(index + 1).padStart(2, '0')} {active}>
                  <FavoritesPanel currentCountry={city.country} />
                </SpaPanel>
              );
            }
            if (tab.slug === 'things-to-do') {
              const things = getThings(city);
              return (
                <SpaPanel slug={tab.slug} cityName={city.name} summary={summary} fieldNote={String(index + 1).padStart(2, '0')} {active}>
                  {things.length ? <div class="spa-card-grid">{things.map((thing) => <ThingToDoCard {city} {thing} />)}</div> : <div class="spa-empty"><h4>Nothing pinned here yet.</h4><p>This section will fill automatically when the city content is generated.</p></div>}
                </SpaPanel>
              );
            }
            const category = tab.slug as CategorySlug;
            const places = getPlaces(city, category);
            return (
              <SpaPanel slug={tab.slug} cityName={city.name} summary={summary} fieldNote={String(index + 1).padStart(2, '0')} {active}>
                {places.length ? <div class="spa-card-grid">{places.map((place) => <PlaceCard {city} {place} />)}</div> : <div class="spa-empty"><h4>Nothing pinned here yet.</h4><p>This section will fill automatically when the city content is generated.</p></div>}
              </SpaPanel>
            );
          })}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const initializeSpa = () => {
    document.querySelectorAll<HTMLElement>('[data-city-spa]').forEach((spa) => {
      if (spa.dataset.spaReady === 'true') return;
      spa.dataset.spaReady = 'true';

      const tabs = [...spa.querySelectorAll<HTMLButtonElement>('[data-spa-tab]')];
      const panels = [...spa.querySelectorAll<HTMLElement>('[data-spa-panel]')];
      const defaultSlug = spa.dataset.spaDefault ?? tabs[0]?.dataset.spaTab ?? '';

      const activate = (slug: string) => {
        tabs.forEach((tab) => {
          const active = tab.dataset.spaTab === slug;
          tab.classList.toggle('is-active', active);
          tab.setAttribute('aria-selected', active ? 'true' : 'false');
        });
        panels.forEach((panel) => {
          const active = panel.dataset.spaPanel === slug;
          panel.classList.toggle('is-active', active);
          panel.hidden = !active;
        });
      };

      tabs.forEach((tab) => tab.addEventListener('click', () => activate(tab.dataset.spaTab ?? defaultSlug)));
      activate(defaultSlug);
    });
  };

  initializeSpa();
  document.addEventListener('astro:page-load', initializeSpa);
</script>

<style>
  .travel-desk {
    --spa-paper: #eee8dc;
    --spa-paper-strong: #e4dccd;
    --spa-green: #315545;
    --spa-green-soft: #547264;
    --spa-rust: #b76645;
    --spa-blue: #306f85;
    --spa-ink: #262c29;
    --spa-muted: #6c716d;
    position: relative;
    overflow: hidden;
    padding: clamp(1.2rem, 2.5vw, 2.2rem) 0 clamp(4.6rem, 8vw, 7rem);
    background:
      radial-gradient(circle at 12% 18%,rgba(255,255,255,.055),transparent 25%),
      radial-gradient(circle at 88% 72%,rgba(183,102,69,.09),transparent 28%),
      linear-gradient(145deg,#263a31,#1f3129 62%,#1b2b24);
    color:#f7f2e7;
  }

  .travel-desk::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: .16;
    background-image: repeating-linear-gradient(0deg, transparent 0 5px, rgba(255,255,255,.025) 5px 6px);
    mix-blend-mode: soft-light;
  }

  .travel-desk__transition,
  .travel-desk__inner { position: relative; z-index: 1; }
  .travel-desk__transition {
    width: min(1180px, calc(100% - 2rem));
    margin: 0 auto clamp(2.8rem, 6vw, 5.5rem);
    text-align: center;
  }
  .travel-desk__transition span {
    display: block;
    width: min(5.5rem, 18vw);
    height: 1px;
    margin: 0 auto 1.3rem;
    background: rgba(247,242,231,.48);
  }
  .travel-desk__transition p {
    margin: 0;
    font: 500 clamp(1.5rem, 2.9vw, 2.35rem)/1.05 Caveat, cursive;
    letter-spacing: .01em;
  }
  .travel-desk__transition small {
    display: block;
    margin-top: .6rem;
    color: rgba(247,242,231,.62);
    font: 600 .64rem/1.2 'DM Sans', sans-serif;
    letter-spacing: .18em;
  }

  .travel-desk__inner { width: min(1180px, calc(100% - 2rem)); margin: 0 auto; }
  .travel-desk__heading { margin-bottom: 2rem; text-align: center; }
  .travel-desk__heading p { margin: 0 0 .55rem; color: #d6cdbd; font: 700 .66rem/1 'DM Sans', sans-serif; letter-spacing: .22em; }
  .travel-desk__heading h2 { margin: 0; font: 500 clamp(2rem, 4vw, 3.3rem)/1.02 Fraunces, serif; }

  .travel-desk__board {
    display: grid;
    grid-template-columns: minmax(13.5rem, 18rem) minmax(0, 1fr);
    align-items: stretch;
    gap: 0;
    min-height: 41rem;
    filter: drop-shadow(0 22px 28px rgba(6,13,10,.26));
  }
  .travel-desk__index {
    position: relative;
    padding: 2rem 0 1.7rem;
    background: #d9d0be;
    color: var(--spa-green);
    border: 1px solid rgba(24,52,40,.26);
    border-right: 0;
  }
  .travel-desk__index::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: .35;
    background: repeating-linear-gradient(0deg, transparent 0 12px, rgba(49,85,69,.04) 12px 13px);
  }
  .travel-desk__index-label,
  .travel-desk__index-note { position: relative; z-index: 1; padding: 0 1.4rem; }
  .travel-desk__index-label { margin: 0 0 1rem; font: 700 .61rem/1 'DM Sans', sans-serif; letter-spacing: .2em; }
  .travel-desk__index-note { margin: 1.3rem 0 0; color: #657066; font: 500 .66rem/1.45 'DM Sans', sans-serif; }
  .travel-desk__index-list { position: relative; z-index: 1; display: grid; }
  .travel-desk-tab {
    position: relative;
    width: calc(100% + .9rem);
    min-height: 4.25rem;
    display: grid;
    grid-template-columns: 2.3rem 3rem minmax(0,1fr) 1.25rem;
    align-items: center;
    gap: .45rem;
    margin: -1px -.9rem 0 0;
    padding: .45rem .8rem .45rem .65rem;
    border: 1px solid rgba(49,85,69,.22);
    background: #e8e0d1;
    color: var(--spa-green);
    text-align: left;
    cursor: pointer;
    transform-origin: right center;
    transition: transform .18s ease, background .18s ease, color .18s ease;
  }
  .travel-desk-tab:nth-child(2n) { transform: rotate(.22deg); }
  .travel-desk-tab:nth-child(3n) { transform: rotate(-.17deg); }
  .travel-desk-tab:hover { transform: translateX(.25rem) rotate(0); }
  .travel-desk-tab.is-active {
    z-index: 3;
    background: #f4eee3;
    color: #233f33;
    transform: translateX(.75rem) rotate(0);
    box-shadow: -4px 4px 0 rgba(49,85,69,.08);
  }
  .travel-desk-tab.is-favorites { border-top: 1px dashed rgba(183,102,69,.5); }
  .travel-desk-tab__number { color: var(--spa-rust); font: 700 .58rem/1 Fraunces, serif; }
  .travel-desk-tab__drawing { display: grid; place-items: center; }
  .travel-desk-tab__drawing :global(svg) { width: 2.45rem; height: 2.45rem; }
  .travel-desk-tab__copy { min-width: 0; display: grid; gap: .18rem; }
  .travel-desk-tab__copy strong { font: 600 .86rem/1.05 Fraunces, serif; }
  .travel-desk-tab__copy small { overflow: hidden; color: #6b756d; font: 600 .54rem/1.1 'DM Sans', sans-serif; text-overflow: ellipsis; white-space: nowrap; }
  .travel-desk-tab__arrow { font-size: 1rem; }

  .travel-desk__paper {
    position: relative;
    min-width: 0;
    padding: clamp(2rem, 4vw, 3.5rem);
    background:
      linear-gradient(rgba(238,232,220,.96), rgba(238,232,220,.96)),
      repeating-linear-gradient(0deg, transparent 0 23px, rgba(48,111,133,.07) 23px 24px);
    color: var(--spa-ink);
    border: 1px solid rgba(24,52,40,.25);
    box-shadow: inset 15px 0 18px rgba(49,85,69,.045);
  }
  .travel-desk__paper::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 4.25rem;
    width: 1px;
    background: rgba(183,102,69,.16);
    pointer-events: none;
  }
  .travel-desk__paper-rule { position: absolute; inset: 0; pointer-events: none; opacity: .32; background: radial-gradient(circle at 80% 8%, rgba(49,85,69,.09), transparent 18%); }
  .travel-desk__clip { position: absolute; left: -1.55rem; width: 3rem; height: .72rem; border: 2px solid rgba(82,82,72,.45); border-radius: 999px; transform: rotate(90deg); }
  .travel-desk__clip--top { top: 5.5rem; }
  .travel-desk__clip--bottom { bottom: 5.5rem; }
  .travel-desk__panels { position: relative; z-index: 1; min-height: 100%; }
  .spa-card-grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 1rem; }
  .spa-empty {
    max-width: 31rem;
    margin: 5rem auto;
    padding: 2rem;
    text-align: center;
    border: 1px dashed rgba(49,85,69,.32);
    background: rgba(255,255,255,.15);
  }
  .spa-empty h4 { margin: 0 0 .55rem; color: var(--spa-green); font: 600 1.25rem/1.15 Fraunces, serif; }
  .spa-empty p { margin: 0; color: var(--spa-muted); font-size: .78rem; line-height: 1.55; }

  @media (max-width: 1120px) {
    .spa-card-grid { grid-template-columns: repeat(2, minmax(0,1fr)); }
  }
  @media (max-width: 760px) {
    .travel-desk { padding-bottom: 4rem; }
    .travel-desk__inner, .travel-desk__transition { width: min(100% - 1.25rem, 1180px); }
    .travel-desk__board { display: block; min-height: 0; filter: none; }
    .travel-desk__index { padding: 1.2rem 0; border-right: 1px solid rgba(24,52,40,.26); }
    .travel-desk__index-list { display: flex; gap: .45rem; overflow-x: auto; padding: .15rem .75rem .55rem; scroll-snap-type: x proximity; }
    .travel-desk-tab,
    .travel-desk-tab:nth-child(2n),
    .travel-desk-tab:nth-child(3n) {
      flex: 0 0 10.5rem;
      width: 10.5rem;
      min-height: 4.8rem;
      grid-template-columns: 1.8rem 2.5rem minmax(0,1fr);
      margin: 0;
      padding: .5rem;
      transform: none;
      scroll-snap-align: start;
    }
    .travel-desk-tab:hover,
    .travel-desk-tab.is-active { transform: translateY(-.15rem); }
    .travel-desk-tab__arrow { display: none; }
    .travel-desk-tab__drawing :global(svg) { width: 2rem; height: 2rem; }
    .travel-desk__index-note { display: none; }
    .travel-desk__paper { min-height: 32rem; padding: 2rem .8rem 2.5rem; border-top: 0; box-shadow: none; }
    .travel-desk__paper::after { left: 2.65rem; }
    .travel-desk__clip { display: none; }
    .spa-card-grid { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .travel-desk-tab { transition: none; }
  }
</style>
