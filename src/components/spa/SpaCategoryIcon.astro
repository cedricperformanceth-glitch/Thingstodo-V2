{icon === 'explore' && (
  <svg viewBox="0 0 160 120" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><circle cx="54" cy="66" r="24" stroke-width="3"/><circle cx="106" cy="66" r="24" stroke-width="3"/><path d="M75 52h10M66 57l9-5M94 57l-9-5M75 52v14M85 52v14" stroke-width="3"/><path d="M28 66H16M144 66h-12M80 29V14" stroke-width="2.2"/><path d="M43 96c24 6 49 6 74 0" stroke-width="1.4" opacity=".5"/><path d="M48 39 39 25M112 39l9-14" stroke-width="2"/></g></svg>
