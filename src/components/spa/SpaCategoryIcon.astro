)}

{icon === 'markets' && (
  <svg viewBox="0 0 160 120" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M34 48h92l-12 58H46Z" stroke-width="3"/><path d="M55 49c2-22 12-34 25-34s23 12 25 34" stroke-width="3"/><path d="M49 63h66M46 78h72M43 93h73" stroke-width="1.8"/><path d="M58 49v57M77 49v57M96 49v57M114 49v57" stroke-width="1.5" opacity=".75"/><path d="M34 111c30 3 62 3 94 0" stroke-width="1.4" opacity=".5"/></g></svg>
