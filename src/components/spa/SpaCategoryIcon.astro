---
import type { SpaTabIcon } from '../../engines/spa/spa-engine';
interface Props { icon: SpaTabIcon; }
const { icon } = Astro.props;
---

{icon === 'restaurants' && (
  <svg viewBox="0 0 160 120" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M25 55c4 29 20 44 50 44s46-15 50-44" stroke-width="3.2"/><path d="M21 52c8-10 24-14 54-14s46 4 54 14c-8 10-24 14-54 14S29 62 21 52Z" stroke-width="3.2"/><path d="M36 55c10-6 20-7 39-7s31 2 42 8M42 60c8-10 16-9 25 0 8-10 16-10 25 0 7-8 15-8 22-1" stroke-width="2"/><path d="M93 42 130 9M101 46l37-28" stroke-width="4"/><path d="M59 31c-7-9-3-17 2-23M73 31c-6-9-2-18 3-25M86 32c-5-8-1-15 4-21" stroke-width="2"/><path d="M36 106c23 4 49 4 76 0" stroke-width="1.4" opacity=".5"/></g></svg>
)}

{icon === 'cafes' && (
  <svg viewBox="0 0 160 120" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M35 43h68v35c0 14-11 25-25 25H60c-14 0-25-11-25-25Z" stroke-width="3"/><path d="M103 51h12c11 0 18 7 18 16s-7 16-18 16h-12" stroke-width="3"/><path d="M31 43h77M43 107h72" stroke-width="2"/><path d="M57 32c-7-9 4-14-1-23M76 32c-8-10 5-15 0-25M94 32c-6-8 4-13 1-21" stroke-width="2.3"/><path d="M49 54c15 5 30 5 44 0" stroke-width="1.4" opacity=".6"/></g></svg>
)}

{icon === 'guesthouses' && (
