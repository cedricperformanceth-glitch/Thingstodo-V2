)}

{icon === 'favorites' && (
  <svg viewBox="0 0 160 120" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M80 103 32 59C11 38 22 15 45 15c15 0 26 9 35 21 9-12 20-21 35-21 23 0 34 23 13 44Z" stroke-width="3"/><path d="M49 27c7-5 16-5 23 1" stroke-width="1.5" opacity=".55"/><path d="M46 110c23 3 48 3 72 0" stroke-width="1.4" opacity=".45"/></g></svg>
