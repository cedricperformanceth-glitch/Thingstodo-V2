---
import type { CityHeroDisplayFact } from '../../engines/hero/hero-facts';
import type { CityHeroPartner } from '../../engines/hero/hero-partners';

interface Props {
  stampSrc: string;
  photoSrc: string;
  facts: CityHeroDisplayFact[];
  partners: readonly CityHeroPartner[];
  cityName: string;
  messageLines: string[];
}

const { stampSrc, photoSrc, facts, partners, cityName, messageLines } = Astro.props;
const envelopeSource = '/assets/shared/hero/envelope/airmail-postcard-template.webp';
---

<div class="city-hero-envelope" style={`--city-hero-envelope-source: url("${envelopeSource}")`}>
  <span class="city-hero-envelope__base" aria-hidden="true"></span>

  <div class="city-hero-envelope__media-frame">
    <div class="city-hero-envelope__media">
      <figure class="city-hero-envelope__photo" aria-hidden="true">
        <img src={photoSrc} alt="" width="1600" height="1100" fetchpriority="high" />
      </figure>

      <div class="city-hero-envelope__facts" aria-hidden="true">
        {facts.map((fact) => (
          <span>
            {fact.icon === 'calendar' && (
              <svg viewBox="0 0 18 18"><rect x="3" y="4" width="12" height="11" rx="1.2"/><path d="M6 2.5v3M12 2.5v3M3 7h12"/></svg>
            )}
            {fact.icon === 'road' && (
              <svg viewBox="0 0 18 18"><rect x="3" y="4" width="12" height="8" rx="1.5"/><path d="M5 12v2M13 12v2M5 7h8M6 4V2.8M12 4V2.8"/></svg>
            )}
            {fact.icon === 'climate' && (
              <svg viewBox="0 0 18 18"><circle cx="9" cy="9" r="3.2"/><path d="M9 1.8v2M9 14.2v2M1.8 9h2M14.2 9h2M3.9 3.9l1.4 1.4M12.7 12.7l1.4 1.4M14.1 3.9l-1.4 1.4M5.3 12.7l-1.4 1.4"/></svg>
            )}
            {fact.icon === 'location' && (
              <svg viewBox="0 0 18 18"><path d="M9 16s5-4.6 5-9A5 5 0 0 0 4 7c0 4.4 5 9 5 9Z"/><circle cx="9" cy="7" r="1.7"/></svg>
            )}
            {fact.text}
          </span>
        ))}
      </div>

      <div class="city-hero-envelope__partners">
        {partners.length > 0 && (
          <>
            <span class="city-hero-envelope__partners-label">Partner with</span>
            <div class="city-hero-envelope__partner-links">
              {partners.map((partner) => (
                <a
                  class="city-hero-envelope__partner-link"
                  href={partner.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Open partner site ${partner.label}`}
                >
                  <span>{partner.label}</span>
                  <b aria-hidden="true">↗</b>
                </a>
              ))}
            </div>
          </>
        )}
      </div>
    </div>
  </div>

  <div class="city-hero-envelope__message-frame" aria-hidden="true">
    <span class="city-hero-envelope__city-name">{cityName}</span>
    <p class="city-hero-envelope__description">
      {messageLines.map((line) => <span>{line}</span>)}
    </p>
  </div>

  <img class="city-hero-envelope__city-stamp" src={stampSrc} alt="" aria-hidden="true" />
  <img class="city-hero-envelope__air-mail" src="/assets/shared/hero/postmarks/air-mail-par-avion.webp" alt="" aria-hidden="true" />
</div>

<style>
  .city-hero-envelope {
    --envelope-rule-start: 51.5%;
    position: relative;
    width: 100%;
    aspect-ratio: 2.15 / 1;
    isolation: isolate;
  }

  .city-hero-envelope__base {
    position: absolute;
    inset: 0;
    display: block;
    background: transparent var(--city-hero-envelope-source) center / 100% 100% no-repeat;
    pointer-events: none;
    clip-path: inset(7% 3.4% 6.8% 3.4%);
  }

  /* V1 media geometry, expressed once inside the shared envelope. */
  .city-hero-envelope__media-frame {
    --media-scale: .6;
    --media-size: 166.667%;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 47%) minmax(0, 53%);
    width: var(--media-size);
    height: var(--media-size);
    box-sizing: border-box;
    padding: clamp(2rem, 3vw, 2.7rem);
    pointer-events: none;
    transform: scale(var(--media-scale)) rotate(-.15deg);
    transform-origin: top left;
  }

  .city-hero-envelope__media {
    grid-column: 1;
    display: flex;
    width: 103%;
    min-width: 0;
    flex-direction: column;
    padding: .7rem clamp(1.15rem, 2vw, 1.65rem) .45rem .55rem;
    transform: translate(3.15rem, 2.15rem);
    transform-origin: top left;
  }

  .city-hero-envelope__photo {
    position: relative;
    margin: 0;
    padding: .28rem;
    background: #fff;
    box-sizing: border-box;
    transform: rotate(.45deg);
  }

  .city-hero-envelope__photo img {
    display: block;
    width: 100%;
    height: 19.15rem;
    object-fit: cover;
    object-position: center;
    filter: saturate(.88) contrast(.97);
  }

  .city-hero-envelope__facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .72rem 1.3rem;
    margin: 1.05rem 0 0 .2rem;
    color: rgba(31, 57, 45, .76);
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: 1.18rem;
    line-height: 1.15;
  }

  .city-hero-envelope__facts span {
    display: inline-flex;
    min-width: 0;
    align-items: center;
    gap: .35rem;
    white-space: nowrap;
  }

  .city-hero-envelope__facts svg {
    width: 1.36rem;
    height: 1.36rem;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: .8;
  }

  /*
   * The partnership slot is structural and always reserves the same space.
   * Partner content is optional, manually supplied per destination, and capped at two.
   */
  .city-hero-envelope__partners {
    width: calc(100% - .35rem);
    height: 5.1rem;
    margin: .95rem 0 0 .2rem;
    pointer-events: auto;
  }

  .city-hero-envelope__partners-label {
    display: block;
    margin: 0 0 .32rem .04rem;
    color: rgba(31, 57, 45, .58);
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: .92rem;
    line-height: 1;
    transform: rotate(-.65deg);
    transform-origin: left center;
  }

  .city-hero-envelope__partner-links {
    display: grid;
    gap: .3rem;
    width: min(19rem, 100%);
  }

  .city-hero-envelope__partner-link {
    position: relative;
    display: block;
    min-width: 0;
    padding: .08rem 1.25rem .22rem .05rem;
    border-bottom: 1px solid rgba(49, 85, 69, .45);
    color: #315545;
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: .86rem;
    font-weight: 600;
    line-height: 1.05;
    text-decoration: none;
    white-space: nowrap;
    transition: color .15s ease, border-color .15s ease;
  }

  .city-hero-envelope__partner-link::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    height: .62rem;
    border-right: 1px solid rgba(49, 85, 69, .45);
  }

  .city-hero-envelope__partner-link span {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .city-hero-envelope__partner-link b {
    position: absolute;
    right: -.03rem;
    bottom: .43rem;
    z-index: 1;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: .88rem;
    font-weight: 400;
    line-height: 1;
    transform: translate(38%, -10%);
  }

  .city-hero-envelope__partner-link:hover,
  .city-hero-envelope__partner-link:focus-visible {
    border-color: #b76645;
    color: #8a4d36;
    outline: none;
  }

  .city-hero-envelope__partner-link:hover::after,
  .city-hero-envelope__partner-link:focus-visible::after {
    border-color: #b76645;
  }

  /*
   * The original V1 postcard rendered its content on a 166.667% surface
   * scaled back to 60%. Reproducing that coordinate system here lets the
   * handwritten copy use the original line metrics without visual guesswork.
   */
  .city-hero-envelope__message-frame {
    --message-scale: .6;
    --message-size: 166.667%;
    --envelope-line-gap: 3.56rem;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    width: var(--message-size);
    height: var(--message-size);
    pointer-events: none;
    transform: scale(var(--message-scale));
    transform-origin: top left;
  }

  .city-hero-envelope__city-name {
    position: absolute;
    top: calc(46.5% + .19rem);
    left: var(--envelope-rule-start);
    margin: 0;
    color: #315545;
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: 3.58rem;
    font-weight: 600;
    letter-spacing: -.035em;
    line-height: var(--envelope-line-gap);
    white-space: nowrap;
    transform: translateY(-.28rem) rotate(-.8deg);
  }

  .city-hero-envelope__description {
    position: absolute;
    top: calc(46.5% + 1.14rem + var(--envelope-line-gap));
    left: calc(var(--envelope-rule-start) + .55em);
    width: calc(96% - var(--envelope-rule-start) - .55em);
    margin: 0;
    color: #3f4943;
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: 1.11rem;
    font-weight: 500;
    letter-spacing: 0;
    line-height: var(--envelope-line-gap);
    transform: translateY(-.22rem) rotate(-.25deg);
  }

  .city-hero-envelope__description span { display: block; white-space: nowrap; }

  .city-hero-envelope__city-stamp {
    position: absolute;
    top: 7.51953%;
    left: 79.49219%;
    z-index: 3;
    display: block;
    width: 11.65365%;
    height: 26.46484%;
    object-fit: fill;
    pointer-events: none;
  }

  .city-hero-envelope__air-mail {
    position: absolute;
    top: calc(27.5% - 28px);
    right: 27%;
    z-index: 4;
    display: block;
    width: 19%;
    aspect-ratio: 360 / 168;
    object-fit: contain;
    opacity: .76;
    pointer-events: none;
    mix-blend-mode: multiply;
    filter: contrast(1.32) brightness(1.08) saturate(1.05);
    transform: rotate(-6deg);
    transform-origin: center;
  }

  @media (max-width: 980px) and (min-width: 761px) {
    .city-hero-envelope__media-frame { --media-scale: .8; --media-size: 125%; }
    .city-hero-envelope__media { width: 102%; transform: translate(2.25rem, 1.55rem); }
    .city-hero-envelope__photo img { height: 16.2rem; }
    .city-hero-envelope__facts { font-size: 1rem; }
    .city-hero-envelope__facts svg { width: 1.05rem; height: 1.05rem; }
    .city-hero-envelope__partners { height: 4.55rem; margin-top: .75rem; }
    .city-hero-envelope__partners-label { font-size: .78rem; }
    .city-hero-envelope__partner-link { font-size: .74rem; }

    .city-hero-envelope__message-frame {
      --message-scale: .8;
      --message-size: 125%;
      --envelope-line-gap: 3.42rem;
    }
    .city-hero-envelope__city-name { font-size: 3.42rem; }
    .city-hero-envelope__description { top: calc(46.5% + .9rem + var(--envelope-line-gap)); font-size: 1.08rem; }
  }

  @media (max-width: 760px) {
    .city-hero-envelope__media-frame {
      --media-scale: .6;
      --media-size: 166.667%;
      padding: 1.25rem;
    }
    .city-hero-envelope__media {
      width: 101%;
      padding: .35rem .8rem .3rem .2rem;
      transform: translate(1.4rem, 1.15rem);
    }
    .city-hero-envelope__photo { padding: .2rem; }
    .city-hero-envelope__photo img { height: 13rem; }
    .city-hero-envelope__facts { gap: .48rem .72rem; margin-top: .65rem; font-size: .96rem; }
    .city-hero-envelope__facts svg { width: 1.05rem; height: 1.05rem; }
    .city-hero-envelope__partners { height: 4.5rem; margin-top: .72rem; }
    .city-hero-envelope__partners-label { font-size: .78rem; }
    .city-hero-envelope__partner-link { font-size: .76rem; }

    .city-hero-envelope__message-frame {
      --message-scale: .6;
      --message-size: 166.667%;
      --envelope-line-gap: 2.84rem;
    }
    .city-hero-envelope__city-name { top: calc(46.5% + .1rem); font-size: 2.35rem; line-height: var(--envelope-line-gap); }
    .city-hero-envelope__description { top: calc(46.5% + .62rem + var(--envelope-line-gap)); font-size: .88rem; line-height: var(--envelope-line-gap); }
    .city-hero-envelope__air-mail { top: calc(26% - 28px); right: 23%; width: 22%; }
  }
</style>
