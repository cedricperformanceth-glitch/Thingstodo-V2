---
interface Props {
  stampSrc: string;
}

const { stampSrc } = Astro.props;
const envelopeSource = '/assets/shared/hero/envelope/airmail-postcard-template.webp';
---

<div class="city-hero-envelope" aria-hidden="true" style={`--city-hero-envelope-source: url("${envelopeSource}")`}>
  <span class="city-hero-envelope__base"></span>
  <span class="city-hero-envelope__city-stamp-zone">
    <img class="city-hero-envelope__city-stamp" src={stampSrc} alt="" />
  </span>
  <img class="city-hero-envelope__air-mail" src="/assets/shared/hero/postmarks/air-mail-par-avion.webp" alt="" />
</div>

<style>
  .city-hero-envelope {
    --envelope-rule-start: 55%;
    position: relative;
    width: 100%;
    aspect-ratio: 2.15 / 1;
    isolation: isolate;
  }

  .city-hero-envelope__base {
    position: absolute;
    inset: 0;
    display: block;
    background: transparent var(--city-hero-envelope-source) center / 100% 100% no-repeat;
    pointer-events: none;
    clip-path: inset(7% 3.4% 6.8% 3.4%);
  }

  .city-hero-envelope__city-stamp-zone {
    position: absolute;
    top: 10.5%;
    left: 81.4%;
    z-index: 3;
    display: grid;
    width: 11.8%;
    height: 22.5%;
    place-items: center;
    pointer-events: none;
  }

  .city-hero-envelope__city-stamp {
    display: block;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    transform: translateY(4%);
  }

  .city-hero-envelope__air-mail {
    position: absolute;
    top: calc(27.5% - 28px);
    right: 27%;
    z-index: 4;
    display: block;
    width: 19%;
    aspect-ratio: 360 / 168;
    object-fit: contain;
    opacity: .76;
    pointer-events: none;
    mix-blend-mode: multiply;
    filter: contrast(1.32) brightness(1.08) saturate(1.05);
    transform: rotate(-6deg);
    transform-origin: center;
  }

  @media (max-width: 760px) {
    .city-hero-envelope__air-mail {
      top: calc(26% - 28px);
      right: 23%;
      width: 22%;
    }
  }
</style>
