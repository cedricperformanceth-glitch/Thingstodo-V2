---
import type { City } from '../../core/models/types';
import { getHero } from '../../engines/hero/hero-engine';
import CityHeroEnvelope from './CityHeroEnvelope.astro';

interface Props { city: City; }
const { city } = Astro.props;
const hero = getHero(city);
---

<section class="city-hero" aria-labelledby="city-title">
  <h1 id="city-title" class="city-hero__title">{hero.title}</h1>
  <div class="city-hero__semantic">
    <p>{hero.copy.messageLines.join(' ')}</p>
    <ul aria-label={`${city.name} travel facts`}>
      {hero.displayFacts.map((fact) => <li>{fact.text}</li>)}
    </ul>
    {hero.copy.drawingCaption && <p>{hero.copy.drawingCaption}</p>}
  </div>
  <div class="city-hero__layout">
    <CityHeroEnvelope
      stampSrc={hero.cityAssets.stamp}
      photoSrc={hero.cityAssets.photo}
      facts={hero.displayFacts}
      partners={hero.partners}
      cityName={city.name}
      messageLines={hero.copy.messageLines}
    />
    <div class="city-hero__drawing-area" aria-hidden="true">
      <figure class="city-hero__drawing">
        <img class="city-hero__drawing-image" src={hero.cityAssets.drawing} alt="" />
        {hero.copy.drawingCaption && <figcaption>{hero.copy.drawingCaption}</figcaption>}
      </figure>
    </div>
  </div>
</section>

<style>
  .city-hero {
    position: relative;
    width: calc(100vw - 2rem);
    max-width: none;
    margin-top: -2rem;
    margin-left: calc(50% - 50vw + 1rem);
    padding: clamp(5.6rem, 7vw, 6.8rem) 0 clamp(2.1rem, 3vw, 3rem);
  }

  .city-hero__layout {
    display: grid;
    grid-template-columns: clamp(43rem, calc(132vw - 45rem), 58rem) minmax(17rem, 18.25rem);
    align-items: center;
    justify-content: start;
    gap: clamp(.8rem, 1.35vw, 1.25rem);
  }

  .city-hero__title,
  .city-hero__semantic {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .city-hero__drawing-area {
    display: flex;
    width: 18.25rem;
    align-items: center;
    justify-content: center;
  }

  .city-hero__drawing {
    width: 18rem;
    max-width: 100%;
    margin: 0 auto;
    pointer-events: none;
    transform: rotate(-2deg);
  }

  .city-hero__drawing-image {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .city-hero__drawing figcaption {
    margin: 0;
    color: rgba(31, 57, 45, .58);
    font-family: 'Segoe Print', 'Bradley Hand', cursive;
    font-size: .66rem;
    letter-spacing: .02em;
    text-align: center;
    transform: rotate(1deg);
  }

  @media (min-width: 981px) {
    .city-hero__drawing figcaption { font-size: .59rem; }
  }

  @media (max-width: 980px) {
    .city-hero__layout { grid-template-columns: 1fr; gap: 1.25rem; }
    .city-hero__drawing-area { margin-inline: auto; }
  }

  @media (max-width: 760px) {
    .city-hero { padding-top: 4.3rem; }
    .city-hero__drawing-area { width: min(16.5rem, 88vw); }
    .city-hero__drawing { width: 100%; }
  }
</style>
