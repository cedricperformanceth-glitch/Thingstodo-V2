---
import type { City } from '../../core/models/types';
import { getHero } from '../../engines/hero/hero-engine';
import CityHeroEnvelope from './CityHeroEnvelope.astro';

interface Props { city: City; }
const { city } = Astro.props;
const hero = getHero(city);
---

<section class={`city-hero city-hero--${hero.presentation.heroScale}`} aria-labelledby="city-title">
  <h1 id="city-title" class="city-hero__title">{hero.title}</h1>
  <CityHeroEnvelope />
</section>

<style>
  .city-hero { width: min(100%, 1120px); margin-inline: auto; }
  .city-hero__title { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .city-hero--compact { max-width: 960px; }
  .city-hero--standard { max-width: 1040px; }
  .city-hero--large { max-width: 1120px; }
</style>
