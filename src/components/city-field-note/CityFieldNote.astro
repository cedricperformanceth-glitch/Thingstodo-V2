---
import type { City, Country, MediaRecord } from '../../core/models/types';
import { cityFieldNoteView } from '../../engines/city-field-note/city-field-note-engine';
import { cityPath } from '../../core/routing/paths';
import AdSlot from '../shared/AdSlot.astro';

interface Props { city: City; country: Country; }
const { city, country } = Astro.props;
const view = cityFieldNoteView(city, country);
const heroSections = view.chapters.slice(0, 4);
const heroImage = view.media[0];
const galleryImages = view.media.slice(1, 3);
const chapterSevenImage = view.media[3];
const categoryDetails: Record<string, string> = {
  'things-to-do': 'Activities, rides & river days',
  restaurants: 'Where to eat',
  cafes: 'Coffee, breakfast & slow stops',
  accommodation: 'Where to stay',
};
const categoryLinks = city.categories.slice(0, 4).map((category) => ({
  label: category === 'things-to-do' ? 'Things to do' : category.split('-').map((part) => `${part.charAt(0).toUpperCase()}${part.slice(1)}`).join(' '),
  detail: categoryDetails[category] ?? 'Open this section in the practical notebook',
  href: `${cityPath(city)}#${category}`,
}));
const adIndexes = new Map([[1, view.adSlots[0]], [4, view.adSlots[1]], [6, view.adSlots[2]]]);
const credit = (image: MediaRecord) => [image.author || image.sourceName, image.license].filter(Boolean).join(' · ');
const sourcePhotos = view.media.filter((photo, index, list) => list.findIndex((candidate) => (candidate.sourceUrl || candidate.src || candidate.id) === (photo.sourceUrl || photo.src || photo.id)) === index);
---

<article class="city-note" aria-labelledby="city-note-title">
  <header class="city-note__hero">
    <div class="city-note__hero-copy">
      <p class="city-note__kicker">{view.typeLabel}</p>
      <h1 id="city-note-title">{view.title}</h1>
      <p class="city-note__context">{view.contextLine}</p>
      <p class="city-note__deck">{view.subtitle}</p>
      <div class="city-note__read" aria-label={`${city.name} guide chapters`}>
        <span>READ THE CITY</span>
        <ol>{heroSections.map((section, index) => <li><b>{String(index + 1).padStart(2, '0')}</b>{section.title}</li>)}</ol>
      </div>
      <div class="city-note__stamp" aria-label={`${city.name} field note`}><span>CITY FIELD NOTE</span><strong>Before you begin</strong><small>{city.name} · {country.name}</small></div>
    </div>
    <figure class="city-note__hero-visual">
      {heroImage ? <img src={heroImage.src} alt={heroImage.alt} width="1800" height="1200" fetchpriority="high" /> : <div class="city-note__hero-placeholder" role="img" aria-label={`Editorial hero photo to add for ${city.name}`}><span>FIELD PHOTO</span><strong>Editorial media to add</strong><small>{city.name} · exact-place image</small></div>}
      <figcaption><span>{view.intro}</span>{heroImage && <small>{heroImage.sourceUrl ? <a href={heroImage.sourceUrl} target="_blank" rel="noreferrer">{credit(heroImage)}</a> : credit(heroImage)}</small>}</figcaption>
    </figure>
  </header>

  <section class="city-note__quick" aria-label={`${city.name} guide overview`}>
    {view.quickRead.map((item) => <div><span>{item.label}</span><strong>{item.value}</strong><small>{item.detail}</small></div>)}
  </section>

  <div class="city-note__chapters">
    {view.chapters.map((chapter, index) => {
      const isChapterSevenPhoto = index === 6 || chapter.photoSlot;
      const hasSupport = Boolean(isChapterSevenPhoto || (chapter.facts && chapter.facts.length) || chapter.note);
      const adSlot = adIndexes.get(index);
      return <>
        <section class:list={['city-note__chapter', { 'city-note__chapter--reverse': index % 2 === 1 && hasSupport }, { 'city-note__chapter--solo': !hasSupport }]}>
          <div class="city-note__chapter-copy"><p class="city-note__section-label">{chapter.eyebrow}</p><h2>{chapter.title}</h2><div class="city-note__prose">{chapter.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div></div>
          {isChapterSevenPhoto ? <figure class="city-note__chapter-photo">
            {chapterSevenImage ? <img src={chapterSevenImage.src} alt={chapterSevenImage.alt} width="1200" height="900" loading="lazy" decoding="async" /> : <div class="city-note__chapter-photo-placeholder" role="img" aria-label={`Editorial chapter photo to add for ${city.name}`}><span>FIELD PHOTO 04</span><strong>Editorial image to add</strong></div>}
            <figcaption><span>{chapterSevenImage ? chapterSevenImage.alt : 'Chapter seven editorial photo'}</span>{chapterSevenImage && <small>{chapterSevenImage.sourceUrl ? <a href={chapterSevenImage.sourceUrl} target="_blank" rel="noreferrer">{credit(chapterSevenImage)}</a> : credit(chapterSevenImage)}</small>}</figcaption>
          </figure> : hasSupport && <aside class="city-note__chapter-side">{chapter.facts && chapter.facts.length > 0 && <><h3>Keep close</h3><dl class="city-note__facts">{chapter.facts.map((fact) => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}</dl></>}{chapter.note && <div class="city-note__note"><span>{chapter.note.label}</span><p>{chapter.note.text}</p></div>}</aside>}
        </section>
        {index === 2 && <section class="city-note__photo-spread" aria-label={`${city.name} field photographs`}>{(galleryImages.length ? galleryImages : [undefined, undefined]).map((image, imageIndex) => <figure class="city-note__photo-card">{image ? <img src={image.src} alt={image.alt} width="1200" height="900" loading="lazy" decoding="async" /> : <div class="city-note__photo-placeholder"><span>FIELD PHOTO {String(imageIndex + 1).padStart(2, '0')}</span></div>}<figcaption><span>{image ? image.alt : 'Editorial image to add'}</span>{image && <small>{image.sourceUrl ? <a href={image.sourceUrl} target="_blank" rel="noreferrer">{credit(image)}</a> : credit(image)}</small>}</figcaption></figure>)}</section>}
        {adSlot && <AdSlot slot={adSlot} />}
      </>;
    })}
  </div>

  <section class="city-note__closing">
    <p class="city-note__section-label">{view.closing.eyebrow}</p><h2>{view.closing.title}</h2><p>{view.closing.text}</p>
    <div class="city-note__next">
      <a class="city-note__next-featured" href={cityPath(city)}>
        <span class="city-note__next-kicker">RETURN TO THE ISLAND</span>
        <span class="city-note__next-featured-copy"><strong>Explore {city.name}</strong><small>Destination overview · Explore Board</small></span>
        <span class="city-note__next-arrow" aria-hidden="true">↗</span>
      </a>
      <div class="city-note__next-grid">
        {categoryLinks.map((link, index) => <a class="city-note__next-card" href={link.href}>
          <span class="city-note__next-number">{String(index + 1).padStart(2, '0')}</span>
          <span class="city-note__next-card-copy"><strong>{link.label}</strong><small>{link.detail}</small></span>
          <span class="city-note__next-arrow" aria-hidden="true">→</span>
        </a>)}
      </div>
    </div>
  </section>

  <section class="city-note__method" aria-label="City field note method and sources">
    <p class="city-note__method-copy"><strong>Field note method.</strong> Destination context is generated from the Atlas city structure, then checked and expanded during the editorial pass with official, local and specialist sources where possible. Independent travel reporting is used to identify practical questions and traveller perspective; its wording is not copied.</p>
    <details class="city-note__sources">
      <summary>Sources &amp; photo licences</summary>
      <div class="city-note__source-grid">
        <section><h3>Research sources</h3>{view.sources.length ? <ul>{view.sources.map((source) => <li><a href={source.sourceUrl} target="_blank" rel="noreferrer">{source.sourceName} ↗</a></li>)}</ul> : <p>No external research source is recorded for this city note.</p>}</section>
        <section><h3>Photo licences</h3>{sourcePhotos.length ? <ul>{sourcePhotos.map((photo) => <li>{photo.sourceUrl ? <a href={photo.sourceUrl} target="_blank" rel="noreferrer">{photo.author || photo.sourceName || 'Photo source'}{photo.license ? ` · ${photo.license}` : ''} ↗</a> : <span>{photo.author || photo.sourceName || 'Photo source'}{photo.license ? ` · ${photo.license}` : ''}</span>}</li>)}</ul> : <p>No external photo licence is recorded for this city note.</p>}</section>
      </div>
    </details>
  </section>
</article>

<style>
  .city-note{--note-paper:var(--field-card-page);--note-paper-soft:var(--field-card-sheet);--note-ink:#252923;--note-muted:#70766d;--note-green:#315545;--note-green-dark:#203c31;--note-terracotta:#b76645;--note-line:rgb(49 85 69/.2);width:min(1180px,calc(100% - 48px));margin-inline:auto;color:var(--note-ink);font-family:var(--field-card-practical)}
  .city-note__hero{display:grid;grid-template-columns:minmax(0,1.02fr) minmax(360px,.98fr);gap:clamp(42px,7vw,92px);align-items:center;padding:clamp(54px,8vw,96px) 0 56px}.city-note__kicker,.city-note__section-label{margin:0 0 12px;color:var(--note-terracotta);font-size:.69rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}.city-note h1,.city-note h2{margin:0;color:var(--note-green-dark);font-family:var(--field-card-title);font-weight:500}.city-note h1{max-width:760px;font-size:clamp(3.8rem,9vw,7.7rem);line-height:.88;letter-spacing:-.055em}.city-note__context{margin:18px 0 0;color:var(--note-green);font:600 clamp(1.05rem,2vw,1.45rem)/1.1 var(--field-card-handwritten)}.city-note__deck{max-width:680px;margin:24px 0 0;color:#4d554f;font:400 clamp(1rem,1.7vw,1.18rem)/1.7 var(--field-card-editorial)}
  .city-note__read{margin-top:34px;padding-top:18px;border-top:1px solid var(--note-line)}.city-note__read>span{display:block;margin-bottom:12px;color:var(--note-muted);font-size:.62rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}.city-note__read ol{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px 18px;margin:0;padding:0;list-style:none}.city-note__read li{display:flex;gap:8px;color:var(--note-green-dark);font:400 .82rem/1.35 var(--field-card-practical)}.city-note__read li b{color:var(--note-terracotta);font:600 1rem/1 var(--field-card-handwritten)}.city-note__stamp{display:inline-grid;margin-top:30px;padding:12px 18px 10px;border:1px solid rgb(183 102 69/.48);color:var(--note-terracotta);transform:rotate(-2deg)}.city-note__stamp span,.city-note__stamp small{font-size:.58rem;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.city-note__stamp strong{margin:2px 0;font:600 1.32rem/1 var(--field-card-handwritten)}
  .city-note__hero-visual{position:relative;margin:0;padding:13px 13px 30px;background:var(--note-paper-soft);box-shadow:6px 8px 0 rgb(49 85 69/.08),0 16px 34px rgb(32 60 49/.1);transform:rotate(1deg)}.city-note__hero-visual::before,.city-note__photo-card::before,.city-note__chapter-photo::before{content:'';position:absolute;z-index:2;background:rgb(205 188 148/.58);transform:rotate(-4deg)}.city-note__hero-visual::before{top:-10px;left:14%;width:86px;height:21px}.city-note__hero-visual img,.city-note__hero-placeholder{display:block;width:100%;height:clamp(390px,50vw,650px)}.city-note__hero-visual img{object-fit:cover;filter:saturate(.9) contrast(.96)}.city-note__hero-placeholder{display:grid;place-content:center;gap:7px;background:linear-gradient(145deg,#d9dfd5,#bcc8bc);color:var(--note-green);text-align:center}.city-note__hero-placeholder span,.city-note__hero-placeholder small{font-size:.6rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase}.city-note__hero-placeholder strong{font:500 clamp(1.45rem,2.8vw,2.2rem)/1 var(--field-card-title)}.city-note__hero-visual figcaption{padding:11px 6px 0;color:var(--note-green);font:600 1rem/1.15 var(--field-card-handwritten)}.city-note__hero-visual figcaption>span{display:block}.city-note__hero-visual figcaption small,.city-note__photo-card figcaption small,.city-note__chapter-photo figcaption small{display:block;margin-top:7px;color:var(--note-muted);font:700 .56rem/1.35 var(--field-card-practical);letter-spacing:.05em;text-transform:uppercase}.city-note figcaption a{color:inherit;text-underline-offset:.14rem}
  .city-note__quick{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin-bottom:clamp(72px,9vw,118px);border-block:1px solid var(--note-line)}.city-note__quick>div{min-height:118px;padding:20px 22px;border-right:1px solid var(--note-line)}.city-note__quick>div:last-child{border-right:0}.city-note__quick span{display:block;margin-bottom:7px;color:var(--note-muted);font-size:.62rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.city-note__quick strong{display:block;color:var(--note-green-dark);font:600 clamp(1.1rem,2vw,1.45rem)/1.05 var(--field-card-handwritten)}.city-note__quick small{display:block;margin-top:8px;color:var(--note-muted);font-size:.74rem;line-height:1.45}
  .city-note__chapters{display:grid;gap:clamp(72px,10vw,130px)}.city-note__chapter{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(260px,.7fr);gap:clamp(38px,7vw,88px);align-items:start}.city-note__chapter--reverse{grid-template-columns:minmax(260px,.7fr) minmax(0,1.3fr)}.city-note__chapter--reverse .city-note__chapter-copy{grid-column:2}.city-note__chapter--reverse .city-note__chapter-side{grid-column:1;grid-row:1}.city-note__chapter--solo{grid-template-columns:minmax(0,760px)}.city-note__chapter-copy{max-width:760px}.city-note__chapter h2,.city-note__closing h2{max-width:720px;font-size:clamp(2.15rem,4.5vw,4.15rem);line-height:.98;letter-spacing:-.035em}.city-note__prose{margin-top:24px}.city-note__prose p{margin:0;max-width:720px;color:#444c47;font:400 1rem/1.82 var(--field-card-editorial)}.city-note__prose p+p{margin-top:19px}
  .city-note__chapter-side{position:relative;padding:24px 25px 22px;background:var(--note-paper-soft);box-shadow:4px 6px 0 rgb(49 85 69/.07);transform:rotate(-.7deg)}.city-note__chapter--reverse .city-note__chapter-side{transform:rotate(.7deg)}.city-note__chapter-side::before{content:'';position:absolute;top:-8px;left:34px;width:64px;height:17px;background:rgb(205 188 148/.55);transform:rotate(-3deg)}.city-note__chapter-side h3{margin:0 0 18px;color:var(--note-green-dark);font:600 1.4rem/1 var(--field-card-handwritten)}.city-note__facts{display:grid;gap:15px;margin:0}.city-note__facts div{padding-top:13px;border-top:1px solid rgb(49 85 69/.12)}.city-note__facts dt{color:var(--note-green);font-size:.69rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.city-note__facts dd{margin:5px 0 0;color:#555e58;font:400 .8rem/1.55 var(--field-card-practical)}.city-note__note{margin-top:20px;padding-top:18px;border-top:1px dashed rgb(183 102 69/.35)}.city-note__note span{color:var(--note-terracotta);font-size:.62rem;font-weight:800;letter-spacing:.11em;text-transform:uppercase}.city-note__note p{margin:7px 0 0;color:var(--note-green-dark);font:600 1.1rem/1.3 var(--field-card-handwritten)}
  .city-note__chapter-photo{position:relative;margin:12px 0 0;padding:10px 10px 24px;background:var(--note-paper-soft);box-shadow:5px 7px 0 rgb(49 85 69/.065),0 14px 28px rgb(32 60 49/.08);transform:rotate(1deg)}.city-note__chapter-photo::before{top:-8px;left:31%;width:72px;height:17px}.city-note__chapter-photo img,.city-note__chapter-photo-placeholder{display:block;width:100%;height:clamp(250px,28vw,380px)}.city-note__chapter-photo img{object-fit:cover;filter:saturate(.88) contrast(.97)}.city-note__chapter-photo-placeholder{display:grid;place-content:center;gap:6px;background:#c9d2c8;color:var(--note-green);text-align:center}.city-note__chapter-photo-placeholder span{font-size:.62rem;font-weight:800;letter-spacing:.13em}.city-note__chapter-photo-placeholder strong{font:600 1.15rem var(--field-card-handwritten)}.city-note__chapter-photo figcaption{padding:10px 5px 0;color:var(--note-green-dark);font:600 1rem/1.2 var(--field-card-handwritten)}.city-note__chapter-photo figcaption>span{display:block}
  .city-note__photo-spread{position:relative;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(22px,4vw,46px);align-items:end;padding:clamp(20px,3vw,34px) 0}.city-note__photo-spread::before{content:'FROM THE FIELD';position:absolute;top:-14px;left:0;color:var(--note-terracotta);font-size:.58rem;font-weight:800;letter-spacing:.14em}.city-note__photo-card{position:relative;margin:0;padding:11px 11px 26px;background:var(--note-paper-soft);box-shadow:5px 7px 0 rgb(49 85 69/.065),0 14px 28px rgb(32 60 49/.08);transform:rotate(-.65deg)}.city-note__photo-card:nth-child(even){transform:translateY(24px) rotate(.8deg)}.city-note__photo-card::before{top:-8px;left:18%;width:70px;height:17px}.city-note__photo-card img,.city-note__photo-placeholder{display:block;width:100%;height:clamp(260px,33vw,430px)}.city-note__photo-card img{object-fit:cover;filter:saturate(.88) contrast(.97)}.city-note__photo-placeholder{display:grid;place-items:center;background:#c9d2c8;color:var(--note-green)}.city-note__photo-placeholder span{font-size:.62rem;font-weight:800;letter-spacing:.13em}.city-note__photo-card figcaption{padding:10px 5px 0;color:var(--note-green-dark);font:600 1rem/1.2 var(--field-card-handwritten)}.city-note__photo-card figcaption>span{display:block}
  .city-note__closing{margin-top:clamp(34px,5vw,64px);padding:clamp(42px,7vw,72px);border-top:1px solid var(--note-line);background:rgb(248 245 236/.58)}.city-note__closing h2{font-size:clamp(2.4rem,5vw,4.7rem);line-height:.95}.city-note__closing>p:not(.city-note__section-label){max-width:650px;margin:18px 0 0;color:var(--note-muted);line-height:1.65}
  .city-note__next{display:grid;gap:14px;margin-top:32px}.city-note__next a{color:var(--note-green-dark);text-decoration:none}.city-note__next-featured{position:relative;display:grid;grid-template-columns:minmax(0,1fr) auto;grid-template-rows:auto 1fr;gap:10px 24px;min-height:150px;align-items:end;padding:24px 27px;border:1px solid rgb(49 85 69/.27);background:linear-gradient(115deg,rgb(255 253 248/.98),rgb(239 233 218/.68));box-shadow:4px 5px 0 rgb(49 85 69/.055);transition:transform 180ms ease,border-color 180ms ease,box-shadow 180ms ease}.city-note__next-featured::before{content:'';position:absolute;top:0;left:0;width:96px;height:3px;background:var(--note-terracotta)}.city-note__next-kicker{grid-column:1/-1;align-self:start;color:var(--note-terracotta);font-size:.57rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}.city-note__next-featured-copy{display:grid;gap:6px}.city-note__next-featured strong{font:500 clamp(1.65rem,3vw,2.5rem)/1 var(--field-card-title)}.city-note__next-featured small{color:var(--note-muted);font-size:.72rem;line-height:1.4}.city-note__next-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.city-note__next-card{display:grid;grid-template-columns:34px minmax(0,1fr) auto;gap:15px;align-items:center;min-height:106px;padding:18px 20px;border:1px solid var(--note-line);background:rgb(255 253 248/.72);transition:transform 180ms ease,border-color 180ms ease,background 180ms ease}.city-note__next-number{align-self:start;padding-top:4px;color:var(--note-terracotta);font:600 .92rem/1 var(--field-card-handwritten)}.city-note__next-card-copy{display:grid;gap:5px}.city-note__next-card strong{font:500 1.14rem/1.05 var(--field-card-title)}.city-note__next-card small{color:var(--note-muted);font-size:.7rem;line-height:1.35}.city-note__next-arrow{align-self:center;color:var(--note-terracotta);font:600 1.25rem/1 var(--field-card-handwritten);transition:transform 180ms ease}.city-note__next-featured:hover,.city-note__next-featured:focus-visible{outline:none;border-color:rgb(183 102 69/.5);box-shadow:6px 8px 0 rgb(49 85 69/.07);transform:translateY(-3px)}.city-note__next-card:hover,.city-note__next-card:focus-visible{outline:none;border-color:rgb(183 102 69/.42);background:var(--note-paper);transform:translateY(-2px)}.city-note__next-featured:hover .city-note__next-arrow,.city-note__next-featured:focus-visible .city-note__next-arrow,.city-note__next-card:hover .city-note__next-arrow,.city-note__next-card:focus-visible .city-note__next-arrow{transform:translateX(4px)}
  .city-note__method{margin:clamp(48px,6vw,76px) 0 clamp(42px,5vw,68px);padding-top:20px;border-top:1px solid rgb(49 85 69/.14);color:#203c31}.city-note__method-copy{max-width:880px;margin:0;color:rgb(38 55 47/.56);font:400 .66rem/1.62 var(--field-card-editorial)}.city-note__method-copy strong{color:rgb(38 55 47/.78);font-weight:600}.city-note__sources{margin-top:12px;border-top:1px solid rgb(49 85 69/.1);border-bottom:1px solid rgb(49 85 69/.12)}.city-note__sources summary{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:12px 2px;color:rgb(49 85 69/.72);font:400 .56rem/1.3 var(--field-card-practical);letter-spacing:.08em;text-transform:uppercase;cursor:pointer;list-style:none}.city-note__sources summary::-webkit-details-marker{display:none}.city-note__sources summary::after{content:'+';color:#9d3040;font:400 .95rem/1 var(--field-card-editorial)}.city-note__sources[open] summary::after{transform:rotate(45deg)}.city-note__source-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(28px,6vw,72px);padding:6px 2px 19px}.city-note__source-grid h3{margin:0 0 9px;color:rgb(49 85 69/.66);font-size:.49rem;font-weight:400;letter-spacing:.11em;text-transform:uppercase}.city-note__source-grid ul{display:grid;gap:6px;margin:0;padding:0;list-style:none}.city-note__source-grid li,.city-note__source-grid p{margin:0;color:rgb(38 55 47/.56);font:400 .61rem/1.48 var(--field-card-editorial)}.city-note__source-grid a{color:rgb(49 85 69/.7);text-underline-offset:2px}
  @media(max-width:900px){.city-note__hero,.city-note__chapter,.city-note__chapter--reverse{grid-template-columns:1fr}.city-note__chapter--reverse .city-note__chapter-copy,.city-note__chapter--reverse .city-note__chapter-side{grid-column:auto;grid-row:auto}.city-note__hero-visual{width:min(100%,680px)}.city-note__quick{grid-template-columns:repeat(2,minmax(0,1fr))}.city-note__quick>div:nth-child(2){border-right:0}.city-note__quick>div:nth-child(-n+2){border-bottom:1px solid var(--note-line)}.city-note__chapter-photo{width:min(100%,620px)}.city-note__source-grid{grid-template-columns:1fr;gap:18px}}
