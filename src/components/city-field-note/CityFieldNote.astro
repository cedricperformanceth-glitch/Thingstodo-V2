---
import type { City, Country, MediaRecord } from '../../core/models/types';
import { cityFieldNoteView } from '../../engines/city-field-note/city-field-note-engine';
import { cityPath, categoryPath } from '../../core/routing/paths';
import AdSlot from '../shared/AdSlot.astro';

interface Props { city: City; country: Country; }
const { city, country } = Astro.props;
const view = cityFieldNoteView(city, country);
const heroSections = view.chapters.slice(0, 4);
const heroImage = view.media[0];
const galleryImages = view.media.slice(1, 3);
const categoryLinks = city.categories.slice(0, 4).map((category) => ({
  label: category === 'things-to-do' ? 'Things to do' : category.split('-').map((part) => `${part.charAt(0).toUpperCase()}${part.slice(1)}`).join(' '),
  href: categoryPath(city, category),
}));
const adIndexes = new Map([[1, view.adSlots[0]], [4, view.adSlots[1]], [6, view.adSlots[2]]]);
const credit = (image: MediaRecord) => [image.author || image.sourceName, image.license].filter(Boolean).join(' · ');
---

<article class="city-note" aria-labelledby="city-note-title">
  <header class="city-note__hero">
    <div class="city-note__hero-copy">
      <p class="city-note__kicker">{view.typeLabel}</p>
      <h1 id="city-note-title">{view.title}</h1>
      <p class="city-note__context">{view.contextLine}</p>
      <p class="city-note__deck">{view.subtitle}</p>
      <div class="city-note__read" aria-label={`${city.name} guide chapters`}>
        <span>READ THE CITY</span>
        <ol>{heroSections.map((section, index) => <li><b>{String(index + 1).padStart(2, '0')}</b>{section.title}</li>)}</ol>
      </div>
      <div class="city-note__stamp" aria-label={`${city.name} field note`}>
        <span>CITY FIELD NOTE</span><strong>Before you begin</strong><small>{city.name} · {country.name}</small>
      </div>
    </div>

    <figure class="city-note__hero-visual">
      {heroImage ? (
        <img src={heroImage.src} alt={heroImage.alt} width="1800" height="1200" fetchpriority="high" />
      ) : (
        <div class="city-note__hero-placeholder" role="img" aria-label={`Editorial hero photo to add for ${city.name}`}><span>FIELD PHOTO</span><strong>Editorial media to add</strong><small>{city.name} · exact-place image</small></div>
      )}
      <figcaption>
        <span>{view.intro}</span>
        {heroImage && <small>{heroImage.sourceUrl ? <a href={heroImage.sourceUrl} target="_blank" rel="noreferrer">{credit(heroImage)}</a> : credit(heroImage)}</small>}
      </figcaption>
    </figure>
  </header>

  <section class="city-note__quick" aria-label={`${city.name} guide overview`}>
    {view.quickRead.map((item) => <div><span>{item.label}</span><strong>{item.value}</strong><small>{item.detail}</small></div>)}
  </section>

  <div class="city-note__chapters">
    {view.chapters.map((chapter, index) => {
      const hasSupport = Boolean((chapter.facts && chapter.facts.length) || chapter.note);
      const adSlot = adIndexes.get(index);
      return <>
        <section class:list={['city-note__chapter', { 'city-note__chapter--reverse': index % 2 === 1 && hasSupport }, { 'city-note__chapter--solo': !hasSupport }]}>
          <div class="city-note__chapter-copy">
            <p class="city-note__section-label">{chapter.eyebrow}</p>
            <h2>{chapter.title}</h2>
            <div class="city-note__prose">{chapter.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div>
          </div>
          {hasSupport && <aside class="city-note__chapter-side">
            {chapter.facts && chapter.facts.length > 0 && <><h3>Keep close</h3><dl class="city-note__facts">{chapter.facts.map((fact) => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}</dl></>}
            {chapter.note && <div class="city-note__note"><span>{chapter.note.label}</span><p>{chapter.note.text}</p></div>}
          </aside>}
        </section>

        {index === 2 && <section class="city-note__photo-spread" aria-label={`${city.name} field photographs`}>
          {(galleryImages.length ? galleryImages : [undefined, undefined]).map((image, imageIndex) => <figure class="city-note__photo-card">
            {image ? <img src={image.src} alt={image.alt} width="1200" height="900" loading="lazy" decoding="async" /> : <div class="city-note__photo-placeholder"><span>FIELD PHOTO {String(imageIndex + 1).padStart(2, '0')}</span></div>}
            <figcaption>
              <span>{image ? image.alt : 'Editorial image to add'}</span>
              {image && <small>{image.sourceUrl ? <a href={image.sourceUrl} target="_blank" rel="noreferrer">{credit(image)}</a> : credit(image)}</small>}
            </figcaption>
          </figure>)}
        </section>}
        {adSlot && <AdSlot slot={adSlot} />}
      </>;
    })}
  </div>

  <p class="city-note__warning">{view.warning}</p>

  {view.sources.length > 0 && <details class="city-note__sources">
    <summary>Sources & research notes</summary>
    <ul>{view.sources.map((source) => <li><a href={source.sourceUrl} target="_blank" rel="noreferrer">{source.sourceName} ↗</a><span>{source.note}</span><small>Reviewed {source.reviewedAt}</small></li>)}</ul>
  </details>}

  <section class="city-note__closing">
    <p class="city-note__section-label">{view.closing.eyebrow}</p>
    <h2>{view.closing.title}</h2>
    <p>{view.closing.text}</p>
    <div class="city-note__next">
      <a href={cityPath(city)}><strong>Explore {city.name}</strong><small>Destination overview and Explore Board</small></a>
      {categoryLinks.map((link) => <a href={link.href}><strong>{link.label}</strong><small>Open this Atlas chapter</small></a>)}
    </div>
  </section>
</article>

<style>
  .city-note{--note-paper:var(--field-card-page);--note-paper-soft:var(--field-card-sheet);--note-ink:#252923;--note-muted:#70766d;--note-green:#315545;--note-green-dark:#203c31;--note-terracotta:#b76645;--note-line:rgb(49 85 69/.2);width:min(1180px,calc(100% - 48px));margin-inline:auto;color:var(--note-ink);font-family:var(--field-card-practical)}
  .city-note__hero{display:grid;grid-template-columns:minmax(0,1.02fr) minmax(360px,.98fr);gap:clamp(42px,7vw,92px);align-items:center;padding:clamp(54px,8vw,96px) 0 56px}.city-note__kicker,.city-note__section-label{margin:0 0 12px;color:var(--note-terracotta);font-size:.69rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}.city-note h1,.city-note h2{margin:0;color:var(--note-green-dark);font-family:var(--field-card-title);font-weight:500}.city-note h1{max-width:760px;font-size:clamp(3.8rem,9vw,7.7rem);line-height:.88;letter-spacing:-.055em}.city-note__context{margin:18px 0 0;color:var(--note-green);font:600 clamp(1.05rem,2vw,1.45rem)/1.1 var(--field-card-handwritten)}.city-note__deck{max-width:680px;margin:24px 0 0;color:#4d554f;font:400 clamp(1rem,1.7vw,1.18rem)/1.7 var(--field-card-editorial)}
  .city-note__read{margin-top:34px;padding-top:18px;border-top:1px solid var(--note-line)}.city-note__read>span{display:block;margin-bottom:12px;color:var(--note-muted);font-size:.62rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}.city-note__read ol{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px 18px;margin:0;padding:0;list-style:none}.city-note__read li{display:flex;gap:8px;color:var(--note-green-dark);font:400 .82rem/1.35 var(--field-card-practical)}.city-note__read li b{color:var(--note-terracotta);font:600 1rem/1 var(--field-card-handwritten)}.city-note__stamp{display:inline-grid;margin-top:30px;padding:12px 18px 10px;border:1px solid rgb(183 102 69/.48);color:var(--note-terracotta);transform:rotate(-2deg)}.city-note__stamp span,.city-note__stamp small{font-size:.58rem;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.city-note__stamp strong{margin:2px 0;font:600 1.32rem/1 var(--field-card-handwritten)}
  .city-note__hero-visual{position:relative;margin:0;padding:13px 13px 30px;background:var(--note-paper-soft);box-shadow:6px 8px 0 rgb(49 85 69/.08),0 16px 34px rgb(32 60 49/.1);transform:rotate(1deg)}.city-note__hero-visual::before,.city-note__photo-card::before{content:'';position:absolute;z-index:2;background:rgb(205 188 148/.58);transform:rotate(-4deg)}.city-note__hero-visual::before{top:-10px;left:14%;width:86px;height:21px}.city-note__hero-visual img,.city-note__hero-placeholder{display:block;width:100%;height:clamp(390px,50vw,650px)}.city-note__hero-visual img{object-fit:cover;filter:saturate(.9) contrast(.96)}.city-note__hero-placeholder{display:grid;place-content:center;gap:7px;background:linear-gradient(145deg,#d9dfd5,#bcc8bc);color:var(--note-green);text-align:center}.city-note__hero-placeholder span,.city-note__hero-placeholder small{font-size:.6rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase}.city-note__hero-placeholder strong{font:500 clamp(1.45rem,2.8vw,2.2rem)/1 var(--field-card-title)}.city-note__hero-visual figcaption{padding:11px 6px 0;color:var(--note-green);font:600 1rem/1.15 var(--field-card-handwritten)}.city-note__hero-visual figcaption>span{display:block}.city-note__hero-visual figcaption small,.city-note__photo-card figcaption small{display:block;margin-top:7px;color:var(--note-muted);font:700 .56rem/1.35 var(--field-card-practical);letter-spacing:.05em;text-transform:uppercase}.city-note figcaption a{color:inherit;text-underline-offset:.14rem}
  .city-note__quick{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin-bottom:clamp(72px,9vw,118px);border-block:1px solid var(--note-line)}.city-note__quick>div{min-height:118px;padding:20px 22px;border-right:1px solid var(--note-line)}.city-note__quick>div:last-child{border-right:0}.city-note__quick span{display:block;margin-bottom:7px;color:var(--note-muted);font-size:.62rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.city-note__quick strong{display:block;color:var(--note-green-dark);font:600 clamp(1.1rem,2vw,1.45rem)/1.05 var(--field-card-handwritten)}.city-note__quick small{display:block;margin-top:8px;color:var(--note-muted);font-size:.74rem;line-height:1.45}
  .city-note__chapters{display:grid;gap:clamp(72px,10vw,130px)}.city-note__chapter{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(260px,.7fr);gap:clamp(38px,7vw,88px);align-items:start}.city-note__chapter--reverse{grid-template-columns:minmax(260px,.7fr) minmax(0,1.3fr)}.city-note__chapter--reverse .city-note__chapter-copy{grid-column:2}.city-note__chapter--reverse .city-note__chapter-side{grid-column:1;grid-row:1}.city-note__chapter--solo{grid-template-columns:minmax(0,760px)}.city-note__chapter-copy{max-width:760px}.city-note__chapter h2,.city-note__closing h2{max-width:720px;font-size:clamp(2.15rem,4.5vw,4.15rem);line-height:.98;letter-spacing:-.035em}.city-note__prose{margin-top:24px}.city-note__prose p{margin:0;max-width:720px;color:#444c47;font:400 1rem/1.82 var(--field-card-editorial)}.city-note__prose p+p{margin-top:19px}
  .city-note__chapter-side{position:relative;padding:24px 25px 22px;background:var(--note-paper-soft);box-shadow:4px 6px 0 rgb(49 85 69/.07);transform:rotate(-.7deg)}.city-note__chapter--reverse .city-note__chapter-side{transform:rotate(.7deg)}.city-note__chapter-side::before{content:'';position:absolute;top:-8px;left:34px;width:64px;height:17px;background:rgb(205 188 148/.55);transform:rotate(-3deg)}.city-note__chapter-side h3{margin:0 0 18px;color:var(--note-green-dark);font:600 1.4rem/1 var(--field-card-handwritten)}.city-note__facts{display:grid;gap:15px;margin:0}.city-note__facts div{padding-top:13px;border-top:1px solid rgb(49 85 69/.12)}.city-note__facts dt{color:var(--note-green);font-size:.69rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.city-note__facts dd{margin:5px 0 0;color:#555e58;font:400 .8rem/1.55 var(--field-card-practical)}.city-note__note{margin-top:20px;padding-top:18px;border-top:1px dashed rgb(183 102 69/.35)}.city-note__note span{color:var(--note-terracotta);font-size:.62rem;font-weight:800;letter-spacing:.11em;text-transform:uppercase}.city-note__note p{margin:7px 0 0;color:var(--note-green-dark);font:600 1.1rem/1.3 var(--field-card-handwritten)}
  .city-note__photo-spread{position:relative;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(22px,4vw,46px);align-items:end;padding:clamp(20px,3vw,34px) 0}.city-note__photo-spread::before{content:'FROM THE FIELD';position:absolute;top:-14px;left:0;color:var(--note-terracotta);font-size:.58rem;font-weight:800;letter-spacing:.14em}.city-note__photo-card{position:relative;margin:0;padding:11px 11px 26px;background:var(--note-paper-soft);box-shadow:5px 7px 0 rgb(49 85 69/.065),0 14px 28px rgb(32 60 49/.08);transform:rotate(-.65deg)}.city-note__photo-card:nth-child(even){transform:translateY(24px) rotate(.8deg)}.city-note__photo-card::before{top:-8px;left:18%;width:70px;height:17px}.city-note__photo-card img,.city-note__photo-placeholder{display:block;width:100%;height:clamp(260px,33vw,430px)}.city-note__photo-card img{object-fit:cover;filter:saturate(.88) contrast(.97)}.city-note__photo-placeholder{display:grid;place-items:center;background:#c9d2c8;color:var(--note-green)}.city-note__photo-placeholder span{font-size:.62rem;font-weight:800;letter-spacing:.13em}.city-note__photo-card figcaption{padding:10px 5px 0;color:var(--note-green-dark);font:600 1rem/1.2 var(--field-card-handwritten)}.city-note__photo-card figcaption>span{display:block}
  .city-note__warning{max-width:820px;margin:clamp(76px,10vw,124px) auto 0;padding:22px 28px;border-left:3px solid var(--note-terracotta);background:rgb(248 245 236/.62);color:#56605a;font:400 .86rem/1.65 var(--field-card-practical)}.city-note__sources{margin-top:42px;padding-top:22px;border-top:1px solid var(--note-line)}.city-note__sources summary{color:var(--note-green);cursor:pointer;font-size:.72rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.city-note__sources ul{display:grid;gap:12px;margin:18px 0 0;padding:0;list-style:none}.city-note__sources li{display:grid;grid-template-columns:minmax(180px,.7fr) minmax(0,1.3fr) auto;gap:14px;align-items:start;padding-top:12px;border-top:1px solid rgb(49 85 69/.1)}.city-note__sources a{color:var(--note-green-dark);font-size:.8rem;font-weight:700}.city-note__sources span{color:#59615c;font-size:.78rem;line-height:1.5}.city-note__sources small{color:var(--note-muted);font-size:.62rem;white-space:nowrap}
  .city-note__closing{margin-top:clamp(82px,11vw,138px);padding:clamp(42px,7vw,72px);border-top:1px solid var(--note-line);background:rgb(248 245 236/.58)}.city-note__closing h2{font-size:clamp(2.4rem,5vw,4.7rem);line-height:.95}.city-note__closing>p:not(.city-note__section-label){max-width:650px;margin:18px 0 0;color:var(--note-muted);line-height:1.65}.city-note__next{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-top:30px}.city-note__next a{display:grid;min-height:112px;align-content:end;padding:19px;border:1px solid var(--note-line);background:var(--note-paper);color:var(--note-green-dark);text-decoration:none}.city-note__next strong{font:500 1.08rem var(--field-card-title)}.city-note__next small{margin-top:5px;color:var(--note-muted);font-size:.72rem;line-height:1.4}
  @media(max-width:900px){.city-note__hero,.city-note__chapter,.city-note__chapter--reverse{grid-template-columns:1fr}.city-note__chapter--reverse .city-note__chapter-copy,.city-note__chapter--reverse .city-note__chapter-side{grid-column:auto;grid-row:auto}.city-note__hero-visual{width:min(100%,680px)}.city-note__quick{grid-template-columns:repeat(2,minmax(0,1fr))}.city-note__quick>div:nth-child(2){border-right:0}.city-note__quick>div:nth-child(-n+2){border-bottom:1px solid var(--note-line)}.city-note__sources li{grid-template-columns:1fr}.city-note__sources small{white-space:normal}}
  @media(max-width:620px){.city-note{width:min(100% - 24px,1180px)}.city-note__hero{padding-top:42px}.city-note h1{font-size:clamp(3.55rem,21vw,5.6rem)}.city-note__read ol,.city-note__quick,.city-note__next,.city-note__photo-spread{grid-template-columns:1fr}.city-note__quick>div,.city-note__quick>div:nth-child(2){border-right:0;border-bottom:1px solid var(--note-line)}.city-note__quick>div:last-child{border-bottom:0}.city-note__hero-visual img,.city-note__hero-placeholder{height:clamp(330px,105vw,520px)}.city-note__chapter-side{width:calc(100% - 16px)}.city-note__photo-card,.city-note__photo-card:nth-child(even){transform:rotate(-.45deg)}.city-note__photo-card:nth-child(even){margin-left:14px}.city-note__closing{padding:34px 22px}}
</style>

<style is:global>body:has(.city-note){background:linear-gradient(rgb(244 240 231/.96),rgb(244 240 231/.96)),repeating-linear-gradient(0deg,transparent 0 31px,rgb(49 85 69/.028) 31px 32px)}</style>
