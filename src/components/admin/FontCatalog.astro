---
const fonts = [
  {
    label: 'Alex Brush',
    annotation: 'country & city calligraphy',
    family: "'Alex Brush', cursive",
    status: 'ready',
    note: 'Local Atlas font · ready to preview',
  },
  {
    label: 'Dr Sugiyama',
    annotation: 'japonnais manuscrit',
    family: "'Dr Sugiyama', cursive",
    status: 'ready',
    note: 'Google Fonts reference · ready to preview',
  },
  {
    label: 'Cookie',
    annotation: 'manuscrit attacher',
    family: "'Cookie', cursive",
    status: 'ready',
    note: 'Google Fonts reference · ready to preview',
  },
  {
    label: 'BlowBrush',
    annotation: 'brush',
    family: "'BlowBrush', sans-serif",
    status: 'ready',
    note: 'Local Atlas font · ready to preview',
  },
  {
    label: 'Flowmery',
    annotation: 'Flowmery',
    family: "'Flowmery', cursive",
    status: 'restricted',
    note: 'Commercial/web use allowed · font file is not published in the public repository',
  },
  {
    label: 'Embolism Spark',
    annotation: 'Embolism Spark',
    family: "'Embolism Spark', cursive",
    status: 'restricted',
    note: 'Commercial/web use allowed · font file is not published in the public repository',
  },
];
---

<div class="font-catalog">
  <header class="font-catalog__heading">
    <p class="font-catalog__kicker">TYPE LIBRARY · CATALOGUE</p>
    <h2>Preview the Atlas fonts</h2>
    <p>Choose a font and compare the same title, short description and button treatment before using it anywhere in the Atlas.</p>
  </header>

  <div class="font-catalog__body">
    <div class="font-catalog__toolbar">
      <label class="font-catalog__field" for="font-catalog-select">
        <span>Font</span>
        <select id="font-catalog-select">
          {fonts.map((font) => (
            <option
              value={font.label}
              data-font-family={font.family}
              data-font-status={font.status}
              data-font-note={font.note}
              data-font-annotation={font.annotation}
            >
              {font.label} · {font.annotation}
            </option>
          ))}
        </select>
      </label>

      <div class="font-catalog__meta" aria-live="polite">
        <span class="font-catalog__status" id="font-catalog-status">READY</span>
        <p id="font-catalog-note">Local Atlas font · ready to preview</p>
      </div>
    </div>

    <section class="font-preview" id="font-catalog-preview" aria-label="Selected font preview">
      <div class="font-preview__label">
        <span>LIVE SAMPLE</span>
        <strong id="font-catalog-name">Alex Brush</strong>
      </div>

      <div class="font-preview__sheet">
        <h3>Where the road becomes a story</h3>
        <p>Follow the river road, stop where the map gets interesting, and keep the places you want to return to.</p>
        <button type="button">Open field note</button>
      </div>

      <p class="font-preview__warning" id="font-catalog-warning" hidden>
        This font is catalogued and licensed for web/commercial use, but its raw file cannot be published in this public GitHub repository. The preview will activate once the font is served from an allowed private or production asset location.
      </p>
    </section>
  </div>
</div>

<script>
  const fontSelect = document.querySelector<HTMLSelectElement>('#font-catalog-select');
  const fontPreview = document.querySelector<HTMLElement>('#font-catalog-preview');
  const fontStatus = document.querySelector<HTMLElement>('#font-catalog-status');
  const fontNote = document.querySelector<HTMLElement>('#font-catalog-note');
  const fontName = document.querySelector<HTMLElement>('#font-catalog-name');
  const fontWarning = document.querySelector<HTMLElement>('#font-catalog-warning');

  const updateFontPreview = () => {
    const option = fontSelect?.selectedOptions[0];
    if (!option || !fontPreview) return;

    const family = option.dataset.fontFamily || 'inherit';
    const status = option.dataset.fontStatus || 'ready';
    const note = option.dataset.fontNote || '';
    const name = option.value;

    fontPreview.style.setProperty('--catalog-font', family);
    fontPreview.dataset.fontStatus = status;
    if (fontName) fontName.textContent = name;
    if (fontNote) fontNote.textContent = note;
    if (fontStatus) {
      fontStatus.textContent = status === 'ready' ? 'READY' : 'CATALOGUED';
      fontStatus.classList.toggle('is-restricted', status !== 'ready');
    }
    if (fontWarning) fontWarning.hidden = status === 'ready';
  };

  fontSelect?.addEventListener('change', updateFontPreview);
  updateFontPreview();
</script>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Cookie&family=Dr+Sugiyama&display=swap');
  @import url('/assets/fonts/blowbrush/blowbrush.css');

  .font-catalog{position:relative;z-index:1;padding:clamp(34px,5vw,74px)}
  .font-catalog__heading{max-width:720px;padding-bottom:clamp(34px,5vw,58px);border-bottom:1px solid #ded7c9}
  .font-catalog__kicker{margin:0 0 10px;color:#738076;font-size:.67rem;font-weight:700;letter-spacing:.2em}
  .font-catalog__heading h2{margin:0;color:#203329;font-family:'Newsreader',Georgia,serif;font-size:clamp(2.4rem,4.5vw,4.5rem);font-weight:400;letter-spacing:-.045em;line-height:.95}
  .font-catalog__heading>p:last-child{max-width:620px;margin:18px 0 0;color:#72786f;font-family:'Newsreader',Georgia,serif;font-size:1.05rem;line-height:1.55}
  .font-catalog__body{padding:clamp(42px,6vw,70px) 0 0}
  .font-catalog__toolbar{display:grid;grid-template-columns:minmax(260px,1fr) minmax(260px,.9fr);gap:22px;align-items:end}
  .font-catalog__field{display:grid;gap:9px}
  .font-catalog__field>span{color:#59665e;font-size:.7rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase}
  .font-catalog__field select{width:100%;min-height:52px;padding:0 14px;border:1px solid #d7d0c2;border-radius:3px;color:#23352c;background:#fffdf8;font:inherit;outline:none;cursor:pointer}
  .font-catalog__field select:focus{border-color:#6e8a76;box-shadow:0 0 0 3px rgb(49 87 59/.08)}
  .font-catalog__meta{min-height:52px;padding:11px 14px;border-left:3px solid #31573b;background:#f5f0df}
  .font-catalog__status{display:block;color:#31573b;font-size:.58rem;font-weight:800;letter-spacing:.13em}
  .font-catalog__status.is-restricted{color:#9a673e}
  .font-catalog__meta p{margin:4px 0 0;color:#72786f;font-size:.7rem;line-height:1.4}
  .font-preview{--catalog-font:'Alex Brush',cursive;margin-top:26px;border:1px solid #d6cebf;background:#f3eee2;box-shadow:0 12px 30px rgb(57 47 31/.06)}
  .font-preview__label{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:10px 14px;border-bottom:1px solid #dcd4c5;color:#7d8078;font-size:.59rem;font-weight:700;letter-spacing:.12em}
  .font-preview__label strong{color:#31573b;font-size:.68rem;font-weight:700;letter-spacing:.03em}
  .font-preview__sheet{padding:clamp(28px,5vw,54px);background:#fffdf8}
  .font-preview__sheet h3{max-width:760px;margin:0 0 18px;color:#253b30;font-family:var(--catalog-font);font-size:clamp(2.25rem,5vw,4.6rem);font-weight:400;line-height:1.02;letter-spacing:0}
  .font-preview__sheet p{max-width:700px;margin:0 0 26px;color:#5f685f;font-family:var(--catalog-font);font-size:clamp(1.05rem,1.8vw,1.42rem);font-weight:400;line-height:1.48}
  .font-preview__sheet button{min-height:46px;padding:10px 19px;border:1px solid #263c30;border-radius:2px;color:#fbf7ed;background:#263c30;font-family:var(--catalog-font);font-size:1.15rem;font-weight:400;line-height:1;cursor:default}
  .font-preview[data-font-status='restricted'] .font-preview__sheet h3,
  .font-preview[data-font-status='restricted'] .font-preview__sheet p,
  .font-preview[data-font-status='restricted'] .font-preview__sheet button{font-family:var(--catalog-font),'Newsreader',Georgia,serif}
  .font-preview__warning{margin:0;padding:14px 16px;border-top:1px solid #e2d3be;color:#765a3f;background:#fbf1e3;font-size:.72rem;line-height:1.55}
  @media(max-width:760px){.font-catalog{padding:34px 24px}.font-catalog__toolbar{grid-template-columns:1fr}.font-preview__label{align-items:flex-start;flex-direction:column}.font-preview__sheet{padding:30px 22px}}
</style>
