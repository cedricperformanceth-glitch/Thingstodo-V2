---
const fonts = [
  { label: 'Newsreader', family: "'Newsreader', Georgia, serif", status: 'ready', source: 'Site font' },
  { label: 'Manrope', family: "'Manrope', ui-sans-serif, system-ui, sans-serif", status: 'ready', source: 'Site font' },
  { label: 'Caveat', family: "'Caveat', 'Segoe Print', cursive", status: 'ready', source: 'Site font' },
  { label: 'Fraunces', family: "'Fraunces', Georgia, serif", status: 'ready', source: 'Site font' },
  { label: 'DM Sans', family: "'DM Sans', ui-sans-serif, system-ui, sans-serif", status: 'ready', source: 'Site font' },
  { label: 'Segoe Print / Bradley Hand', family: "'Segoe Print', 'Bradley Hand', cursive", status: 'ready', source: 'Site/system stack' },
  { label: 'Schoolbell', family: "'Schoolbell', 'Segoe Print', cursive", status: 'ready', source: 'Site font' },
  { label: 'Indie Flower', family: "'Indie Flower', 'Segoe Print', cursive", status: 'ready', source: 'Site font' },
  { label: 'Alex Brush', family: "'Alex Brush', 'Caveat', cursive", status: 'ready', source: 'Atlas font bank · country & city calligraphy' },
  { label: 'Cookie', family: "'Cookie', cursive", status: 'ready', source: 'Atlas font bank · manuscrit attacher' },
  { label: 'Dr Sugiyama', family: "'Dr Sugiyama', cursive", status: 'ready', source: 'Atlas font bank · japonnais manuscrit' },
  { label: 'BlowBrush', family: "'BlowBrush', sans-serif", status: 'ready', source: 'Atlas font bank · brush' },
  { label: 'Flowmery', family: "'Flowmery', cursive", status: 'restricted', source: 'Atlas font bank · public preview unavailable' },
  { label: 'Embolism Spark', family: "'Embolism Spark', cursive", status: 'restricted', source: 'Atlas font bank · public preview unavailable' },
];

const usages = [
  {
    id: 'activity-main-title',
    area: 'ACTIVITY',
    label: 'Main title',
    current: 'Newsreader',
    kind: 'activity-main-title',
    sample: 'Kuang Si Waterfall',
    detail: 'Hero H1 on monetisable activity field cards',
  },
  {
    id: 'activity-section-title',
    area: 'ACTIVITY',
    label: 'Section title',
    current: 'Newsreader',
    kind: 'activity-section-title',
    sample: 'The road to the falls',
    detail: 'Editorial chapter headings inside the activity page',
  },
  {
    id: 'activity-editorial',
    area: 'ACTIVITY',
    label: 'Editorial text',
    current: 'Newsreader',
    kind: 'activity-editorial',
    sample: 'The road leaves Luang Prabang and gradually gives way to forest, villages and the cooler air around the falls.',
    detail: 'Long-form story and descriptive copy',
  },
  {
    id: 'activity-practical',
    area: 'ACTIVITY',
    label: 'Practical / Quick Read',
    current: 'Manrope',
    kind: 'activity-practical',
    sample: 'TIME · HALF DAY',
    detail: 'Quick Read values, labels and practical information',
  },
  {
    id: 'activity-annotation',
    area: 'ACTIVITY',
    label: 'Handwritten annotations',
    current: 'Caveat',
    kind: 'activity-annotation',
    sample: 'Go early — before the crowds',
    detail: 'Field notes, photo notes, stamps and handwritten remarks',
  },
  {
    id: 'spa-card-title',
    area: 'SPA',
    label: 'Card title',
    current: 'Cookie',
    kind: 'spa-card-title',
    sample: 'Kuang Si Waterfall',
    detail: 'Title of activity, restaurant, café and stay cards in the SPA',
  },
  {
    id: 'spa-card-description',
    area: 'SPA',
    label: 'Card description',
    current: 'Segoe Print / Bradley Hand',
    kind: 'spa-card-description',
    sample: 'Turquoise pools, forest paths and an easy half-day escape from Luang Prabang.',
    detail: 'Short descriptive copy under SPA card titles',
  },
  {
    id: 'spa-category-title',
    area: 'SPA',
    label: 'Section / category title',
    current: 'Fraunces',
    kind: 'spa-category-title',
    sample: 'Things to do',
    detail: 'Travel Desk headings and SPA category names',
  },
  {
    id: 'spa-metadata',
    area: 'SPA',
    label: 'Labels / metadata',
    current: 'DM Sans',
    kind: 'spa-metadata',
    sample: '11 PLACES · FIELD NOTE 01',
    detail: 'Counts, eyebrow labels and small technical information',
  },
  {
    id: 'explore-handwritten',
    area: 'EXPLORE BOARD',
    label: 'Handwritten copy',
    current: 'Segoe Print / Bradley Hand',
    kind: 'explore-handwritten',
    sample: 'Kuang Si Waterfall',
    detail: 'Explore Board titles, notes and chalk-style copy',
  },
];
---

<div class="font-catalog">
  <header class="font-catalog__heading">
    <p class="font-catalog__kicker">TYPE LIBRARY · USAGE MAP</p>
    <h2>Atlas typography previews</h2>
    <p>Every row mirrors one important typography role in the Atlas. Change any selector to test another font here only — nothing in the public site is modified.</p>
  </header>

  <div class="font-catalog__legend" aria-label="Font catalogue legend">
    <span><i class="font-catalog__dot"></i> Current site font is selected by default</span>
    <span>Preview only · no style is saved</span>
  </div>

  <div class="font-usage-list">
    {usages.map((usage, index) => (
      <section
        class="font-usage"
        data-font-usage
        data-current-font={usage.current}
        style={`--preview-font:${fonts.find((font) => font.label === usage.current)?.family ?? 'inherit'}`}
      >
        <div class="font-usage__identity">
          <span class="font-usage__number">{String(index + 1).padStart(2, '0')}</span>
          <div>
            <p>{usage.area}</p>
            <h3>{usage.label}</h3>
            <small>{usage.detail}</small>
          </div>
        </div>

        <div class="font-usage__control">
          <label for={`font-usage-${usage.id}`}>Preview font</label>
          <select id={`font-usage-${usage.id}`} data-font-select>
            {fonts.map((font) => (
              <option
                value={font.label}
                data-font-family={font.family}
                data-font-status={font.status}
                data-font-source={font.source}
                selected={font.label === usage.current}
              >
                {font.label}{font.status === 'restricted' ? ' · preview unavailable' : ''}
              </option>
            ))}
          </select>
          <div class="font-usage__selection-meta">
            <span data-font-state>CURRENT · {usage.current}</span>
            <small data-font-source>{fonts.find((font) => font.label === usage.current)?.source}</small>
          </div>
        </div>

        <div class="font-usage__preview" data-preview-kind={usage.kind}>
          <span class="font-usage__preview-label">PREVIEW</span>
          <div class="font-usage__sample">{usage.sample}</div>
          <p class="font-usage__warning" data-font-warning hidden>
            This font is in the Atlas bank, but its font file cannot be published from this public repository. The selector is kept for catalogue completeness; a real preview needs an allowed private/production font source.
          </p>
        </div>
      </section>
    ))}
  </div>
</div>

<script>
  const usageRows = Array.from(document.querySelectorAll<HTMLElement>('[data-font-usage]'));

  const updateUsagePreview = (row: HTMLElement) => {
    const select = row.querySelector<HTMLSelectElement>('[data-font-select]');
    const option = select?.selectedOptions[0];
    if (!option) return;

    const currentFont = row.dataset.currentFont || '';
    const selectedFont = option.value;
    const family = option.dataset.fontFamily || 'inherit';
    const status = option.dataset.fontStatus || 'ready';
    const source = option.dataset.fontSource || '';
    const state = row.querySelector<HTMLElement>('[data-font-state]');
    const sourceLabel = row.querySelector<HTMLElement>('[data-font-source]');
    const warning = row.querySelector<HTMLElement>('[data-font-warning]');

    row.style.setProperty('--preview-font', status === 'ready' ? family : "'Newsreader', Georgia, serif");
    row.classList.toggle('is-alternative', selectedFont !== currentFont);
    row.classList.toggle('is-restricted', status !== 'ready');

    if (state) state.textContent = status !== 'ready'
      ? `CATALOGUED · ${selectedFont}`
      : selectedFont === currentFont
        ? `CURRENT · ${selectedFont}`
        : `PREVIEW · ${selectedFont}`;
    if (sourceLabel) sourceLabel.textContent = source;
    if (warning) warning.hidden = status === 'ready';
  };

  usageRows.forEach((row) => {
    const select = row.querySelector<HTMLSelectElement>('[data-font-select]');
    select?.addEventListener('change', () => updateUsagePreview(row));
    updateUsagePreview(row);
  });
</script>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Cookie&family=Dr+Sugiyama&display=swap');

  @font-face {
    font-family: 'BlowBrush';
    src: url('/assets/fonts/blowbrush/BlowBrush.otf') format('opentype');
    font-style: normal;
    font-weight: 400;
    font-display: swap;
  }

  .font-catalog{position:relative;z-index:1;padding:clamp(34px,5vw,74px)}
  .font-catalog__heading{max-width:760px;padding-bottom:clamp(32px,4.5vw,52px);border-bottom:1px solid #ded7c9}
  .font-catalog__kicker{margin:0 0 10px;color:#738076;font-size:.67rem;font-weight:700;letter-spacing:.2em}
  .font-catalog__heading h2{margin:0;color:#203329;font-family:'Newsreader',Georgia,serif;font-size:clamp(2.4rem,4.5vw,4.5rem);font-weight:400;letter-spacing:-.045em;line-height:.95}
  .font-catalog__heading>p:last-child{max-width:660px;margin:18px 0 0;color:#72786f;font-family:'Newsreader',Georgia,serif;font-size:1.05rem;line-height:1.55}
  .font-catalog__legend{display:flex;flex-wrap:wrap;justify-content:space-between;gap:10px 24px;padding:18px 0;color:#7d827a;font-size:.66rem;letter-spacing:.05em}
  .font-catalog__legend span{display:flex;align-items:center;gap:7px}.font-catalog__dot{width:6px;height:6px;border-radius:50%;background:#31573b;box-shadow:0 0 0 3px rgb(49 87 59/.08)}
  .font-usage-list{display:grid;border-top:1px solid #ddd5c7}
  .font-usage{--preview-font:'Newsreader',Georgia,serif;display:grid;grid-template-columns:minmax(190px,.72fr) minmax(220px,.76fr) minmax(300px,1.52fr);gap:clamp(20px,3vw,38px);align-items:center;padding:clamp(25px,3.5vw,38px) 0;border-bottom:1px solid #e2dbce;transition:background .16s ease}
  .font-usage.is-alternative{background:linear-gradient(90deg,transparent,rgb(49 87 59/.022) 18%,rgb(49 87 59/.022) 82%,transparent)}
  .font-usage__identity{display:grid;grid-template-columns:30px minmax(0,1fr);gap:12px;align-items:start}.font-usage__number{padding-top:3px;color:#aaa398;font-size:.59rem;font-weight:700;letter-spacing:.12em}.font-usage__identity p{margin:0 0 5px;color:#b76645;font-size:.57rem;font-weight:800;letter-spacing:.14em}.font-usage__identity h3{margin:0;color:#263a30;font-family:'Newsreader',Georgia,serif;font-size:1.18rem;font-weight:600;line-height:1.08}.font-usage__identity small{display:block;margin-top:8px;color:#888b83;font-size:.67rem;line-height:1.45}
  .font-usage__control{display:grid;gap:7px}.font-usage__control>label{color:#59665e;font-size:.61rem;font-weight:700;letter-spacing:.09em;text-transform:uppercase}.font-usage__control select{width:100%;min-height:43px;padding:0 11px;border:1px solid #d5cdbf;border-radius:2px;color:#26372e;background:#fffdf8;font:500 .76rem/1 'Manrope',ui-sans-serif,system-ui,sans-serif;outline:none;cursor:pointer}.font-usage__control select:focus{border-color:#6e8a76;box-shadow:0 0 0 3px rgb(49 87 59/.08)}.font-usage__selection-meta{display:grid;gap:2px;min-height:28px}.font-usage__selection-meta span{color:#31573b;font-size:.55rem;font-weight:800;letter-spacing:.1em}.font-usage.is-alternative .font-usage__selection-meta span{color:#b76645}.font-usage.is-restricted .font-usage__selection-meta span{color:#98633e}.font-usage__selection-meta small{color:#929188;font-size:.58rem;line-height:1.3}
  .font-usage__preview{position:relative;min-width:0;padding:24px 26px;border:1px solid #ded6c8;background:#f8f4ea;box-shadow:3px 4px 0 rgb(49 87 59/.035)}.font-usage__preview-label{position:absolute;top:8px;right:10px;color:#aaa398;font:700 .48rem/1 'DM Sans',ui-sans-serif,sans-serif;letter-spacing:.13em}.font-usage__sample{overflow-wrap:anywhere;color:#203c31;font-family:var(--preview-font)}
  .font-usage__preview[data-preview-kind='activity-main-title'] .font-usage__sample{max-width:9ch;font-size:clamp(3.15rem,5.4vw,5.6rem);font-weight:600;line-height:.84;letter-spacing:-.055em}
  .font-usage__preview[data-preview-kind='activity-section-title'] .font-usage__sample{max-width:15ch;font-size:clamp(2rem,3.1vw,3.2rem);font-weight:600;line-height:.98;letter-spacing:-.035em}
  .font-usage__preview[data-preview-kind='activity-editorial'] .font-usage__sample{max-width:38rem;color:#444c47;font-size:.96rem;font-weight:400;line-height:1.78}
  .font-usage__preview[data-preview-kind='activity-practical'] .font-usage__sample{font-size:clamp(1.65rem,2.8vw,2.5rem);font-weight:400;line-height:.98;letter-spacing:-.035em;text-transform:uppercase}
  .font-usage__preview[data-preview-kind='activity-annotation'] .font-usage__sample{color:#315545;font-size:1.15rem;font-weight:600;line-height:1.08;transform:rotate(-1deg);transform-origin:left center}
  .font-usage__preview[data-preview-kind='spa-card-title'] .font-usage__sample{font-size:calc(clamp(1.28rem,1.8vw,1.62rem) + 1px);font-weight:400;line-height:1.03;letter-spacing:0}
  .font-usage__preview[data-preview-kind='spa-card-description'] .font-usage__sample{max-width:31rem;color:#5b625c;font-size:.78rem;font-weight:400;line-height:1.45}
  .font-usage__preview[data-preview-kind='spa-category-title'] .font-usage__sample{font-size:clamp(1.35rem,2.25vw,1.82rem);font-weight:500;line-height:1.05;letter-spacing:-.045em}
  .font-usage__preview[data-preview-kind='spa-metadata'] .font-usage__sample{color:#667168;font-size:.62rem;font-weight:700;line-height:1.3;letter-spacing:.12em;text-transform:uppercase}
  .font-usage__preview[data-preview-kind='explore-handwritten'] .font-usage__sample{font-size:clamp(1.65rem,3vw,2.4rem);font-weight:500;line-height:1.05;letter-spacing:-.045em;transform:rotate(-.25deg);transform-origin:left center}
  .font-usage__warning{margin:15px 0 0;padding-top:12px;border-top:1px solid #e5d6c2;color:#7e6044;font:500 .65rem/1.5 'Manrope',ui-sans-serif,system-ui,sans-serif}
  @media(max-width:980px){.font-usage{grid-template-columns:minmax(180px,.85fr) minmax(220px,1fr);align-items:start}.font-usage__preview{grid-column:1/-1}}
  @media(max-width:640px){.font-catalog{padding:34px 22px}.font-catalog__legend{display:grid}.font-usage{grid-template-columns:1fr;gap:18px}.font-usage__preview{grid-column:auto;padding:24px 20px}.font-usage__identity{grid-template-columns:26px minmax(0,1fr)}.font-usage__preview[data-preview-kind='activity-main-title'] .font-usage__sample{font-size:clamp(3rem,15vw,4.6rem)}}
</style>
