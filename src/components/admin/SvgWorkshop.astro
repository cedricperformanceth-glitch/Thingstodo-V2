---
type SvgCatalogueItem = {
  id: string;
  title: string;
  src: string;
  note?: string;
  tags?: string[];
};

const currentStudy = {
  id: 'desk-globe-plane-v1',
  title: 'Desk globe + orbiting plane · V1',
  src: '/assets/admin/svg-workbench/current/desk-globe-plane-v1.svg',
};

// Add an item here only after the user has explicitly validated the SVG for reuse.
const svgCatalogue: SvgCatalogueItem[] = [
  {
    id: 'globe-flight-line-art',
    title: 'Globe + flight path',
    src: '/assets/admin/svg-workbench/current/desk-globe-plane-v1.svg',
    note: 'Validated black line-art globe with dashed flight route and airplane.',
    tags: ['travel', 'globe', 'airplane', 'route', 'line art'],
  },
];
---

<div class="svg-workshop">
  <header class="svg-workshop__heading">
    <p class="svg-workshop__kicker">SVG WORKBENCH · PREVIEW ONLY</p>
    <h2>SVG studio</h2>
    <p>Build, annotate and review Atlas SVGs here first. Nothing in this workspace changes the public site until a drawing is explicitly validated and exported.</p>
  </header>

  <section class="svg-workbench" aria-labelledby="svg-workbench-title">
    <div class="svg-workbench__topline">
      <div>
        <span>ACTIVE STUDY</span>
        <h3 id="svg-workbench-title">{currentStudy.title}</h3>
        <code>{currentStudy.src}</code>
      </div>
      <span class="svg-workbench__status">V1 · WORKING COPY</span>
    </div>

    <div class="svg-annotation-toolbar" aria-label="SVG annotation tools">
      <div class="svg-annotation-toolbar__tools" role="group" aria-label="Drawing tools">
        <button type="button" class="is-active" data-svg-tool="pen">Pen</button>
        <button type="button" data-svg-tool="circle">Circle</button>
        <button type="button" data-svg-tool="arrow">Arrow</button>
        <button type="button" data-svg-tool="cross">X</button>
        <button type="button" data-svg-tool="marker">Marker</button>
      </div>
      <div class="svg-annotation-toolbar__actions">
        <button type="button" data-svg-undo>Undo</button>
        <button type="button" data-svg-clear>Clear</button>
        <button type="button" data-svg-grid aria-pressed="false">Grid</button>
      </div>
    </div>

    <div class="svg-workbench__stage" data-svg-workbench-stage>
      <div class="svg-workbench__mount" data-svg-workbench-mount>
        <img
          class="svg-workbench__study"
          src={currentStudy.src}
          alt="Desk globe with an airplane circling the Earth"
          data-svg-current-study
          data-svg-title={currentStudy.title}
          data-svg-src={currentStudy.src}
          decoding="async"
        />
      </div>
      <div class="svg-workbench__grid" data-svg-grid-layer aria-hidden="true"></div>
      <canvas class="svg-workbench__annotations" data-svg-annotation-canvas aria-label="Transparent SVG annotation layer"></canvas>
      <div class="svg-workbench__axes" data-svg-axes aria-hidden="true">
        <span class="svg-axis svg-axis--tl">0,0</span>
        <span class="svg-axis svg-axis--tr">100,0</span>
        <span class="svg-axis svg-axis--bl">0,100</span>
        <span class="svg-axis svg-axis--br">100,100</span>
      </div>
    </div>

    <div class="svg-review-composer">
      <label class="svg-review-composer__field">
        <span>YOUR NOTE</span>
        <textarea data-svg-review-note rows="2" placeholder="Ex: make the globe simpler, move the plane closer, use blue here..."></textarea>
      </label>
      <button class="svg-review-composer__generate" type="button" data-svg-generate-prompt>
        <span>Generate prompt</span>
        <small>Copy for ChatGPT</small>
      </button>
    </div>

    <div class="svg-review-output" data-svg-review-output hidden>
      <div class="svg-review-output__topline">
        <span>PROMPT READY</span>
        <button type="button" data-svg-copy-prompt>Copy again</button>
      </div>
      <textarea data-svg-prompt-output readonly rows="5" aria-label="Generated SVG review prompt"></textarea>
      <p data-svg-copy-status aria-live="polite"></p>
    </div>

    <div class="svg-workbench__rule">
      <span>01 · BUILD HERE</span>
      <span>02 · ANNOTATE</span>
      <span>03 · REVIEW TOGETHER</span>
      <span>04 · VALIDATE / EXPORT</span>
    </div>
  </section>

  <section class="svg-catalogue" aria-labelledby="svg-catalogue-title">
    <header class="svg-catalogue__heading">
      <div>
        <p>VALIDATED LIBRARY</p>
        <h3 id="svg-catalogue-title">SVG catalogue</h3>
      </div>
      <span>{svgCatalogue.length} saved</span>
    </header>

    <p class="svg-catalogue__intro">Only SVGs deliberately kept for reuse belong here. Catalogue drawings are loaded only when opened.</p>

    {svgCatalogue.length ? (
      <div class="svg-catalogue__list">
        {svgCatalogue.map((item, index) => (
          <button
            class="svg-catalogue__item"
            type="button"
            data-svg-catalogue-item
            data-svg-src={item.src}
            data-svg-title={item.title}
            data-svg-note={item.note ?? ''}
            data-svg-tags={(item.tags ?? []).join(' · ')}
          >
            <span class="svg-catalogue__number">{String(index + 1).padStart(2, '0')}</span>
            <span class="svg-catalogue__copy">
              <strong>{item.title}</strong>
              <small>{item.note || 'Validated reusable SVG'}</small>
            </span>
            <span class="svg-catalogue__open">VIEW ↗</span>
          </button>
        ))}
      </div>
    ) : (
      <div class="svg-catalogue__empty">
        <span>CATALOGUE READY</span>
        <strong>No validated SVG saved yet.</strong>
        <p>The globe above is only the current study. It will enter this catalogue only after you explicitly validate it.</p>
      </div>
    )}
  </section>

  <dialog class="svg-viewer" id="svg-catalogue-dialog" aria-labelledby="svg-dialog-title">
    <div class="svg-viewer__shell">
      <header class="svg-viewer__header">
        <div>
          <p>SVG CATALOGUE</p>
          <h3 id="svg-dialog-title">SVG preview</h3>
          <small id="svg-dialog-tags"></small>
        </div>
        <button class="svg-viewer__close" type="button" data-svg-dialog-close aria-label="Close SVG preview">×</button>
      </header>
      <div class="svg-viewer__stage">
        <img id="svg-dialog-image" alt="" decoding="async" />
        <span class="svg-viewer__loading" id="svg-dialog-loading">Loading SVG…</span>
      </div>
      <footer class="svg-viewer__footer">
        <p id="svg-dialog-note">Validated reusable Atlas SVG.</p>
        <code id="svg-dialog-path"></code>
      </footer>
    </div>
  </dialog>
</div>

<script>
  type Point = { x: number; y: number };
  type Annotation =
    | { type: 'pen'; points: Point[] }
    | { type: 'circle'; start: Point; end: Point }
    | { type: 'arrow'; start: Point; end: Point }
    | { type: 'cross'; point: Point }
    | { type: 'marker'; point: Point; number: number };
  type Tool = Annotation['type'];

  const stage = document.querySelector<HTMLElement>('[data-svg-workbench-stage]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-svg-annotation-canvas]');
  const gridLayer = document.querySelector<HTMLElement>('[data-svg-grid-layer]');
  const axes = document.querySelector<HTMLElement>('[data-svg-axes]');
  const currentStudyElement = document.querySelector<HTMLElement>('[data-svg-current-study]');
  const toolButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-svg-tool]'));
  const noteField = document.querySelector<HTMLTextAreaElement>('[data-svg-review-note]');
  const promptOutput = document.querySelector<HTMLTextAreaElement>('[data-svg-prompt-output]');
  const reviewOutput = document.querySelector<HTMLElement>('[data-svg-review-output]');
  const copyStatus = document.querySelector<HTMLElement>('[data-svg-copy-status]');

  let activeTool: Tool = 'pen';
  let annotations: Annotation[] = [];
  let draft: Annotation | null = null;
  let pointerDown = false;
  let markerCount = 0;
  let dpr = Math.max(1, window.devicePixelRatio || 1);
  const ctx = canvas?.getContext('2d') ?? null;

  const pointFromEvent = (event: PointerEvent): Point => {
    if (!canvas) return { x: 0, y: 0 };
    const rect = canvas.getBoundingClientRect();
    return {
      x: Math.min(1, Math.max(0, (event.clientX - rect.left) / rect.width)),
      y: Math.min(1, Math.max(0, (event.clientY - rect.top) / rect.height)),
    };
  };

  const toPixels = (point: Point) => {
    if (!canvas) return { x: 0, y: 0 };
    return { x: point.x * canvas.clientWidth, y: point.y * canvas.clientHeight };
  };

  const drawArrowHead = (start: Point, end: Point) => {
    if (!ctx) return;
    const a = toPixels(start);
    const b = toPixels(end);
    const angle = Math.atan2(b.y - a.y, b.x - a.x);
    const size = 13;
    ctx.beginPath();
    ctx.moveTo(b.x, b.y);
    ctx.lineTo(b.x - size * Math.cos(angle - Math.PI / 6), b.y - size * Math.sin(angle - Math.PI / 6));
    ctx.moveTo(b.x, b.y);
    ctx.lineTo(b.x - size * Math.cos(angle + Math.PI / 6), b.y - size * Math.sin(angle + Math.PI / 6));
    ctx.stroke();
  };

  const renderAnnotation = (annotation: Annotation) => {
    if (!ctx || !canvas) return;
    ctx.save();
    ctx.strokeStyle = '#b44835';
    ctx.fillStyle = '#b44835';
    ctx.lineWidth = 2.5;
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';

    if (annotation.type === 'pen') {
      if (annotation.points.length < 2) return ctx.restore();
      ctx.beginPath();
      annotation.points.forEach((point, index) => {
        const p = toPixels(point);
        if (index === 0) ctx.moveTo(p.x, p.y);
        else ctx.lineTo(p.x, p.y);
      });
      ctx.stroke();
    }

    if (annotation.type === 'circle') {
      const a = toPixels(annotation.start);
      const b = toPixels(annotation.end);
      ctx.beginPath();
      ctx.ellipse((a.x + b.x) / 2, (a.y + b.y) / 2, Math.abs(b.x - a.x) / 2, Math.abs(b.y - a.y) / 2, 0, 0, Math.PI * 2);
      ctx.stroke();
    }

    if (annotation.type === 'arrow') {
      const a = toPixels(annotation.start);
      const b = toPixels(annotation.end);
      ctx.beginPath();
      ctx.moveTo(a.x, a.y);
      ctx.lineTo(b.x, b.y);
      ctx.stroke();
      drawArrowHead(annotation.start, annotation.end);
    }

    if (annotation.type === 'cross') {
      const p = toPixels(annotation.point);
      const size = 13;
      ctx.beginPath();
      ctx.moveTo(p.x - size, p.y - size);
      ctx.lineTo(p.x + size, p.y + size);
      ctx.moveTo(p.x + size, p.y - size);
      ctx.lineTo(p.x - size, p.y + size);
      ctx.stroke();
    }

    if (annotation.type === 'marker') {
      const p = toPixels(annotation.point);
      ctx.beginPath();
      ctx.arc(p.x, p.y, 12, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = '#fffdf8';
      ctx.font = '700 11px Manrope, sans-serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(String(annotation.number), p.x, p.y + .5);
    }
    ctx.restore();
  };

  const redraw = () => {
    if (!ctx || !canvas) return;
    ctx.clearRect(0, 0, canvas.clientWidth, canvas.clientHeight);
    annotations.forEach(renderAnnotation);
    if (draft) renderAnnotation(draft);
  };

  const resizeCanvas = () => {
    if (!canvas || !stage || !ctx) return;
    const rect = stage.getBoundingClientRect();
    dpr = Math.max(1, window.devicePixelRatio || 1);
    canvas.width = Math.max(1, Math.round(rect.width * dpr));
    canvas.height = Math.max(1, Math.round(rect.height * dpr));
    canvas.style.width = `${rect.width}px`;
    canvas.style.height = `${rect.height}px`;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    redraw();
  };

  const finishDraft = () => {
    if (!draft) return;
    if (draft.type !== 'pen' || draft.points.length > 1) annotations.push(draft);
    draft = null;
    redraw();
  };

  canvas?.addEventListener('pointerdown', (event) => {
    event.preventDefault();
    canvas.setPointerCapture(event.pointerId);
    pointerDown = true;
    const point = pointFromEvent(event);
    if (activeTool === 'cross') {
      annotations.push({ type: 'cross', point });
      pointerDown = false;
      redraw();
      return;
    }
    if (activeTool === 'marker') {
      markerCount += 1;
      annotations.push({ type: 'marker', point, number: markerCount });
      pointerDown = false;
      redraw();
      return;
    }
    if (activeTool === 'pen') draft = { type: 'pen', points: [point] };
    if (activeTool === 'circle') draft = { type: 'circle', start: point, end: point };
    if (activeTool === 'arrow') draft = { type: 'arrow', start: point, end: point };
    redraw();
  });

  canvas?.addEventListener('pointermove', (event) => {
    if (!pointerDown || !draft) return;
    event.preventDefault();
    const point = pointFromEvent(event);
    if (draft.type === 'pen') draft.points.push(point);
    if (draft.type === 'circle' || draft.type === 'arrow') draft.end = point;
    redraw();
  });

  const endPointer = (event: PointerEvent) => {
    if (!pointerDown) return;
    pointerDown = false;
    if (canvas?.hasPointerCapture(event.pointerId)) canvas.releasePointerCapture(event.pointerId);
    finishDraft();
  };
  canvas?.addEventListener('pointerup', endPointer);
  canvas?.addEventListener('pointercancel', endPointer);

  toolButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const next = button.dataset.svgTool as Tool | undefined;
      if (!next) return;
      activeTool = next;
      toolButtons.forEach((item) => item.classList.toggle('is-active', item === button));
    });
  });

  document.querySelector('[data-svg-undo]')?.addEventListener('click', () => {
    annotations.pop();
    markerCount = annotations.filter((item) => item.type === 'marker').length;
    redraw();
  });

  document.querySelector('[data-svg-clear]')?.addEventListener('click', () => {
    annotations = [];
    draft = null;
    markerCount = 0;
    redraw();
  });

  document.querySelector<HTMLButtonElement>('[data-svg-grid]')?.addEventListener('click', (event) => {
    const button = event.currentTarget as HTMLButtonElement;
    const enabled = button.getAttribute('aria-pressed') !== 'true';
    button.setAttribute('aria-pressed', String(enabled));
    button.classList.toggle('is-active', enabled);
    gridLayer?.classList.toggle('is-visible', enabled);
    axes?.classList.toggle('is-visible', enabled);
  });

  const pct = (value: number) => `${(value * 100).toFixed(1)}%`;
  const zone = (point: Point) => {
    const column = Math.min(7, Math.floor(point.x * 8));
    const row = Math.min(7, Math.floor(point.y * 8));
    return `${String.fromCharCode(65 + column)}${row + 1}`;
  };
  const midpoint = (a: Point, b: Point): Point => ({ x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 });

  const annotationLine = (annotation: Annotation, index: number) => {
    const id = String(index + 1).padStart(2, '0');
    if (annotation.type === 'cross') return `${id} — X — zone ${zone(annotation.point)} — x ${pct(annotation.point.x)}, y ${pct(annotation.point.y)}`;
    if (annotation.type === 'marker') return `${id} — marker ${annotation.number} — zone ${zone(annotation.point)} — x ${pct(annotation.point.x)}, y ${pct(annotation.point.y)}`;
    if (annotation.type === 'arrow') return `${id} — arrow — ${zone(annotation.start)} (${pct(annotation.start.x)}, ${pct(annotation.start.y)}) → ${zone(annotation.end)} (${pct(annotation.end.x)}, ${pct(annotation.end.y)})`;
    if (annotation.type === 'circle') {
      const center = midpoint(annotation.start, annotation.end);
      return `${id} — circle — centre ${zone(center)} — x ${pct(center.x)}, y ${pct(center.y)} — width ${pct(Math.abs(annotation.end.x - annotation.start.x))}, height ${pct(Math.abs(annotation.end.y - annotation.start.y))}`;
    }
    const start = annotation.points[0] ?? { x: 0, y: 0 };
    const end = annotation.points[annotation.points.length - 1] ?? start;
    return `${id} — pen stroke — ${zone(start)} (${pct(start.x)}, ${pct(start.y)}) → ${zone(end)} (${pct(end.x)}, ${pct(end.y)}) — ${annotation.points.length} sampled points`;
  };

  const buildPrompt = () => {
    const note = noteField?.value.trim() || 'No additional written note.';
    const lines = annotations.length ? annotations.map(annotationLine).join('\n') : 'No graphical annotations.';
    const studyTitle = currentStudyElement?.dataset.svgTitle || 'Current SVG preview';
    const studySrc = currentStudyElement?.dataset.svgSrc || 'Unknown path';
    return [
      'SVG REVIEW — ATLAS ADMIN',
      `Study: ${studyTitle}`,
      `File: ${studySrc}`,
      'Target: Admin > SVG > Current SVG Preview only.',
      'Coordinates are relative to the full preview canvas: 0% top-left, 100% bottom-right. A1–H8 uses the same canvas.',
      '',
      'GRAPHICAL ANNOTATIONS',
      lines,
      '',
      'WRITTEN NOTE',
      note,
      '',
      'Modify this SVG study according to these annotations. Keep it in the admin workbench and do not move it to the public site or validated catalogue unless I explicitly approve it.',
    ].join('\n');
  };

  const copyPrompt = async (value: string) => {
    try {
      await navigator.clipboard.writeText(value);
      if (copyStatus) copyStatus.textContent = 'Prompt copied. Paste it directly into ChatGPT.';
    } catch {
      if (copyStatus) copyStatus.textContent = 'Clipboard blocked. Copy the generated prompt manually.';
    }
  };

  document.querySelector('[data-svg-generate-prompt]')?.addEventListener('click', async () => {
    const prompt = buildPrompt();
    if (promptOutput) promptOutput.value = prompt;
    if (reviewOutput) reviewOutput.hidden = false;
    await copyPrompt(prompt);
  });

  document.querySelector('[data-svg-copy-prompt]')?.addEventListener('click', async () => {
    await copyPrompt(promptOutput?.value || buildPrompt());
  });

  const observer = new ResizeObserver(resizeCanvas);
  if (stage) observer.observe(stage);
  resizeCanvas();

  // Catalogue viewer: files remain unloaded until a saved item is explicitly opened.
  const svgDialog = document.querySelector<HTMLDialogElement>('#svg-catalogue-dialog');
  const svgDialogImage = document.querySelector<HTMLImageElement>('#svg-dialog-image');
  const svgDialogTitle = document.querySelector<HTMLElement>('#svg-dialog-title');
  const svgDialogNote = document.querySelector<HTMLElement>('#svg-dialog-note');
  const svgDialogPath = document.querySelector<HTMLElement>('#svg-dialog-path');
  const svgDialogTags = document.querySelector<HTMLElement>('#svg-dialog-tags');
  const svgDialogLoading = document.querySelector<HTMLElement>('#svg-dialog-loading');
  const svgItems = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-svg-catalogue-item]'));

  const clearSvgPreview = () => {
    if (!svgDialogImage) return;
    svgDialogImage.removeAttribute('src');
    svgDialogImage.alt = '';
    svgDialogImage.classList.remove('is-loaded');
    if (svgDialogLoading) {
      svgDialogLoading.hidden = false;
      svgDialogLoading.textContent = 'Loading SVG…';
    }
  };
  const closeSvgDialog = () => {
    if (svgDialog?.open) svgDialog.close();
    clearSvgPreview();
  };
  svgItems.forEach((item) => {
    item.addEventListener('click', () => {
      if (!svgDialog || !svgDialogImage) return;
      const src = item.dataset.svgSrc || '';
      if (!src) return;
      const title = item.dataset.svgTitle || 'SVG preview';
      if (svgDialogTitle) svgDialogTitle.textContent = title;
      if (svgDialogNote) svgDialogNote.textContent = item.dataset.svgNote || 'Validated reusable Atlas SVG.';
      if (svgDialogPath) svgDialogPath.textContent = src;
      if (svgDialogTags) svgDialogTags.textContent = item.dataset.svgTags || '';
      svgDialogImage.alt = `${title} SVG preview`;
      if (svgDialogLoading) svgDialogLoading.hidden = false;
      svgDialogImage.src = src;
      svgDialog.showModal();
    });
  });
  svgDialogImage?.addEventListener('load', () => {
    svgDialogImage.classList.add('is-loaded');
    if (svgDialogLoading) svgDialogLoading.hidden = true;
  });
  svgDialogImage?.addEventListener('error', () => {
    if (svgDialogLoading) svgDialogLoading.textContent = 'Preview unavailable';
  });
  document.querySelector('[data-svg-dialog-close]')?.addEventListener('click', closeSvgDialog);
  svgDialog?.addEventListener('close', clearSvgPreview);
  svgDialog?.addEventListener('click', (event) => {
    if (event.target === svgDialog) closeSvgDialog();
  });
</script>

<style>
  .svg-workshop{position:relative;z-index:1;padding:clamp(34px,5vw,74px)}
  .svg-workshop__heading{max-width:760px;padding-bottom:clamp(32px,4.5vw,52px);border-bottom:1px solid #ded7c9}
  .svg-workshop__kicker{margin:0 0 10px;color:#738076;font-size:.67rem;font-weight:700;letter-spacing:.2em}
  .svg-workshop__heading h2{margin:0;color:#203329;font-family:'Newsreader',Georgia,serif;font-size:clamp(2.4rem,4.5vw,4.5rem);font-weight:400;letter-spacing:-.045em;line-height:.95}
  .svg-workshop__heading>p:last-child{max-width:660px;margin:18px 0 0;color:#72786f;font-family:'Newsreader',Georgia,serif;font-size:1.05rem;line-height:1.55}

  .svg-workbench{margin-top:clamp(38px,5vw,58px);border:1px solid #d9d1c3;background:#f5f0e5;box-shadow:5px 7px 0 rgb(49 87 59/.045)}
  .svg-workbench__topline{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;padding:18px 20px;border-bottom:1px solid #ded6c8;background:#fbf8f1}
  .svg-workbench__topline span{display:block;color:#8a8c84;font-size:.57rem;font-weight:800;letter-spacing:.14em}
  .svg-workbench__topline h3{margin:4px 0 0;color:#263a30;font-family:'Newsreader',Georgia,serif;font-size:1.5rem;font-weight:600}
  .svg-workbench__topline code{display:block;margin-top:5px;color:#8b8d86;font-size:.57rem}
  .svg-workbench__status{flex:none;padding:6px 8px;border:1px solid rgb(183 102 69/.3);color:#a05e43!important;background:rgb(183 102 69/.045);transform:rotate(1deg)}

  .svg-annotation-toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 12px;border-bottom:1px solid #ded6c8;background:#eee7da}
  .svg-annotation-toolbar__tools,.svg-annotation-toolbar__actions{display:flex;flex-wrap:wrap;gap:5px}
  .svg-annotation-toolbar button{min-height:30px;padding:0 10px;border:1px solid transparent;border-radius:2px;color:#697169;background:transparent;font:700 .59rem/1 'Manrope',sans-serif;letter-spacing:.045em;cursor:pointer}
  .svg-annotation-toolbar button:hover{color:#263a30;background:rgb(255 253 248/.65)}
  .svg-annotation-toolbar button.is-active{border-color:rgb(49 87 59/.25);color:#31573b;background:#fffdf8;box-shadow:0 1px 2px rgb(39 49 42/.06)}

  .svg-workbench__stage{position:relative;display:grid;min-height:clamp(380px,46vw,560px);place-items:center;overflow:hidden;background:#fffdf8;isolation:isolate}
  .svg-workbench__stage::before{position:absolute;z-index:1;inset:18px;border:1px dashed rgb(49 87 59/.12);content:'';pointer-events:none}
  .svg-workbench__mount{position:absolute;z-index:0;inset:0;display:grid;place-items:center;padding:clamp(24px,4vw,46px)}
