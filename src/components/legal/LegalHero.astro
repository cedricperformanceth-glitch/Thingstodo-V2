---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
}

const {
  eyebrow = 'Legal',
  title,
  intro,
} = Astro.props;
---

<header class="legal-hero">
  <p class="legal-hero__eyebrow">{eyebrow}</p>
  <h1>{title}</h1>
  {intro && <p class="legal-hero__intro">{intro}</p>}
</header>

<style>
  .legal-hero {
    width: min(860px, 100%);
    margin: clamp(22px, 4vw, 52px) auto clamp(34px, 6vw, 72px);
    text-align: center;
  }

  .legal-hero__eyebrow {
    margin: 0 0 12px;
    color: rgb(49 87 59 / .72);
    font-family: 'DM Sans', Arial, sans-serif;
    font-size: .7rem;
    font-weight: 700;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  .legal-hero h1 {
    margin: 0;
    color: var(--ink);
    font-family: 'Newsreader', Georgia, serif;
    font-size: clamp(2.55rem, 7vw, 5.35rem);
    font-weight: 400;
    line-height: .98;
    letter-spacing: -.045em;
  }

  .legal-hero__intro {
    width: min(620px, 100%);
    margin: 18px auto 0;
    color: rgb(31 43 36 / .68);
    font-family: 'Manrope', ui-sans-serif, system-ui, sans-serif;
    font-size: clamp(.92rem, 1.6vw, 1.05rem);
    line-height: 1.7;
  }

  @media (max-width: 620px) {
    .legal-hero {
      margin-top: 12px;
      margin-bottom: 34px;
    }

    .legal-hero__eyebrow {
      margin-bottom: 10px;
      font-size: .63rem;
    }

    .legal-hero__intro {
      margin-top: 14px;
      font-size: .9rem;
      line-height: 1.62;
    }
  }
</style>
