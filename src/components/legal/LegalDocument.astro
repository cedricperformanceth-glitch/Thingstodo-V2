---
import type { LegalPageData } from '../../features/legal/types';
import LegalSection from './LegalSection.astro';

interface Props {
  page: LegalPageData;
}

const { page } = Astro.props;
const showToc = Boolean(page.showToc && page.sections.length > 1);
---

<article class="legal-document" aria-labelledby="legal-document-title">
  <div class="legal-document__inner">
    <header class="legal-document__header">
      <p class="legal-document__label">{page.documentLabel ?? 'Legal note'}</p>
      <p class="legal-document__title" id="legal-document-title">{page.title}</p>
      {page.documentIntro && <p class="legal-document__intro">{page.documentIntro}</p>}
      <p class="legal-document__updated">
        <span>Last updated</span>
        <time>{page.lastUpdated}</time>
      </p>
    </header>

    {showToc && (
      <nav class="legal-document__toc" aria-label="On this page">
        <p>On this page</p>
        <ol>
          {page.sections.map((section, index) => (
            <li>
              <a href={`#${section.id}`}>
                <span>{section.number ?? String(index + 1).padStart(2, '0')}</span>
                {section.title}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <div class="legal-document__sections">
      {page.sections.map((section, index) => <LegalSection section={section} ordinal={index + 1} />)}
    </div>

    <footer class="legal-document__footer">
      <div>
        <span>Last updated</span>
        <time>{page.lastUpdated}</time>
      </div>
      {page.footerNote && <p>{page.footerNote}</p>}
    </footer>
  </div>
</article>

<style>
  .legal-document {
    width: min(970px, 100%);
    margin: 0 auto clamp(28px, 6vw, 72px);
    border: 1px solid rgb(49 87 59 / .1);
    background: var(--field-card-sheet);
    box-shadow: 0 22px 65px rgb(44 52 46 / .055);
  }

  .legal-document__inner {
    width: min(738px, calc(100% - clamp(48px, 10vw, 118px)));
    margin: 0 auto;
    padding: clamp(48px, 8vw, 86px) 0 clamp(42px, 7vw, 72px);
  }

  .legal-document__header {
    padding-bottom: clamp(34px, 5vw, 48px);
    border-bottom: 1px solid rgb(49 87 59 / .14);
  }

  .legal-document__label {
    margin: 0 0 12px;
    color: rgb(49 87 59 / .68);
    font-family: 'DM Sans', Arial, sans-serif;
    font-size: .63rem;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  .legal-document__title {
    margin: 0;
    color: var(--ink);
    font-family: 'Newsreader', Georgia, serif;
    font-size: clamp(2rem, 4.8vw, 3.15rem);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -.035em;
  }

  .legal-document__intro {
    width: min(650px, 100%);
    margin: 17px 0 0;
    color: rgb(31 43 36 / .7);
    font-family: 'Newsreader', Georgia, serif;
    font-size: clamp(1.02rem, 1.85vw, 1.15rem);
    line-height: 1.65;
  }

  .legal-document__updated {
    display: flex;
    flex-wrap: wrap;
    gap: 5px 9px;
    margin: 19px 0 0;
    color: rgb(31 43 36 / .5);
    font-family: 'DM Sans', Arial, sans-serif;
    font-size: .65rem;
    line-height: 1.4;
    letter-spacing: .045em;
  }

  .legal-document__updated span::after {
    content: '·';
    margin-left: 9px;
  }

  .legal-document__toc {
    margin-top: 28px;
    padding: 20px 0 22px;
    border-bottom: 1px solid rgb(49 87 59 / .12);
  }

  .legal-document__toc > p {
    margin: 0 0 11px;
    color: rgb(49 87 59 / .62);
    font-family: 'DM Sans', Arial, sans-serif;
    font-size: .61rem;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .legal-document__toc ol {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 7px 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .legal-document__toc a {
    display: flex;
    gap: 9px;
    color: rgb(31 43 36 / .68);
    font-family: 'Manrope', ui-sans-serif, system-ui, sans-serif;
    font-size: .78rem;
    line-height: 1.45;
    text-decoration: none;
  }

  .legal-document__toc a span {
    flex: none;
    color: rgb(49 87 59 / .46);
    font-family: 'DM Sans', Arial, sans-serif;
    font-size: .62rem;
    font-weight: 700;
    line-height: 1.85;
  }

  .legal-document__toc a:hover,
  .legal-document__toc a:focus-visible {
    color: #9d5139;
  }

  .legal-document__sections {
    padding-top: clamp(42px, 6.5vw, 64px);
  }

  .legal-document__footer {
    display: grid;
    gap: 8px;
    margin-top: clamp(58px, 8vw, 84px);
    padding-top: 20px;
    border-top: 1px solid rgb(49 87 59 / .14);
    color: rgb(31 43 36 / .46);
    font-family: 'DM Sans', Arial, sans-serif;
    font-size: .63rem;
    line-height: 1.55;
    letter-spacing: .035em;
  }

  .legal-document__footer div {
    display: flex;
    flex-wrap: wrap;
    gap: 5px 9px;
  }

  .legal-document__footer div span::after {
    content: '·';
    margin-left: 9px;
  }

  .legal-document__footer p {
    margin: 0;
  }

  @media (max-width: 720px) {
    .legal-document {
      width: calc(100% + 2rem);
      margin-left: -1rem;
      margin-right: -1rem;
      border-inline: 0;
      box-shadow: none;
    }

    .legal-document__inner {
      width: calc(100% - 38px);
      padding: 38px 0 42px;
    }

    .legal-document__header {
      padding-bottom: 30px;
    }

    .legal-document__toc ol {
      grid-template-columns: 1fr;
      gap: 7px;
    }

    .legal-document__sections {
      padding-top: 38px;
    }

    .legal-document__footer {
      margin-top: 52px;
    }
  }
</style>
