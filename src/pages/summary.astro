---
import BaseLayout from '../components/layout/BaseLayout.astro';
import '../features/summary/summary-adjustments.css';
import '../features/summary/whatsapp-share.css';

const seo = {
  title: 'Trip Summary | Things To Do Atlas',
  description: 'Your personal Things To Do Atlas summary.',
  canonicalPath: '/summary',
  indexable: false,
};
---
<BaseLayout seo={seo}>
  <section class="summary-shell" aria-labelledby="trip-summary-title">
    <div class="summary-clipboard" data-trip-summary>
      <img
        class="summary-clipboard__frame"
        src="/assets/shared/summary/clipboard-trip-summary.svg"
        alt=""
        aria-hidden="true"
        decoding="async"
      />

      <svg class="summary-clipboard__clip" viewBox="0 0 300 112" aria-hidden="true">
        <g fill="none" stroke-linecap="round" stroke-linejoin="round">
          <path d="M91 34V24C91 13 100 5 111 5H189C200 5 209 13 209 24V34" stroke="#725f45" stroke-width="6"/>
          <rect x="56" y="29" width="188" height="76" rx="18" fill="#ad9169" stroke="#725f45" stroke-width="4"/>
          <path d="M81 52H219" stroke="#d8c2a2" stroke-width="4" opacity=".82"/>
          <path d="M78 84C124 79 174 79 222 84" stroke="#7b6548" stroke-width="3" opacity=".55"/>
          <rect x="111" y="13" width="78" height="36" rx="12" fill="#c5aa82" stroke="#725f45" stroke-width="4"/>
          <circle cx="150" cy="31" r="7" fill="#725f45" stroke="none"/>
        </g>
      </svg>

      <span class="paper-detail paper-detail--date" aria-hidden="true">LAOS / 2026</span>
      <span class="paper-detail paper-detail--check" aria-hidden="true">✓ field notes</span>
      <span class="paper-detail paper-detail--corner" aria-hidden="true"></span>

      <div class="summary-clipboard__ui">
        <header class="summary-heading">
          <p class="summary-heading__eyebrow">PERSONAL ATLAS</p>
          <h1 id="trip-summary-title">Trip Summary</h1>
          <p class="summary-status" data-summary-status aria-live="polite">YOUR ATLAS · 0 places collected · 0 favorites · 2 routes</p>
        </header>

        <div class="summary-tabs" role="tablist" aria-label="Trip Summary sections">
          <button
            id="summary-tab-atlas"
            class="summary-tab summary-tab--atlas"
            type="button"
            role="tab"
            aria-selected="true"
            aria-controls="summary-panel-atlas"
            data-summary-tab="atlas"
          >
            <span aria-hidden="true">01</span>
            My Atlas
          </button>
          <button
            id="summary-tab-favorites"
            class="summary-tab summary-tab--favorites"
            type="button"
            role="tab"
            aria-selected="false"
            aria-controls="summary-panel-favorites"
            data-summary-tab="favorites"
            tabindex="-1"
          >
            <span aria-hidden="true">02</span>
            My Favorites
          </button>
          <button
            id="summary-tab-adventure"
            class="summary-tab summary-tab--adventure"
            type="button"
            role="tab"
            aria-selected="false"
            aria-controls="summary-panel-adventure"
            data-summary-tab="adventure"
            tabindex="-1"
          >
            <span aria-hidden="true">03</span>
            The Adventure
          </button>
        </div>

        <div class="summary-panels">
          <section
            id="summary-panel-atlas"
            class="summary-panel summary-panel--atlas"
            role="tabpanel"
            aria-labelledby="summary-tab-atlas"
            data-summary-panel="atlas"
          >
            <div class="summary-panel__intro">
              <h2 class="summary-visually-hidden">My Atlas</h2>
              <p class="summary-count" data-summary-atlas-count aria-live="polite">0 SAVED PLACES</p>
              <p class="summary-panel__note">Your journey so far.</p>
              <button
                class="summary-take-atlas"
                type="button"
                data-summary-share-open
                disabled
              >
                <span>Take my Atlas with me</span>
                <span class="summary-take-atlas__arrow" aria-hidden="true">↗</span>
              </button>
            </div>
            <div class="summary-grid" data-summary-atlas-grid></div>
          </section>

          <section
            id="summary-panel-favorites"
            class="summary-panel summary-panel--favorites"
            role="tabpanel"
            aria-labelledby="summary-tab-favorites"
            data-summary-panel="favorites"
            hidden
          >
            <div class="summary-panel__intro">
              <h2 class="summary-visually-hidden">My Favorites</h2>
              <p class="summary-count" data-summary-favorites-count aria-live="polite">0 FAVORITES</p>
              <p class="summary-panel__note">The places you would choose again.</p>
            </div>
            <div class="summary-grid" data-summary-favorites-grid></div>
          </section>

          <section
            id="summary-panel-adventure"
            class="summary-panel summary-panel--adventure"
            role="tabpanel"
            aria-labelledby="summary-tab-adventure"
            data-summary-panel="adventure"
            hidden
          >
            <div class="summary-panel__intro summary-panel__intro--adventure">
              <h2 class="summary-visually-hidden">The Adventure</h2>
              <p class="summary-count" data-summary-route-count>2 ROUTES READY</p>
              <p class="summary-panel__note adventure-intro">Choose a direction and turn the places you collected into a journey.</p>
            </div>

            <div class="adventure-routes" aria-label="Laos adventure routes">
              <article class="adventure-route adventure-route--north-south">
                <div class="adventure-route__identity">
                  <div class="adventure-route__kicker">
                    <span class="adventure-route__number">01</span>
                    <p class="adventure-route__label">LAOS · ROUTE 01</p>
                  </div>
                  <h3><span>NORTH</span><b aria-hidden="true">↓</b><span>SOUTH</span></h3>
                </div>
                <ol class="adventure-route__stops" aria-label="North to South route stops">
                  <li>Luang Prabang</li>
                  <li>Vang Vieng</li>
                  <li>Vientiane</li>
                  <li>Thakhek</li>
                  <li>Bolaven Loop</li>
                  <li>Pakse</li>
                  <li>Don Det</li>
                </ol>
                <span class="adventure-route__status">OPEN ROUTE →</span>
              </article>

              <article class="adventure-route adventure-route--south-north">
                <div class="adventure-route__identity">
                  <div class="adventure-route__kicker">
                    <span class="adventure-route__number">02</span>
                    <p class="adventure-route__label">LAOS · ROUTE 02</p>
                  </div>
                  <h3><span>SOUTH</span><b aria-hidden="true">↑</b><span>NORTH</span></h3>
                </div>
                <ol class="adventure-route__stops" aria-label="South to North route stops">
                  <li>Don Det</li>
                  <li>Pakse</li>
                  <li>Bolaven Loop</li>
                  <li>Thakhek</li>
                  <li>Vientiane</li>
                  <li>Vang Vieng</li>
                  <li>Luang Prabang</li>
                  <li>Slow Boat</li>
                </ol>
                <span class="adventure-route__status">OPEN ROUTE →</span>
              </article>
            </div>

            <div class="adventure-note">
              <span aria-hidden="true">✓</span>
              <p>Collect places. Keep the ones that matter. Then choose the road that connects them.</p>
            </div>
          </section>
        </div>
      </div>

      <div class="summary-share" data-summary-share-modal hidden>
        <div
          class="summary-share__dialog"
          role="dialog"
          aria-modal="true"
          aria-labelledby="summary-share-title"
          aria-describedby="summary-share-description"
          data-summary-share-dialog
          tabindex="-1"
        >
          <button
            class="summary-share__close"
            type="button"
            aria-label="Close WhatsApp sharing"
            data-summary-share-close
          >×</button>
          <p class="summary-share__eyebrow">TAKE IT WITH YOU</p>
          <h2 id="summary-share-title">Your Atlas is ready.</h2>
          <p class="summary-share__copy" id="summary-share-description" data-summary-share-count>
            Save a place to prepare your Atlas.
          </p>
          <a
            class="summary-share__whatsapp"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            data-summary-share-whatsapp
            aria-disabled="true"
          >
            <span>Send to WhatsApp</span>
            <span aria-hidden="true">↗</span>
          </a>
          <p class="summary-share__note">WhatsApp opens with your Atlas prepared. Choose yourself, a friend or a group — no phone number is stored here.</p>
        </div>
      </div>
    </div>
  </section>

  <script>
    import '../features/summary/client';
    import '../features/summary/whatsapp-share';
  </script>
</BaseLayout>
