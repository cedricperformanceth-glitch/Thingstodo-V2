---
import BaseLayout from '../../../components/layout/BaseLayout.astro';
import CityFieldNote from '../../../components/city-field-note/CityFieldNote.astro';
import { getCities, getCity } from '../../../engines/city/city-engine';
import { getCountry } from '../../../engines/country/country-engine';
import { cityFieldNotePath, cityPath } from '../../../core/routing/paths';

export function getStaticPaths() {
  return getCities().map((city) => ({ params: { country: city.country, city: city.slug } }));
}

const city = getCity(Astro.params.country ?? '', Astro.params.city ?? '');
const country = getCountry(Astro.params.country ?? '');
if (!city || !country) return Astro.redirect('/');

const seo = {
  title: `${city.name} City Field Note | Things To Do Atlas`,
  description: `Read the ${city.name} city field note: destination context, local rhythm, movement, stay planning and practical orientation before opening the detailed Atlas chapters.`,
  canonicalPath: cityFieldNotePath(city),
  indexable: false,
};
---

<BaseLayout
  {seo}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: country.name, path: `/${country.slug}` },
    { name: city.name, path: cityPath(city) },
    { name: 'City Field Note', path: cityFieldNotePath(city) },
  ]}
  ogType="article"
>
  <main class="city-field-note-page">
    <nav class="city-field-note-page__return" aria-label={`${city.name} field note navigation`}>
      <a href={cityPath(city)}>← Back to {city.name}</a>
      <span>City note · generated layer</span>
    </nav>
    <CityFieldNote {city} {country} />
  </main>
</BaseLayout>

<style>
  .city-field-note-page { width:min(1280px,calc(100% - 1rem)); margin:0 auto; padding:clamp(5rem,8vw,7rem) 0 4rem; }
  .city-field-note-page__return { display:flex; justify-content:space-between; gap:1rem; padding:0 clamp(.5rem,3vw,2.5rem) 1.25rem; color:#315545; font:500 .78rem var(--field-card-handwritten); }
  .city-field-note-page__return a { text-decoration:none; }.city-field-note-page__return span { color:#8c4c40; }
  @media(max-width:600px){.city-field-note-page{width:calc(100% - .5rem)}.city-field-note-page__return span{display:none}}
</style>
