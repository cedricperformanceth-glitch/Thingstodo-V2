---
import BaseLayout from '../../../components/layout/BaseLayout.astro';
import CityFieldNote from '../../../components/city-field-note/CityFieldNote.astro';
import { getCities, getCity } from '../../../engines/city/city-engine';
import { getCountry } from '../../../engines/country/country-engine';
import { getEditorialCityFieldNoteMedia, getEditorialCityFieldNoteSeo } from '../../../engines/city-field-note/city-field-note-editorial';
import { cityFieldNotePath, cityPath } from '../../../core/routing/paths';

export function getStaticPaths() {
  return getCities().map((city) => ({ params: { country: city.country, city: city.slug } }));
}

const city = getCity(Astro.params.country ?? '', Astro.params.city ?? '');
const country = getCountry(Astro.params.country ?? '');
if (!city || !country) return Astro.redirect('/');

const editorialSeo = getEditorialCityFieldNoteSeo(city.id);
const editorialMedia = getEditorialCityFieldNoteMedia(city.id);
const heroImage = editorialMedia[0];
const seo = {
  title: editorialSeo?.title ?? `${city.name} City Field Note | Things To Do Atlas`,
  description: editorialSeo?.description ?? `Read the ${city.name} city field note: destination context, local rhythm, movement, stay planning and practical orientation before opening the detailed Atlas chapters.`,
  canonicalPath: cityFieldNotePath(city),
  indexable: editorialSeo?.indexable ?? false,
  ...(heroImage ? { image: heroImage.src, imageAlt: heroImage.alt } : {}),
};
const structuredData = [{
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: editorialSeo?.title ?? `${city.name} City Field Note`,
  description: seo.description,
  inLanguage: 'en',
  about: { '@type': 'Place', name: city.name },
  contentLocation: {
    '@type': 'Place',
    name: `${city.name}, ${country.name}`,
    geo: { '@type': 'GeoCoordinates', latitude: city.coordinates.latitude, longitude: city.coordinates.longitude },
  },
  ...(heroImage ? { image: heroImage.src } : {}),
}];
---

<BaseLayout
  {seo}
  {structuredData}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: country.name, path: `/${country.slug}` },
    { name: city.name, path: cityPath(city) },
    { name: 'City Field Note', path: cityFieldNotePath(city) },
  ]}
  ogType="article"
>
  <div class="city-field-note-page">
    <nav class="city-field-note-page__return" aria-label={`${city.name} field note navigation`}>
      <a href={cityPath(city)}>← Back to {city.name}</a>
      <span>{editorialSeo ? 'Researched city note' : 'City note · generated layer'}</span>
    </nav>
    <CityFieldNote {city} {country} />
  </div>
</BaseLayout>

<style>
  .city-field-note-page { width:100%; padding:clamp(5rem,8vw,7rem) 0 4rem; }
  .city-field-note-page__return { display:flex; width:min(1180px,calc(100% - 48px)); margin-inline:auto; align-items:center; justify-content:space-between; gap:20px; padding:0 0 24px; border-bottom:1px solid rgb(49 85 69/.2); color:#315545; font:700 .72rem/1.2 var(--field-card-practical); letter-spacing:.08em; text-transform:uppercase; }
  .city-field-note-page__return a { color:inherit; text-decoration:none; }
  .city-field-note-page__return span { color:#8c4c40; }
  :global(body:has(.city-note) #main-content) { width:100%; max-width:none; padding:0; }
  @media(max-width:620px){.city-field-note-page__return{width:min(100% - 24px,1180px)}.city-field-note-page__return span{display:none}}
</style>
