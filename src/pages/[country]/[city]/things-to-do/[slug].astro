---
import BaseLayout from '../../../../components/layout/BaseLayout.astro';
import FieldCard from '../../../../components/field-card/FieldCard.astro';
import FieldCardNavigation from '../../../../components/field-card/FieldCardNavigation.astro';
import { getCities, getCity } from '../../../../engines/city/city-engine';
import { getCountry } from '../../../../engines/country/country-engine';
import { getThings, getThing } from '../../../../engines/category/category-engine';
import { cityPath, countryPath, thingPath } from '../../../../core/routing/paths';

export function getStaticPaths() {
  return getCities().flatMap((city) => getThings(city).map((thing) => ({
    params: { country: city.country, city: city.slug, slug: thing.slug },
  })));
}

const city = getCity(Astro.params.country ?? '', Astro.params.city ?? '');
const country = getCountry(Astro.params.country ?? '');
const thing = city ? getThing(city, Astro.params.slug ?? '') : undefined;
if (!city || !country || !thing) return Astro.redirect('/');

const seo = {
  title: `${thing.name} | Things To Do Atlas`,
  description: thing.shortDescription,
  canonicalPath: thingPath(city, thing),
  indexable: city.seo.indexable,
};

const breadcrumbs = [
  { name: 'Atlas', path: '/' },
  { name: country.name, path: countryPath(country) },
  { name: city.name, path: cityPath(city) },
  { name: thing.name, path: thingPath(city, thing) },
];
---

<BaseLayout {seo} {breadcrumbs}>
  <FieldCardNavigation {country} {city} {thing} />
  <FieldCard {thing} />
</BaseLayout>
