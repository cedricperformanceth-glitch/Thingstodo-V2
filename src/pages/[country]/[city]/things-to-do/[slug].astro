---
import BaseLayout from '../../../../components/layout/BaseLayout.astro';
import FieldCard from '../../../../components/field-card/FieldCard.astro';
import { getCities, getCity } from '../../../../engines/city/city-engine';
import { getThings, getThing } from '../../../../engines/category/category-engine';
import { cityPath, thingPath } from '../../../../core/routing/paths';
export function getStaticPaths() { return getCities().flatMap((city) => getThings(city.slug).map((thing) => ({ params:{country:city.country,city:city.slug,slug:thing.slug} }))); }
const city = getCity(Astro.params.country ?? '', Astro.params.city ?? '');
const thing = city ? getThing(city.slug, Astro.params.slug ?? '') : undefined;
if (!city || !thing) return Astro.redirect('/');
const seo = { title:`${thing.name} | Things To Do Atlas`, description:thing.shortDescription, canonicalPath:thingPath(city,thing), indexable:true };
---
<BaseLayout {seo} breadcrumbs={[{name:'Home',path:'/'},{name:'Laos',path:'/laos'},{name:city.name,path:cityPath(city)},{name:'Things to do',path:`${cityPath(city)}/things-to-do`},{name:thing.name,path:thingPath(city,thing)}]}><FieldCard {city} {thing} /></BaseLayout>
