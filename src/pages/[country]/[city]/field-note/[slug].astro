---
import { getCities, getCity } from '../../../../engines/city/city-engine';
import { getCityFieldNoteSpaTargets } from '../../../../engines/city-field-note/city-field-note-spa-links';
import { getCountryFieldNote } from '../../../../content/country-field-notes';
import { countryFieldNotePath } from '../../../../core/routing/paths';

export function getStaticPaths() {
  return getCities().flatMap((city) =>
    getCityFieldNoteSpaTargets(city)
      .filter((target) => target.id.startsWith('country-'))
      .map((target) => ({
        params: {
          country: city.country,
          city: city.slug,
          slug: target.id.replace(/^country-/, ''),
        },
      })),
  );
}

const city = getCity(Astro.params.country ?? '', Astro.params.city ?? '');
const noteCountry = getCountryFieldNote(Astro.params.slug ?? '');
const isLinked = city && noteCountry && getCityFieldNoteSpaTargets(city).some((target) => target.id === noteCountry.id);
if (!city || !noteCountry || !isLinked) return Astro.redirect('/');

// This nested path is only a legacy deep link to a country field note.
// Send visitors and crawlers to the single canonical public URL instead of
// publishing a duplicate copy with a noindex directive.
return Astro.redirect(countryFieldNotePath(noteCountry), 301);
