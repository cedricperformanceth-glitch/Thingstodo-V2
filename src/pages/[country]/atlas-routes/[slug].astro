---
import BaseLayout from '../../../components/layout/BaseLayout.astro';
import AtlasRoutePage from '../../../components/atlas-route/AtlasRoutePage.astro';
import { getAtlasRouteContent } from '../../../content/atlas-route-content';
import { getAtlasRouteEditorialContent } from '../../../content/atlas-route-editorial';
import { applyAtlasRouteMediaPolicy } from '../../../content/atlas-route-media-policy';
import { getAllFinalCtaRoutes } from '../../../content/final-cta-routes';

export function getStaticPaths() {
  return getAllFinalCtaRoutes().map((route) => ({
    params: { country: route.country, slug: route.slug },
    props: { route },
  }));
}

const { route } = Astro.props;
const editorialRouteContent = getAtlasRouteEditorialContent(route.country, route.slug);
const rawRouteContent = editorialRouteContent ?? getAtlasRouteContent(route.country, route.slug);
const routeContent = rawRouteContent ? applyAtlasRouteMediaPolicy(rawRouteContent) : undefined;

const seo = {
  title: editorialRouteContent
    ? `${editorialRouteContent.title} | Things To Do Atlas`
    : `${route.label} Atlas Route | Things To Do Atlas`,
  description: editorialRouteContent
    ? editorialRouteContent.subtitle
    : `${route.label} travel route for ${route.country}.`,
  canonicalPath: route.href,
  indexable: Boolean(editorialRouteContent),
};
---

<BaseLayout
  seo={seo}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: route.country.toUpperCase(), path: `/${route.country}` },
    { name: route.label, path: route.href },
  ]}
  ogType="article"
>
  {routeContent ? (
    <AtlasRoutePage route={routeContent} />
  ) : (
    <section class="atlas-route-shell">
      <p>ATLAS ROUTE</p>
      <h1>{route.label}</h1>
      <p class="atlas-route-shell__note">This route is registered and ready for its reusable Atlas Route content blocks.</p>
      <a href={`/${route.country}`}>Continue exploring {route.country} →</a>
    </section>
  )}
</BaseLayout>

<style>
  :global(#main-content) {
    width: min(1240px, calc(100% - 2rem));
    padding-top: 0;
    padding-bottom: 0;
  }

  .atlas-route-shell {
    width: min(760px, calc(100% - 2rem));
    min-height: 72vh;
    margin: 0 auto;
    padding: 10rem 0 6rem;
  }

  .atlas-route-shell > p:first-child {
    margin: 0 0 .65rem;
    color: #b76645;
    font-size: .7rem;
    font-weight: 700;
    letter-spacing: .16em;
  }

  .atlas-route-shell h1 {
    margin: 0;
    color: #315545;
  }

  .atlas-route-shell__note {
    margin: 1.5rem 0 3rem;
    color: #645f56;
  }

  .atlas-route-shell a {
    color: #315545;
    font-family: 'Caveat', cursive;
    font-size: 1.25rem;
  }
</style>
