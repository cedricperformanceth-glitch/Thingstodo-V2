  .admin-workspace{display:grid;grid-template-columns:minmax(260px,330px) minmax(0,1fr);gap:clamp(28px,4.5vw,70px);align-items:start}.admin-tabs{position:sticky;top:32px;display:grid;gap:2px}.admin-tab{position:relative;display:grid;grid-template-columns:38px 1fr;gap:13px;width:100%;padding:19px 14px 19px 8px;border:0;border-bottom:1px solid rgb(64 74 66/.13);color:#72776f;background:transparent;text-align:left;cursor:pointer;transition:color .18s ease,transform .18s ease}.admin-tab:hover{color:#203329;transform:translateX(3px)}.admin-tab::before{position:absolute;left:-14px;top:50%;width:4px;height:0;border-radius:4px;background:#31573b;content:'';transform:translateY(-50%);transition:height .18s ease}.admin-tab.is-active{color:#203329}.admin-tab.is-active::before{height:44px}.admin-tab__index{padding-top:3px;color:#a1a096;font-size:.64rem;font-weight:600;letter-spacing:.14em}.admin-tab__copy{display:grid;gap:4px}.admin-tab__copy strong{font-family:'Newsreader',Georgia,serif;font-size:1.32rem;font-weight:600}.admin-tab__copy small{color:#8a8c84;font-size:.72rem}
  .admin-canvas-wrap{position:relative;min-width:0}.admin-panel{position:relative;min-height:760px;border:1px solid rgb(74 68 55/.11);background:#fffdf8;box-shadow:0 26px 70px rgb(57 47 31/.09),0 2px 4px rgb(57 47 31/.05)}.admin-panel::after{position:absolute;inset:16px;border:1px solid rgb(49 87 59/.035);content:'';pointer-events:none}.admin-tape{position:absolute;z-index:3;top:-14px;width:90px;height:30px;background:rgb(226 210 165/.68);box-shadow:0 1px 1px rgb(54 46 31/.08);pointer-events:none}.admin-tape--left{left:9%;transform:rotate(-4deg)}.admin-tape--right{right:8%;transform:rotate(3deg)}
  .city-form{position:relative;z-index:1;padding:clamp(34px,5vw,74px)}.panel-heading{max-width:720px;padding-bottom:clamp(34px,5vw,58px);border-bottom:1px solid #ded7c9}.panel-kicker{margin:0 0 10px;color:#738076;font-size:.67rem;font-weight:700;letter-spacing:.2em}.panel-heading h2{margin:0;color:#203329;font-family:'Newsreader',Georgia,serif;font-size:clamp(2.4rem,4.5vw,4.5rem);font-weight:400;letter-spacing:-.045em;line-height:.95}.panel-heading>p:last-child{max-width:620px;margin:18px 0 0;color:#72786f;font-family:'Newsreader',Georgia,serif;font-size:1.05rem;line-height:1.55}
  .form-section{display:grid;grid-template-columns:54px minmax(0,1fr);gap:clamp(18px,3vw,38px);padding:clamp(42px,6vw,70px) 0;border-bottom:1px solid #e4ddcf}.form-section--last{border-bottom:0;padding-bottom:0}.section-number{padding-top:4px;color:#a39d91;font-size:.64rem;font-weight:700;letter-spacing:.14em}.section-content{min-width:0}.section-heading{max-width:690px;margin-bottom:28px}.section-heading h3{margin:0 0 7px;color:#263a30;font-family:'Newsreader',Georgia,serif;font-size:1.75rem;font-weight:600}.section-heading p{margin:0;color:#7a7f77;font-size:.84rem;line-height:1.6}.field-grid{display:grid;gap:18px}.field-grid--two{grid-template-columns:repeat(2,minmax(0,1fr))}.field{display:grid;gap:9px}.field>span,.choice-fieldset legend{color:#59665e;font-size:.7rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase}.field input,.field select{width:100%;min-height:52px;padding:0 14px;border:1px solid #d7d0c2;border-radius:3px;color:#23352c;background:#fffdf8;font:inherit;outline:none}.field input:focus,.field select:focus{border-color:#6e8a76;box-shadow:0 0 0 3px rgb(49 87 59/.08)}.field--short{max-width:240px}.choice-fieldset{margin:28px 0 0;padding:0;border:0}.settlement-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:10px}.settlement-card{position:relative;cursor:pointer}.settlement-card input{position:absolute;opacity:0}.settlement-card__body{display:grid;gap:4px;padding:18px 20px;border:1px solid #d8d1c4;background:#fbf8f1;transition:.18s ease}.settlement-card__body strong{font-family:'Newsreader',Georgia,serif;font-size:1.18rem}.settlement-card__body small{color:#85877f;font-size:.72rem}.settlement-card input:checked+.settlement-card__body{border-color:#31573b;background:#f0f3eb;box-shadow:inset 4px 0 0 #31573b}.automatic-note{display:flex;gap:15px;align-items:flex-start;margin-top:18px;padding:17px 18px;background:#f5f0df}.automatic-note__stamp{flex:0 0 auto;padding:4px 7px;border:1px solid rgb(49 87 59/.28);color:#31573b;font-size:.59rem;font-weight:700;letter-spacing:.12em;transform:rotate(-2deg)}.automatic-note strong{display:block;color:#44534b;font-size:.78rem}.automatic-note p{margin:4px 0 0;color:#777b74;font-size:.72rem;line-height:1.5}.number-input{display:flex;align-items:center;gap:10px}.number-input input{max-width:112px}.number-input small{color:#8d8d84;font-size:.72rem}.field-hint{max-width:650px;margin:16px 0 0;color:#8a887f;font-family:'Newsreader',Georgia,serif;font-size:.9rem;font-style:italic;line-height:1.55}.asset-list{display:grid;border-top:1px solid #ddd5c6}.asset-row{display:grid;grid-template-columns:90px minmax(0,1fr);gap:18px;align-items:start;padding:16px 0;border-bottom:1px solid #e5ded1}.asset-row__type{padding-top:3px;color:#7b8179;font-size:.62rem;font-weight:700;letter-spacing:.12em}.asset-row code{overflow-wrap:anywhere;color:#385446;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.77rem}.command-card{border:1px solid #d5cebf;background:#f3efe5}.command-card__top{display:flex;align-items:center;justify-content:space-between;padding:10px 13px;border-bottom:1px solid #ddd5c7;color:#7b7e76;font-size:.61rem;font-weight:700;letter-spacing:.12em}.command-card__top button{border:0;color:#31573b;background:transparent;font:inherit;cursor:pointer}.command-card>code{display:block;padding:18px;overflow-wrap:anywhere;color:#253c30;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.78rem;line-height:1.6}.generation-summary{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-top:16px}.generation-summary>div{padding:14px;border:1px solid #e0d8ca}.generation-summary small{display:block;margin-bottom:4px;color:#98958b;font-size:.59rem;letter-spacing:.1em;text-transform:uppercase}.generation-summary strong{color:#4c5c53;font-size:.72rem;font-weight:600}.generate-button{display:flex;align-items:center;justify-content:space-between;gap:20px;width:100%;margin-top:24px;padding:18px 20px;border:1px solid #263c30;border-radius:2px;color:#fbf7ed;background:#263c30;cursor:pointer;text-align:left}.generate-button span{font-family:'Newsreader',Georgia,serif;font-size:1.05rem}.generate-button small{color:#cad4cc;font-size:.68rem}.copy-feedback{min-height:1.2em;margin:10px 0 0;color:#64736a;font-size:.72rem}
  .admin-note{width:max-content;margin:clamp(30px,5vw,54px) 5% 0 auto;color:rgb(49 87 59/.62);font-family:'Caveat',cursive;font-size:clamp(1.1rem,1.8vw,1.45rem);transform:rotate(-2deg)}
  @media(max-width:820px){.admin-shell{width:min(100% - 28px,720px);padding-top:28px}.admin-header{align-items:flex-start}.admin-brand__mark,.admin-status{display:none}.admin-workspace{grid-template-columns:1fr;gap:24px}.admin-tabs{position:static;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.admin-tab{grid-template-columns:1fr;min-height:108px;padding:16px;border:1px solid rgb(49 87 59/.12);background:rgb(255 253 248/.45)}.admin-tab::before{left:15px;top:auto;bottom:-1px;width:0;height:3px;transform:none}.admin-tab.is-active::before{width:52px;height:3px}.admin-tab:hover{transform:none}.admin-tab__index{padding:0}.field-grid--two,.settlement-options,.generation-summary{grid-template-columns:1fr}.city-form{padding:34px 24px}.form-section{grid-template-columns:1fr;gap:10px}.section-number{padding:0}.admin-panel::after{inset:8px}} @media(max-width:520px){.admin-header h1{font-size:clamp(2.85rem,15vw,4.2rem)}.admin-intro{margin-top:14px;font-size:1rem}.admin-tabs{grid-template-columns:1fr}.admin-tab{min-height:88px}.asset-row{grid-template-columns:1fr;gap:6px}.generate-button{align-items:flex-start;flex-direction:column}}
</style>
