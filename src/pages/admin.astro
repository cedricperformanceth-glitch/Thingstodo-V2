---
import '../core/design-system/tokens.css';
import { getCountries } from '../engines/country/country-engine';
import FontCatalog from '../components/admin/FontCatalog.astro';

const countries = getCountries();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#f4f0e7" />
    <title>Atlas Admin</title>
  </head>
  <body class="admin-body">
    <main class="admin-shell">
      <header class="admin-header">
        <div class="admin-brand">
          <div class="admin-brand__mark" aria-hidden="true"><span>ATLAS</span><small>V2</small></div>
          <div>
            <p class="admin-eyebrow">EDITORIAL WORKSPACE</p>
            <h1>Atlas Admin</h1>
            <p class="admin-intro">Prepare the next destination, then let the Atlas pipeline do the repetitive work.</p>
          </div>
        </div>
        <div class="admin-status"><span class="admin-status__dot"></span><span>Private workspace</span></div>
      </header>

      <section class="admin-workspace" aria-label="Atlas admin workspace">
        <nav class="admin-tabs" role="tablist" aria-label="Admin sections">
          <button class="admin-tab is-active" type="button" role="tab" id="admin-tab-city" aria-controls="admin-panel-city" aria-selected="true" data-admin-tab="city">
            <span class="admin-tab__index">01</span>
            <span class="admin-tab__copy"><strong>Create a city</strong><small>New destination workspace</small></span>
          </button>
          <button class="admin-tab" type="button" role="tab" id="admin-tab-field-cards" aria-controls="admin-panel-field-cards" aria-selected="false" tabindex="-1" data-admin-tab="field-cards">
            <span class="admin-tab__index">02</span>
            <span class="admin-tab__copy"><strong>Field Cards</strong><small>Activity page workspace</small></span>
          </button>
          <button class="admin-tab" type="button" role="tab" id="admin-tab-fonts" aria-controls="admin-panel-fonts" aria-selected="false" tabindex="-1" data-admin-tab="fonts">
            <span class="admin-tab__index">03</span>
            <span class="admin-tab__copy"><strong>Font Catalogue</strong><small>Preview the Atlas type library</small></span>
          </button>
        </nav>

        <div class="admin-canvas-wrap">
          <span class="admin-tape admin-tape--left" aria-hidden="true"></span>
          <span class="admin-tape admin-tape--right" aria-hidden="true"></span>

          <section class="admin-panel is-active" id="admin-panel-city" role="tabpanel" aria-labelledby="admin-tab-city" data-admin-panel="city">
            <form class="city-form" id="city-create-form">
              <header class="panel-heading">
                <p class="panel-kicker">NEW DESTINATION · STEP 01</p>
                <h2>Create the next place</h2>
                <p>Only the choices that belong to you are shown here. Categories, search ranges and the technical profile stay automatic.</p>
              </header>

              <section class="form-section">
                <div class="section-number">01</div>
                <div class="section-content">
                  <div class="section-heading"><h3>Destination</h3><p>Name the place and tell Atlas what kind of settlement it is.</p></div>
                  <div class="field-grid field-grid--two">
                    <label class="field">
                      <span>Country</span>
                      <select name="country" id="city-country">
                        {countries.map((country) => <option value={country.slug}>{country.name}</option>)}
                      </select>
                    </label>
                    <label class="field">
                      <span>City or village name</span>
                      <input name="cityName" id="city-name" type="text" autocomplete="off" placeholder="Destination name" required />
                    </label>
                  </div>

                  <fieldset class="choice-fieldset">
                    <legend>Settlement type</legend>
                    <div class="settlement-options">
                      <label class="settlement-card">
                        <input type="radio" name="settlement" value="village" checked />
                        <span class="settlement-card__body"><strong>Village</strong><small>Lighter Atlas structure</small></span>
                      </label>
                      <label class="settlement-card">
                        <input type="radio" name="settlement" value="city" />
                        <span class="settlement-card__body"><strong>City</strong><small>Full default city categories</small></span>
                      </label>
                    </div>
                  </fieldset>

                  <div class="automatic-note">
                    <span class="automatic-note__stamp">AUTO</span>
                    <div><strong>Categories follow the settlement type.</strong><p id="category-summary">Things to do · Restaurants · Coffee · Guest Houses · Essential Information</p></div>
                  </div>
                </div>
              </section>

              <section class="form-section">
                <div class="section-number">02</div>
                <div class="section-content">
                  <div class="section-heading"><h3>Hero artwork</h3><p>Place the three files in GitHub using these canonical paths. Atlas already knows how to read them.</p></div>
                  <div class="asset-list">
                    <div class="asset-row"><span class="asset-row__type">STAMP</span><code id="asset-stamp">/assets/cities/&lt;country&gt;/&lt;destination&gt;/hero/stamps/&lt;destination&gt;-hero-stamp.webp</code></div>
                    <div class="asset-row"><span class="asset-row__type">DRAWING</span><code id="asset-drawing">/assets/cities/&lt;country&gt;/&lt;destination&gt;/hero/drawings/&lt;destination&gt;-hero-drawing.webp</code></div>
                    <div class="asset-row"><span class="asset-row__type">PHOTO</span><code id="asset-photo">/assets/cities/&lt;country&gt;/&lt;destination&gt;/hero/photos/&lt;destination&gt;-hero-photo.webp</code></div>
                  </div>
                  <p class="field-hint">No upload system: the files stay in the repository and the admin only follows the asset convention.</p>
                </div>
              </section>

              <section class="form-section form-section--last">
                <div class="section-number">03</div>
                <div class="section-content">
                  <div class="section-heading"><h3>Generation handoff</h3><p>The admin is still static, so this first version prepares the exact pipeline command instead of exposing a GitHub token in the browser.</p></div>
                  <div class="command-card">
                    <div class="command-card__top"><span>READY COMMAND</span><button type="button" id="copy-command">Copy</button></div>
                    <code id="create-command">npm run create-city -- &lt;country&gt; &lt;destination&gt; --settlement village --profile compact</code>
                  </div>
                  <div class="generation-summary">
                    <div><small>Profile</small><strong>compact · automatic</strong></div>
                    <div><small>Explore Board</small><strong>empty · chosen later</strong></div>
                    <div><small>SEO</small><strong>noindex · draft</strong></div>
                  </div>
                  <button class="generate-button" type="button" id="prepare-city"><span>Prepare this destination</span><small>Copies the pipeline command</small></button>
                  <p class="copy-feedback" id="copy-feedback" aria-live="polite"></p>
                </div>
              </section>
            </form>
          </section>

          <section class="admin-panel" id="admin-panel-field-cards" role="tabpanel" aria-labelledby="admin-tab-field-cards" data-admin-panel="field-cards" hidden></section>

          <section class="admin-panel" id="admin-panel-fonts" role="tabpanel" aria-labelledby="admin-tab-fonts" data-admin-panel="fonts" hidden>
            <FontCatalog />
          </section>
        </div>
      </section>

      <p class="admin-note" aria-hidden="true">build the atlas, one place at a time</p>
    </main>

    <script>
      const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-admin-tab]'));
      const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-admin-panel]'));
      const cityName = document.querySelector<HTMLInputElement>('#city-name');
      const country = document.querySelector<HTMLSelectElement>('#city-country');
      const command = document.querySelector<HTMLElement>('#create-command');
      const stamp = document.querySelector<HTMLElement>('#asset-stamp');
      const drawing = document.querySelector<HTMLElement>('#asset-drawing');
      const photo = document.querySelector<HTMLElement>('#asset-photo');
      const categorySummary = document.querySelector<HTMLElement>('#category-summary');
      const feedback = document.querySelector<HTMLElement>('#copy-feedback');

      const slugify = (value: string) => value.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
      const settlementValue = () => document.querySelector<HTMLInputElement>('input[name="settlement"]:checked')?.value ?? 'village';

      const updatePreview = () => {
        const countrySlug = country?.value || 'country';
        const slug = slugify(cityName?.value || '') || 'destination';
        const settlement = settlementValue();
        const base = `/assets/cities/${countrySlug}/${slug}/hero`;
        if (stamp) stamp.textContent = `${base}/stamps/${slug}-hero-stamp.webp`;
        if (drawing) drawing.textContent = `${base}/drawings/${slug}-hero-drawing.webp`;
        if (photo) photo.textContent = `${base}/photos/${slug}-hero-photo.webp`;
        if (command) command.textContent = `npm run create-city -- ${countrySlug} ${slug} --settlement ${settlement} --profile compact`;
        if (categorySummary) categorySummary.textContent = settlement === 'city'
          ? 'Things to do · Restaurants · Coffee · Guest Houses · Rental Scooter · Gym & Fitness · Market & Shopping · Essential Information'
          : 'Things to do · Restaurants · Coffee · Guest Houses · Essential Information';
      };

      const copyCommand = async () => {
        updatePreview();
        const value = command?.textContent?.trim();
        if (!value) return;
        try {
          await navigator.clipboard.writeText(value);
          if (feedback) feedback.textContent = 'Command copied. It is ready for Codex or your local terminal.';
        } catch {
          if (feedback) feedback.textContent = value;
        }
      };

      const activateTab = (tab: HTMLButtonElement) => {
        const target = tab.dataset.adminTab;
        tabs.forEach((item) => {
          const active = item === tab;
          item.classList.toggle('is-active', active);
          item.setAttribute('aria-selected', String(active));
          item.tabIndex = active ? 0 : -1;
        });
        panels.forEach((panel) => {
          const active = panel.dataset.adminPanel === target;
          panel.classList.toggle('is-active', active);
          panel.hidden = !active;
        });
      };

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => activateTab(tab));
        tab.addEventListener('keydown', (event) => {
          if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
          event.preventDefault();
          let nextIndex = index;
          if (event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
          if (event.key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
          if (event.key === 'Home') nextIndex = 0;
          if (event.key === 'End') nextIndex = tabs.length - 1;
          const nextTab = tabs[nextIndex];
          if (!nextTab) return;
          activateTab(nextTab);
          nextTab.focus();
        });
      });

      document.querySelectorAll('input[name="settlement"]').forEach((input) => input.addEventListener('change', updatePreview));
      cityName?.addEventListener('input', updatePreview);
      country?.addEventListener('change', updatePreview);
      document.querySelector('#copy-command')?.addEventListener('click', copyCommand);
      document.querySelector('#prepare-city')?.addEventListener('click', copyCommand);
      updatePreview();
    </script>
  </body>
</html>

<style>
  :global(html){min-height:100%;background:#ebe4d5} :global(body.admin-body){min-height:100vh;margin:0;color:#213229;background:radial-gradient(circle at 16% 4%,rgb(255 255 255/.7),transparent 28rem),linear-gradient(180deg,#f3eee3 0%,#e8e0d0 100%);font-family:'Manrope',ui-sans-serif,system-ui,sans-serif} :global(body.admin-body::before){position:fixed;inset:0;pointer-events:none;content:'';opacity:.16;background-image:repeating-linear-gradient(0deg,rgb(70 58 39/.035) 0,rgb(70 58 39/.035) 1px,transparent 1px,transparent 4px);mix-blend-mode:multiply}
