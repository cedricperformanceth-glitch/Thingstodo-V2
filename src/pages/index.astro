---
import BaseLayout from '../components/layout/BaseLayout.astro';
import AtlasHomepage from '../components/home/AtlasHomepage.astro';
import '../features/homepage/homepage.css';
import '../features/homepage/coffee.css';
import '../features/homepage/hero-copy.css';

const seo = {
  title: 'Things To Do Atlas',
  description: 'Independent travel chapters for curious travellers. Start with Laos and explore places, field notes and practical stops across the Atlas.',
  canonicalPath: '/',
  indexable: true,
};
---

<BaseLayout {seo} immersive scrollableImmersive showNavbar showFooter breadcrumbs={[{ name: 'Home', path: '/' }]}>
  <AtlasHomepage />
</BaseLayout>
