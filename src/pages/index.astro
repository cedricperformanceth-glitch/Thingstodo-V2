---
import BaseLayout from '../components/layout/BaseLayout.astro';
import AtlasHomepage from '../components/home/AtlasHomepage.astro';
import '../features/homepage/homepage.css';

const seo = {
  title: 'Things To Do Atlas',
  description: 'Choose a country and open your Things To Do Atlas travel chapter.',
  canonicalPath: '/',
  indexable: true,
};
---

<BaseLayout {seo} immersive showNavbar breadcrumbs={[{ name: 'Home', path: '/' }]}>
  <AtlasHomepage />
</BaseLayout>