---
import BaseLayout from '../components/layout/BaseLayout.astro';
import FinalCta from '../components/final-cta/FinalCta.astro';
import { getCountries, getCountry } from '../engines/country/country-engine';
import { getCities } from '../engines/city/city-engine';
import { countryPath, cityPath } from '../core/routing/paths';
export function getStaticPaths() { return getCountries().map((country) => ({ params:{country:country.slug} })); }
const country = getCountry(Astro.params.country ?? '');
if (!country) return Astro.redirect('/');
const cities = getCities().filter((city) => city.country === country.slug);
const isLaos = country.slug === 'laos';
const laosCityNotes: Record<string, string> = {
  'don-det': 'River paths and hammock days',
  'luang-prabang': 'Temple bells and Mekong light',
  pakse: 'Plateau roads and southern rivers',
  'tad-lo': 'Waterfall country at an easy pace',
  thakhek: 'Limestone roads and cave country',
  'vang-vieng': 'Karst horizons and Nam Song',
  vientiane: 'Temple roofs and slow evenings',
};
const laosNavigationOrder = ['luang-prabang', 'vang-vieng', 'vientiane', 'thakhek', 'tad-lo', 'pakse', 'don-det'];
const navigationCities = isLaos
  ? laosNavigationOrder.flatMap((slug) => cities.filter((city) => city.slug === slug))
  : cities;
const laosMapLabels = [
  { slug: 'luang-prabang', name: 'Luang Prabang', x: 970, y: 292, anchor: 'middle', markerX: 929, markerY: 324 },
  { slug: 'vang-vieng', name: 'Vang Vieng', x: 1000, y: 385, anchor: 'middle', markerX: 968, markerY: 405 },
  { slug: 'vientiane', name: 'Vientiane', x: 1012, y: 482, anchor: 'start', markerX: 976, markerY: 495 },
  { slug: 'thakhek', name: 'Thakhek', x: 1150, y: 572, anchor: 'end', markerX: 1136, markerY: 534 },
  { slug: 'tad-lo', name: 'Tad Lo', x: 1336, y: 780, anchor: 'start', markerX: 1304, markerY: 790 },
  { slug: 'pakse', name: 'Pakse', x: 1222, y: 842, anchor: 'end', markerX: 1258, markerY: 814 },
  { slug: 'don-det', name: 'Don Det', x: 1233, y: 956, anchor: 'end', markerX: 1266, markerY: 921 },
];
---
{isLaos ? (
  <BaseLayout immersive showSiteChrome seo={country.seo} breadcrumbs={[{name:'Home',path:'/'},{name:country.name,path:countryPath(country)}]}>
    <section class="laos-board" aria-labelledby="laos-board-title">
      <div class="laos-board__frame">
        <img class="laos-board__art" src="/assets/countries/laos/laos-city-selection.webp" alt="A chalk illustration of the map of Laos on a green framed chalkboard." width="1536" height="1024" fetchpriority="high" />
        <svg class="laos-board__map-labels" viewBox="0 0 1536 1024" aria-label="Laos destination labels, ordered from Luang Prabang in the north to Don Det in the south" role="img">
          {laosMapLabels.map((label, index) => (
            <g class="laos-board__map-destination" data-map-city={label.slug} style={`--map-label-delay:${0.94 + index * 0.14}s`}>
              <circle class="laos-board__map-marker-pulse" cx={label.markerX} cy={label.markerY} r="17" aria-hidden="true" />
              <text class="laos-board__map-label-halo" x={label.x} y={label.y} text-anchor={label.anchor} aria-hidden="true">{label.name}</text>
              <text class="laos-board__map-label-ink" x={label.x} y={label.y} text-anchor={label.anchor}>{label.name}</text>
            </g>
          ))}
        </svg>
        <div class="laos-board__content">
          <header class="laos-board__heading">
            <h1 id="laos-board-title">Explore Laos</h1>
            <svg class="laos-board__underline" viewBox="0 0 208 16" aria-hidden="true">
              <path pathLength="1" d="M3 10.5c28-5.4 57-7.2 85-5.6 40.2 2.2 73.2 7.8 116.5 1.9" />
            </svg>
          </header>
          <nav class="laos-board__cities" aria-label="Choose a city in Laos">
            {navigationCities.map((city, index) => (
              <a class="laos-board__city" data-city={city.slug} href={cityPath(city)} style={`--city-delay:${0.34 + index * 0.13}s`}>
                <span class="laos-board__city-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <span class="laos-board__city-copy">
                  <span class="laos-board__city-name">
                    {city.name}
                    <svg class="laos-board__city-accent" viewBox="0 0 160 9" preserveAspectRatio="none" aria-hidden="true">
                      <path pathLength="1" d="M2 6.2c23-2.7 43-3.1 62-1.7 25 1.8 54 2.9 94-.8" />
                    </svg>
                  </span>
                  <span class="laos-board__city-note">{laosCityNotes[city.slug] ?? city.description}</span>
                </span>
              </a>
            ))}
          </nav>
        </div>
      </div>
    </section>
    <FinalCta country={country.slug} />
    <div class="final-cta-footer-transition" aria-hidden="true"></div>
  </BaseLayout>
) : (
  <BaseLayout seo={country.seo} breadcrumbs={[{name:'Home',path:'/'},{name:country.name,path:countryPath(country)}]}><h1>{country.name}</h1><p>{country.chapter}</p><section><h2>Cities</h2><div class="grid">{cities.map((city) => <article><h3><a href={cityPath(city)}>{city.name}</a></h3><p>{city.description}</p></article>)}</div></section></BaseLayout>
)}

<script>
  document.querySelectorAll<HTMLElement>('.laos-board').forEach((board) => {
    const cityLinks = Array.from(board.querySelectorAll<HTMLElement>('.laos-board__city[data-city]'));
    const mapDestinations = Array.from(board.querySelectorAll<SVGGElement>('.laos-board__map-destination[data-map-city]'));

    const setActiveCity = (slug: string | null) => {
      cityLinks.forEach((link) => link.classList.toggle('is-active', Boolean(slug) && link.dataset.city === slug));
      mapDestinations.forEach((destination) => destination.classList.toggle('is-active', Boolean(slug) && destination.dataset.mapCity === slug));
    };

    cityLinks.forEach((link) => {
      const slug = link.dataset.city ?? null;
      link.addEventListener('pointerenter', () => setActiveCity(slug));
      link.addEventListener('pointerleave', () => {
        if (document.activeElement !== link) setActiveCity(null);
      });
      link.addEventListener('focus', () => setActiveCity(slug));
      link.addEventListener('blur', () => setActiveCity(null));
    });
  });
</script>

<style>
  :global(body.page--immersive) { background: #10291f; }
  :global(main.main--immersive) { width: 100%; min-height: 100svh; margin: 0; padding: 0; }
  .final-cta-footer-transition {
    width: 100vw;
    height: clamp(2.5rem, 5vw, 4.5rem);
    margin-left: calc(50% - 50vw);
    background: linear-gradient(
      180deg,
      #f3ede0 0%,
      rgba(243, 237, 224, .72) 18%,
      rgba(49, 85, 69, .54) 48%,
      #315545 80%,
      #315545 100%
    );
  }
  .laos-board {
    --laos-blue: #002868;
    --laos-blue-deep: #002868;
    --laos-blue-glow: #002868;
    --laos-red: #7d2730;
    --laos-label-erase: #214739;
    --chalk-ivory: #EEE4CF;
    --chalk-muted: #d7ccb5;
    min-height: 100svh;
    overflow: hidden;
    background: #10291f;
  }
  .laos-board__frame {
    position: relative;
    width: min(100vw, 150svh);
    min-height: min(100svh, 66.6667vw);
    margin: 0 auto;
    container-type: inline-size;
  }
  .laos-board__art { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: contain; }
  .laos-board__map-labels { position: absolute; inset: 0; z-index: 1; width: 100%; height: 100%; pointer-events: none; overflow: visible; }
  .laos-board__map-labels text { font: 650 32px/1 var(--handwritten); letter-spacing: .012em; }
  .laos-board__map-destination { --map-label-color: var(--laos-blue); }
  .laos-board__map-label-halo { fill: none; stroke: var(--laos-label-erase); stroke-width: 5.2; stroke-linecap: round; stroke-linejoin: round; paint-order: stroke; opacity: 0; animation: map-label-halo .18s ease-out calc(var(--map-label-delay) + .46s) forwards; }
  .laos-board__map-label-ink { fill: transparent; stroke: var(--map-label-color); stroke-width: 1.08; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 520; stroke-dashoffset: 520; paint-order: stroke; opacity: .98; transition: filter 220ms ease, opacity 220ms ease; animation: map-label-write .86s cubic-bezier(.2,.75,.22,1) var(--map-label-delay) forwards; }
  .laos-board__map-marker-pulse { fill: rgb(0 40 104 / .08); stroke: var(--laos-blue-glow); stroke-width: 1.7; opacity: 0; transform: scale(.68); transform-box: fill-box; transform-origin: center; transition: opacity 220ms ease, transform 260ms cubic-bezier(.2,.75,.22,1); }
  .laos-board__map-destination.is-active { --map-label-color: var(--laos-blue-glow); }
  .laos-board__map-destination.is-active .laos-board__map-label-ink { filter: drop-shadow(0 0 4px rgb(0 40 104 / .5)); opacity: 1; }
  .laos-board__map-destination.is-active .laos-board__map-marker-pulse { opacity: .96; transform: scale(1); }

  /* Desktop composition is locked to the chalkboard itself, not the viewport. */
  .laos-board__content { position: absolute; inset: 0; z-index: 2; min-width: 0; pointer-events: none; }
  .laos-board__heading {
    position: absolute;
    top: 11.2%;
    left: 22.7%;
    width: max-content;
    max-width: 34%;
    color: rgb(246 244 224 / .93);
    pointer-events: auto;
  }
  .laos-board__heading h1 { margin: 0; font: 500 clamp(2.9rem, 4.7cqw, 5.2rem) / .86 var(--handwritten); letter-spacing: -.055em; white-space: nowrap; opacity: 0; clip-path: inset(0 100% 0 0); animation: chalk-write .95s cubic-bezier(.2,.75,.22,1) .08s forwards; }
  .laos-board__underline { display: block; width: min(15.5rem, 100%); height: auto; margin: .45rem 0 0 .15rem; overflow: visible; }
  .laos-board__underline path { fill: none; stroke: var(--laos-red); stroke-width: 1.45; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 1; opacity: .88; animation: chalk-underline .8s ease-out .48s forwards; }

  .laos-board__cities {
    position: absolute;
    top: 27.2%;
    left: 7.6%;
    display: grid;
    grid-template-columns: minmax(0, 1.16fr) minmax(0, .84fr);
    grid-template-rows: repeat(4, auto);
    grid-auto-flow: column;
    column-gap: clamp(1.65rem, 2.25cqw, 2.35rem);
    row-gap: clamp(1.15rem, 1.55cqw, 1.55rem);
    width: 34.5%;
    max-width: 34.5%;
    margin: 0;
    align-items: start;
    pointer-events: auto;
  }
  .laos-board__city {
    display: grid;
    grid-template-columns: 2.15rem minmax(0, 1fr);
    gap: .48rem;
    width: 100%;
    min-width: 0;
    color: var(--chalk-ivory);
    text-decoration: none;
    opacity: 0;
    clip-path: inset(0 100% 0 0);
    animation: chalk-write .72s cubic-bezier(.2,.75,.22,1) var(--city-delay) forwards;
  }
  .laos-board__city-index {
    display: flex;
    align-items: center;
    gap: .26rem;
    padding-top: .38rem;
    color: rgb(238 228 207 / .5);
    font: 500 clamp(.61rem, .66cqw, .7rem) / 1 var(--field-card-practical);
    letter-spacing: .12em;
    transition: color 220ms ease, text-shadow 220ms ease;
  }
  .laos-board__city-index::after {
    content: '';
    display: block;
    width: .58rem;
    height: 1px;
    background: currentColor;
    opacity: .62;
    transform: rotate(-4deg);
    transform-origin: left center;
  }
  .laos-board__city-copy { display: grid; gap: .31rem; min-width: 0; }
  .laos-board__city-name {
    position: relative;
    display: inline-block;
    justify-self: start;
    max-width: 100%;
    padding-bottom: .2rem;
    font: 600 clamp(1.42rem, 2.02cqw, 1.95rem) / 1.02 var(--field-card-title);
    letter-spacing: .004em;
    text-wrap: balance;
    text-shadow: 0 1px 0 rgb(0 0 0 / .28), 0 0 8px rgb(238 228 207 / .035);
    transition: color 220ms ease, text-shadow 220ms ease, transform 220ms cubic-bezier(.2,.75,.22,1);
  }
  .laos-board__city[data-city='luang-prabang'] .laos-board__city-name,
  .laos-board__city[data-city='vang-vieng'] .laos-board__city-name { white-space: nowrap; }
  .laos-board__city-accent { position: absolute; left: 0; bottom: -.1rem; width: 100%; min-width: 3rem; height: .42rem; overflow: visible; opacity: .2; }
  .laos-board__city-accent path { fill: none; stroke: var(--laos-blue-glow); stroke-width: 1.35; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke 220ms ease, stroke-dashoffset 320ms cubic-bezier(.2,.75,.22,1), opacity 220ms ease; }
  .laos-board__city-note {
    max-width: 14rem;
    color: rgb(235 226 208 / .88);
    font: 400 clamp(.86rem, 1.02cqw, .98rem) / 1.36 var(--field-card-practical);
    letter-spacing: .008em;
    text-wrap: pretty;
    text-shadow: 0 1px 0 rgb(0 0 0 / .22);
    transition: color 220ms ease, opacity 220ms ease, transform 220ms ease;
  }
  .laos-board__city:is(:hover, :focus-visible, .is-active) .laos-board__city-index { color: var(--laos-blue-glow); text-shadow: 0 0 7px rgb(0 40 104 / .28); }
  .laos-board__city:is(:hover, :focus-visible, .is-active) .laos-board__city-name { color: var(--laos-blue-glow); text-shadow: 0 1px 0 rgb(0 0 0 / .24), 0 0 8px rgb(0 40 104 / .24); transform: translateY(-1px); }
  .laos-board__city:is(:hover, :focus-visible, .is-active) .laos-board__city-accent { opacity: .9; }
  .laos-board__city:is(:hover, :focus-visible, .is-active) .laos-board__city-accent path { stroke: var(--laos-red); stroke-dashoffset: 0; }
  .laos-board__city:is(:hover, :focus-visible, .is-active) .laos-board__city-note { color: rgb(248 242 228 / .98); transform: translateY(-1px); }
  .laos-board__city:focus-visible { outline: 1px dashed var(--laos-blue-glow); outline-offset: 7px; border-radius: 2px; }

  @keyframes chalk-write { to { opacity: 1; clip-path: inset(0 -2rem 0 0); } }
  @keyframes chalk-underline { to { stroke-dashoffset: 0; } }
  @keyframes map-label-halo { to { opacity: .92; } }
  @keyframes map-label-write { 0%,68% { fill: transparent; } 100% { fill: var(--map-label-color); stroke-dashoffset: 0; } }

  @media (max-width: 1100px) and (min-width: 861px) {
    .laos-board__cities { left: 6.8%; width: 37%; max-width: 37%; column-gap: 1.25rem; row-gap: 1.05rem; }
    .laos-board__city { grid-template-columns: 1.9rem minmax(0, 1fr); gap: .35rem; }
    .laos-board__city-index::after { width: .4rem; }
    .laos-board__city-name { font-size: clamp(1.25rem, 2cqw, 1.55rem); }
    .laos-board__city-note { max-width: 11.5rem; font-size: clamp(.76rem, 1cqw, .86rem); }
  }

  @media (max-width: 860px) {
    .laos-board { min-height: 100dvh; background: #10291f; }
    .laos-board__frame { width: 100%; min-height: 100dvh; margin: 0; container-type: normal; }
    .laos-board__art, .laos-board__map-labels { width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: contain; object-position: top center; }
    .laos-board__map-labels { inset: 0 auto auto 0; }
    .laos-board__content { position: relative; inset: auto; width: min(86%, 38rem); min-width: 0; padding: clamp(6.8rem, 18vw, 10rem) 0 3rem clamp(2rem, 7vw, 4rem); pointer-events: auto; }
    .laos-board__heading { position: static; width: max-content; max-width: 100%; }
    .laos-board__heading h1 { font-size: clamp(2.9rem, 8vw, 4.5rem); }
    .laos-board__cities { position: relative; inset: auto; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: repeat(4, auto); grid-auto-flow: column; column-gap: 2rem; row-gap: 1.55rem; width: min(34rem, 100%); max-width: 100%; margin-top: clamp(2.2rem, 6vw, 3.5rem); }
    .laos-board__city { grid-template-columns: 2.15rem minmax(0, 1fr); gap: .45rem; }
    .laos-board__city-name { font-size: 1.48rem; }
    .laos-board__city-note { max-width: 12.5rem; font-size: .84rem; }
  }
  @media (max-width: 640px) {
    .final-cta-footer-transition { height: 2.75rem; }
  }
  @media (max-width: 560px) {
    .laos-board { background: #10291f; }
    .laos-board__art { display: block; }
    .laos-board__content { width: min(100% - 3rem, 27rem); padding: clamp(7.25rem, 30vw, 10rem) 0 3rem; margin-inline: auto; }
    .laos-board__cities { grid-template-columns: 1fr; grid-template-rows: none; grid-auto-flow: row; gap: 1.1rem; margin-top: 2.5rem; }
    .laos-board__city { grid-template-columns: 2.15rem minmax(0, 1fr); }
    .laos-board__city-name { font-size: 1.42rem; }
    .laos-board__city-note { max-width: none; font-size: .84rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .laos-board__heading h1, .laos-board__city { opacity: 1; clip-path: none; animation: none; }
    .laos-board__underline path { stroke-dashoffset: 0; animation: none; }
    .laos-board__map-label-halo { opacity: .92; animation: none; }
    .laos-board__map-label-ink { fill: var(--map-label-color); stroke-dashoffset: 0; animation: none; transition: none; }
    .laos-board__map-marker-pulse, .laos-board__city-name, .laos-board__city-note, .laos-board__city-index, .laos-board__city-accent path { transition: none; }
  }
</style>